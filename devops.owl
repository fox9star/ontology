<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/ontology/devops#imageTag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">이미지 태그</rdfs:label>
    <rdfs:label xml:lang="en">Image Tag</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#BuildArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the image tag for a Build Artifact as a string value.</rdfs:comment>
    <rdfs:comment xml:lang="ko">빌드 산출물에 기록된 컨테이너 이미지 태그 또는 배포 표식 문자열을 보존한다. 내용 해시와 동일한 식별자로 간주하지 않는다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#vulnerabilityCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">취약점 수</rdfs:label>
    <rdfs:label xml:lang="en">Vulnerability Count</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#SecurityScanTask"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Records the vulnerability count for a Security Scan Task as a integer value.</rdfs:comment>
    <rdfs:comment xml:lang="ko">보안 검사 실행에서 보고한 취약점 개수를 정수로 기록한다. 개수가 없으면 0으로 추정하지 않는다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#branchName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">브랜치 이름</rdfs:label>
    <rdfs:label xml:lang="en">Branch Name</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#DevOpsPipeline"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the branch name for a DevOps Pipeline as a string value.</rdfs:comment>
    <rdfs:comment xml:lang="ko">파이프라인 실행이 대상으로 삼은 소스 저장소 브랜치 이름을 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#DevOpsAgent">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/core#Agent"/>
    <rdfs:label xml:lang="ko">DevOps 에이전트</rdfs:label>
    <rdfs:label>DevOps Agent</rdfs:label>
    <rdfs:label xml:lang="en">DevOps Agent</rdfs:label>
    <rdfs:comment>Autonomous agent responsible for managing CI/CD operations.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents an agent that manages or performs CI/CD pipeline work.</rdfs:comment>
    <rdfs:comment xml:lang="ko">CI/CD 파이프라인 작업을 관리하거나 수행하는 사람 또는 소프트웨어 에이전트.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#generatesReport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/ontology/core#runOutput"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#SecurityScanTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/devops#VulnerabilityReport"/>
    <rdfs:label xml:lang="ko">취약점 보고서를 생성</rdfs:label>
    <rdfs:label xml:lang="en">Generates Report</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Security Scan Task to a Vulnerability Report.</rdfs:comment>
    <rdfs:comment xml:lang="ko">보안 검사 실행이 생성한 취약점 보고서를 연결한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#hasTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#DevOpsPipeline"/>
    <rdfs:range rdf:resource="http://example.org/ontology/devops#PipelineTask"/>
    <rdfs:label xml:lang="ko">작업을 포함</rdfs:label>
    <rdfs:label>has task</rdfs:label>
    <rdfs:label xml:lang="en">Has Task</rdfs:label>
    <rdfs:comment>Links a pipeline to its constituent tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a DevOps Pipeline to a Pipeline Task.</rdfs:comment>
    <rdfs:comment xml:lang="ko">CI/CD 파이프라인 실행에 포함된 개별 작업 실행을 연결한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#pipelineId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">파이프라인 ID</rdfs:label>
    <rdfs:label xml:lang="en">Pipeline ID</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#DevOpsPipeline"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the pipeline id for a DevOps Pipeline as a string value.</rdfs:comment>
    <rdfs:comment xml:lang="ko">실행 시스템이 부여한 CI/CD 파이프라인 식별 문자열을 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#DeploymentTask">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/devops#PipelineTask"/>
    <rdfs:label xml:lang="ko">배포 작업</rdfs:label>
    <rdfs:label>Deployment Task</rdfs:label>
    <rdfs:label xml:lang="en">Deployment Task</rdfs:label>
    <rdfs:comment>Artifact deployment task into target environments.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents deployment of an artifact to a target environment.</rdfs:comment>
    <rdfs:comment xml:lang="ko">빌드 산출물을 명시된 대상 환경에 배포하는 파이프라인 작업 실행.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#environmentName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">환경 이름</rdfs:label>
    <rdfs:label xml:lang="en">Environment Name</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#TargetEnvironment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the environment name for a Target Environment as a string value.</rdfs:comment>
    <rdfs:comment xml:lang="ko">배포 대상 환경의 사람이 읽을 수 있는 이름을 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#SecurityScanTask">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/devops#PipelineTask"/>
    <rdfs:label xml:lang="ko">보안 검사 작업</rdfs:label>
    <rdfs:label>Security Scan Task</rdfs:label>
    <rdfs:label xml:lang="en">Security Scan Task</rdfs:label>
    <rdfs:comment>Static analysis and vulnerability scanning task.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents security analysis or vulnerability scanning in a pipeline.</rdfs:comment>
    <rdfs:comment xml:lang="ko">코드 또는 산출물의 보안 문제와 취약점을 검사하는 파이프라인 작업 실행.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#producesArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/ontology/core#runOutput"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#BuildTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/devops#BuildArtifact"/>
    <rdfs:label xml:lang="ko">빌드 산출물을 생성</rdfs:label>
    <rdfs:label xml:lang="en">Produces Artifact</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Build Task to a Build Artifact.</rdfs:comment>
    <rdfs:comment xml:lang="ko">빌드 작업 실행이 생성한 바이너리·이미지·패키지 산출물을 연결한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#PipelineTask">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/core#TaskRun"/>
    <rdfs:label xml:lang="ko">파이프라인 작업 실행</rdfs:label>
    <rdfs:label>Pipeline Task</rdfs:label>
    <rdfs:label xml:lang="en">Pipeline Task</rdfs:label>
    <rdfs:comment>Individual step or job in a DevOps pipeline.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents an individual step or job in a DevOps pipeline.</rdfs:comment>
    <rdfs:comment xml:lang="ko">CI/CD 파이프라인에 포함된 개별 단계의 작업 실행. 빌드·보안 검사·배포 실행의 상위 클래스이다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#BuildTask">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/devops#PipelineTask"/>
    <rdfs:label xml:lang="ko">빌드 작업</rdfs:label>
    <rdfs:label>Build Task</rdfs:label>
    <rdfs:label xml:lang="en">Build Task</rdfs:label>
    <rdfs:comment>Code compilation and packaging task.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents compilation or packaging work in a DevOps pipeline.</rdfs:comment>
    <rdfs:comment xml:lang="ko">소스 코드를 컴파일하거나 패키징해 빌드 산출물을 만드는 파이프라인 작업 실행.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#DevOpsPipeline">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/core#TaskRun"/>
    <rdfs:label xml:lang="ko">CI/CD 파이프라인 실행</rdfs:label>
    <rdfs:label>DevOps Pipeline</rdfs:label>
    <rdfs:label xml:lang="en">DevOps Pipeline</rdfs:label>
    <rdfs:comment>A CI/CD execution pipeline managed by AI agents.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents an ordered CI/CD workflow and its constituent tasks.</rdfs:comment>
    <rdfs:comment xml:lang="ko">특정 소스 커밋에 대해 여러 파이프라인 작업을 묶어 수행한 한 번의 CI/CD 실행.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#commitHash">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">커밋 해시</rdfs:label>
    <rdfs:label xml:lang="en">Commit Hash</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#DevOpsPipeline"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the commit hash for a DevOps Pipeline as a string value.</rdfs:comment>
    <rdfs:comment xml:lang="ko">파이프라인 실행에 사용한 소스 커밋의 해시 식별자를 기록한다. 현재 브랜치의 최신 커밋과 자동으로 같다고 간주하지 않는다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#BuildArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/core#Artifact"/>
    <rdfs:label xml:lang="ko">빌드 산출물</rdfs:label>
    <rdfs:label>Build Artifact</rdfs:label>
    <rdfs:label xml:lang="en">Build Artifact</rdfs:label>
    <rdfs:comment>Output binary, Docker image, or package produced by a build task.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a binary, container image, or package produced by a build task.</rdfs:comment>
    <rdfs:comment xml:lang="ko">빌드 실행이 생성한 실행 파일, 컨테이너 이미지 또는 배포 패키지 결과물.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInformedBy"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#PipelineTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/devops#PipelineTask"/>
    <rdfs:label xml:lang="ko">선행 파이프라인 작업</rdfs:label>
    <rdfs:label xml:lang="en">Depends On</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Pipeline Task to a Pipeline Task.</rdfs:comment>
    <rdfs:comment xml:lang="ko">한 파이프라인 작업 실행이 선행 작업 실행에 의존함을 연결한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#TargetEnvironment">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">배포 대상 환경</rdfs:label>
    <rdfs:label>Target Environment</rdfs:label>
    <rdfs:label xml:lang="en">Target Environment</rdfs:label>
    <rdfs:comment>Deployment target such as Staging, Production, or K8s Cluster.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents an environment to which a build artifact may be deployed.</rdfs:comment>
    <rdfs:comment xml:lang="ko">빌드 산출물이 배포되는 운영·검증 등의 대상 환경을 식별하는 자원.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#deploysArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#DeploymentTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/devops#BuildArtifact"/>
    <rdfs:label xml:lang="ko">배포한 빌드 산출물</rdfs:label>
    <rdfs:label xml:lang="en">Deploys Artifact</rdfs:label>
    <rdfs:comment xml:lang="ko">배포 실행이 실제로 사용한 빌드 산출물.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a Deployment Task to a Build Artifact.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#executionStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/ontology/core#taskStatus"/>
    <rdfs:label xml:lang="ko">실행 상태</rdfs:label>
    <rdfs:label xml:lang="en">Execution Status</rdfs:label>
    <rdfs:domain rdf:nodeID="nd3cbc7e218064b16b34384f09865f348b1"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the execution status for a subject as a string value.</rdfs:comment>
    <rdfs:comment xml:lang="ko">전체 파이프라인 또는 개별 단계 실행의 상태 코드를 기록한다. 허용 값과 단계 간 일관성은 SHACL에서 검사한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#VulnerabilityReport">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/core#Artifact"/>
    <rdfs:label xml:lang="ko">취약점 보고서</rdfs:label>
    <rdfs:label>Vulnerability Report</rdfs:label>
    <rdfs:label xml:lang="en">Vulnerability Report</rdfs:label>
    <rdfs:comment>Security audit report listing CVEs and severity levels.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents findings produced by a security scan.</rdfs:comment>
    <rdfs:comment xml:lang="ko">보안 검사 실행에서 발견한 취약점과 분석 결과를 담은 보고서 결과물.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd3cbc7e218064b16b34384f09865f348b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="nd3cbc7e218064b16b34384f09865f348b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#deployedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#DeploymentTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/devops#TargetEnvironment"/>
    <rdfs:label xml:lang="ko">배포 환경</rdfs:label>
    <rdfs:label xml:lang="en">Deployed To</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Deployment Task to a Target Environment.</rdfs:comment>
    <rdfs:comment xml:lang="ko">배포 작업 실행의 대상 환경을 연결한다. 배포 성공 여부는 실행 상태로 별도 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops#managedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/ontology/core#runAgent"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/devops#PipelineTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/devops#DevOpsAgent"/>
    <rdfs:label xml:lang="ko">담당 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Managed By</rdfs:label>
    <rdfs:comment xml:lang="ko">실행 작업을 담당하는 DevOps 에이전트.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a Pipeline Task to a DevOps Agent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/devops">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">DevOps 및 CI/CD 에이전트 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">DevOps &amp; CI/CD AI Agent Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">소프트웨어 빌드, 보안 검사, 컨테이너 패키징 및 배포 실행을 표현한다.</rdfs:comment>
    <owl:imports rdf:resource="https://example.org/ontology/core"/>
    <owl:imports rdf:resource="https://example.org/ontology/vocab"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <owl:versionInfo>1.2.1</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd3cbc7e218064b16b34384f09865f348b2">
    <rdf:first rdf:resource="http://example.org/ontology/devops#DevOpsPipeline"/>
