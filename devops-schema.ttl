@prefix devops: <http://example.org/ontology/devops#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix core: <https://example.org/ontology/core#> .

<http://example.org/ontology/devops> a owl:Ontology ;
    rdfs:label "DevOps 및 CI/CD 에이전트 온톨로지"@ko, "DevOps & CI/CD AI Agent Ontology"@en ;
    rdfs:comment "소프트웨어 빌드, 보안 검사, 컨테이너 패키징 및 배포 실행을 표현한다."@ko ;
    owl:imports <https://example.org/ontology/core>, <https://example.org/ontology/vocab>, <http://www.w3.org/ns/prov-o#> ;
    owl:versionInfo "1.2.1" .

# Classes
devops:DevOpsPipeline a rdfs:Class, owl:Class ;
    rdfs:subClassOf core:TaskRun ;
    rdfs:label "CI/CD 파이프라인 실행"@ko ;
    rdfs:label "DevOps Pipeline" ;
    rdfs:comment "A CI/CD execution pipeline managed by AI agents." .

devops:PipelineTask a rdfs:Class, owl:Class ;
    rdfs:subClassOf core:TaskRun ;
    rdfs:label "파이프라인 작업 실행"@ko ;
    rdfs:label "Pipeline Task" ;
    rdfs:comment "Individual step or job in a DevOps pipeline." .

devops:BuildTask a rdfs:Class, owl:Class ;
    rdfs:subClassOf devops:PipelineTask ;
    rdfs:label "빌드 작업"@ko ;
    rdfs:label "Build Task" ;
    rdfs:comment "Code compilation and packaging task." .

devops:SecurityScanTask a rdfs:Class, owl:Class ;
    rdfs:subClassOf devops:PipelineTask ;
    rdfs:label "보안 검사 작업"@ko ;
    rdfs:label "Security Scan Task" ;
    rdfs:comment "Static analysis and vulnerability scanning task." .

devops:DeploymentTask a rdfs:Class, owl:Class ;
    rdfs:subClassOf devops:PipelineTask ;
    rdfs:label "배포 작업"@ko ;
    rdfs:label "Deployment Task" ;
    rdfs:comment "Artifact deployment task into target environments." .

devops:DevOpsAgent a rdfs:Class, owl:Class ;
    rdfs:subClassOf core:Agent ;
    rdfs:label "DevOps 에이전트"@ko ;
    rdfs:label "DevOps Agent" ;
    rdfs:comment "Autonomous agent responsible for managing CI/CD operations." .

devops:BuildArtifact a rdfs:Class, owl:Class ;
    rdfs:subClassOf core:Artifact ;
    rdfs:label "빌드 산출물"@ko ;
    rdfs:label "Build Artifact" ;
    rdfs:comment "Output binary, Docker image, or package produced by a build task." .

devops:TargetEnvironment a rdfs:Class, owl:Class ;
    rdfs:label "배포 대상 환경"@ko ;
    rdfs:label "Target Environment" ;
    rdfs:comment "Deployment target such as Staging, Production, or K8s Cluster." .

devops:VulnerabilityReport a rdfs:Class, owl:Class ;
    rdfs:subClassOf core:Artifact ;
    rdfs:label "취약점 보고서"@ko ;
    rdfs:label "Vulnerability Report" ;
    rdfs:comment "Security audit report listing CVEs and severity levels." .

# Object Properties
devops:hasTask a owl:ObjectProperty ;
    rdfs:domain devops:DevOpsPipeline ; rdfs:range devops:PipelineTask ;
    rdfs:label "작업을 포함"@ko ;
    rdfs:label "has task" ;
    rdfs:comment "Links a pipeline to its constituent tasks." .

devops:managedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf core:runAgent ;
    rdfs:domain devops:PipelineTask ; rdfs:range devops:DevOpsAgent ;
    rdfs:label "담당 에이전트"@ko ;
    rdfs:comment "실행 작업을 담당하는 DevOps 에이전트."@ko .

devops:producesArtifact a owl:ObjectProperty ;
    rdfs:subPropertyOf core:runOutput ;
    rdfs:domain devops:BuildTask ; rdfs:range devops:BuildArtifact ;
    rdfs:label "빌드 산출물을 생성"@ko .

devops:deployedTo a owl:ObjectProperty ;
    rdfs:domain devops:DeploymentTask ; rdfs:range devops:TargetEnvironment ;
    rdfs:label "배포 환경"@ko .

devops:deploysArtifact a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain devops:DeploymentTask ; rdfs:range devops:BuildArtifact ;
    rdfs:label "배포한 빌드 산출물"@ko ;
    rdfs:comment "배포 실행이 실제로 사용한 빌드 산출물."@ko .

devops:dependsOn a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasInformedBy ;
    rdfs:domain devops:PipelineTask ; rdfs:range devops:PipelineTask ;
    rdfs:label "선행 파이프라인 작업"@ko .

devops:generatesReport a owl:ObjectProperty ;
    rdfs:subPropertyOf core:runOutput ;
    rdfs:domain devops:SecurityScanTask ; rdfs:range devops:VulnerabilityReport ;
    rdfs:label "취약점 보고서를 생성"@ko .

# Datatype Properties
devops:pipelineId a owl:DatatypeProperty ;
    rdfs:label "파이프라인 ID"@ko ;
    rdfs:domain devops:DevOpsPipeline ;
    rdfs:range xsd:string .

devops:commitHash a owl:DatatypeProperty ;
    rdfs:label "커밋 해시"@ko ;
    rdfs:domain devops:DevOpsPipeline ;
    rdfs:range xsd:string .

devops:branchName a owl:DatatypeProperty ;
    rdfs:label "브랜치 이름"@ko ;
    rdfs:domain devops:DevOpsPipeline ;
    rdfs:range xsd:string .

devops:executionStatus a owl:DatatypeProperty ;
    rdfs:subPropertyOf core:taskStatus ;
    rdfs:label "실행 상태"@ko ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( devops:DevOpsPipeline devops:PipelineTask ) ] ;
    rdfs:range xsd:string .

devops:vulnerabilityCount a owl:DatatypeProperty ;
    rdfs:label "취약점 수"@ko ;
    rdfs:domain devops:SecurityScanTask ;
    rdfs:range xsd:integer .

devops:imageTag a owl:DatatypeProperty ;
    rdfs:label "이미지 태그"@ko ;
    rdfs:domain devops:BuildArtifact ;
    rdfs:range xsd:string .

devops:environmentName a owl:DatatypeProperty ;
    rdfs:label "환경 이름"@ko ;
    rdfs:domain devops:TargetEnvironment ;
    rdfs:range xsd:string .

# English labels and definitions for named schema terms.
<http://example.org/ontology/devops#BuildArtifact> rdfs:label "Build Artifact"@en ; rdfs:comment "Represents a binary, container image, or package produced by a build task."@en .
<http://example.org/ontology/devops#BuildTask> rdfs:label "Build Task"@en ; rdfs:comment "Represents compilation or packaging work in a DevOps pipeline."@en .
<http://example.org/ontology/devops#DeploymentTask> rdfs:label "Deployment Task"@en ; rdfs:comment "Represents deployment of an artifact to a target environment."@en .
<http://example.org/ontology/devops#DevOpsAgent> rdfs:label "DevOps Agent"@en ; rdfs:comment "Represents an agent that manages or performs CI/CD pipeline work."@en .
<http://example.org/ontology/devops#DevOpsPipeline> rdfs:label "DevOps Pipeline"@en ; rdfs:comment "Represents an ordered CI/CD workflow and its constituent tasks."@en .
<http://example.org/ontology/devops#PipelineTask> rdfs:label "Pipeline Task"@en ; rdfs:comment "Represents an individual step or job in a DevOps pipeline."@en .
<http://example.org/ontology/devops#SecurityScanTask> rdfs:label "Security Scan Task"@en ; rdfs:comment "Represents security analysis or vulnerability scanning in a pipeline."@en .
<http://example.org/ontology/devops#TargetEnvironment> rdfs:label "Target Environment"@en ; rdfs:comment "Represents an environment to which a build artifact may be deployed."@en .
<http://example.org/ontology/devops#VulnerabilityReport> rdfs:label "Vulnerability Report"@en ; rdfs:comment "Represents findings produced by a security scan."@en .
<http://example.org/ontology/devops#branchName> rdfs:label "Branch Name"@en ; rdfs:comment "Records the branch name for a DevOps Pipeline as a string value."@en .
<http://example.org/ontology/devops#commitHash> rdfs:label "Commit Hash"@en ; rdfs:comment "Records the commit hash for a DevOps Pipeline as a string value."@en .
<http://example.org/ontology/devops#dependsOn> rdfs:label "Depends On"@en ; rdfs:comment "Links a Pipeline Task to a Pipeline Task."@en .
<http://example.org/ontology/devops#deployedTo> rdfs:label "Deployed To"@en ; rdfs:comment "Links a Deployment Task to a Target Environment."@en .
<http://example.org/ontology/devops#deploysArtifact> rdfs:label "Deploys Artifact"@en ; rdfs:comment "Links a Deployment Task to a Build Artifact."@en .
<http://example.org/ontology/devops#environmentName> rdfs:label "Environment Name"@en ; rdfs:comment "Records the environment name for a Target Environment as a string value."@en .
<http://example.org/ontology/devops#executionStatus> rdfs:label "Execution Status"@en ; rdfs:comment "Records the execution status for a subject as a string value."@en .
<http://example.org/ontology/devops#generatesReport> rdfs:label "Generates Report"@en ; rdfs:comment "Links a Security Scan Task to a Vulnerability Report."@en .
<http://example.org/ontology/devops#hasTask> rdfs:label "Has Task"@en ; rdfs:comment "Links a DevOps Pipeline to a Pipeline Task."@en .
<http://example.org/ontology/devops#imageTag> rdfs:label "Image Tag"@en ; rdfs:comment "Records the image tag for a Build Artifact as a string value."@en .
<http://example.org/ontology/devops#managedBy> rdfs:label "Managed By"@en ; rdfs:comment "Links a Pipeline Task to a DevOps Agent."@en .
<http://example.org/ontology/devops#pipelineId> rdfs:label "Pipeline ID"@en ; rdfs:comment "Records the pipeline id for a DevOps Pipeline as a string value."@en .
<http://example.org/ontology/devops#producesArtifact> rdfs:label "Produces Artifact"@en ; rdfs:comment "Links a Build Task to a Build Artifact."@en .
<http://example.org/ontology/devops#vulnerabilityCount> rdfs:label "Vulnerability Count"@en ; rdfs:comment "Records the vulnerability count for a Security Scan Task as a integer value."@en .

# Korean definitions for CI/CD executions and artifact provenance.
devops:BuildArtifact rdfs:comment "빌드 실행이 생성한 실행 파일, 컨테이너 이미지 또는 배포 패키지 결과물."@ko .
devops:BuildTask rdfs:comment "소스 코드를 컴파일하거나 패키징해 빌드 산출물을 만드는 파이프라인 작업 실행."@ko .
devops:DeploymentTask rdfs:comment "빌드 산출물을 명시된 대상 환경에 배포하는 파이프라인 작업 실행."@ko .
devops:DevOpsAgent rdfs:comment "CI/CD 파이프라인 작업을 관리하거나 수행하는 사람 또는 소프트웨어 에이전트."@ko .
devops:DevOpsPipeline rdfs:comment "특정 소스 커밋에 대해 여러 파이프라인 작업을 묶어 수행한 한 번의 CI/CD 실행."@ko .
devops:PipelineTask rdfs:comment "CI/CD 파이프라인에 포함된 개별 단계의 작업 실행. 빌드·보안 검사·배포 실행의 상위 클래스이다."@ko .
devops:SecurityScanTask rdfs:comment "코드 또는 산출물의 보안 문제와 취약점을 검사하는 파이프라인 작업 실행."@ko .
devops:TargetEnvironment rdfs:comment "빌드 산출물이 배포되는 운영·검증 등의 대상 환경을 식별하는 자원."@ko .
devops:VulnerabilityReport rdfs:comment "보안 검사 실행에서 발견한 취약점과 분석 결과를 담은 보고서 결과물."@ko .
devops:branchName rdfs:comment "파이프라인 실행이 대상으로 삼은 소스 저장소 브랜치 이름을 기록한다."@ko .
devops:commitHash rdfs:comment "파이프라인 실행에 사용한 소스 커밋의 해시 식별자를 기록한다. 현재 브랜치의 최신 커밋과 자동으로 같다고 간주하지 않는다."@ko .
devops:dependsOn rdfs:comment "한 파이프라인 작업 실행이 선행 작업 실행에 의존함을 연결한다."@ko .
devops:deployedTo rdfs:comment "배포 작업 실행의 대상 환경을 연결한다. 배포 성공 여부는 실행 상태로 별도 기록한다."@ko .
devops:environmentName rdfs:comment "배포 대상 환경의 사람이 읽을 수 있는 이름을 기록한다."@ko .
devops:executionStatus rdfs:comment "전체 파이프라인 또는 개별 단계 실행의 상태 코드를 기록한다. 허용 값과 단계 간 일관성은 SHACL에서 검사한다."@ko .
devops:generatesReport rdfs:comment "보안 검사 실행이 생성한 취약점 보고서를 연결한다."@ko .
devops:hasTask rdfs:comment "CI/CD 파이프라인 실행에 포함된 개별 작업 실행을 연결한다."@ko .
devops:imageTag rdfs:comment "빌드 산출물에 기록된 컨테이너 이미지 태그 또는 배포 표식 문자열을 보존한다. 내용 해시와 동일한 식별자로 간주하지 않는다."@ko .
devops:pipelineId rdfs:comment "실행 시스템이 부여한 CI/CD 파이프라인 식별 문자열을 기록한다."@ko .
devops:producesArtifact rdfs:comment "빌드 작업 실행이 생성한 바이너리·이미지·패키지 산출물을 연결한다."@ko .
devops:vulnerabilityCount rdfs:comment "보안 검사 실행에서 보고한 취약점 개수를 정수로 기록한다. 개수가 없으면 0으로 추정하지 않는다."@ko .
