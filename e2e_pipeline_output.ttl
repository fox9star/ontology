@prefix mv: <https://example.org/mv#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mv:e2e_project_01 a mv:MusicVideoProject ;
    rdfs:label "시티팝 야경 60초 풀패키지 뮤직비디오"@ko ;
    mv:hasAudio mv:audio_main ;
    mv:hasBrief mv:e2e_project_01_brief ;
    mv:hasFinalVideo mv:video_main ;
    mv:hasImage mv:image_01,
        mv:image_02 ;
    mv:hasTimeline mv:timeline_main .

mv:task_subtitle_gen a mv:SubtitleGenerationTask ;
    rdfs:label "타임라인 자막 싱크 작업"@ko ;
    prov:wasAssociatedWith mv:agent_subtitler ;
    mv:usesInput mv:timeline_main ;
    mv:status "completed" .

mv:task_translation a mv:TranslationTask ;
    rdfs:label "영어 가사 번역 작업"@ko ;
    prov:wasAssociatedWith mv:agent_translator ;
    mv:dependsOn mv:task_lyric_gen ;
    mv:status "completed" .

mv:agent_editor a mv:AIAgent ;
    rdfs:label "영상 편집 에이전트"@ko .

mv:agent_lyricist a mv:AIAgent ;
    rdfs:label "가사 작사 AI 에이전트"@ko .

mv:agent_music a mv:AIAgent ;
    rdfs:label "음악 생성 AI 에이전트"@ko .

mv:agent_subtitler a mv:AIAgent ;
    rdfs:label "자막 싱크 AI 에이전트"@ko .

mv:agent_translator a mv:AIAgent ;
    rdfs:label "다국어 번역 AI 에이전트"@ko .

mv:e2e_project_01_brief a mv:CreativeBrief ;
    mv:targetDurationSeconds 60.0 .

mv:shot_01 a mv:Shot ;
    rdfs:label "첫 번째 밤거리 샷"@ko ;
    mv:endSecond 30.0 ;
    mv:orderIndex 1 ;
    mv:startSecond 0.0 ;
    mv:usesImage mv:image_01 .

mv:shot_02 a mv:Shot ;
    rdfs:label "두 번째 드라이브 샷"@ko ;
    mv:endSecond 60.0 ;
    mv:orderIndex 2 ;
    mv:startSecond 30.0 ;
    mv:usesImage mv:image_02 .

mv:task_audio_gen a mv:AudioGenerationTask ;
    rdfs:label "음원 트랙 자동 생성"@ko ;
    prov:wasAssociatedWith mv:agent_music ;
    mv:status "completed" .

mv:task_lyric_gen a mv:LyricGenerationTask ;
    rdfs:label "한국어 가사 작사 작업"@ko ;
    prov:wasAssociatedWith mv:agent_lyricist ;
    mv:status "completed" .

mv:task_render a mv:RenderTask ;
    prov:wasAssociatedWith mv:agent_editor ;
    mv:status "completed" .

mv:video_main a mv:MusicVideo ;
    rdfs:label "최종 렌더링 뮤직비디오"@ko ;
    prov:wasGeneratedBy mv:task_render ;
    mv:durationSeconds 60.0 ;
    mv:fileUri <https://example.org/assets/citypop_final.mp4> ;
    mv:hasTimeline mv:timeline_main ;
    mv:usesAudio mv:audio_main .

mv:audio_main a mv:AudioAsset ;
    rdfs:label "메인 음원"@ko ;
    prov:wasGeneratedBy mv:task_audio_gen ;
    mv:bpm 124 ;
    mv:durationSeconds 60.0 ;
    mv:fileUri <https://example.org/assets/citypop_master.wav> ;
    mv:genre "City Pop" ;
    mv:lyricText "Running through the city night under glowing neon signs",
        "화려한 네온사인 아래 달리는 도시의 밤" .

mv:image_01 a mv:ImageAsset ;
    mv:fileUri <https://example.org/assets/night_skyline.png> ;
    mv:height 1080 ;
    mv:width 1920 .

mv:image_02 a mv:ImageAsset ;
    mv:fileUri <https://example.org/assets/neon_drive.png> ;
    mv:height 1080 ;
    mv:width 1920 .

mv:timeline_main a mv:Timeline ;
    rdfs:label "메인 타임라인"@ko ;
    mv:hasShot mv:shot_01,
        mv:shot_02 .

