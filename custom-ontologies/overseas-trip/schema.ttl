@prefix trip: <https://example.org/ontology/custom/overseas-trip#> .
@prefix core: <https://example.org/ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/custom/overseas-trip> a owl:Ontology ;
    rdfs:label "해외여행 계획 온톨로지"@ko, "Overseas trip planning ontology"@en ;
    rdfs:comment "여행 계획의 목적지, 입국 요건, 일자별 일정, 동반자, 항공 구간, 보험, 예약, 예산을 연결한다. 예제는 합성 계획이며 실제 입국 가능 여부, 예약 성사, 보험 가입, 비용을 주장하지 않는다."@ko,
      "Connects trip plans, destinations, entry requirements, daily itineraries, travelers, flight segments, insurance, bookings and budgets. The example is a synthetic plan and asserts no actual entry eligibility, reservation, coverage or cost."@en ;
    owl:imports <https://example.org/ontology/core> ;
    owl:versionIRI <https://example.org/ontology/custom/overseas-trip/0.1.0> ;
    owl:versionInfo "0.1.0" .

trip:TripPlan a owl:Class ; rdfs:subClassOf core:Project ;
    rdfs:label "여행 계획"@ko, "Trip plan"@en ;
    rdfs:comment "출발일과 귀국일, 인원, 목적지, 일정, 예약, 예산을 하나로 묶는 해외여행 계획의 범위이다."@ko,
      "Defines the scope of an overseas trip joining its dates, traveler count, destinations, itinerary, bookings and budget."@en .
trip:Destination a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "목적지"@ko, "Destination"@en ;
    rdfs:comment "여행 계획이 방문하는 국가 단위의 목적지이며 입국 요건은 이 목적지에 대해 확인한다."@ko,
      "Represents a country-level destination visited by a trip plan; entry requirements are checked against it."@en .
trip:EntryRequirement a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "입국 요건"@ko, "Entry requirement"@en ;
    rdfs:comment "여권 유효기간, 비자, 전자여행허가처럼 목적지 입국 전에 확인해야 하는 한 가지 조건과 그 확인 상태이다."@ko,
      "Represents one condition to verify before entering a destination, such as passport validity, visa or travel authorization, and its check status."@en .
trip:ItineraryDay a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "일정 일자"@ko, "Itinerary day"@en ;
    rdfs:comment "여행 계획 안에서 날짜와 머무는 도시를 가지며 하루의 활동을 순서대로 묶는 단위이다."@ko,
      "Represents one dated day of a trip plan in a city, grouping that day's ordered activities."@en .
trip:Activity a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "활동"@ko, "Activity"@en ;
    rdfs:comment "하루 일정 안에서 순서와 계획 시간을 가지는 관광, 식사, 이동 같은 한 가지 활동이다."@ko,
      "Represents one ordered activity of a day, such as sightseeing, a meal or a transfer, with a planned duration."@en .
trip:Booking a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "예약"@ko, "Booking"@en ;
    rdfs:comment "항공, 숙박, 이동, 입장권, 보험의 예약 계획 또는 확정 상태를 기록한다. 확정에는 확인 근거가 필요하다."@ko,
      "Records a planned or confirmed flight, lodging, transport, ticket or insurance booking; confirmation requires an evidence record."@en .
trip:BudgetItem a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "예산 항목"@ko, "Budget item"@en ;
    rdfs:comment "범주, 계획 금액, 통화를 가지는 여행 비용 한 건이며 실제 결제 금액이 아니라 계획값이다."@ko,
      "Records one trip cost with a category, planned amount and currency; it is a planned value, not a paid amount."@en .

trip:hasDestination a owl:ObjectProperty ; rdfs:domain trip:TripPlan ; rdfs:range trip:Destination ;
    rdfs:label "목적지 포함"@ko, "Has destination"@en ;
    rdfs:comment "여행 계획이 방문하는 국가 단위 목적지를 연결한다."@ko,
      "Links a trip plan to a country-level destination it visits."@en .
trip:hasEntryRequirement a owl:ObjectProperty ; rdfs:domain trip:Destination ; rdfs:range trip:EntryRequirement ;
    rdfs:label "입국 요건 포함"@ko, "Has entry requirement"@en ;
    rdfs:comment "목적지에 입국하기 위해 확인해야 하는 요건을 연결한다. 요건이 없다는 사실을 이 관계의 부재로 추정하지 않는다."@ko,
      "Links a destination to a requirement to verify before entry; the absence of a link does not imply no requirement exists."@en .
trip:hasItineraryDay a owl:ObjectProperty ; rdfs:domain trip:TripPlan ; rdfs:range trip:ItineraryDay ;
    rdfs:label "일정 일자 포함"@ko, "Has itinerary day"@en ;
    rdfs:comment "여행 계획을 구성하는 날짜별 일정을 연결하며 실제 순서는 일차 번호로 기록한다."@ko,
      "Links a trip plan to its dated days; their sequence is recorded by day numbers."@en .
trip:atDestination a owl:ObjectProperty ; rdfs:domain trip:ItineraryDay ; rdfs:range trip:Destination ;
    rdfs:label "체류 목적지"@ko, "At destination"@en ;
    rdfs:comment "그날 머무는 국가 단위 목적지를 연결하며 같은 여행 계획의 목적지여야 한다."@ko,
      "Links a day to the country-level destination where it is spent, which must belong to the same trip plan."@en .
trip:hasActivity a owl:ObjectProperty ; rdfs:domain trip:ItineraryDay ; rdfs:range trip:Activity ;
    rdfs:label "활동 포함"@ko, "Has activity"@en ;
    rdfs:comment "하루 일정을 구성하는 활동을 연결하며 실제 순서는 활동 순번으로 기록한다."@ko,
      "Links a day to its activities; their local sequence is recorded by activity order values."@en .
trip:hasBooking a owl:ObjectProperty ; rdfs:domain trip:TripPlan ; rdfs:range trip:Booking ;
    rdfs:label "예약 포함"@ko, "Has booking"@en ;
    rdfs:comment "여행 계획에서 관리하는 예약을 연결한다."@ko,
      "Links a trip plan to a booking it manages."@en .
trip:coversActivity a owl:ObjectProperty ; rdfs:domain trip:Booking ; rdfs:range trip:Activity ;
    rdfs:label "지원 활동"@ko, "Covers activity"@en ;
    rdfs:comment "예약이 뒷받침하는 활동을 연결하며 같은 여행 계획의 활동이어야 한다. 이 관계만으로 예약이 확정되었다고 주장하지 않는다."@ko,
      "Links a booking to an activity it supports, within the same trip plan, without asserting that the booking is confirmed."@en .
trip:hasBudgetItem a owl:ObjectProperty ; rdfs:domain trip:TripPlan ; rdfs:range trip:BudgetItem ;
    rdfs:label "예산 항목 포함"@ko, "Has budget item"@en ;
    rdfs:comment "여행 계획의 비용 계획 항목을 연결한다."@ko,
      "Links a trip plan to one of its planned cost items."@en .
trip:forBooking a owl:ObjectProperty ; rdfs:domain trip:BudgetItem ; rdfs:range trip:Booking ;
    rdfs:label "대상 예약"@ko, "For booking"@en ;
    rdfs:comment "예산 항목이 충당하려는 예약을 연결하며 같은 여행 계획의 예약이어야 한다."@ko,
      "Links a budget item to the booking it is meant to pay for, within the same trip plan."@en .

trip:planStatus a owl:DatatypeProperty ; rdfs:domain trip:TripPlan ; rdfs:range xsd:string ;
    rdfs:label "계획 상태"@ko, "Plan status"@en ;
    rdfs:comment "여행 계획의 draft 또는 confirmed 상태이며 확정에는 입국 요건 확인과 예약 확정이 필요하다."@ko,
      "Records draft or confirmed plan status; confirmation requires checked entry requirements and confirmed bookings."@en .
trip:departureDate a owl:DatatypeProperty ; rdfs:domain trip:TripPlan ; rdfs:range xsd:date ;
    rdfs:label "출발일"@ko, "Departure date"@en ;
    rdfs:comment "여행을 시작하는 날짜이며 일정과 예약 날짜의 하한이다."@ko,
      "Records the date the trip begins, the lower bound for itinerary and booking dates."@en .
trip:returnDate a owl:DatatypeProperty ; rdfs:domain trip:TripPlan ; rdfs:range xsd:date ;
    rdfs:label "귀국일"@ko, "Return date"@en ;
    rdfs:comment "여행이 끝나는 날짜이며 출발일보다 빠를 수 없고 일정과 예약 날짜의 상한이다."@ko,
      "Records the date the trip ends, not earlier than departure, and the upper bound for itinerary and booking dates."@en .
trip:travelerCount a owl:DatatypeProperty ; rdfs:domain trip:TripPlan ; rdfs:range xsd:integer ;
    rdfs:label "여행 인원"@ko, "Traveler count"@en ;
    rdfs:comment "함께 여행하는 사람 수를 양의 정수로 기록하며 여행자의 신원이나 여권 정보는 담지 않는다."@ko,
      "Records the number of travelers as a positive integer without traveler identity or passport data."@en .
trip:countryCode a owl:DatatypeProperty ; rdfs:domain trip:Destination ; rdfs:range xsd:string ;
    rdfs:label "국가 코드"@ko, "Country code"@en ;
    rdfs:comment "목적지 국가를 나타내는 대문자 두 글자 코드이다."@ko,
      "Records the two-letter uppercase code of the destination country."@en .
trip:countryName a owl:DatatypeProperty ; rdfs:domain trip:Destination ; rdfs:range xsd:string ;
    rdfs:label "국가 이름"@ko, "Country name"@en ;
    rdfs:comment "사람이 읽는 목적지 국가의 이름이다."@ko,
      "Records the human-readable name of the destination country."@en .
trip:requirementKind a owl:DatatypeProperty ; rdfs:domain trip:EntryRequirement ; rdfs:range xsd:string ;
    rdfs:label "요건 종류"@ko, "Requirement kind"@en ;
    rdfs:comment "passport-validity, visa, travel-authorization, vaccination, customs 중 확인할 요건의 종류이며 한 목적지에서 중복되지 않는다."@ko,
      "Records the requirement kind: passport-validity, visa, travel-authorization, vaccination or customs; unique within a destination."@en .
trip:checkStatus a owl:DatatypeProperty ; rdfs:domain trip:EntryRequirement ; rdfs:range xsd:string ;
    rdfs:label "확인 상태"@ko, "Check status"@en ;
    rdfs:comment "아직 확인하지 않았으면 unchecked, 충족을 확인했으면 satisfied, 해당하지 않음을 확인했으면 not-required로 기록한다."@ko,
      "Marks a requirement as unchecked, satisfied or confirmed not-required; no outcome is assumed without checking."@en .
trip:checkEvidenceUri a owl:DatatypeProperty ; rdfs:domain trip:EntryRequirement ; rdfs:range xsd:anyURI ;
    rdfs:label "확인 근거 주소"@ko, "Check evidence URI"@en ;
    rdfs:comment "공식 안내나 확인 기록의 위치이며 satisfied 또는 not-required 상태에 필수이고 unchecked 상태에서는 쓰지 않는다."@ko,
      "Points to the official guidance or check record; required for satisfied or not-required and absent while unchecked."@en .
trip:dayNumber a owl:DatatypeProperty ; rdfs:domain trip:ItineraryDay ; rdfs:range xsd:integer ;
    rdfs:label "일차 번호"@ko, "Day number"@en ;
    rdfs:comment "한 여행 계획 안에서 중복되지 않는 양의 정수 일차 번호이다."@ko,
      "Records a positive integer day number that must be unique within a trip plan."@en .
trip:dayDate a owl:DatatypeProperty ; rdfs:domain trip:ItineraryDay ; rdfs:range xsd:date ;
    rdfs:label "일정 날짜"@ko, "Day date"@en ;
    rdfs:comment "그 일차의 날짜이며 출발일과 귀국일 사이여야 한다."@ko,
      "Records the date of the day, which must fall between the departure and return dates."@en .
trip:cityName a owl:DatatypeProperty ; rdfs:domain trip:ItineraryDay ; rdfs:range xsd:string ;
    rdfs:label "체류 도시"@ko, "City name"@en ;
    rdfs:comment "그날 주로 머무는 도시의 이름이다."@ko,
      "Records the name of the city where the day is mainly spent."@en .
trip:activityOrder a owl:DatatypeProperty ; rdfs:domain trip:Activity ; rdfs:range xsd:integer ;
    rdfs:label "활동 순번"@ko, "Activity order"@en ;
    rdfs:comment "하루 안에서 중복되지 않는 양의 정수 활동 순번이다."@ko,
      "Records a positive integer activity order that must be unique within its day."@en .
trip:activityCategory a owl:DatatypeProperty ; rdfs:domain trip:Activity ; rdfs:range xsd:string ;
    rdfs:label "활동 범주"@ko, "Activity category"@en ;
    rdfs:comment "sightseeing, meal, transport, lodging-checkin, free-time 중 활동의 범주이다."@ko,
      "Records the activity category: sightseeing, meal, transport, lodging-checkin or free-time."@en .
trip:plannedDurationMinutes a owl:DatatypeProperty ; rdfs:domain trip:Activity ; rdfs:range xsd:integer ;
    rdfs:label "계획 시간 분"@ko, "Planned duration in minutes"@en ;
    rdfs:comment "활동에 잡아 둔 시간을 분 단위 양의 정수로 기록하며 실제 소요 시간과 구분한다."@ko,
      "Records a positive planned duration in minutes, separate from measured time."@en .
trip:bookingKind a owl:DatatypeProperty ; rdfs:domain trip:Booking ; rdfs:range xsd:string ;
    rdfs:label "예약 종류"@ko, "Booking kind"@en ;
    rdfs:comment "flight, lodging, transport, ticket, insurance 중 예약의 종류이다."@ko,
      "Records the booking kind: flight, lodging, transport, ticket or insurance."@en .
trip:bookingStatus a owl:DatatypeProperty ; rdfs:domain trip:Booking ; rdfs:range xsd:string ;
    rdfs:label "예약 상태"@ko, "Booking status"@en ;
    rdfs:comment "아직 계획이면 planned, 확인 근거가 있으면 booked, 취소되었으면 cancelled로 기록한다."@ko,
      "Marks a booking as planned, booked with an evidence record, or cancelled."@en .
trip:confirmationEvidenceUri a owl:DatatypeProperty ; rdfs:domain trip:Booking ; rdfs:range xsd:anyURI ;
    rdfs:label "예약 확인 근거 주소"@ko, "Confirmation evidence URI"@en ;
    rdfs:comment "예약 확인서나 접수 기록의 위치이며 booked 상태에 필수이고 planned 상태에서는 쓰지 않는다."@ko,
      "Points to the confirmation record; required for booked and absent while planned, with no invented confirmation numbers."@en .
trip:bookingStartDate a owl:DatatypeProperty ; rdfs:domain trip:Booking ; rdfs:range xsd:date ;
    rdfs:label "예약 시작일"@ko, "Booking start date"@en ;
    rdfs:comment "예약 이용이 시작되는 날짜이며 출발일 이후여야 한다."@ko,
      "Records the date the booked service starts, not before the trip departure."@en .
trip:bookingEndDate a owl:DatatypeProperty ; rdfs:domain trip:Booking ; rdfs:range xsd:date ;
    rdfs:label "예약 종료일"@ko, "Booking end date"@en ;
    rdfs:comment "예약 이용이 끝나는 날짜이며 시작일보다 빠를 수 없고 귀국일 이전이어야 한다."@ko,
      "Records the date the booked service ends, not before its start and not after the trip return."@en .
trip:budgetCategory a owl:DatatypeProperty ; rdfs:domain trip:BudgetItem ; rdfs:range xsd:string ;
    rdfs:label "예산 범주"@ko, "Budget category"@en ;
    rdfs:comment "transport, lodging, food, activities, insurance, other 중 비용의 범주이다."@ko,
      "Records the cost category: transport, lodging, food, activities, insurance or other."@en .
trip:plannedAmount a owl:DatatypeProperty ; rdfs:domain trip:BudgetItem ; rdfs:range xsd:decimal ;
    rdfs:label "계획 금액"@ko, "Planned amount"@en ;
    rdfs:comment "0 이상의 계획 금액이며 통화 코드와 함께 해석하고 실제 결제 금액과 구분한다."@ko,
      "Records a non-negative planned amount, read together with its currency code and separate from paid amounts."@en .
trip:currencyCode a owl:DatatypeProperty ; rdfs:domain trip:BudgetItem ; rdfs:range xsd:string ;
    rdfs:label "통화 코드"@ko, "Currency code"@en ;
    rdfs:comment "계획 금액에 적용되는 대문자 세 글자 통화 코드이며 서로 다른 통화는 합산하지 않는다."@ko,
      "Records the three-letter uppercase currency code of the amount; different currencies are never summed together."@en .

trip:Traveler a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "동반자"@ko, "Traveler"@en ;
    rdfs:comment "여행 계획에 함께하는 한 사람이다. 이름, 여권번호, 생년월일 같은 신원 정보는 담지 않고 역할과 연령대 같은 계획에 필요한 속성만 기록한다."@ko,
      "Represents one person on a trip plan, holding only planning attributes such as role and age group and no name, passport number or birth date."@en .
trip:FlightSegment a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "항공 구간"@ko, "Flight segment"@en ;
    rdfs:comment "항공 예약 안에서 순번을 가지며 출발 공항에서 도착 공항으로 한 번 비행하는 구간이다."@ko,
      "Represents one flight leg of a flight booking, ordered within the booking, from a departure airport to an arrival airport."@en .
trip:InsurancePolicy a owl:Class ; rdfs:subClassOf core:Artifact ;
    rdfs:label "보험 보장"@ko, "Insurance policy"@en ;
    rdfs:comment "보험 예약에 속하며 보장 종류, 보장 한도, 보장 대상 동반자를 기록한다. 가입 여부와 확인 근거는 소속 예약의 상태가 나타낸다."@ko,
      "Describes the coverage kinds, limit and insured travelers of an insurance booking; purchase status and evidence live on that booking."@en .

trip:hasTraveler a owl:ObjectProperty ; rdfs:domain trip:TripPlan ; rdfs:range trip:Traveler ;
    rdfs:label "동반자 포함"@ko, "Has traveler"@en ;
    rdfs:comment "여행 계획에 함께하는 동반자를 연결하며 그 수는 여행 인원과 같아야 한다."@ko,
      "Links a trip plan to a traveler on it; their number must equal the traveler count."@en .
trip:hasFlightSegment a owl:ObjectProperty ; rdfs:domain trip:Booking ; rdfs:range trip:FlightSegment ;
    rdfs:label "항공 구간 포함"@ko, "Has flight segment"@en ;
    rdfs:comment "항공 예약을 구성하는 구간을 연결하며 항공 종류의 예약에만 쓴다."@ko,
      "Links a flight booking to its segments; used only on bookings of kind flight."@en .
trip:hasInsurancePolicy a owl:ObjectProperty ; rdfs:domain trip:Booking ; rdfs:range trip:InsurancePolicy ;
    rdfs:label "보험 보장 포함"@ko, "Has insurance policy"@en ;
    rdfs:comment "보험 예약의 보장 내용을 연결하며 보험 종류의 예약에만 쓴다."@ko,
      "Links an insurance booking to its coverage details; used only on bookings of kind insurance."@en .
trip:coversTraveler a owl:ObjectProperty ; rdfs:domain trip:InsurancePolicy ; rdfs:range trip:Traveler ;
    rdfs:label "보장 대상 동반자"@ko, "Covers traveler"@en ;
    rdfs:comment "보험이 보장하는 동반자를 연결하며 같은 여행 계획의 동반자여야 한다. 연결이 없는 동반자는 보장되지 않은 것으로 본다."@ko,
      "Links a policy to an insured traveler of the same trip plan; a traveler without a link is treated as not covered."@en .
trip:appliesToTraveler a owl:ObjectProperty ; rdfs:domain trip:EntryRequirement ; rdfs:range trip:Traveler ;
    rdfs:label "적용 동반자"@ko, "Applies to traveler"@en ;
    rdfs:comment "입국 요건이 특정 동반자에게 적용될 때 연결한다. 연결이 없으면 일행 전체에 대한 요건이며 같은 계획의 동반자여야 한다."@ko,
      "Links a requirement to the specific traveler it applies to; without a link it is a group-level requirement, and the traveler must be on the same plan."@en .

trip:travelerRole a owl:DatatypeProperty ; rdfs:domain trip:Traveler ; rdfs:range xsd:string ;
    rdfs:label "동반자 역할"@ko, "Traveler role"@en ;
    rdfs:comment "계획을 책임지는 대표 여행자 primary 또는 함께하는 companion 중 하나이며 한 계획에 primary는 한 명이다."@ko,
      "Records primary for the lead traveler or companion for others; a plan has exactly one primary traveler."@en .
trip:ageGroup a owl:DatatypeProperty ; rdfs:domain trip:Traveler ; rdfs:range xsd:string ;
    rdfs:label "연령대"@ko, "Age group"@en ;
    rdfs:comment "adult, child, infant 중 동반자의 연령대이며 정확한 생년월일은 기록하지 않는다."@ko,
      "Records adult, child or infant without an exact birth date."@en .
trip:nationalityCode a owl:DatatypeProperty ; rdfs:domain trip:Traveler ; rdfs:range xsd:string ;
    rdfs:label "국적 코드"@ko, "Nationality code"@en ;
    rdfs:comment "입국 요건이 국적에 따라 달라질 때 참고하는 대문자 두 글자 국가 코드이며 알 수 없으면 비워 두고 추정하지 않는다."@ko,
      "Records a two-letter uppercase country code used when entry requirements depend on nationality; left empty rather than guessed."@en .
trip:segmentOrder a owl:DatatypeProperty ; rdfs:domain trip:FlightSegment ; rdfs:range xsd:integer ;
    rdfs:label "구간 순번"@ko, "Segment order"@en ;
    rdfs:comment "항공 예약 안에서 중복되지 않는 양의 정수 구간 순번이다."@ko,
      "Records a positive integer segment order that must be unique within a flight booking."@en .
trip:departureAirport a owl:DatatypeProperty ; rdfs:domain trip:FlightSegment ; rdfs:range xsd:string ;
    rdfs:label "출발 공항 코드"@ko, "Departure airport code"@en ;
    rdfs:comment "구간의 출발 공항을 나타내는 대문자 세 글자 IATA 코드이며 도착 공항과 달라야 한다."@ko,
      "Records the three-letter uppercase IATA code of the departure airport, different from the arrival airport."@en .
trip:arrivalAirport a owl:DatatypeProperty ; rdfs:domain trip:FlightSegment ; rdfs:range xsd:string ;
    rdfs:label "도착 공항 코드"@ko, "Arrival airport code"@en ;
    rdfs:comment "구간의 도착 공항을 나타내는 대문자 세 글자 IATA 코드이며 다음 구간의 출발 공항과 이어져야 한다."@ko,
      "Records the three-letter uppercase IATA code of the arrival airport, which must connect to the next segment's departure airport."@en .
trip:segmentDepartureDate a owl:DatatypeProperty ; rdfs:domain trip:FlightSegment ; rdfs:range xsd:date ;
    rdfs:label "구간 출발일"@ko, "Segment departure date"@en ;
    rdfs:comment "구간이 출발하는 날짜이며 소속 예약의 기간 안에 있어야 한다. 실제 편명과 시각은 기록하지 않는다."@ko,
      "Records the date the segment departs, within its booking period; flight numbers and times are not recorded."@en .
trip:segmentArrivalDate a owl:DatatypeProperty ; rdfs:domain trip:FlightSegment ; rdfs:range xsd:date ;
    rdfs:label "구간 도착일"@ko, "Segment arrival date"@en ;
    rdfs:comment "구간이 도착하는 날짜이며 출발일보다 빠를 수 없고 다음 구간의 출발일보다 늦을 수 없다."@ko,
      "Records the arrival date, not before departure and not after the next segment's departure."@en .
trip:coverageKind a owl:DatatypeProperty ; rdfs:domain trip:InsurancePolicy ; rdfs:range xsd:string ;
    rdfs:label "보장 종류"@ko, "Coverage kind"@en ;
    rdfs:comment "medical, cancellation, baggage, liability 중 보험이 보장하는 종류이며 하나 이상 기록한다."@ko,
      "Records a coverage kind among medical, cancellation, baggage and liability; at least one is required."@en .
trip:coverageLimitAmount a owl:DatatypeProperty ; rdfs:domain trip:InsurancePolicy ; rdfs:range xsd:decimal ;
    rdfs:label "보장 한도 금액"@ko, "Coverage limit amount"@en ;
    rdfs:comment "보험 전체에 적용되는 0 이상의 보장 한도 계획값이며 통화 코드와 함께 해석한다."@ko,
      "Records a non-negative planned policy-wide coverage limit, read together with its currency code."@en .
trip:coverageLimitCurrency a owl:DatatypeProperty ; rdfs:domain trip:InsurancePolicy ; rdfs:range xsd:string ;
    rdfs:label "보장 한도 통화 코드"@ko, "Coverage limit currency code"@en ;
    rdfs:comment "보장 한도에 적용되는 대문자 세 글자 통화 코드이다."@ko,
      "Records the three-letter uppercase currency code of the coverage limit."@en .

# Each resource represents one distinct trip-planning role.
trip:TripRoleDisjointness a owl:AllDisjointClasses ;
    owl:members ( trip:TripPlan trip:Destination trip:EntryRequirement trip:ItineraryDay
                  trip:Activity trip:Booking trip:BudgetItem trip:Traveler
                  trip:FlightSegment trip:InsurancePolicy ) .
