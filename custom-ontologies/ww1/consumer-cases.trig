@prefix ns1: <https://example.org/ontology/custom/ww1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.test/consumer/ww1-accept> {
    <https://example.test/ww1/belleauWood> a ns1:Event,
            ns1:HistoricalClaim ;
        rdfs:label "Battle of Belleau Wood"@en,
            "벨로 숲 전투"@ko ;
        ns1:endDate "1918-06-26"^^xsd:date ;
        ns1:eventKind "battle" ;
        ns1:hadCommander <https://example.test/ww1/pershing> ;
        ns1:hasBelligerent <https://example.test/ww1/partGermany>,
            <https://example.test/ww1/partUsa> ;
        ns1:inTheatre <https://example.test/ww1/theatreWestern> ;
        ns1:locationName "Belleau, Aisne, France" ;
        ns1:outcome "allied-victory" ;
        ns1:relatedConflict <https://example.test/ww1/wwi> ;
        ns1:startDate "1918-06-01"^^xsd:date ;
        ns1:verificationStatus "unverified" .

    <https://example.test/ww1/caporetto> a ns1:Event,
            ns1:HistoricalClaim ;
