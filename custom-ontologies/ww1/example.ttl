ex:sarajevo a ww1:Event, ww1:HistoricalClaim ; rdfs:label "사라예보 사건: 프란츠 페르디난트 대공 암살"@ko, "Assassination of Archduke Franz Ferdinand in Sarajevo"@en ;
    ww1:eventKind "assassination" ; ww1:startDate "1914-06-28"^^xsd:date ; ww1:endDate "1914-06-28"^^xsd:date ;
    ww1:relatedConflict ex:wwi ; ww1:locationName "Sarajevo, Bosnia and Herzegovina (then Austria-Hungary)" ; ww1:verificationStatus "unverified" .
ex:declAHSerbia a ww1:Event, ww1:HistoricalClaim ; rdfs:label "오스트리아-헝가리의 세르비아 선전포고"@ko, "Austria-Hungary declares war on Serbia"@en ;
    ww1:eventKind "war-declaration" ; ww1:startDate "1914-07-28"^^xsd:date ; ww1:endDate "1914-07-28"^^xsd:date ;
    ww1:relatedConflict ex:wwi ;
    ww1:initiatedBy ex:austriaHungary ; ww1:directedAgainst ex:serbia ; ww1:verificationStatus "unverified" .
ex:declGerRussia a ww1:Event, ww1:HistoricalClaim ; rdfs:label "독일의 러시아 선전포고"@ko, "Germany declares war on Russia"@en ;
    ww1:eventKind "war-declaration" ; ww1:startDate "1914-08-01"^^xsd:date ; ww1:endDate "1914-08-01"^^xsd:date ;
    ww1:relatedConflict ex:wwi ;
    ww1:initiatedBy ex:germany ; ww1:directedAgainst ex:russia ; ww1:verificationStatus "unverified" .
ex:declGerFrance a ww1:Event, ww1:HistoricalClaim ; rdfs:label "독일의 프랑스 선전포고"@ko, "Germany declares war on France"@en ;
    ww1:eventKind "war-declaration" ; ww1:startDate "1914-08-03"^^xsd:date ; ww1:endDate "1914-08-03"^^xsd:date ;
    ww1:relatedConflict ex:wwi ;
    ww1:initiatedBy ex:germany ; ww1:directedAgainst ex:france ; ww1:verificationStatus "unverified" .
ex:invasionBelgium a ww1:Event, ww1:HistoricalClaim ; rdfs:label "독일의 벨기에 침공"@ko, "German invasion of Belgium"@en ;
    ww1:eventKind "invasion" ; ww1:startDate "1914-08-04"^^xsd:date ; ww1:endDate "1914-08-04"^^xsd:date ;
    ww1:relatedConflict ex:wwi ; ww1:locationName "Belgium" ;
    ww1:initiatedBy ex:germany ; ww1:directedAgainst ex:belgium ; ww1:verificationStatus "unverified" .
ex:declUKGer a ww1:Event, ww1:HistoricalClaim ; rdfs:label "영국의 독일 선전포고"@ko, "United Kingdom declares war on Germany"@en ;
    ww1:eventKind "war-declaration" ; ww1:startDate "1914-08-04"^^xsd:date ; ww1:endDate "1914-08-04"^^xsd:date ;
    ww1:relatedConflict ex:wwi ;
    ww1:initiatedBy ex:uk ; ww1:directedAgainst ex:germany ; ww1:verificationStatus "unverified" .
ex:declJapanGer a ww1:Event, ww1:HistoricalClaim ; rdfs:label "일본의 독일 선전포고"@ko, "Japan declares war on Germany"@en ;
    ww1:eventKind "war-declaration" ; ww1:startDate "1914-08-23"^^xsd:date ; ww1:endDate "1914-08-23"^^xsd:date ;
    ww1:relatedConflict ex:wwi ;
    ww1:initiatedBy ex:japan ; ww1:directedAgainst ex:germany ; ww1:verificationStatus "unverified" .
ex:raidBlackSea a ww1:Event, ww1:HistoricalClaim ; rdfs:label "오스만 함대의 러시아 흑해 항구 공격"@ko, "Ottoman raid on Russian Black Sea ports"@en ;
