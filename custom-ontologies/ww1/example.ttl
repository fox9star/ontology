    ww1:servedState ex:germany ; ww1:birthYear 1848 ; ww1:deathYear 1916 .
ex:hamilton a ww1:Person ; rdfs:label "이언 해밀턴"@ko, "Ian Hamilton"@en ;
    ww1:servedState ex:uk ; ww1:birthYear 1853 ; ww1:deathYear 1947 .
ex:kemal a ww1:Person ; rdfs:label "무스타파 케말"@ko, "Mustafa Kemal"@en ;
    ww1:servedState ex:ottoman ; ww1:birthYear 1881 ; ww1:deathYear 1938 .
ex:petain a ww1:Person ; rdfs:label "필리프 페탱"@ko, "Philippe Pétain"@en ;
    ww1:servedState ex:france ; ww1:birthYear 1856 ; ww1:deathYear 1951 .
ex:falkenhayn a ww1:Person ; rdfs:label "에리히 폰 팔켄하인"@ko, "Erich von Falkenhayn"@en ;
    ww1:servedState ex:germany ; ww1:birthYear 1861 ; ww1:deathYear 1922 .
ex:jellicoe a ww1:Person ; rdfs:label "존 젤리코"@ko, "John Jellicoe"@en ;
    ww1:servedState ex:uk ; ww1:birthYear 1859 ; ww1:deathYear 1935 .
ex:beatty a ww1:Person ; rdfs:label "데이비드 비티"@ko, "David Beatty"@en ;
    ww1:servedState ex:uk ; ww1:birthYear 1871 ; ww1:deathYear 1936 .
ex:scheer a ww1:Person ; rdfs:label "라인하르트 셰어"@ko, "Reinhard Scheer"@en ;
    ww1:servedState ex:germany ; ww1:birthYear 1863 ; ww1:deathYear 1928 .
ex:hipper a ww1:Person ; rdfs:label "프란츠 폰 히퍼"@ko, "Franz von Hipper"@en ;
    ww1:servedState ex:germany ; ww1:birthYear 1863 ; ww1:deathYear 1943 .
ex:haig a ww1:Person ; rdfs:label "더글러스 헤이그"@ko, "Douglas Haig"@en ;
