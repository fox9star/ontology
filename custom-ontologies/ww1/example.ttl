ex:tannenberg a ww1:Event, ww1:HistoricalClaim ; rdfs:label "탄넨베르크 전투"@ko, "Battle of Tannenberg"@en ;
    ww1:eventKind "battle" ; ww1:startDate "1914-08-26"^^xsd:date ; ww1:endDate "1914-08-30"^^xsd:date ;
    ww1:locationName "East Prussia (now in Poland)" ; ww1:relatedConflict ex:wwi ; ww1:inTheatre ex:theatreEastern ;
    ww1:outcome "central-victory" ;
    ww1:hasBelligerent ex:partGermany, ex:partRussia ;
    ww1:hadCommander ex:hindenburg, ex:ludendorff, ex:samsonov ;
    ww1:verificationStatus "unverified" .
ex:marne a ww1:Event, ww1:HistoricalClaim ; rdfs:label "제1차 마른 전투"@ko, "First Battle of the Marne"@en ;
    ww1:eventKind "battle" ; ww1:startDate "1914-09-06"^^xsd:date ; ww1:endDate "1914-09-12"^^xsd:date ;
