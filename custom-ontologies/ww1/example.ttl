@prefix ww1: <https://example.org/ontology/custom/ww1#> .
@prefix ex: <https://example.org/ontology/custom/ww1#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Curated draft of widely known First World War facts. It is NOT a complete record:
# only twelve states, twelve battles and six agreements are included, belligerent and
# commander lists name principal contingents only, and every record is marked
# "unverified" with no source cited. Outcomes are coarse labels; "contested" marks
# battles whose result historians still debate. Check each claim against a cited
# source before changing its status to "source-checked".

ex:wwi a ww1:Conflict ; rdfs:label "제1차 세계대전"@ko, "World War I"@en ;
    ww1:conflictStartDate "1914-07-28"^^xsd:date ; ww1:conflictEndDate "1918-11-11"^^xsd:date .
ex:alliedPowers a ww1:Side ; rdfs:label "연합국"@ko, "Allied Powers"@en .
ex:centralPowers a ww1:Side ; rdfs:label "동맹국"@ko, "Central Powers"@en .
ex:tripleAlliance a ww1:Alliance ; rdfs:label "3국 동맹"@ko, "Triple Alliance"@en ;
    ww1:hasMember ex:germany, ex:austriaHungary, ex:italy ; ww1:correspondingSide ex:centralPowers .
ex:tripleEntente a ww1:Alliance ; rdfs:label "3국 협상"@ko, "Triple Entente"@en ;
    ww1:hasMember ex:france, ex:uk, ex:russia ; ww1:correspondingSide ex:alliedPowers .

ex:theatreWestern a ww1:Theatre ; rdfs:label "서부 전선"@ko, "Western Front"@en .
ex:theatreEastern a ww1:Theatre ; rdfs:label "동부 전선"@ko, "Eastern Front"@en .
ex:theatreItalian a ww1:Theatre ; rdfs:label "이탈리아 전선"@ko, "Italian Front"@en .
ex:theatreMiddleEast a ww1:Theatre ; rdfs:label "중동 전역"@ko, "Middle Eastern theatre"@en .
ex:theatreNaval a ww1:Theatre ; rdfs:label "해상 전역(북해)"@ko, "Naval theatre (North Sea)"@en .

ex:germany a ww1:State ; rdfs:label "독일 제국"@ko, "German Empire"@en ; ww1:governmentForm "empire" .
ex:austriaHungary a ww1:State ; rdfs:label "오스트리아-헝가리 제국"@ko, "Austria-Hungary"@en ; ww1:governmentForm "empire" .
ex:ottoman a ww1:State ; rdfs:label "오스만 제국"@ko, "Ottoman Empire"@en ; ww1:governmentForm "empire" .
ex:bulgaria a ww1:State ; rdfs:label "불가리아 왕국"@ko, "Kingdom of Bulgaria"@en ; ww1:governmentForm "kingdom" .
ex:france a ww1:State ; rdfs:label "프랑스 제3공화국"@ko, "French Third Republic"@en ; ww1:governmentForm "republic" .
ex:uk a ww1:State ; rdfs:label "영국"@ko, "United Kingdom"@en ; ww1:governmentForm "kingdom" .
ex:russia a ww1:State ; rdfs:label "러시아 제국"@ko, "Russian Empire"@en ; ww1:governmentForm "empire" .
ex:serbia a ww1:State ; rdfs:label "세르비아 왕국"@ko, "Kingdom of Serbia"@en ; ww1:governmentForm "kingdom" .
ex:belgium a ww1:State ; rdfs:label "벨기에 왕국"@ko, "Kingdom of Belgium"@en ; ww1:governmentForm "kingdom" .
ex:japan a ww1:State ; rdfs:label "일본 제국"@ko, "Empire of Japan"@en ; ww1:governmentForm "empire" .
ex:italy a ww1:State ; rdfs:label "이탈리아 왕국"@ko, "Kingdom of Italy"@en ; ww1:governmentForm "kingdom" .
ex:usa a ww1:State ; rdfs:label "미국"@ko, "United States"@en ; ww1:governmentForm "republic" .

ex:hindenburg a ww1:Person ; rdfs:label "파울 폰 힌덴부르크"@ko, "Paul von Hindenburg"@en ;
    ww1:servedState ex:germany ; ww1:birthYear 1847 ; ww1:deathYear 1934 .
ex:ludendorff a ww1:Person ; rdfs:label "에리히 루덴도르프"@ko, "Erich Ludendorff"@en ;
    ww1:servedState ex:germany ; ww1:birthYear 1865 ; ww1:deathYear 1937 .
ex:samsonov a ww1:Person ; rdfs:label "알렉산드르 삼소노프"@ko, "Alexander Samsonov"@en ;
    ww1:servedState ex:russia ; ww1:birthYear 1859 ; ww1:deathYear 1914 .
ex:joffre a ww1:Person ; rdfs:label "조제프 조프르"@ko, "Joseph Joffre"@en ;
    ww1:servedState ex:france ; ww1:birthYear 1852 ; ww1:deathYear 1931 .
ex:french a ww1:Person ; rdfs:label "존 프렌치"@ko, "John French"@en ;
    ww1:servedState ex:uk ; ww1:birthYear 1852 ; ww1:deathYear 1925 .
