ex:foch a ww1:Person ; rdfs:label "페르디낭 포슈"@ko, "Ferdinand Foch"@en ;
    ww1:servedState ex:france ; ww1:birthYear 1851 ; ww1:deathYear 1929 .
ex:cadorna a ww1:Person ; rdfs:label "루이지 카도르나"@ko, "Luigi Cadorna"@en ;
    ww1:servedState ex:italy ; ww1:birthYear 1850 ; ww1:deathYear 1928 .
ex:below a ww1:Person ; rdfs:label "오토 폰 벨로"@ko, "Otto von Below"@en ;
    ww1:servedState ex:germany ; ww1:birthYear 1857 ; ww1:deathYear 1944 .
ex:pershing a ww1:Person ; rdfs:label "존 퍼싱"@ko, "John J. Pershing"@en ;
    ww1:servedState ex:usa ; ww1:birthYear 1860 ; ww1:deathYear 1948 .
ex:diaz a ww1:Person ; rdfs:label "아르만도 디아스"@ko, "Armando Diaz"@en ;
    ww1:servedState ex:italy ; ww1:birthYear 1861 ; ww1:deathYear 1928 .

ex:partGermany a ww1:Participation, ww1:HistoricalClaim ;
    rdfs:label "독일 제국의 참전"@ko, "German Empire enters the war"@en ;
    ww1:participant ex:germany ; ww1:inConflict ex:wwi ; ww1:onSide ex:centralPowers ;
    ww1:entryDate "1914-08-01"^^xsd:date ; ww1:enteredVia ex:declGerRussia ;
    ww1:exitDate "1918-11-11"^^xsd:date ; ww1:endedByAgreement ex:compiegne ;
    ww1:verificationStatus "unverified" .
ex:partAustriaHungary a ww1:Participation, ww1:HistoricalClaim ;
    rdfs:label "오스트리아-헝가리 제국의 참전"@ko, "Austria-Hungary enters the war"@en ;
    ww1:participant ex:austriaHungary ; ww1:inConflict ex:wwi ; ww1:onSide ex:centralPowers ;
    ww1:entryDate "1914-07-28"^^xsd:date ; ww1:enteredVia ex:declAHSerbia ;
    ww1:exitDate "1918-11-03"^^xsd:date ; ww1:endedByAgreement ex:villaGiusti ;
    ww1:verificationStatus "unverified" .
ex:partOttoman a ww1:Participation, ww1:HistoricalClaim ;
    rdfs:label "오스만 제국의 참전"@ko, "Ottoman Empire enters the war"@en ;
