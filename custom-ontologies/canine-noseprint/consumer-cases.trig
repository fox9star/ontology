    <https://example.test/canine-noseprint/evaluation-run-01> a ns1:EvaluationRun ;
        rdfs:label "Unrun evaluation record"@en,
            "미실행 평가 기록"@ko ;
        ns1:evaluationNote "메타데이터 픽스처만으로 성능을 측정하지 않았다."^^xsd:string ;
        ns1:evaluationProtocol "실제 승인된 이미지와 개체 단위로 분리한 검증 프로토콜이 마련된 뒤 수행해야 한다."^^xsd:string ;
        ns1:evaluationStatus "not_run"^^xsd:string ;
        ns1:evaluationUsesDataset <https://example.test/canine-noseprint/synthetic-reference-dataset> ;
        ns1:evaluationUsesMetric <https://example.test/canine-noseprint/metric-eer>,
            <https://example.test/canine-noseprint/metric-far>,
            <https://example.test/canine-noseprint/metric-frr>,
            <https://example.test/canine-noseprint/metric-rank1> ;
        ns1:evaluationUsesModel <https://example.test/canine-noseprint/dnnet-reference> .

