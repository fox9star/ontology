    rdfs:range xsd:string .

np:templateFromSample a owl:ObjectProperty ;
    rdfs:label "Template from sample"@en,
        "원본 표본"@ko ;
    rdfs:comment "Links a related nose-print sample entity."@en,
        "관련 비문 표본 개체를 연결한다."@ko ;
    rdfs:domain np:BiometricTemplate ;
    rdfs:range np:NosePrintSample .

np:templateGeneratedBy a owl:ObjectProperty ;
    rdfs:label "Generated by model"@en,
        "생성 방법·모델"@ko ;
    rdfs:comment "Links a related recognition method or model entity."@en,
        "관련 인식 방법 또는 모델 개체를 연결한다."@ko ;
    rdfs:domain np:BiometricTemplate ;
