@prefix np: <https://example.org/ontology/custom/canine-noseprint#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/custom/canine-noseprint> a owl:Ontology ;
    rdfs:label "Canine Nose-Print Ontology"@en,
        "개의 비문 온톨로지 (canine-noseprint)"@ko ;
    rdfs:comment "Connects canine nose-pattern samples, capture and quality, preprocessing, subject comparison, evaluation status, data-use permission and evidence."@en,
        "개 코 무늬 표본, 촬영·품질·전처리, 개체 비교와 검증 상태, 데이터 이용 권한 및 문헌 근거를 연결한다."@ko ;
    owl:versionIRI <https://example.org/ontology/custom/canine-noseprint/0.1.0> ;
    owl:versionInfo "0.1.0" .

np:captureDeviceModel a owl:DatatypeProperty ;
    rdfs:label "Device model"@en,
        "장치 모델"@ko ;
    rdfs:comment "Records or classifies device model."@en,
        "장치 모델를 기록하거나 구분한다."@ko ;
    rdfs:domain np:CaptureSession ;
    rdfs:range xsd:string .

np:captureDeviceType a owl:DatatypeProperty ;
    rdfs:label "Capture device type"@en,
        "촬영 장치 유형"@ko ;
    rdfs:comment "Records or classifies capture device type."@en,
        "촬영 장치 유형를 기록하거나 구분한다."@ko ;
    rdfs:domain np:CaptureSession ;
    rdfs:range xsd:string .

