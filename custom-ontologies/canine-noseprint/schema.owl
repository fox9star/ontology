  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#sampleCapturedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">촬영 세션</rdfs:label>
    <rdfs:label xml:lang="en">Captured in</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 촬영 세션 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related capture session entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintSample"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#CaptureSession"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#evaluationUsesMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">평가 지표</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation uses metric</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 인식 성능 지표 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related recognition performance metric entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationRun"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#templateDigest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">템플릿 해시</rdfs:label>
    <rdfs:label xml:lang="en">Template digest</rdfs:label>
    <rdfs:comment xml:lang="ko">템플릿 해시를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies template digest.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#BiometricTemplate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#ReferenceDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">참조 데이터셋</rdfs:label>
    <rdfs:label xml:lang="en">Reference dataset</rdfs:label>
    <rdfs:comment xml:lang="ko">표본 수, 개체 수, 출처 유형, 분할 절차와 한계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records sample and subject counts, provenance type, split protocol and limitations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#matchNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">결과 해석 메모</rdfs:label>
    <rdfs:label xml:lang="en">Result interpretation note</rdfs:label>
    <rdfs:comment xml:lang="ko">결과 해석 메모를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies result interpretation note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#MatchResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#preprocessingOfSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">처리 대상 표본</rdfs:label>
    <rdfs:label xml:lang="en">Preprocesses sample</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 비문 표본 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related nose-print sample entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#PreprocessingRecord"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintSample"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#metricDocumentedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
