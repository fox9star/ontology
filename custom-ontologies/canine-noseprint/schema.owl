    <rdfs:label xml:lang="en">Metric source</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 문헌 출처 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related documentation source entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#DocumentationSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#projectStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">프로젝트 상태</rdfs:label>
    <rdfs:label xml:lang="en">Project status</rdfs:label>
    <rdfs:comment xml:lang="ko">프로젝트 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies project status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintProject"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#resultForTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">대상 비교 작업</rdfs:label>
    <rdfs:label xml:lang="en">Result for task</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 비문 비교 작업 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related nose-print comparison task entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#MatchResult"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#IdentificationTask"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#projectHasComparisonTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">비교 작업</rdfs:label>
    <rdfs:label xml:lang="en">Has comparison task</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 비문 비교 작업 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related nose-print comparison task entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#IdentificationTask"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#metricUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">지표 단위</rdfs:label>
    <rdfs:label xml:lang="en">Metric unit</rdfs:label>
    <rdfs:comment xml:lang="ko">지표 단위를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies metric unit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#NoseRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">비문 관심 영역</rdfs:label>
    <rdfs:label xml:lang="en">Nose-pattern region of interest</rdfs:label>
    <rdfs:comment xml:lang="ko">코 표면에서 분석 대상으로 정한 해부학적 관심 영역을 기술한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the anatomical region of interest selected on the nose surface.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#datasetSampleCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">표본 수</rdfs:label>
    <rdfs:label xml:lang="en">Sample count</rdfs:label>
    <rdfs:comment xml:lang="ko">표본 수를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies sample count.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#ReferenceDataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#permissionStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">이용 허가 상태</rdfs:label>
    <rdfs:label xml:lang="en">Permission status</rdfs:label>
    <rdfs:comment xml:lang="ko">이용 허가 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies permission status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#DataUsePermission"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#sampleOfSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">대상 개체</rdfs:label>
    <rdfs:label xml:lang="en">Sample of subject</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 개체 참조 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related canine subject reference entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintSample"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#CanineSubject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#sampleUsesRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">분석 영역</rdfs:label>
    <rdfs:label xml:lang="en">Uses region</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 비문 관심 영역 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related nose-pattern region of interest entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintSample"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#NoseRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#IdentificationTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">비문 비교 작업</rdfs:label>
    <rdfs:label xml:lang="en">Nose-print comparison task</rdfs:label>
    <rdfs:comment xml:lang="ko">1:1 검증 또는 1:N 식별 작업, 입력, 갤러리와 처리 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a 1:1 verification or 1:N identification task, inputs, gallery and status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#modelName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">방법 또는 모델 이름</rdfs:label>
    <rdfs:label xml:lang="en">Method or model name</rdfs:label>
    <rdfs:comment xml:lang="ko">방법 또는 모델 이름를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies method or model name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#RecognitionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#preprocessingStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전처리 상태</rdfs:label>
    <rdfs:label xml:lang="en">Preprocessing status</rdfs:label>
    <rdfs:comment xml:lang="ko">전처리 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies preprocessing status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#PreprocessingRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#metricName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">지표 이름</rdfs:label>
    <rdfs:label xml:lang="en">Metric name</rdfs:label>
    <rdfs:comment xml:lang="ko">지표 이름를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies metric name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#modelScopeNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">적용 범위 메모</rdfs:label>
    <rdfs:label xml:lang="en">Scope note</rdfs:label>
    <rdfs:comment xml:lang="ko">적용 범위 메모를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies scope note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#RecognitionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#datasetName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">데이터셋 이름</rdfs:label>
    <rdfs:label xml:lang="en">Dataset name</rdfs:label>
    <rdfs:comment xml:lang="ko">데이터셋 이름를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies dataset name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#ReferenceDataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#datasetSubjectCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">개체 수</rdfs:label>
    <rdfs:label xml:lang="en">Subject count</rdfs:label>
    <rdfs:comment xml:lang="ko">개체 수를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies subject count.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#ReferenceDataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#sampleStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">표본 상태</rdfs:label>
    <rdfs:label xml:lang="en">Sample status</rdfs:label>
    <rdfs:comment xml:lang="ko">표본 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies sample status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintSample"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#templateMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">템플릿 생성 방법</rdfs:label>
    <rdfs:label xml:lang="en">Template method</rdfs:label>
    <rdfs:comment xml:lang="ko">템플릿 생성 방법를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies template method.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#BiometricTemplate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#projectHasPermission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">표본 이용 권한</rdfs:label>
    <rdfs:label xml:lang="en">Has permission record</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 표본 이용 권한 기록 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related data-use permission record entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#DataUsePermission"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#CanineSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">개체 참조</rdfs:label>
    <rdfs:label xml:lang="en">Canine subject reference</rdfs:label>
    <rdfs:comment xml:lang="ko">비문 표본을 연결하는 가명 개체 참조이며 개 온톨로지의 개체 URI와 교차 연결할 수 있다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pseudonymous subject reference for nose samples, optionally cross-linked to the dog ontology.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
