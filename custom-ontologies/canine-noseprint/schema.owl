<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#datasetIncludesSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">포함 표본</rdfs:label>
    <rdfs:label xml:lang="en">Includes sample</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 비문 표본 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related nose-print sample entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#ReferenceDataset"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintSample"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#metricMeasurementStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">측정 상태</rdfs:label>
    <rdfs:label xml:lang="en">Measurement status</rdfs:label>
    <rdfs:comment xml:lang="ko">측정 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies measurement status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#evaluationUsesModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">평가 방법·모델</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation uses model</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 인식 방법 또는 모델 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related recognition method or model entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationRun"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#RecognitionModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#captureDeviceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">촬영 장치 유형</rdfs:label>
    <rdfs:label xml:lang="en">Capture device type</rdfs:label>
    <rdfs:comment xml:lang="ko">촬영 장치 유형를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies capture device type.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#CaptureSession"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#metricKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">지표 유형</rdfs:label>
    <rdfs:label xml:lang="en">Metric kind</rdfs:label>
    <rdfs:comment xml:lang="ko">지표 유형를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies metric kind.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#matchStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">비교 상태</rdfs:label>
    <rdfs:label xml:lang="en">Match status</rdfs:label>
    <rdfs:comment xml:lang="ko">비교 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies match status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#MatchResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#EvaluationRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">성능 평가 실행</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation run</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 데이터, 방법, 프로토콜과 측정 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records evaluation data, method, protocol and measurement status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#RecognitionModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">인식 방법 또는 모델</rdfs:label>
    <rdfs:label xml:lang="en">Recognition method or model</rdfs:label>
    <rdfs:comment xml:lang="ko">비문 비교 방법·구조와 출처를 기록하고 모델의 구현·평가 상태를 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a nose-pattern comparison method or architecture, evidence source and implementation status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#PreprocessingRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">전처리 기록</rdfs:label>
    <rdfs:label xml:lang="en">Preprocessing record</rdfs:label>
    <rdfs:comment xml:lang="ko">관심 영역 추출·정규화 같은 처리 단계와 실행 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records processing such as region extraction or normalization and its run status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#captureSurfaceCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">코 표면 상태</rdfs:label>
    <rdfs:label xml:lang="en">Nose surface condition</rdfs:label>
    <rdfs:comment xml:lang="ko">코 표면 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies nose surface condition.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#CaptureSession"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#sourceAuthors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">저자</rdfs:label>
    <rdfs:label xml:lang="en">Authors</rdfs:label>
    <rdfs:comment xml:lang="ko">저자를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies authors.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#evaluationProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">평가 프로토콜</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation protocol</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 프로토콜를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies evaluation protocol.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#metricValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">측정값</rdfs:label>
    <rdfs:label xml:lang="en">Metric value</rdfs:label>
    <rdfs:comment xml:lang="ko">측정값를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies metric value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#resultCandidateSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">후보 개체</rdfs:label>
    <rdfs:label xml:lang="en">Candidate subject</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 개체 참조 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related canine subject reference entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#MatchResult"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#CanineSubject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#matchRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">후보 순위</rdfs:label>
    <rdfs:label xml:lang="en">Candidate rank</rdfs:label>
    <rdfs:comment xml:lang="ko">후보 순위를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies candidate rank.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#MatchResult"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#sourceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">문헌 URI</rdfs:label>
    <rdfs:label xml:lang="en">Source URI</rdfs:label>
    <rdfs:comment xml:lang="ko">문헌 URI를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies source uri.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#projectHasSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">비문 표본</rdfs:label>
    <rdfs:label xml:lang="en">Has sample</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 비문 표본 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related nose-print sample entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/canine-noseprint#NosePrintSample"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://example.org/ontology/custom/canine-noseprint/0.1.0"/>
    <rdfs:label xml:lang="ko">개의 비문 온톨로지 (canine-noseprint)</rdfs:label>
    <rdfs:label xml:lang="en">Canine Nose-Print Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">개 코 무늬 표본, 촬영·품질·전처리, 개체 비교와 검증 상태, 데이터 이용 권한 및 문헌 근거를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Connects canine nose-pattern samples, capture and quality, preprocessing, subject comparison, evaluation status, data-use permission and evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#modelStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">구현 상태</rdfs:label>
    <rdfs:label xml:lang="en">Implementation status</rdfs:label>
    <rdfs:comment xml:lang="ko">구현 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies implementation status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#RecognitionModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#ImageQualityAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">이미지 품질 평가</rdfs:label>
    <rdfs:label xml:lang="en">Image quality assessment</rdfs:label>
    <rdfs:comment xml:lang="ko">초점, 각도, 조명, 반사와 가림 등의 평가 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records assessment of focus, pose, lighting, glare and occlusion.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#BiometricTemplate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">비문 특징 템플릿</rdfs:label>
    <rdfs:label xml:lang="en">Nose-pattern biometric template</rdfs:label>
    <rdfs:comment xml:lang="ko">표본에서 생성될 특징 표현의 방법·버전·상태를 기록하며 템플릿 값을 직접 담지 않는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records method, version and status of a derived feature representation without storing the template itself.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#NosePrintSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">비문 표본</rdfs:label>
    <rdfs:label xml:lang="en">Nose-print sample</rdfs:label>
    <rdfs:comment xml:lang="ko">개체, 관심 영역, 촬영 세션, 이미지 자산 참조와 품질 평가를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a subject, region, capture session, image-asset reference and quality assessment.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#NosePrintProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">개의 비문 프로젝트</rdfs:label>
    <rdfs:label xml:lang="en">Canine nose-print project</rdfs:label>
    <rdfs:comment xml:lang="ko">개의 비문 표본, 촬영, 처리, 비교·검증, 데이터 이용 권한과 문헌 근거를 한 범위에 묶는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Groups canine nose-pattern samples, capture, processing, comparison, evaluation, data-use permission and evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#EvaluationMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">인식 성능 지표</rdfs:label>
    <rdfs:label xml:lang="en">Recognition performance metric</rdfs:label>
    <rdfs:comment xml:lang="ko">Rank-1, EER, FAR, FRR 등의 척도와 측정값 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a measure such as Rank-1, EER, FAR or FRR and whether it was measured.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#qualityStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">종합 품질 상태</rdfs:label>
    <rdfs:label xml:lang="en">Overall quality status</rdfs:label>
    <rdfs:comment xml:lang="ko">종합 품질 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies overall quality status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#ImageQualityAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#captureNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">촬영 메모</rdfs:label>
    <rdfs:label xml:lang="en">Capture note</rdfs:label>
    <rdfs:comment xml:lang="ko">촬영 메모를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies capture note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#CaptureSession"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#evaluationNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">평가 메모</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation note</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 메모를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies evaluation note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#EvaluationRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#taskThresholdSetting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">판정 임계값 설정</rdfs:label>
    <rdfs:label xml:lang="en">Threshold setting</rdfs:label>
    <rdfs:comment xml:lang="ko">판정 임계값 설정를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies threshold setting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#IdentificationTask"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#datasetSplitProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">데이터 분할 절차</rdfs:label>
    <rdfs:label xml:lang="en">Dataset split protocol</rdfs:label>
    <rdfs:comment xml:lang="ko">데이터 분할 절차를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies dataset split protocol.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#ReferenceDataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/canine-noseprint#poseStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">각도 적합성</rdfs:label>
    <rdfs:label xml:lang="en">Pose status</rdfs:label>
    <rdfs:comment xml:lang="ko">각도 적합성를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies pose status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/canine-noseprint#ImageQualityAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
