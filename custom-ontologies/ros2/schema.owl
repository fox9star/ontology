<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#serviceNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Service"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">서비스 설명</rdfs:label>
    <rdfs:label xml:lang="en">Service note</rdfs:label>
    <rdfs:comment xml:lang="ko">서비스가 수행하는 짧은 요청·응답 작업을 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the short request/response operation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasController">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:label xml:lang="ko">컨트롤러 구성요소</rdfs:label>
    <rdfs:label xml:lang="en">Has controller</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에서 관리하는 컨트롤러를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a controller managed by the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#controlledBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:label xml:lang="ko">제어 컨트롤러</rdfs:label>
    <rdfs:label xml:lang="en">Controlled by</rdfs:label>
    <rdfs:comment xml:lang="ko">장치에 명령을 전달하는 컨트롤러를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the controller that sends commands to the device.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#recordKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">구성 기록 유형</rdfs:label>
    <rdfs:label xml:lang="en">Configuration record kind</rdfs:label>
    <rdfs:comment xml:lang="ko">학습용 연결 구성을 합성 기록으로 표시하고, 문서화된 개념 사실과 구별한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Marks a learning configuration as synthetic and separates it from documented concept facts.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#qosName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">QoS 이름</rdfs:label>
    <rdfs:label xml:lang="en">QoS name</rdfs:label>
    <rdfs:comment xml:lang="ko">정책 묶음을 식별하는 프로파일 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a name identifying the policy profile.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasService">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Service"/>
    <rdfs:label xml:lang="ko">서비스 인터페이스</rdfs:label>
    <rdfs:label xml:lang="en">Has service</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에서 제공하거나 사용하는 서비스를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a service provided or used by the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#Topic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">토픽</rdfs:label>
    <rdfs:label xml:lang="en">Topic</rdfs:label>
    <rdfs:comment xml:lang="ko">발행자와 구독자가 메시지 스트림을 비동기적으로 교환하는 이름 있는 인터페이스다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A named interface for asynchronous message streams between publishers and subscribers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/ros2#CommunicationInterface"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#sourceAccessedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="ko">확인 날짜</rdfs:label>
    <rdfs:label xml:lang="en">Access date</rdfs:label>
    <rdfs:comment xml:lang="ko">이 온톨로지 자료를 작성하면서 문서를 확인한 날짜를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the date the source was checked for this ontology.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#nodeName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">노드 이름</rdfs:label>
    <rdfs:label xml:lang="en">Node name</rdfs:label>
    <rdfs:comment xml:lang="ko">ROS 그래프에서 노드를 식별하는 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the name identifying a node in the ROS graph.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#serviceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Service"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">서비스 이름</rdfs:label>
    <rdfs:label xml:lang="en">Service name</rdfs:label>
    <rdfs:comment xml:lang="ko">호출 가능한 서비스 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the callable service name.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#systemPurpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">시스템 목적</rdfs:label>
    <rdfs:label xml:lang="en">System purpose</rdfs:label>
    <rdfs:comment xml:lang="ko">구성이 지원하는 응용 목적을 요약한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Summarizes the application purpose of the configuration.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#controlsHardware">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:label xml:lang="ko">제어 장치</rdfs:label>
    <rdfs:label xml:lang="en">Controls hardware</rdfs:label>
    <rdfs:comment xml:lang="ko">컨트롤러가 읽거나 명령하는 하드웨어 구성요소를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links hardware components read or commanded by the controller.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#parentFrame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#CoordinateFrame"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#CoordinateFrame"/>
    <rdfs:label xml:lang="ko">상위 프레임</rdfs:label>
    <rdfs:label xml:lang="en">Parent frame</rdfs:label>
    <rdfs:comment xml:lang="ko">좌표 프레임 트리에서 바로 위의 프레임을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the immediate parent frame in the coordinate frame tree.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#qosNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">QoS 설명</rdfs:label>
    <rdfs:label xml:lang="en">QoS note</rdfs:label>
    <rdfs:comment xml:lang="ko">프로파일 선택 목적과 출처 범위를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the profile use case and evidence scope.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasPackage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:label xml:lang="ko">사용 패키지</rdfs:label>
    <rdfs:label xml:lang="en">Includes package</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에서 사용하는 패키지를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a package used by the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#packageRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">패키지 역할</rdfs:label>
    <rdfs:label xml:lang="en">Package role</rdfs:label>
    <rdfs:comment xml:lang="ko">패키지가 라이브러리, 공통 인터페이스, 제어기 또는 응용 중 무엇을 제공하는지 분류한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classifies a package as a library, common interface, controller or application.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hardwareNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">하드웨어 설명</rdfs:label>
    <rdfs:label xml:lang="en">Hardware note</rdfs:label>
    <rdfs:comment xml:lang="ko">하드웨어 연결과 합성 예시의 범위를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes hardware integration and the synthetic example scope.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#serviceClient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Service"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">서비스 클라이언트</rdfs:label>
    <rdfs:label xml:lang="en">Service client</rdfs:label>
    <rdfs:comment xml:lang="ko">서비스에 요청을 보내는 클라이언트 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a client node that sends requests to the service.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#controllerKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">컨트롤러 종류</rdfs:label>
    <rdfs:label xml:lang="en">Controller kind</rdfs:label>
    <rdfs:comment xml:lang="ko">컨트롤러를 broadcaster, command 또는 custom 구성으로 분류한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classifies the controller as a broadcaster, command or custom component.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#actionName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Action"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">액션 이름</rdfs:label>
    <rdfs:label xml:lang="en">Action name</rdfs:label>
    <rdfs:comment xml:lang="ko">목표를 보낼 액션 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the action name to which a goal is sent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#definitionKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#MessageType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">정의 파일 종류</rdfs:label>
    <rdfs:label xml:lang="en">Definition file kind</rdfs:label>
    <rdfs:comment xml:lang="ko">형식 정의가 msg, srv 또는 action 파일인지 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies whether the definition is a msg, srv or action file.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#packageNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">패키지 설명</rdfs:label>
    <rdfs:label xml:lang="en">Package note</rdfs:label>
    <rdfs:comment xml:lang="ko">패키지의 용도와 이 예시에서의 사용 범위를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes a package purpose and its role in this example.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#controllerNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">컨트롤러 설명</rdfs:label>
    <rdfs:label xml:lang="en">Controller note</rdfs:label>
    <rdfs:comment xml:lang="ko">컨트롤 주기와 예시 구현의 범위를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the control role and scope of the example implementation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasSubscriber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Topic"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">구독 노드</rdfs:label>
    <rdfs:label xml:lang="en">Has subscriber</rdfs:label>
    <rdfs:comment xml:lang="ko">토픽 메시지를 받는 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a node that subscribes to topic messages.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#frameNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#CoordinateFrame"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">프레임 설명</rdfs:label>
    <rdfs:label xml:lang="en">Frame note</rdfs:label>
    <rdfs:comment xml:lang="ko">프레임의 예시 장착 위치와 관계를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the example mounting location and frame relationship.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#Action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">액션</rdfs:label>
    <rdfs:label xml:lang="en">Action</rdfs:label>
    <rdfs:comment xml:lang="ko">목표를 보내고 진행 피드백을 받으며 필요하면 취소할 수 있는 장시간 작업 인터페이스다.</rdfs:comment>
    <rdfs:comment xml:lang="en">An interface for long-running work that accepts a goal, provides feedback and can be cancelled.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/ros2#CommunicationInterface"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">ROS 2 시스템 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">ROS 2 System Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">ROS 2 패키지, 노드, 토픽·서비스·액션, QoS, 하드웨어, 컨트롤러, tf2 프레임의 관계를 문서 근거와 함께 표현한다. 가상 온실 연결 예시는 합성 자료로 표시한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents ROS 2 packages, nodes, topics, services, actions, QoS, hardware, controllers and tf2 frames with documentation evidence. The greenhouse wiring example is marked synthetic.</rdfs:comment>
    <owl:versionIRI rdf:resource="https://example.org/ontology/custom/ros2/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#sourceClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">근거 범위</rdfs:label>
    <rdfs:label xml:lang="en">Evidence claim</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 출처가 뒷받침하는 개념 또는 값의 범위를 요약한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Summarizes the concept or value supported by this source.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#controllerPackage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:label xml:lang="ko">컨트롤러 패키지</rdfs:label>
    <rdfs:label xml:lang="en">Controller package</rdfs:label>
    <rdfs:comment xml:lang="ko">컨트롤러 구현을 제공하는 패키지를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the package providing the controller implementation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#serviceServer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Service"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">서비스 서버</rdfs:label>
    <rdfs:label xml:lang="en">Service server</rdfs:label>
    <rdfs:comment xml:lang="ko">요청을 처리하고 응답하는 서버 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the server node that handles requests and returns responses.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#Service">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">서비스</rdfs:label>
    <rdfs:label xml:lang="en">Service</rdfs:label>
    <rdfs:comment xml:lang="ko">클라이언트 요청에 서버가 응답하는 요청·응답 인터페이스다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A request/response interface in which a server responds to a client request.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/ros2#CommunicationInterface"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#commandInterface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">명령 인터페이스</rdfs:label>
    <rdfs:label xml:lang="en">Command interface</rdfs:label>
    <rdfs:comment xml:lang="ko">하드웨어에 쓰는 명령 인터페이스 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a command interface name written to hardware.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#frameRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#CoordinateFrame"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">프레임 역할</rdfs:label>
    <rdfs:label xml:lang="en">Frame role</rdfs:label>
    <rdfs:comment xml:lang="ko">좌표계가 환경 기준인지 센서 기준인지 분류한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classifies the frame as a world, sensor, base, tool or other reference.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#typeNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#MessageType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">형식 설명</rdfs:label>
    <rdfs:label xml:lang="en">Type note</rdfs:label>
    <rdfs:comment xml:lang="ko">형식이 전달하는 내용과 표준·사용자 정의 여부를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the type payload and whether it is standard or custom.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#sourceTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">문서 제목</rdfs:label>
    <rdfs:label xml:lang="en">Source title</rdfs:label>
    <rdfs:comment xml:lang="ko">근거 문서의 제목 또는 파일을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the title or file name of the source.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#typeName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#MessageType"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">형식 이름</rdfs:label>
    <rdfs:label xml:lang="en">Type name</rdfs:label>
    <rdfs:comment xml:lang="ko">패키지 경로를 포함한 ROS 인터페이스 형식 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the ROS interface type name including its package path.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#reliability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">신뢰성 정책</rdfs:label>
    <rdfs:label xml:lang="en">Reliability policy</rdfs:label>
    <rdfs:comment xml:lang="ko">샘플 전달에 reliable, best effort 또는 시스템 기본 정책을 선택한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Selects reliable, best-effort or system-default sample delivery.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasQoSProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:label xml:lang="ko">QoS 프로파일</rdfs:label>
    <rdfs:label xml:lang="en">Has QoS profile</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에서 참조하는 통신 QoS 프로파일을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a communication QoS profile referenced by the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasCoordinateFrame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#CoordinateFrame"/>
    <rdfs:label xml:lang="ko">좌표 프레임</rdfs:label>
    <rdfs:label xml:lang="en">Has coordinate frame</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템의 tf2 프레임 트리에 속한 프레임을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a frame in the system tf2 tree.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hardwareProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">하드웨어 연결 방식</rdfs:label>
    <rdfs:label xml:lang="en">Hardware protocol</rdfs:label>
    <rdfs:comment xml:lang="ko">장치와 제어기 사이의 예시 물리 통신·신호 방식을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the example physical communication or signal method between device and controller.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#messageType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Topic"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#MessageType"/>
    <rdfs:label xml:lang="ko">토픽 메시지 형식</rdfs:label>
    <rdfs:label xml:lang="en">Topic message type</rdfs:label>
    <rdfs:comment xml:lang="ko">토픽에서 전달하는 메시지 형식을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the message type carried by the topic.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#Controller">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">컨트롤러</rdfs:label>
    <rdfs:label xml:lang="en">Controller</rdfs:label>
    <rdfs:comment xml:lang="ko">하드웨어 인터페이스를 읽고 제어 명령을 계산하거나 전달하는 ros2_control 구성요소다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A ros2_control component that reads hardware interfaces and calculates or forwards commands.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#actionServer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Action"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">액션 서버</rdfs:label>
    <rdfs:label xml:lang="en">Action server</rdfs:label>
    <rdfs:comment xml:lang="ko">목표를 실행하고 피드백·결과를 보내는 서버 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the server node that executes goals and returns feedback and results.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#historyPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">이력 정책</rdfs:label>
    <rdfs:label xml:lang="en">History policy</rdfs:label>
    <rdfs:comment xml:lang="ko">큐에 최근 샘플만 보관하거나 사용 가능한 샘플을 모두 보관하는 방식을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records whether the queue keeps the latest samples or all available samples.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#nodeNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">노드 설명</rdfs:label>
    <rdfs:label xml:lang="en">Node note</rdfs:label>
    <rdfs:comment xml:lang="ko">노드의 책임과 예시 구현 여부를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the node responsibility and whether it is an example implementation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasDocumentationSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:label xml:lang="ko">문서 출처</rdfs:label>
    <rdfs:label xml:lang="en">Has documentation source</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템을 설명하는 출처 기록을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a source record documenting the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#usesQoSProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Topic"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:label xml:lang="ko">토픽 QoS 프로파일</rdfs:label>
    <rdfs:label xml:lang="en">Uses QoS profile</rdfs:label>
    <rdfs:comment xml:lang="ko">토픽 발행자와 구독자의 통신 정책 예시를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the communication policy example for the topic endpoints.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#Package">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">패키지</rdfs:label>
    <rdfs:label xml:lang="en">Package</rdfs:label>
    <rdfs:comment xml:lang="ko">ROS 2 코드, 인터페이스 정의 또는 재사용 구성요소를 배포 단위로 묶는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Groups ROS 2 code, interface definitions or reusable components as a package.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#packageUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="ko">패키지 주소</rdfs:label>
    <rdfs:label xml:lang="en">Package URI</rdfs:label>
    <rdfs:comment xml:lang="ko">패키지 저장소 주소 또는 합성 예시 식별자를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a repository URI or a synthetic example identifier.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#ROS2System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">ROS 2 시스템</rdfs:label>
    <rdfs:label xml:lang="en">ROS 2 system</rdfs:label>
    <rdfs:comment xml:lang="ko">패키지, 노드, 통신 인터페이스와 장치 구성을 하나의 ROS 2 응용으로 묶는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Groups packages, nodes, communication interfaces and hardware into a ROS 2 application.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#sourceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="ko">문서 주소</rdfs:label>
    <rdfs:label xml:lang="en">Source URI</rdfs:label>
    <rdfs:comment xml:lang="ko">직접 확인할 수 있는 공식 문서 주소를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a direct URI for the official documentation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Topic"/>
    <rdfs:label xml:lang="ko">토픽 인터페이스</rdfs:label>
    <rdfs:label xml:lang="en">Has topic</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에서 사용하는 토픽을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a topic used by the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#actionNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Action"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">액션 설명</rdfs:label>
    <rdfs:label xml:lang="en">Action note</rdfs:label>
    <rdfs:comment xml:lang="ko">장시간 작업의 목표, 피드백, 취소 또는 결과 예시를 설명한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the example goal, feedback, cancellation or result for long-running work.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#stateInterface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">상태 인터페이스</rdfs:label>
    <rdfs:label xml:lang="en">State interface</rdfs:label>
    <rdfs:comment xml:lang="ko">하드웨어에서 읽는 상태 인터페이스 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a state interface name read from hardware.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#HardwareComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">하드웨어 구성요소</rdfs:label>
    <rdfs:label xml:lang="en">Hardware component</rdfs:label>
    <rdfs:comment xml:lang="ko">ROS 2 하드웨어 인터페이스를 통해 센서 값이나 액추에이터 명령을 주고받는 장치다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A device that exchanges sensor state or actuator commands through a ROS 2 hardware interface.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#controllerNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">컨트롤러 관리자 노드</rdfs:label>
    <rdfs:label xml:lang="en">Controller manager node</rdfs:label>
    <rdfs:comment xml:lang="ko">컨트롤러를 관리하는 실행 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the running node that manages the controller.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#actionClient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Action"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">액션 클라이언트</rdfs:label>
    <rdfs:label xml:lang="en">Action client</rdfs:label>
    <rdfs:comment xml:lang="ko">목표를 보내고 진행 상태를 받는 클라이언트 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a client node that sends goals and receives progress.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Action"/>
    <rdfs:label xml:lang="ko">액션 인터페이스</rdfs:label>
    <rdfs:label xml:lang="en">Has action</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에서 제공하거나 사용하는 액션을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an action provided or used by the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#serviceQoSProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Service"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:label xml:lang="ko">서비스 QoS 프로파일</rdfs:label>
    <rdfs:label xml:lang="en">Service QoS profile</rdfs:label>
    <rdfs:comment xml:lang="ko">서비스 서버와 클라이언트에 대한 예시 QoS 프로파일을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the example QoS profile for the service endpoints.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#nodeRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">노드 역할</rdfs:label>
    <rdfs:label xml:lang="en">Node role</rdfs:label>
    <rdfs:comment xml:lang="ko">예시 시스템에서 노드가 맡는 주된 기능을 분류한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classifies the node’s primary function in the example system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#actionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Action"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#MessageType"/>
    <rdfs:label xml:lang="ko">액션 형식</rdfs:label>
    <rdfs:label xml:lang="en">Action type</rdfs:label>
    <rdfs:comment xml:lang="ko">.action 정의 파일의 형식을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the type defined by the .action interface file.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#MessageType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">인터페이스 형식</rdfs:label>
    <rdfs:label xml:lang="en">Interface type</rdfs:label>
    <rdfs:comment xml:lang="ko">.msg, .srv 또는 .action 파일로 정의되는 ROS 2 메시지 형식이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A ROS 2 message, service or action type defined by a .msg, .srv or .action file.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#packageName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">패키지 이름</rdfs:label>
    <rdfs:label xml:lang="en">Package name</rdfs:label>
    <rdfs:comment xml:lang="ko">ROS 2 패키지의 정확한 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the ROS 2 package identifier.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#CoordinateFrame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">좌표 프레임</rdfs:label>
    <rdfs:label xml:lang="en">Coordinate frame</rdfs:label>
    <rdfs:comment xml:lang="ko">tf2가 시간에 따라 관계를 관리하는 로봇 또는 환경의 공간 기준 좌표계다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A spatial reference frame whose time-varying relationships are managed by tf2.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasNode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">실행 노드</rdfs:label>
    <rdfs:label xml:lang="en">Has node</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에서 실행되는 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a node in the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasHardwareComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:label xml:lang="ko">하드웨어 구성요소</rdfs:label>
    <rdfs:label xml:lang="en">Has hardware component</rdfs:label>
    <rdfs:comment xml:lang="ko">시스템에 연결된 센서·액추에이터·하드웨어 묶음을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links sensors, actuators or hardware systems attached to the system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#historyDepth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">이력 깊이</rdfs:label>
    <rdfs:label xml:lang="en">History depth</rdfs:label>
    <rdfs:comment xml:lang="ko">keep_last 이력에서 보관할 샘플 큐 크기를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the sample queue size for keep_last history.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#CommunicationInterface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">통신 인터페이스</rdfs:label>
    <rdfs:label xml:lang="en">Communication interface</rdfs:label>
    <rdfs:comment xml:lang="ko">토픽, 서비스 또는 액션으로 노드 사이의 메시지 교환 방식을 정의한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Defines how nodes exchange messages through topics, services or actions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#hasPublisher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Topic"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:label xml:lang="ko">발행 노드</rdfs:label>
    <rdfs:label xml:lang="en">Has publisher</rdfs:label>
    <rdfs:comment xml:lang="ko">토픽에 메시지를 발행하는 노드를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a node that publishes messages to the topic.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#usesPackage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Node"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:label xml:lang="ko">실행 패키지</rdfs:label>
    <rdfs:label xml:lang="en">Uses package</rdfs:label>
    <rdfs:comment xml:lang="ko">노드 구현을 포함하는 패키지를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the package containing the node implementation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#sourcePublisher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">문서 제공자</rdfs:label>
    <rdfs:label xml:lang="en">Source publisher</rdfs:label>
    <rdfs:comment xml:lang="ko">문서를 관리하는 ROS 프로젝트 또는 패키지를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the ROS project or package maintaining the source.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#documentedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:label xml:lang="ko">문서 근거</rdfs:label>
    <rdfs:label xml:lang="en">Documented by</rdfs:label>
    <rdfs:comment xml:lang="ko">개념 또는 예시 값의 설명을 뒷받침하는 문서 출처를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a documentation source supporting a concept or example value.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#QoSProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">QoS 프로파일</rdfs:label>
    <rdfs:label xml:lang="en">QoS profile</rdfs:label>
    <rdfs:comment xml:lang="ko">메시지 보관 방식, 큐 깊이, 신뢰성, 지속성 등 통신 정책을 묶는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Groups communication policies such as history, queue depth, reliability and durability.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#componentKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">장치 종류</rdfs:label>
    <rdfs:label xml:lang="en">Component kind</rdfs:label>
    <rdfs:comment xml:lang="ko">장치를 센서, 액추에이터 또는 복합 시스템으로 분류한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Classifies a device as a sensor, actuator or system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#systemNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#ROS2System"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">시스템 설명</rdfs:label>
    <rdfs:label xml:lang="en">System note</rdfs:label>
    <rdfs:comment xml:lang="ko">구성 범위와 예시 여부에 대한 추가 설명을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records additional context and example scope.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#sourceLanguage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">문서 언어</rdfs:label>
    <rdfs:label xml:lang="en">Source language</rdfs:label>
    <rdfs:comment xml:lang="ko">원문 문서의 주 언어를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the primary language of the source.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#componentName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#HardwareComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">장치 이름</rdfs:label>
    <rdfs:label xml:lang="en">Component name</rdfs:label>
    <rdfs:comment xml:lang="ko">예시 시스템에서 장치를 식별하는 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the name identifying the device in the example system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#DocumentationSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">공식 문서 출처</rdfs:label>
    <rdfs:label xml:lang="en">Documentation source</rdfs:label>
    <rdfs:comment xml:lang="ko">ROS 2 개념 설명이나 속성 값의 근거가 되는 문서의 주소와 확인 범위를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a source URI and the claim it supports for a ROS 2 concept or property value.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#Node">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">노드</rdfs:label>
    <rdfs:label xml:lang="en">Node</rdfs:label>
    <rdfs:comment xml:lang="ko">ROS 2 시스템에서 실행되어 기능을 수행하고 다른 노드와 통신하는 실행 단위다.</rdfs:comment>
    <rdfs:comment xml:lang="en">An executable unit that performs a function and communicates with other nodes in a ROS 2 system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#serviceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Service"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#MessageType"/>
    <rdfs:label xml:lang="ko">서비스 형식</rdfs:label>
    <rdfs:label xml:lang="en">Service type</rdfs:label>
    <rdfs:comment xml:lang="ko">요청·응답 구조를 정의하는 서비스 형식을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the service type defining request and response fields.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#controllerName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Controller"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">컨트롤러 이름</rdfs:label>
    <rdfs:label xml:lang="en">Controller name</rdfs:label>
    <rdfs:comment xml:lang="ko">컨트롤러 인스턴스를 식별하는 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the name identifying the controller instance.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#durability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#QoSProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">지속성 정책</rdfs:label>
    <rdfs:label xml:lang="en">Durability policy</rdfs:label>
    <rdfs:comment xml:lang="ko">늦게 연결한 구독자에게 이전 샘플을 보존할지 정한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies whether prior samples are retained for late-joining subscribers.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#topicName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#Topic"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">토픽 이름</rdfs:label>
    <rdfs:label xml:lang="en">Topic name</rdfs:label>
    <rdfs:comment xml:lang="ko">발행·구독에 사용할 토픽 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the topic name used by publishers and subscribers.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#frameName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#CoordinateFrame"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">프레임 이름</rdfs:label>
    <rdfs:label xml:lang="en">Frame name</rdfs:label>
    <rdfs:comment xml:lang="ko">tf2 트리에서 사용할 좌표 프레임 이름을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the coordinate frame name used in the tf2 tree.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/ros2#definedInPackage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/ros2#MessageType"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/ros2#Package"/>
    <rdfs:label xml:lang="ko">형식 정의 패키지</rdfs:label>
    <rdfs:label xml:lang="en">Defined in package</rdfs:label>
    <rdfs:comment xml:lang="ko">인터페이스 형식을 선언하는 패키지를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the package declaring the interface type.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
