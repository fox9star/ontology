        ns1:documentedBy <https://example.test/ros2/src-control> ;
        ns1:packageName "ros2_control"^^xsd:string ;
        ns1:packageNote "하드웨어 구성요소·인터페이스와 컨트롤러 관리 구조를 제공한다."^^xsd:string ;
        ns1:packageRole "control_framework"^^xsd:string ;
        ns1:packageUri "https://github.com/ros-controls/ros2_control"^^xsd:anyURI .

    <https://example.test/ros2/pkg-ros2-controllers> a ns1:Package ;
