    <https://example.test/ros2/src-interfaces> a ns1:DocumentationSource ;
        rdfs:label "ROS 2 topics, services and actions documentation"@en,
            "ROS 2 토픽·서비스·액션 문서"@ko ;
        ns1:sourceAccessedAt "2026-10-07"^^xsd:date ;
        ns1:sourceClaim "Topics carry asynchronous data streams; services use request/response for short work; actions support long-running goals, feedback, cancellation and results."^^xsd:string ;
