        ns1:sourcePublisher "ROS 2 common_interfaces project"^^xsd:string ;
        ns1:sourceTitle "SetBool.srv"^^xsd:string ;
        ns1:sourceUri "https://github.com/ros2/common_interfaces/blob/rolling/std_srvs/srv/SetBool.srv"^^xsd:anyURI .

