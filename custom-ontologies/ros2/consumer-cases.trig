@prefix ns1: <https://example.org/ontology/custom/ros2#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.test/consumer/ros2-accept> {
    <https://example.test/ros2/greenhouse-system> a ns1:ROS2System ;
        rdfs:label "Synthetic ROS 2 greenhouse sensing and irrigation system"@en,
            "가상 온실 계측·관수 ROS 2 구성"@ko ;
        ns1:hasAction <https://example.test/ros2/action-irrigation-cycle> ;
        ns1:hasController <https://example.test/ros2/controller-irrigation-pump> ;
        ns1:hasCoordinateFrame <https://example.test/ros2/frame-greenhouse-map>,
            <https://example.test/ros2/frame-sensor-rack>,
            <https://example.test/ros2/frame-soil-probe>,
            <https://example.test/ros2/frame-temperature-probe> ;
        ns1:hasDocumentationSource <https://example.test/ros2/src-control>,
            <https://example.test/ros2/src-interfaces>,
            <https://example.test/ros2/src-qos-guide>,
            <https://example.test/ros2/src-rclcpp-qos>,
            <https://example.test/ros2/src-setbool>,
            <https://example.test/ros2/src-temperature>,
            <https://example.test/ros2/src-tf2> ;
        ns1:hasHardwareComponent <https://example.test/ros2/hardware-pump>,
            <https://example.test/ros2/hardware-soil-probe>,
            <https://example.test/ros2/hardware-temperature-sensor> ;
        ns1:hasNode <https://example.test/ros2/node-controller-manager>,
            <https://example.test/ros2/node-greenhouse-supervisor>,
            <https://example.test/ros2/node-operator-console>,
            <https://example.test/ros2/node-sensor-bridge> ;
        ns1:hasPackage <https://example.test/ros2/pkg-controller-manager>,
            <https://example.test/ros2/pkg-farm-interfaces>,
            <https://example.test/ros2/pkg-greenhouse-app>,
            <https://example.test/ros2/pkg-rclcpp>,
            <https://example.test/ros2/pkg-ros2-control>,
            <https://example.test/ros2/pkg-ros2-controllers>,
            <https://example.test/ros2/pkg-sensor-msgs>,
            <https://example.test/ros2/pkg-std-srvs>,
            <https://example.test/ros2/pkg-tf2> ;
        ns1:hasQoSProfile <https://example.test/ros2/qos-default>,
            <https://example.test/ros2/qos-sensor-data>,
            <https://example.test/ros2/qos-services> ;
        ns1:hasService <https://example.test/ros2/service-pump-enable> ;
        ns1:hasTopic <https://example.test/ros2/topic-soil-moisture>,
            <https://example.test/ros2/topic-temperature> ;
        ns1:recordKind "synthetic"^^xsd:string ;
        ns1:systemNote "실제 온실 배포, 펌프 회로, 센서 배선이나 검증된 안전 동작이 아닌 개념 예시다. 공식 ROS 개념 근거는 출처 개체에 연결한다."^^xsd:string ;
        ns1:systemPurpose "학습용 구조로 온도·토양 수분을 수집하고 관수 펌프 동작을 요청한다."^^xsd:string .

    <https://example.test/ros2/action-irrigation-cycle> a ns1:Action ;
        rdfs:label "Synthetic irrigation cycle action"@en,
            "가상 관수 사이클 액션"@ko ;
        ns1:actionClient <https://example.test/ros2/node-operator-console> ;
        ns1:actionName "/greenhouse/irrigation/run_cycle"^^xsd:string ;
        ns1:actionNote "긴 관수 작업에 목표·진행 피드백·결과·취소를 보여주는 합성 액션 연결이다. 농업 처방이나 안전 로직을 제공하지 않는다."^^xsd:string ;
        ns1:actionServer <https://example.test/ros2/node-greenhouse-supervisor> ;
        ns1:actionType <https://example.test/ros2/type-irrigation-cycle> ;
        ns1:documentedBy <https://example.test/ros2/src-interfaces> .

    <https://example.test/ros2/frame-soil-probe> a ns1:CoordinateFrame ;
        rdfs:label "Synthetic soil probe frame"@en,
            "가상 토양 프로브 프레임"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-tf2> ;
        ns1:frameName "soil_probe"^^xsd:string ;
        ns1:frameNote "센서 랙에 연결된 합성 토양 프로브 프레임이다."^^xsd:string ;
        ns1:frameRole "sensor"^^xsd:string ;
        ns1:parentFrame <https://example.test/ros2/frame-sensor-rack> .

    <https://example.test/ros2/frame-temperature-probe> a ns1:CoordinateFrame ;
        rdfs:label "Synthetic temperature probe frame"@en,
            "가상 온도 프로브 프레임"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-tf2> ;
        ns1:frameName "temperature_probe"^^xsd:string ;
        ns1:frameNote "센서 랙에 연결된 합성 센서 프레임이다."^^xsd:string ;
        ns1:frameRole "sensor"^^xsd:string ;
        ns1:parentFrame <https://example.test/ros2/frame-sensor-rack> .

    <https://example.test/ros2/hardware-soil-probe> a ns1:HardwareComponent ;
        rdfs:label "Synthetic soil moisture probe"@en,
            "가상 토양 수분 프로브"@ko ;
        ns1:componentKind "sensor"^^xsd:string ;
        ns1:componentName "soil_moisture_probe"^^xsd:string ;
        ns1:documentedBy <https://example.test/ros2/src-control> ;
        ns1:hardwareNote "센서 측정 단위, 교정, 전기 연결과 ROS 드라이버는 구현하지 않은 예시다."^^xsd:string ;
        ns1:hardwareProtocol "가상 MCU를 통한 아날로그 입력"^^xsd:string ;
        ns1:stateInterface "['moisture']"^^xsd:string .

    <https://example.test/ros2/hardware-temperature-sensor> a ns1:HardwareComponent ;
        rdfs:label "Synthetic temperature sensor"@en,
            "가상 온도 센서"@ko ;
        ns1:componentKind "sensor"^^xsd:string ;
        ns1:componentName "temperature_sensor"^^xsd:string ;
        ns1:documentedBy <https://example.test/ros2/src-control> ;
        ns1:hardwareNote "연결 방식과 상태 인터페이스는 예시이며 실제 센서 모델·드라이버를 검증하지 않았다."^^xsd:string ;
        ns1:hardwareProtocol "가상 MCU를 통한 I2C 센서 읽기"^^xsd:string ;
        ns1:stateInterface "['temperature']"^^xsd:string .

    <https://example.test/ros2/pkg-rclcpp> a ns1:Package ;
        rdfs:label "rclcpp"@en,
            "rclcpp"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-rclcpp-qos> ;
        ns1:packageName "rclcpp"^^xsd:string ;
        ns1:packageNote "C++ ROS 2 클라이언트 라이브러리다. 이 예시 애플리케이션의 구현 의존성을 나타낸다."^^xsd:string ;
        ns1:packageRole "client_library"^^xsd:string ;
        ns1:packageUri "https://github.com/ros2/rclcpp"^^xsd:anyURI .

    <https://example.test/ros2/pkg-ros2-control> a ns1:Package ;
        rdfs:label "ros2_control"@en,
            "ros2_control"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-control> ;
        ns1:packageName "ros2_control"^^xsd:string ;
        ns1:packageNote "하드웨어 구성요소·인터페이스와 컨트롤러 관리 구조를 제공한다."^^xsd:string ;
        ns1:packageRole "control_framework"^^xsd:string ;
        ns1:packageUri "https://github.com/ros-controls/ros2_control"^^xsd:anyURI .

    <https://example.test/ros2/pkg-ros2-controllers> a ns1:Package ;
        rdfs:label "ros2_controllers"@en,
            "ros2_controllers"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-control> ;
        ns1:packageName "ros2_controllers"^^xsd:string ;
        ns1:packageNote "공용 ros2_control 컨트롤러 플러그인 모음이다."^^xsd:string ;
        ns1:packageRole "controller_plugins"^^xsd:string ;
        ns1:packageUri "https://github.com/ros-controls/ros2_controllers"^^xsd:anyURI .

    <https://example.test/ros2/pkg-tf2> a ns1:Package ;
        rdfs:label "tf2"@en,
            "tf2"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-tf2> ;
        ns1:packageName "tf2"^^xsd:string ;
        ns1:packageNote "좌표 프레임 간 관계를 저장하고 변환하는 라이브러리 모음이다."^^xsd:string ;
        ns1:packageRole "transform_library"^^xsd:string ;
        ns1:packageUri "https://github.com/ros2/geometry2"^^xsd:anyURI .

    <https://example.test/ros2/qos-default> a ns1:QoSProfile ;
        rdfs:label "ROS 2 default QoS example"@en,
            "ROS 2 기본 QoS 예시"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-qos-guide> ;
        ns1:durability "volatile"^^xsd:string ;
        ns1:historyDepth 10 ;
        ns1:historyPolicy "keep_last"^^xsd:string ;
        ns1:qosName "DefaultQoS"^^xsd:string ;
        ns1:qosNote "ROS 2 문서의 기본 publish/subscribe 설정 예시다. 각 RMW 구현의 세부 기본값은 달라질 수 있다."^^xsd:string ;
        ns1:reliability "reliable"^^xsd:string .

    <https://example.test/ros2/service-pump-enable> a ns1:Service ;
        rdfs:label "Synthetic pump enable service"@en,
            "가상 펌프 활성 서비스"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-interfaces> ;
        ns1:serviceClient <https://example.test/ros2/node-operator-console> ;
        ns1:serviceName "/greenhouse/pump/set_enabled"^^xsd:string ;
        ns1:serviceNote "작업자 패널이 펌프 활성 여부를 요청하는 예시 서비스다. 실제 펌프를 작동시키지 않는다."^^xsd:string ;
        ns1:serviceQoSProfile <https://example.test/ros2/qos-services> ;
        ns1:serviceServer <https://example.test/ros2/node-greenhouse-supervisor> ;
        ns1:serviceType <https://example.test/ros2/type-set-bool> .

    <https://example.test/ros2/topic-soil-moisture> a ns1:Topic ;
        rdfs:label "Synthetic soil moisture topic"@en,
            "가상 토양 수분 토픽"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-interfaces> ;
        ns1:hasPublisher <https://example.test/ros2/node-sensor-bridge> ;
        ns1:hasSubscriber <https://example.test/ros2/node-greenhouse-supervisor> ;
        ns1:messageType <https://example.test/ros2/type-soil-moisture> ;
        ns1:topicName "/greenhouse/soil_moisture"^^xsd:string ;
        ns1:usesQoSProfile <https://example.test/ros2/qos-sensor-data> .

    <https://example.test/ros2/topic-temperature> a ns1:Topic ;
        rdfs:label "Synthetic greenhouse temperature topic"@en,
            "가상 온실 온도 토픽"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-interfaces> ;
        ns1:hasPublisher <https://example.test/ros2/node-sensor-bridge> ;
        ns1:hasSubscriber <https://example.test/ros2/node-greenhouse-supervisor> ;
        ns1:messageType <https://example.test/ros2/type-temperature> ;
        ns1:topicName "/greenhouse/temperature"^^xsd:string ;
        ns1:usesQoSProfile <https://example.test/ros2/qos-sensor-data> .

    <https://example.test/ros2/type-irrigation-cycle> a ns1:MessageType ;
        rdfs:label "farm_interfaces/action/IrrigationCycle (synthetic)"@en,
            "farm_interfaces/action/IrrigationCycle (가상)"@ko ;
        ns1:definedInPackage <https://example.test/ros2/pkg-farm-interfaces> ;
        ns1:definitionKind "action"^^xsd:string ;
        ns1:typeName "farm_interfaces/action/IrrigationCycle"^^xsd:string ;
        ns1:typeNote "목표·피드백·결과가 필요한 관수 사이클의 예시 사용자 정의 액션 형식 이름이다."^^xsd:string .

    <https://example.test/ros2/type-set-bool> a ns1:MessageType ;
        rdfs:label "std_srvs/srv/SetBool"@en,
            "std_srvs/srv/SetBool"@ko ;
        ns1:definedInPackage <https://example.test/ros2/pkg-std-srvs> ;
        ns1:definitionKind "srv"^^xsd:string ;
        ns1:documentedBy <https://example.test/ros2/src-setbool> ;
        ns1:typeName "std_srvs/srv/SetBool"^^xsd:string ;
        ns1:typeNote "불리언 요청과 성공 여부·메시지 응답을 정의하는 표준 서비스 형식이다."^^xsd:string .

    <https://example.test/ros2/type-soil-moisture> a ns1:MessageType ;
        rdfs:label "farm_interfaces/msg/SoilMoisture (synthetic)"@en,
            "farm_interfaces/msg/SoilMoisture (가상)"@ko ;
        ns1:definedInPackage <https://example.test/ros2/pkg-farm-interfaces> ;
        ns1:definitionKind "msg"^^xsd:string ;
        ns1:typeName "farm_interfaces/msg/SoilMoisture"^^xsd:string ;
        ns1:typeNote "온실 학습 예시를 위해 만든 사용자 정의 메시지 형식 이름이다. ROS 표준 형식이 아니다."^^xsd:string .

    <https://example.test/ros2/type-temperature> a ns1:MessageType ;
        rdfs:label "sensor_msgs/msg/Temperature"@en,
            "sensor_msgs/msg/Temperature"@ko ;
        ns1:definedInPackage <https://example.test/ros2/pkg-sensor-msgs> ;
        ns1:definitionKind "msg"^^xsd:string ;
        ns1:documentedBy <https://example.test/ros2/src-temperature> ;
        ns1:typeName "sensor_msgs/msg/Temperature"^^xsd:string ;
        ns1:typeNote "sensor_msgs 문서에서 단일 온도 측정값으로 설명하는 표준 메시지 형식이다."^^xsd:string .

    <https://example.test/ros2/controller-irrigation-pump> a ns1:Controller ;
        rdfs:label "Synthetic pump command controller"@en,
            "가상 펌프 명령 컨트롤러"@ko ;
        ns1:controllerKind "custom"^^xsd:string ;
        ns1:controllerName "greenhouse_pump_controller"^^xsd:string ;
        ns1:controllerNode <https://example.test/ros2/node-controller-manager> ;
        ns1:controllerNote "예시 전용 사용자 정의 컨트롤러 연결이다. 공식 ros2_controllers 플러그인이나 실제 하드웨어 드라이버가 아니다."^^xsd:string ;
        ns1:controllerPackage <https://example.test/ros2/pkg-greenhouse-app> ;
        ns1:controlsHardware <https://example.test/ros2/hardware-pump> ;
        ns1:documentedBy <https://example.test/ros2/src-control> .

    <https://example.test/ros2/frame-greenhouse-map> a ns1:CoordinateFrame ;
        rdfs:label "Synthetic greenhouse world frame"@en,
            "가상 온실 기준 프레임"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-tf2> ;
        ns1:frameName "greenhouse_map"^^xsd:string ;
        ns1:frameNote "학습용 프레임 트리의 루트다."^^xsd:string ;
        ns1:frameRole "world"^^xsd:string .

    <https://example.test/ros2/hardware-pump> a ns1:HardwareComponent ;
        rdfs:label "Synthetic irrigation pump"@en,
            "가상 관수 펌프"@ko ;
        ns1:commandInterface "['enable']"^^xsd:string ;
        ns1:componentKind "actuator"^^xsd:string ;
        ns1:componentName "irrigation_pump"^^xsd:string ;
        ns1:controlledBy <https://example.test/ros2/controller-irrigation-pump> ;
        ns1:documentedBy <https://example.test/ros2/src-control> ;
        ns1:hardwareNote "회로·전원·보호·급수 부품을 나타내지 않는 가상 하드웨어 구성요소다."^^xsd:string ;
        ns1:hardwareProtocol "가상 절연 릴레이 출력"^^xsd:string ;
        ns1:stateInterface "['enabled']"^^xsd:string .

    <https://example.test/ros2/node-controller-manager> a ns1:Node ;
        rdfs:label "Synthetic controller_manager node"@en,
            "가상 controller_manager 노드"@ko ;
        ns1:nodeName "/controller_manager"^^xsd:string ;
        ns1:nodeNote "온실 펌프 컨트롤러를 관리하는 합성 구성 연결이다. 특정 실행 환경에서 확인한 런타임 상태가 아니다."^^xsd:string ;
        ns1:nodeRole "controller_manager"^^xsd:string ;
        ns1:usesPackage <https://example.test/ros2/pkg-controller-manager> .

    <https://example.test/ros2/pkg-controller-manager> a ns1:Package ;
        rdfs:label "controller_manager"@en,
            "controller_manager"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-control> ;
        ns1:packageName "controller_manager"^^xsd:string ;
        ns1:packageNote "ros2_control의 컨트롤러와 하드웨어 인터페이스를 관리하는 패키지다."^^xsd:string ;
        ns1:packageRole "control_framework"^^xsd:string ;
        ns1:packageUri "https://github.com/ros-controls/ros2_control/tree/master/controller_manager"^^xsd:anyURI .

    <https://example.test/ros2/pkg-sensor-msgs> a ns1:Package ;
        rdfs:label "sensor_msgs"@en,
            "sensor_msgs"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-temperature> ;
        ns1:packageName "sensor_msgs"^^xsd:string ;
        ns1:packageNote "센서 장치와 관련한 ROS 메시지 정의를 제공한다."^^xsd:string ;
        ns1:packageRole "common_interfaces"^^xsd:string ;
        ns1:packageUri "https://github.com/ros2/common_interfaces/tree/rolling/sensor_msgs"^^xsd:anyURI .

    <https://example.test/ros2/pkg-std-srvs> a ns1:Package ;
        rdfs:label "std_srvs"@en,
            "std_srvs"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-setbool> ;
        ns1:packageName "std_srvs"^^xsd:string ;
        ns1:packageNote "일반적인 단순 서비스 형식을 제공한다."^^xsd:string ;
        ns1:packageRole "common_interfaces"^^xsd:string ;
        ns1:packageUri "https://github.com/ros2/common_interfaces/tree/rolling/std_srvs"^^xsd:anyURI .

    <https://example.test/ros2/qos-services> a ns1:QoSProfile ;
        rdfs:label "ServicesQoS example"@en,
            "ServicesQoS 예시"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-rclcpp-qos> ;
        ns1:durability "volatile"^^xsd:string ;
        ns1:historyDepth 10 ;
        ns1:historyPolicy "keep_last"^^xsd:string ;
        ns1:qosName "ServicesQoS"^^xsd:string ;
        ns1:qosNote "rclcpp ServicesQoS 정의에 기록된 reliable, volatile, keep_last 깊이 10 조합이다."^^xsd:string ;
        ns1:reliability "reliable"^^xsd:string .

    <https://example.test/ros2/frame-sensor-rack> a ns1:CoordinateFrame ;
        rdfs:label "Synthetic sensor rack frame"@en,
            "가상 센서 랙 프레임"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-tf2> ;
        ns1:frameName "sensor_rack"^^xsd:string ;
        ns1:frameNote "온실 기준 프레임에 고정된 합성 장착 프레임이다."^^xsd:string ;
        ns1:frameRole "other"^^xsd:string ;
        ns1:parentFrame <https://example.test/ros2/frame-greenhouse-map> .

    <https://example.test/ros2/node-operator-console> a ns1:Node ;
        rdfs:label "Synthetic operator console node"@en,
            "가상 작업자 패널 노드"@ko ;
        ns1:nodeName "/greenhouse/operator_console"^^xsd:string ;
        ns1:nodeNote "펌프 활성 요청과 관수 사이클 목표를 보내는 예시 노드다."^^xsd:string ;
        ns1:nodeRole "operator"^^xsd:string ;
        ns1:usesPackage <https://example.test/ros2/pkg-greenhouse-app> .

    <https://example.test/ros2/node-sensor-bridge> a ns1:Node ;
        rdfs:label "Synthetic sensor bridge node"@en,
            "가상 센서 브리지 노드"@ko ;
        ns1:nodeName "/greenhouse/sensor_bridge"^^xsd:string ;
        ns1:nodeNote "가상 센서 읽기를 두 토픽으로 발행하는 예시 노드다."^^xsd:string ;
        ns1:nodeRole "driver"^^xsd:string ;
        ns1:usesPackage <https://example.test/ros2/pkg-greenhouse-app> .

    <https://example.test/ros2/pkg-farm-interfaces> a ns1:Package ;
        rdfs:label "farm_interfaces (synthetic)"@en,
            "farm_interfaces (가상)"@ko ;
        ns1:packageName "farm_interfaces"^^xsd:string ;
        ns1:packageNote "토양 수분 메시지와 관수 액션을 보여주기 위해 만든 예시 패키지 식별자이며 실제 저장소나 배포물이 아니다."^^xsd:string ;
        ns1:packageRole "custom_interfaces"^^xsd:string ;
        ns1:packageUri "urn:synthetic:ros2:package:farm_interfaces"^^xsd:anyURI .

    <https://example.test/ros2/qos-sensor-data> a ns1:QoSProfile ;
        rdfs:label "SensorDataQoS example"@en,
            "SensorDataQoS 예시"@ko ;
        ns1:documentedBy <https://example.test/ros2/src-qos-guide>,
            <https://example.test/ros2/src-rclcpp-qos> ;
        ns1:durability "volatile"^^xsd:string ;
        ns1:historyDepth 5 ;
        ns1:historyPolicy "keep_last"^^xsd:string ;
        ns1:qosName "SensorDataQoS"^^xsd:string ;
        ns1:qosNote "rclcpp SensorDataQoS 정의에 기록된 keep_last 깊이 5, best effort, volatile 조합이다. 애플리케이션의 손실 허용 여부는 별도 검토해야 한다."^^xsd:string ;
        ns1:reliability "best_effort"^^xsd:string .

    <https://example.test/ros2/src-qos-guide> a ns1:DocumentationSource ;
        rdfs:label "ROS 2 QoS policies documentation"@en,
            "ROS 2 QoS 정책 문서"@ko ;
        ns1:sourceAccessedAt "2026-10-07"^^xsd:date ;
        ns1:sourceClaim "QoS profiles group history, depth, reliability and durability; sensor data favors timely recent samples, and endpoint profiles must be compatible."^^xsd:string ;
        ns1:sourceLanguage "en"^^xsd:string ;
        ns1:sourcePublisher "ROS 2 Documentation project"^^xsd:string ;
        ns1:sourceTitle "About Quality of Service settings"^^xsd:string ;
        ns1:sourceUri "https://github.com/ros2/ros2_documentation/blob/rolling/source/ROS-Framework/interfaces/topics/About-Quality-of-Service-Settings.rst"^^xsd:anyURI .

    <https://example.test/ros2/src-setbool> a ns1:DocumentationSource ;
