        ns1:sourceTitle "sensor_msgs README: Temperature"^^xsd:string ;
        ns1:sourceUri "https://github.com/ros2/common_interfaces/blob/rolling/sensor_msgs/README.md"^^xsd:anyURI .

    <https://example.test/ros2/src-rclcpp-qos> a ns1:DocumentationSource ;
