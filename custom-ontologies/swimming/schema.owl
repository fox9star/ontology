<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#stroke">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#SwimEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">영법</rdfs:label>
    <rdfs:label xml:lang="en">Stroke</rdfs:label>
    <rdfs:comment xml:lang="ko">freestyle, backstroke, breaststroke, butterfly, individual-medley 중 하나로 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">One of freestyle, backstroke, breaststroke, butterfly or individual-medley.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#Entry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">출전</rdfs:label>
    <rdfs:label xml:lang="en">Entry</rdfs:label>
    <rdfs:comment xml:lang="ko">한 선수가 한 종목에 출전한 기록 하나이다. 출전 신청, 공식 기록, 실격, 기권을 구분하며 상태에 따라 필요한 정보가 다르다.</rdfs:comment>
    <rdfs:comment xml:lang="en">One swimmer's entry in one event, distinguishing entered, official, disqualified and did-not-start states, each with its own required details.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#timingEvidenceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="ko">계시 증빙 주소</rdfs:label>
    <rdfs:label xml:lang="en">Timing evidence URI</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 기록이나 실격 판정을 확인할 수 있는 결과표의 위치이며 문서의 진위를 자동으로 보증하지 않는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Points to the results sheet or ruling behind an official result or disqualification; authenticity is not verified automatically.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#startDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Meet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="ko">대회 시작일</rdfs:label>
    <rdfs:label xml:lang="en">Meet start date</rdfs:label>
    <rdfs:comment xml:lang="ko">대회가 시작되는 날짜이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date the meet begins.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#eventCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#SwimEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">종목 부문</rdfs:label>
    <rdfs:label xml:lang="en">Event category</rdfs:label>
    <rdfs:comment xml:lang="ko">종목의 부문을 women 또는 men으로 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The category of the event, women or men.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#disqualificationReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">실격 사유</rdfs:label>
    <rdfs:label xml:lang="en">Disqualification reason</rdfs:label>
    <rdfs:comment xml:lang="ko">false-start, stroke-violation, turn-violation, finish-violation, other 중 하나이며 실격 상태에만 둔다.</rdfs:comment>
    <rdfs:comment xml:lang="en">One of false-start, stroke-violation, turn-violation, finish-violation or other, used only for a disqualification.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#laneCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Pool"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">레인 수</rdfs:label>
    <rdfs:label xml:lang="en">Lane count</rdfs:label>
    <rdfs:comment xml:lang="ko">수영장의 경기용 레인 수이며 1개 이상 12개 이하의 정수이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of racing lanes, an integer from 1 to 12.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#poolLengthMeters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Pool"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">수영장 길이 미터</rdfs:label>
    <rdfs:label xml:lang="en">Pool length in metres</rdfs:label>
    <rdfs:comment xml:lang="ko">수영장의 한 바퀴 길이를 25 또는 50 미터로 기록한다. 25m 기록과 50m 기록은 서로 비교하지 않는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The length of the pool, 25 or 50 metres; times from 25 m and 50 m pools are not compared with each other.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#seedTimeSeconds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">신청 기록 초</rdfs:label>
    <rdfs:label xml:lang="en">Seed time in seconds</rdfs:label>
    <rdfs:comment xml:lang="ko">출전 신청 때 낸 예상 기록을 초 단위 양의 소수로 기록하며 실제 결과가 아니다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The expected time submitted with the entry, as positive decimal seconds; it is not a result.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#splitTimeSeconds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Split"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">구간 누적 기록 초</rdfs:label>
    <rdfs:label xml:lang="en">Split cumulative time in seconds</rdfs:label>
    <rdfs:comment xml:lang="ko">출발부터 구간 거리까지의 누적 시간이다. 더 먼 구간일수록 커야 하고 종목 거리의 구간은 공식 기록과 같다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The cumulative time from the start to the split distance; it grows with distance, and the split at the full distance equals the final time.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#placeRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">순위</rdfs:label>
    <rdfs:label xml:lang="en">Place rank</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 기록의 종목 내 순위이며 1 이상의 정수이다. 더 빠른 기록이 더 낮은 순위일 수 없다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The place within the event for an official result, an integer from 1; a faster time cannot rank lower.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#splitDistanceMeters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Split"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">구간 거리 미터</rdfs:label>
    <rdfs:label xml:lang="en">Split distance in metres</rdfs:label>
    <rdfs:comment xml:lang="ko">구간 기록을 잰 누적 거리이며 수영장 길이의 배수이고 종목 거리를 넘을 수 없다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The cumulative distance at which the split was taken, a multiple of the pool length and not beyond the event distance.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#hasEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Meet"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/swimming#SwimEvent"/>
    <rdfs:label xml:lang="ko">개설 종목</rdfs:label>
    <rdfs:label xml:lang="en">Has event</rdfs:label>
    <rdfs:comment xml:lang="ko">대회가 여는 종목을 연결한다. 종목은 한 대회에만 속한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a meet to an event it offers; an event belongs to exactly one meet.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#competitionCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Swimmer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">경기 부문</rdfs:label>
    <rdfs:label xml:lang="en">Competition category</rdfs:label>
    <rdfs:comment xml:lang="ko">선수가 출전하는 부문을 women 또는 men으로 기록한다. 종목 부문과 같아야 출전할 수 있다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The category the swimmer competes in, women or men; it must match the event category to enter.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#entryStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">출전 상태</rdfs:label>
    <rdfs:label xml:lang="en">Entry status</rdfs:label>
    <rdfs:comment xml:lang="ko">entered(신청), official(공식 기록), disqualified(실격), did-not-start(기권) 중 하나이며 상태마다 필요한 정보가 다르다.</rdfs:comment>
    <rdfs:comment xml:lang="en">One of entered, official, disqualified or did-not-start, each with different required details.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#Swimmer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">선수</rdfs:label>
    <rdfs:label xml:lang="en">Swimmer</rdfs:label>
    <rdfs:comment xml:lang="ko">경기에 출전하는 수영 선수이다. 이름이나 생년월일 같은 개인정보는 담지 않고 가명 표시와 경기 부문만 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A competitive swimmer; no name or birth date is recorded, only a pseudonymous label and a competition category.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#distanceMeters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#SwimEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">종목 거리 미터</rdfs:label>
    <rdfs:label xml:lang="en">Event distance in metres</rdfs:label>
    <rdfs:comment xml:lang="ko">종목의 거리를 50, 100, 200, 400, 800, 1500 미터 중 하나로 기록하며 영법에 따라 가능한 거리가 다르다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The distance in metres: 50, 100, 200, 400, 800 or 1500, with the possible values depending on the stroke.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#forSwimmer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/swimming#Swimmer"/>
    <rdfs:label xml:lang="ko">출전 선수</rdfs:label>
    <rdfs:label xml:lang="en">For swimmer</rdfs:label>
    <rdfs:comment xml:lang="ko">출전 기록이 어느 선수의 것인지 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an entry to the swimmer who entered.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#Split">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">구간 기록</rdfs:label>
    <rdfs:label xml:lang="en">Split</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 기록의 중간 거리까지의 누적 시간이다. 수영장 길이의 배수 거리에서만 잰다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The cumulative time up to an intermediate distance of an official result, taken only at multiples of the pool length.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#finalTimeSeconds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">공식 기록 초</rdfs:label>
    <rdfs:label xml:lang="en">Final time in seconds</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 기록 상태에서만 두는 최종 기록으로 초 단위 양의 소수이다. 1분 5초 20은 65.20으로 적는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The final time of an official result, positive decimal seconds; 1:05.20 is written 65.20.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#Club">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">클럽</rdfs:label>
    <rdfs:label xml:lang="en">Club</rdfs:label>
    <rdfs:comment xml:lang="ko">선수가 소속된 수영 클럽이나 팀이다. 소속이 없는 선수도 있을 수 있다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A swimming club or team to which a swimmer belongs; a swimmer may have no club.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#hasSplit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/swimming#Split"/>
    <rdfs:label xml:lang="ko">구간 기록 연결</rdfs:label>
    <rdfs:label xml:lang="en">Has split</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 기록의 구간 기록을 연결한다. 구간 기록은 한 출전에만 속한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an official entry to one of its split times; a split belongs to exactly one entry.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#SwimEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">종목</rdfs:label>
    <rdfs:label xml:lang="en">Swim event</rdfs:label>
    <rdfs:comment xml:lang="ko">자유형 100m 같은 영법, 거리, 부문의 조합이며 한 대회에 속한다. 가능한 영법과 거리의 조합이 정해져 있다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A combination of stroke, distance and category, such as the 100 m freestyle for women, belonging to one meet; only certain stroke and distance combinations exist.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Meet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="ko">대회 종료일</rdfs:label>
    <rdfs:label xml:lang="en">Meet end date</rdfs:label>
    <rdfs:comment xml:lang="ko">대회가 끝나는 날짜이며 시작일보다 앞설 수 없다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date the meet ends; it cannot precede the start date.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#Meet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">대회</rdfs:label>
    <rdfs:label xml:lang="en">Meet</rdfs:label>
    <rdfs:comment xml:lang="ko">한 수영장에서 열리는 기간이 있는 대회이다. 하나 이상의 종목을 연다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A meet held in one pool over a period of days, offering one or more events.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#Pool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">수영장</rdfs:label>
    <rdfs:label xml:lang="en">Pool</rdfs:label>
    <rdfs:comment xml:lang="ko">대회가 열리는 수영장이다. 한 바퀴 길이가 25m 또는 50m이며 기록의 종류를 정한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The pool where a meet is held; its length of 25 m or 50 m decides the course of the recorded times.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#heldAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Meet"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/swimming#Pool"/>
    <rdfs:label xml:lang="ko">개최 수영장</rdfs:label>
    <rdfs:label xml:lang="en">Held at</rdfs:label>
    <rdfs:comment xml:lang="ko">대회가 열리는 수영장을 연결한다. 대회는 수영장 한 곳에서 열린다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a meet to the pool where it is held; a meet takes place in exactly one pool.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#inEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Entry"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/swimming#SwimEvent"/>
    <rdfs:label xml:lang="ko">출전 종목</rdfs:label>
    <rdfs:label xml:lang="en">In event</rdfs:label>
    <rdfs:comment xml:lang="ko">출전 기록이 어느 종목의 것인지 연결한다. 한 선수는 같은 종목에 한 번만 출전한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an entry to the event swum; a swimmer enters a given event only once.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming#memberOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/swimming#Swimmer"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/swimming#Club"/>
    <rdfs:label xml:lang="ko">소속 클럽</rdfs:label>
    <rdfs:label xml:lang="en">Member of</rdfs:label>
    <rdfs:comment xml:lang="ko">선수가 소속된 클럽을 연결한다. 선수는 클럽을 하나까지 가질 수 있다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a swimmer to the club they belong to; a swimmer has at most one club.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/swimming">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">수영 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">Swimming ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">경영(수영 경기)의 선수, 클럽, 대회, 수영장, 종목, 출전 결과와 구간 기록을 연결한다. 공식 기록과 실격에는 증빙 주소를 요구하며 같은 종목도 25m와 50m 수영장 기록을 구분한다. 예제는 가상의 선수와 대회만 담는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Connects competitive swimmers, clubs, meets, pools, events, entries and split times. Official results and disqualifications require an evidence location, and times in 25 m and 50 m pools are kept apart. The example contains only fictional swimmers and meets.</rdfs:comment>
    <owl:versionIRI rdf:resource="https://example.org/ontology/custom/swimming/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
