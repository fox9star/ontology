<https://example.test/consumer/marriage-reject> {
    <https://example.test/marriage/garden-plan> a ns1:MarriagePlan ;
        rdfs:label "Fictional garden wedding plan"@en,
            "가상 정원 결혼식 계획"@ko ;
        ns1:budgetAmount 1000000.0 ;
        ns1:coordinatedBy <https://example.test/marriage/garden-partner-a> ;
        ns1:currency "KRW" ;
        ns1:hasBooking <https://example.test/marriage/garden-booking01>,
