item:garden-plan a marriage:MarriagePlan ;
    rdfs:label "Fictional garden wedding plan"@en,
        "가상 정원 결혼식 계획"@ko ;
    marriage:budgetAmount 1000000.0 ;
    marriage:coordinatedBy item:garden-partner-a ;
    marriage:currency "KRW" ;
    marriage:hasBooking item:garden-booking01,
        item:garden-booking02,
        item:garden-booking03 ;
    marriage:hasCeremony item:garden-ceremony ;
    marriage:hasExpense item:garden-expense01,
        item:garden-expense02,
        item:garden-expense03 ;
    marriage:hasInvitation item:garden-invitation-01,
        item:garden-invitation-02 ;
    marriage:hasPartner item:garden-partner-a,
        item:garden-partner-b ;
    marriage:hasPerson item:garden-guest-a,
        item:garden-guest-b,
        item:garden-partner-a,
        item:garden-partner-b ;
    marriage:hasTask item:garden-task-01,
        item:garden-task-02,
        item:garden-task-03 ;
    marriage:marriageInfoStatus "unrecorded" ;
    marriage:planNote "온톨로지 탐색을 위한 가상 계획이며 실제 결혼·행사·예약·지불 기록이 아닙니다." ;
    marriage:recordKind "synthetic" ;
    marriage:status "draft" .

