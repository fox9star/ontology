<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#qualificationHasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ElectricalQualification"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#EvidenceRecord"/>
    <rdfs:label xml:lang="ko">근거 기록</rdfs:label>
    <rdfs:label xml:lang="en">has evidence</rdfs:label>
    <rdfs:comment xml:lang="ko">전기기능사 자격에서 근거 기록로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Electrical craftsman qualification to Evidence record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#ruleType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#AssessmentRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">기준 유형</rdfs:label>
    <rdfs:label xml:lang="en">rule type</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 기준의 기준 유형를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the rule type for Assessment rule.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#materialForStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#MaterialRequirement"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStage"/>
    <rdfs:label xml:lang="ko">적용 시험 단계</rdfs:label>
    <rdfs:label xml:lang="en">for exam stage</rdfs:label>
    <rdfs:comment xml:lang="ko">지참 재료·공구 요건에서 시험 단계로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Material or tool requirement to Exam stage.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#materialRestriction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#MaterialRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">사용 제한·비고</rdfs:label>
    <rdfs:label xml:lang="en">restriction or note</rdfs:label>
    <rdfs:comment xml:lang="ko">지참 재료·공구 요건의 사용 제한·비고를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the restriction or note for Material or tool requirement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#standardHasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStandardVersion"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#EvidenceRecord"/>
    <rdfs:label xml:lang="ko">기준 근거</rdfs:label>
    <rdfs:label xml:lang="en">has evidence</rdfs:label>
    <rdfs:comment xml:lang="ko">출제기준 버전에서 근거 기록로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Exam standard version to Evidence record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#materialSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#MaterialRequirement"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#SourceDocument"/>
    <rdfs:label xml:lang="ko">품목 출처</rdfs:label>
    <rdfs:label xml:lang="en">material source</rdfs:label>
    <rdfs:comment xml:lang="ko">지참 재료·공구 요건에서 공식 출처 문서로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Material or tool requirement to Source document.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#stageHasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStage"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#EvidenceRecord"/>
    <rdfs:label xml:lang="ko">시험 단계 근거</rdfs:label>
    <rdfs:label xml:lang="en">has evidence</rdfs:label>
    <rdfs:comment xml:lang="ko">시험 단계에서 근거 기록로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Exam stage to Evidence record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#ruleMaximumScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#AssessmentRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">만점</rdfs:label>
    <rdfs:label xml:lang="en">maximum score</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 기준의 만점를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the maximum score for Assessment rule.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#evidenceScopeNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">근거 범위·한계</rdfs:label>
    <rdfs:label xml:lang="en">evidence scope and limits</rdfs:label>
    <rdfs:comment xml:lang="ko">근거 기록의 근거 범위·한계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the evidence scope and limits for Evidence record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#Competency">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">직무 역량</rdfs:label>
    <rdfs:label xml:lang="en">Competency</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 시험 범위와 구별하여 기록하는 능력 또는 수행 역량이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A capability recorded separately from the official exam scope and linked to evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#ruleAppliesToStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#AssessmentRule"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStage"/>
    <rdfs:label xml:lang="ko">적용 시험 단계</rdfs:label>
    <rdfs:label xml:lang="en">applies to stage</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 기준에서 시험 단계로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Assessment rule to Exam stage.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#materialIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#MaterialRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">품목 식별자</rdfs:label>
    <rdfs:label xml:lang="en">material identifier</rdfs:label>
    <rdfs:comment xml:lang="ko">지참 재료·공구 요건의 품목 식별자를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the material identifier for Material or tool requirement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#safetyLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#SafetyRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">큐넷 게시 안전 등급</rdfs:label>
    <rdfs:label xml:lang="en">Q-Net published safety level</rdfs:label>
    <rdfs:comment xml:lang="ko">실기 안전 요건의 큐넷 게시 안전 등급를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the Q-Net published safety level for Practical safety requirement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#materialHasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#MaterialRequirement"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#EvidenceRecord"/>
    <rdfs:label xml:lang="ko">품목 근거</rdfs:label>
    <rdfs:label xml:lang="en">has evidence</rdfs:label>
    <rdfs:comment xml:lang="ko">지참 재료·공구 요건에서 근거 기록로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Material or tool requirement to Evidence record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#standardValidThrough">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStandardVersion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="ko">적용 종료일</rdfs:label>
    <rdfs:label xml:lang="en">valid through</rdfs:label>
    <rdfs:comment xml:lang="ko">출제기준 버전의 적용 종료일를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the valid through for Exam standard version.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#materialCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#MaterialRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">품목 분류</rdfs:label>
    <rdfs:label xml:lang="en">material category</rdfs:label>
    <rdfs:comment xml:lang="ko">지참 재료·공구 요건의 품목 분류를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the material category for Material or tool requirement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#stageChoiceCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">선택지 수</rdfs:label>
    <rdfs:label xml:lang="en">choice count</rdfs:label>
    <rdfs:comment xml:lang="ko">시험 단계의 선택지 수를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the choice count for Exam stage.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#ElectricalQualification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">전기기능사 자격</rdfs:label>
    <rdfs:label xml:lang="en">Electrical craftsman qualification</rdfs:label>
    <rdfs:comment xml:lang="ko">전기설비 분야의 국가기술자격 종목과 공식 시험·운영 정보를 나타낸다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents the Korean national technical qualification, including its administering body and source-backed exam information.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#qualificationHasStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ElectricalQualification"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStage"/>
    <rdfs:label xml:lang="ko">시험 단계</rdfs:label>
    <rdfs:label xml:lang="en">has exam stage</rdfs:label>
    <rdfs:comment xml:lang="ko">전기기능사 자격에서 시험 단계로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Electrical craftsman qualification to Exam stage.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#SourceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">공식 출처 문서</rdfs:label>
    <rdfs:label xml:lang="en">Source document</rdfs:label>
    <rdfs:comment xml:lang="ko">자격·시험·출제기준·공개문제·지참준비물에 대한 공식 출처와 그 한계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records an official source for qualification, exam, standards, public tasks, or required materials, together with its limits.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#sourceLimitations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#SourceDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">출처 한계</rdfs:label>
    <rdfs:label xml:lang="en">source limitations</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 출처 문서의 출처 한계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the source limitations for Source document.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#KnowledgeArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">필기 지식 영역</rdfs:label>
    <rdfs:label xml:lang="en">Knowledge area</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 시험 정보에 명시된 필기 시험의 과목 또는 지식 영역이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A written-exam subject or knowledge area explicitly named in official exam information.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#sourcePublisher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#SourceDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">발행·운영 기관</rdfs:label>
    <rdfs:label xml:lang="en">publisher</rdfs:label>
    <rdfs:comment xml:lang="ko">공식 출처 문서의 발행·운영 기관를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the publisher for Source document.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#ruleDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#AssessmentRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">기준 설명</rdfs:label>
    <rdfs:label xml:lang="en">rule description</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 기준의 기준 설명를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the rule description for Assessment rule.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#practicalTaskPreferredLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#PracticalTask"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">실기 과제 이름</rdfs:label>
    <rdfs:label xml:lang="en">practical task label</rdfs:label>
    <rdfs:comment xml:lang="ko">실기 수행 과제의 실기 과제 이름를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the practical task label for Practical task.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#stagePreferredLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ExamStage"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">시험 단계명</rdfs:label>
    <rdfs:label xml:lang="en">stage label</rdfs:label>
    <rdfs:comment xml:lang="ko">시험 단계의 시험 단계명를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the stage label for Exam stage.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#PracticalTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">실기 수행 과제</rdfs:label>
    <rdfs:label xml:lang="en">Practical task</rdfs:label>
    <rdfs:comment xml:lang="ko">큐넷이 안내한 실기 작업의 범위 또는 과제 유형이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A practical-work scope or task type described by Q-Net.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#SafetyRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">실기 안전 요건</rdfs:label>
    <rdfs:label xml:lang="en">Practical safety requirement</rdfs:label>
    <rdfs:comment xml:lang="ko">실기시험에서 게시된 보호구, 금지사항, 안전 채점 또는 안전 등급 문구를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records published practical PPE, prohibitions, safety scoring, or a stated safety-level label.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electricity-craftsman#qualificationAdministeringBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electricity-craftsman#ElectricalQualification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">시행 기관</rdfs:label>
    <rdfs:label xml:lang="en">administering body</rdfs:label>
