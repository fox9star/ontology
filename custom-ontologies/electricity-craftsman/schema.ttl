    rdfs:domain ec:EvidenceRecord ;
    rdfs:range xsd:string .

ec:evidenceStatus a owl:DatatypeProperty ;
    rdfs:label "evidence status"@en,
        "검증 상태"@ko ;
    rdfs:comment "Records the evidence status for Evidence record."@en,
        "근거 기록의 검증 상태를 기록한다."@ko ;
    rdfs:domain ec:EvidenceRecord ;
    rdfs:range xsd:string .

ec:evidenceValidThrough a owl:DatatypeProperty ;
    rdfs:label "verified through"@en,
        "확인된 적용 종료일"@ko ;
    rdfs:comment "Records the verified through for Evidence record."@en,
        "근거 기록의 확인된 적용 종료일를 기록한다."@ko ;
    rdfs:domain ec:EvidenceRecord ;
    rdfs:range xsd:date .

ec:knowledgeAreaDescription a owl:DatatypeProperty ;
