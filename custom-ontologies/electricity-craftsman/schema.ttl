@prefix ec: <https://example.org/ontology/custom/electricity-craftsman#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ec: a owl:Ontology ;
    rdfs:label "Electricity Craftsman Qualification Ontology"@en,
        "전기기능사 온톨로지"@ko ;
    rdfs:comment "A draft connecting Q-Net electricity-craftsman exam facts to provenance and validity periods. Detailed learning criteria are managed with explicit version and review status."@en,
        "큐넷의 전기기능사 시험 정보와 출처·적용기간을 연결하는 초안이다. 상세 학습 기준은 버전별 검토 상태와 함께 관리한다."@ko ;
    owl:versionInfo "0.1.0" .

ec:competencyDescription a owl:DatatypeProperty ;
    rdfs:label "competency description"@en,
        "역량 설명"@ko ;
    rdfs:comment "Records the competency description for Competency."@en,
        "직무 역량의 역량 설명를 기록한다."@ko ;
    rdfs:domain ec:Competency ;
    rdfs:range rdf:langString .

ec:competencyEvidence a owl:ObjectProperty ;
    rdfs:label "competency evidence"@en,
        "역량 근거"@ko ;
    rdfs:comment "Records a relation from Competency to Evidence record."@en,
        "직무 역량에서 근거 기록로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain ec:Competency ;
    rdfs:range ec:EvidenceRecord .

ec:competencyIdentifier a owl:DatatypeProperty ;
    rdfs:label "competency identifier"@en,
        "역량 식별자"@ko ;
    rdfs:comment "Records the competency identifier for Competency."@en,
        "직무 역량의 역량 식별자를 기록한다."@ko ;
    rdfs:domain ec:Competency ;
    rdfs:range xsd:string .

ec:competencyPreferredLabel a owl:DatatypeProperty ;
    rdfs:label "competency label"@en,
        "역량 이름"@ko ;
    rdfs:comment "Records the competency label for Competency."@en,
        "직무 역량의 역량 이름를 기록한다."@ko ;
    rdfs:domain ec:Competency ;
    rdfs:range rdf:langString .

ec:competencyRelatedTask a owl:ObjectProperty ;
    rdfs:label "related practical task"@en,
        "관련 실기 과제"@ko ;
    rdfs:comment "Records a relation from Competency to Practical task."@en,
        "직무 역량에서 실기 수행 과제로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain ec:Competency ;
    rdfs:range ec:PracticalTask .

ec:competencySource a owl:ObjectProperty ;
    rdfs:label "competency source"@en,
        "역량 출처"@ko ;
    rdfs:comment "Records a relation from Competency to Source document."@en,
        "직무 역량에서 공식 출처 문서로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain ec:Competency ;
    rdfs:range ec:SourceDocument .

ec:evidenceClaim a owl:DatatypeProperty ;
    rdfs:label "supported claim"@en,
        "근거가 뒷받침하는 주장"@ko ;
    rdfs:comment "Records the supported claim for Evidence record."@en,
        "근거 기록의 근거가 뒷받침하는 주장를 기록한다."@ko ;
    rdfs:domain ec:EvidenceRecord ;
    rdfs:range rdf:langString .

ec:evidenceIdentifier a owl:DatatypeProperty ;
    rdfs:label "evidence identifier"@en,
        "근거 식별자"@ko ;
    rdfs:comment "Records the evidence identifier for Evidence record."@en,
        "근거 기록의 근거 식별자를 기록한다."@ko ;
    rdfs:domain ec:EvidenceRecord ;
    rdfs:range xsd:string .

ec:evidenceObservedAt a owl:DatatypeProperty ;
    rdfs:label "observed at"@en,
        "확인 시점"@ko ;
    rdfs:comment "Records the observed at for Evidence record."@en,
        "근거 기록의 확인 시점를 기록한다."@ko ;
    rdfs:domain ec:EvidenceRecord ;
    rdfs:range xsd:date .

ec:evidenceScopeNote a owl:DatatypeProperty ;
    rdfs:label "evidence scope and limits"@en,
