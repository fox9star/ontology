ec:Competency a owl:Class ;
    rdfs:label "Competency"@en,
        "직무 역량"@ko ;
    rdfs:comment "A capability recorded separately from the official exam scope and linked to evidence."@en,
        "공식 시험 범위와 구별하여 기록하는 능력 또는 수행 역량이다."@ko .

ec:KnowledgeArea a owl:Class ;
    rdfs:label "Knowledge area"@en,
        "필기 지식 영역"@ko ;
    rdfs:comment "A written-exam subject or knowledge area explicitly named in official exam information."@en,
        "공식 시험 정보에 명시된 필기 시험의 과목 또는 지식 영역이다."@ko .

ec:AssessmentRule a owl:Class ;
    rdfs:label "Assessment rule"@en,
        "평가 기준"@ko ;
    rdfs:comment "A score threshold, item format, or time condition for an exam stage."@en,
        "시험 단계의 점수 기준, 문항 형식 또는 시간 조건을 나타낸다."@ko .

ec:PracticalTask a owl:Class ;
    rdfs:label "Practical task"@en,
        "실기 수행 과제"@ko ;
    rdfs:comment "A practical-work scope or task type described by Q-Net."@en,
        "큐넷이 안내한 실기 작업의 범위 또는 과제 유형이다."@ko .

ec:SafetyRequirement a owl:Class ;
    rdfs:label "Practical safety requirement"@en,
        "실기 안전 요건"@ko ;
    rdfs:comment "Records published practical PPE, prohibitions, safety scoring, or a stated safety-level label."@en,
        "실기시험에서 게시된 보호구, 금지사항, 안전 채점 또는 안전 등급 문구를 기록한다."@ko .

ec:MaterialRequirement a owl:Class ;
    rdfs:label "Material or tool requirement"@en,
        "지참 재료·공구 요건"@ko ;
    rdfs:comment "Records a Q-Net listed practical item, specification, quantity, and any stated restriction."@en,
        "실기시험에서 큐넷이 게시한 지참 품목, 규격, 수량, 사용 제한을 기록한다."@ko .

ec:ElectricalQualification a owl:Class ;
    rdfs:label "Electrical craftsman qualification"@en,
        "전기기능사 자격"@ko ;
    rdfs:comment "Represents the Korean national technical qualification, including its administering body and source-backed exam information."@en,
        "전기설비 분야의 국가기술자격 종목과 공식 시험·운영 정보를 나타낸다."@ko .

ec:ExamStandardVersion a owl:Class ;
    rdfs:label "Exam standard version"@en,
        "출제기준 버전"@ko ;
    rdfs:comment "Records an exam standard's applicability period, publication state, and whether its detailed content has been ingested."@en,
        "적용 시작일과 종료일, 발표 상태, 세부 기준의 반영 상태를 기록한다."@ko .

ec:EvidenceRecord a owl:Class ;
    rdfs:label "Evidence record"@en,
        "근거 기록"@ko ;
    rdfs:comment "Records a source, observation date, scope, and review status for a specific claim."@en,
        "특정 사실의 근거 출처, 확인 시점, 적용 범위, 검토 상태를 기록한다."@ko .

ec:SourceDocument a owl:Class ;
    rdfs:label "Source document"@en,
        "공식 출처 문서"@ko ;
    rdfs:comment "Records an official source for qualification, exam, standards, public tasks, or required materials, together with its limits."@en,
        "자격·시험·출제기준·공개문제·지참준비물에 대한 공식 출처와 그 한계를 기록한다."@ko .

ec:ExamStage a owl:Class ;
    rdfs:label "Exam stage"@en,
        "시험 단계"@ko ;
    rdfs:comment "Represents an assessment stage such as the written or practical examination and its published method."@en,
        "필기 또는 실기처럼 시험의 평가 단계와 검정 방법을 나타낸다."@ko .
