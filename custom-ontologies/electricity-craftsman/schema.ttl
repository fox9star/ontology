ec:evidenceSource a owl:ObjectProperty ;
    rdfs:label "evidence source"@en,
        "근거 출처"@ko ;
    rdfs:comment "Records a relation from Evidence record to Source document."@en,
        "근거 기록에서 공식 출처 문서로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain ec:EvidenceRecord ;
    rdfs:range ec:SourceDocument .

ec:evidenceSourceLocator a owl:DatatypeProperty ;
    rdfs:label "source locator"@en,
        "출처 내 위치"@ko ;
    rdfs:comment "Records the source locator for Evidence record."@en,
