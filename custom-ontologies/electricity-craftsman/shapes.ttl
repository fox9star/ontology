ec:MaterialRequirementShape a sh:NodeShape ;
    sh:message "지참 재료·공구 요건의 필수 값, 자료형, 허용 값을 확인하세요."@ko ;
    sh:property [ sh:datatype rdf:langString ;
            sh:message "규격의 자료형과 허용값을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ec:materialSpecification ],
        [ sh:datatype rdf:langString ;
            sh:message "품목명의 자료형과 허용값을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ec:materialPreferredLabel ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "수량의 자료형과 허용값을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path ec:materialQuantity ],
        [ sh:datatype xsd:string ;
            sh:in ( "tool"^^xsd:string "marking"^^xsd:string "PPE"^^xsd:string "other"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "품목 분류의 자료형과 허용값을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ec:materialCategory ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "단위의 자료형과 허용값을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ec:materialUnit ],
        [ sh:class ec:ExamStage ;
            sh:maxCount 1 ;
            sh:message "적용 시험 단계의 자료형과 허용값을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path ec:materialForStage ],
        [ sh:class ec:SourceDocument ;
            sh:maxCount 1 ;
            sh:message "품목 출처의 자료형과 허용값을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path ec:materialSource ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "품목 식별자의 자료형과 허용값을 확인하세요."@ko ;
