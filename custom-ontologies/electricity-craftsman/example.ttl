    ec:rulePreferredLabel "At least 60 out of 100 on written stage"@en,
        "필기 100점 중 60점 이상"@ko ;
    ec:ruleSource ec:qnet-exam-details ;
    ec:ruleType "minimum_score"^^xsd:string .

ec:safety-level-label a ec:SafetyRequirement ;
    rdfs:label "Q-Net published safety level 4"@en,
        "큐넷 게시 안전등급 4"@ko ;
    ec:safetyForStage ec:stage-practical ;
    ec:safetyHasEvidence ec:evidence-practical-safety ;
    ec:safetyIdentifier "safety-level-label"^^xsd:string ;
    ec:safetyLevel 4 ;
    ec:safetyPreferredLabel "Q-Net published safety level 4"@en,
        "큐넷 게시 안전등급 4"@ko ;
    ec:safetyRequirementType "published_level"^^xsd:string ;
    ec:safetySource ec:qnet-exam-details ;
    ec:safetyText "Records the level number as published by Q-Net without interpreting it as another risk scale."@en,
        "큐넷 페이지에 게시된 등급 숫자 그대로 기록하며 별도의 위험 척도로 해석하지 않는다."@ko .

ec:safety-score a ec:SafetyRequirement ;
    rdfs:label "Safety and housekeeping scoring"@en,
        "안전·정리정돈 채점"@ko ;
    ec:safetyForStage ec:stage-practical ;
    ec:safetyHasEvidence ec:evidence-practical-safety ;
    ec:safetyIdentifier "safety-score"^^xsd:string ;
    ec:safetyPreferredLabel "Safety and housekeeping scoring"@en,
