    ec:safetyText "Work clothing, housekeeping, and safety may be included in scoring."@en,
        "작업복 착용, 정리정돈, 안전사항 등이 채점 대상이 될 수 있다."@ko .

ec:standard-2027-2029 a ec:ExamStandardVersion ;
    rdfs:label "Electricity Craftsman standard 2027-2029"@en,
        "전기기능사 출제기준 2027-2029"@ko ;
    ec:standardContentStatus "not_ingested"^^xsd:string ;
    ec:standardHasEvidence ec:evidence-standard-future ;
    ec:standardIdentifier "electricity-craftsman-2027-2029"^^xsd:string ;
    ec:standardNote "Q-Net lists the title and applicability period. Detailed items and changes from the 2026 standard are not asserted until the source document is reviewed."@en,
        "큐넷 페이지에서 명칭과 적용기간을 확인했다. 세부 출제 항목과 2026년 기준 대비 변경사항은 원문 검토 전까지 주장하지 않는다."@ko ;
    ec:standardPreferredLabel "Electricity Craftsman Exam Standard 2027-2029"@en,
        "전기기능사 출제기준 (2027.1.1~2029.12.31)"@ko ;
    ec:standardSource ec:qnet-standard-2027 ;
    ec:standardStatus "scheduled"^^xsd:string ;
    ec:standardValidFrom "2027-01-01"^^xsd:date ;
    ec:standardValidThrough "2029-12-31"^^xsd:date .

