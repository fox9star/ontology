ec:qualification-electricity-craftsman a ec:ElectricalQualification ;
    rdfs:label "Craftsman Electricity"@en,
        "전기기능사"@ko ;
    ec:qualificationAdministeringBody "한국산업인력공단"^^xsd:string ;
    ec:qualificationAlternativeLabel "Electricity Craftsman"@en ;
    ec:qualificationCategory "국가기술자격 기능사"^^xsd:string ;
    ec:qualificationHasEvidence ec:evidence-exam-structure,
        ec:evidence-materials-list,
        ec:evidence-pass-thresholds,
        ec:evidence-practical-format,
        ec:evidence-practical-safety,
        ec:evidence-practical-scope,
        ec:evidence-public-task,
        ec:evidence-qualification-identity,
        ec:evidence-standard-current,
        ec:evidence-standard-future,
        ec:evidence-written-format ;
    ec:qualificationHasSource ec:qnet-exam-details,
        ec:qnet-materials,
        ec:qnet-public-task-2025,
        ec:qnet-qualification,
        ec:qnet-standard-2024,
        ec:qnet-standard-2027 ;
    ec:qualificationHasStage ec:stage-practical,
        ec:stage-written ;
    ec:qualificationHasStandard ec:standard-2024-2026,
        ec:standard-2027-2029 ;
    ec:qualificationIdentifier "electricity-craftsman"^^xsd:string ;
    ec:qualificationPreferredLabel "Craftsman Electricity"@en,
        "전기기능사"@ko ;
    ec:qualificationQnetCode "7780"^^xsd:string ;
    ec:qualificationRelatedMinistry "기후에너지환경부"^^xsd:string ;
    ec:qualificationStatus "draft"^^xsd:string .

ec:competency-installation a ec:Competency ;
    rdfs:label "Electrical installation work"@en,
        "전기설비 작업 수행"@ko ;
    ec:competencyDescription "A capability linked to the published practical scope for conduit and wiring work; it does not provide real-world installation instructions."@en,
        "공개된 실기 출제경향의 배관·배선공사 범위와 연결되는 작업 역량이다. 실제 시공 절차 지침은 포함하지 않는다."@ko ;
    ec:competencyEvidence ec:evidence-practical-scope ;
    ec:competencyIdentifier "electrical-installation-work"^^xsd:string ;
    ec:competencyPreferredLabel "Electrical installation work"@en,
        "전기설비 작업 수행"@ko ;
    ec:competencyRelatedTask ec:task-conduit-wiring ;
    ec:competencySource ec:qnet-exam-details .

ec:competency-sequence a ec:Competency ;
    rdfs:label "Sequence-control circuit assembly"@en,
        "시퀀스 제어회로 구성"@ko ;
    ec:competencyDescription "A capability linked to completing the sequence-control circuit named in the Q-Net practical scope."@en,
        "큐넷 출제경향에 명시된 시퀀스 제어회로 완성 작업과 연결되는 역량이다."@ko ;
    ec:competencyEvidence ec:evidence-practical-scope ;
    ec:competencyIdentifier "sequence-control-circuit"^^xsd:string ;
    ec:competencyPreferredLabel "Sequence-control circuit assembly"@en,
        "시퀀스 제어회로 구성"@ko ;
    ec:competencyRelatedTask ec:task-sequence-control ;
    ec:competencySource ec:qnet-exam-details .

ec:evidence-public-task a ec:EvidenceRecord ;
    rdfs:label "The public-task page identifies a 2025-08-04 revision applied from the 2025 Craftsman third exam round."@en,
        "공개문제 페이지는 2025-08-04 수정본과 2025년 기능사 제3회부터의 적용시점을 안내한다."@ko ;
    ec:evidenceClaim "The public-task page identifies a 2025-08-04 revision applied from the 2025 Craftsman third exam round."@en,
        "공개문제 페이지는 2025-08-04 수정본과 2025년 기능사 제3회부터의 적용시점을 안내한다."@ko ;
    ec:evidenceIdentifier "evidence-public-task"^^xsd:string ;
    ec:evidenceObservedAt "2026-10-08"^^xsd:date ;
    ec:evidenceScopeNote "공개문제는 변경될 수 있다는 페이지 안내를 함께 기록한다."@en,
        "공개문제는 변경될 수 있다는 페이지 안내를 함께 기록한다."@ko ;
    ec:evidenceSource ec:qnet-public-task-2025 ;
    ec:evidenceSourceLocator "공개문제 본문 > 적용시기 및 수정 내역"^^xsd:string ;
    ec:evidenceStatus "verified_as_of_access"^^xsd:string .

ec:evidence-qualification-identity a ec:EvidenceRecord ;
    rdfs:label "Q-Net lists Craftsman Electricity, item code 7780, HRD Korea as the administering body, and the Ministry of Climate, Energy and Environment as the related ministry."@en,
        "큐넷은 종목을 전기기능사(Craftsman Electricity), 코드 7780, 시행기관 한국산업인력공단, 관련 부처 기후에너지환경부로 표시한다."@ko ;
    ec:evidenceClaim "Q-Net lists Craftsman Electricity, item code 7780, HRD Korea as the administering body, and the Ministry of Climate, Energy and Environment as the related ministry."@en,
        "큐넷은 종목을 전기기능사(Craftsman Electricity), 코드 7780, 시행기관 한국산업인력공단, 관련 부처 기후에너지환경부로 표시한다."@ko ;
    ec:evidenceIdentifier "evidence-qualification-identity"^^xsd:string ;
    ec:evidenceObservedAt "2026-10-08"^^xsd:date ;
    ec:evidenceScopeNote "공식 페이지를 2026-10-08 확인한 사실 스냅샷이다."@en,
        "공식 페이지를 2026-10-08 확인한 사실 스냅샷이다."@ko ;
    ec:evidenceSource ec:qnet-qualification ;
    ec:evidenceSourceLocator "국가자격 종목별 상세정보 > 전기기능사"^^xsd:string ;
    ec:evidenceStatus "verified_as_of_access"^^xsd:string .

ec:rule-practical-pass a ec:AssessmentRule ;
    rdfs:label "Practical pass threshold"@en,
        "실기 합격 기준"@ko ;
    ec:ruleAppliesToStage ec:stage-practical ;
    ec:ruleDescription "The practical-stage pass threshold listed on the current Q-Net detail page."@en,
        "큐넷 현재 상세 페이지에 게시된 실기 합격 기준이다."@ko ;
    ec:ruleHasEvidence ec:evidence-pass-thresholds ;
    ec:ruleIdentifier "practical-pass-60"^^xsd:string ;
    ec:ruleMaximumScore 100.0 ;
    ec:ruleMinimumScore 60.0 ;
    ec:rulePreferredLabel "At least 60 out of 100 on practical stage"@en,
        "실기 100점 중 60점 이상"@ko ;
    ec:ruleSource ec:qnet-exam-details ;
    ec:ruleType "minimum_score"^^xsd:string .

ec:rule-written-pass a ec:AssessmentRule ;
    rdfs:label "Written pass threshold"@en,
        "필기 합격 기준"@ko ;
    ec:ruleAppliesToStage ec:stage-written ;
    ec:ruleDescription "The written-stage pass threshold listed on the current Q-Net detail page."@en,
        "큐넷 현재 상세 페이지에 게시된 필기 합격 기준이다."@ko ;
    ec:ruleHasEvidence ec:evidence-pass-thresholds ;
    ec:ruleIdentifier "written-pass-60"^^xsd:string ;
