    <rdfs:comment xml:lang="ko">SourceDocument의 출처 범위와 주의를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#OnboardCharger">
