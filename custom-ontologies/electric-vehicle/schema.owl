    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#ResourceRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">자원 기록</rdfs:label>
    <rdfs:label xml:lang="en">Resource record</rdfs:label>
    <rdfs:comment xml:lang="ko">식별자와 다국어 이름을 가진 온톨로지 자원이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A named ontology resource with a stable local identifier.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#sessionVehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ChargingSession"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electric-vehicle#Vehicle"/>
    <rdfs:label xml:lang="ko">충전 차량</rdfs:label>
    <rdfs:label xml:lang="en">vehicle in session</rdfs:label>
    <rdfs:comment xml:lang="en">Records vehicle in session for ChargingSession.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ChargingSession의 충전 차량를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#ChargingSession">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">충전 세션</rdfs:label>
    <rdfs:label xml:lang="en">Charging session</rdfs:label>
    <rdfs:comment xml:lang="ko">차량, EVSE 포트와 커넥터가 관여하는 한 번의 충전 과정 기록이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A record of one charging interaction involving a vehicle, EVSE port, and connector.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#energyFlowHasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EnergyFlow"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electric-vehicle#EvidenceRecord"/>
    <rdfs:label xml:lang="ko">에너지 흐름 근거</rdfs:label>
    <rdfs:label xml:lang="en">energy-flow evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Records energy-flow evidence for EnergyFlow.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EnergyFlow의 에너지 흐름 근거를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#AuxiliaryBattery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">보조 배터리</rdfs:label>
    <rdfs:label xml:lang="en">Auxiliary battery</rdfs:label>
    <rdfs:comment xml:lang="ko">차량 액세서리와 저전압 보조 부하에 전력을 공급한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Supplies vehicle accessories and low-voltage auxiliary loads.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#Vehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">차량</rdfs:label>
    <rdfs:label xml:lang="en">Vehicle</rdfs:label>
    <rdfs:comment xml:lang="ko">동력원과 구동계 구성을 기록하는 차량 또는 차량 유형이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A vehicle or vehicle archetype whose propulsion and drivetrain are described.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#componentFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">구성품 기능</rdfs:label>
    <rdfs:label xml:lang="en">component function</rdfs:label>
    <rdfs:comment xml:lang="en">Records component function for PowertrainComponent.</rdfs:comment>
    <rdfs:comment xml:lang="ko">PowertrainComponent의 구성품 기능를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#portSingleVehicleAtATime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EVSEPort"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="ko">동시 충전 차량 제한</rdfs:label>
    <rdfs:label xml:lang="en">supplies one vehicle at a time</rdfs:label>
    <rdfs:comment xml:lang="en">Records supplies one vehicle at a time for EVSEPort.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EVSEPort의 동시 충전 차량 제한를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#ElectrifiedVehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">전동화 차량</rdfs:label>
    <rdfs:label xml:lang="en">Electrified vehicle</rdfs:label>
    <rdfs:comment xml:lang="ko">전기 구동 요소를 사용하는 차량 범주다. 일상어의 EV와 플러그인 전기차 범주를 구별한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A vehicle category using electric-drive elements; colloquial EV usage is distinct from plug-in vehicle categories.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#Vehicle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#BatteryElectricVehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">배터리 전기차</rdfs:label>
    <rdfs:label xml:lang="en">Battery electric vehicle</rdfs:label>
    <rdfs:comment xml:lang="ko">주행용 배터리와 전기 모터로 구동되는 플러그인 차량 유형이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A plug-in vehicle archetype propelled by an electric motor using traction-battery energy.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ElectrifiedVehicle"/>
  </rdf:Description>
</rdf:RDF>
