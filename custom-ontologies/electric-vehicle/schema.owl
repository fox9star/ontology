    <rdfs:comment xml:lang="en">A vehicle archetype combining combustion and electric drive that is not plugged into off-board electricity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ElectrifiedVehicle"/>
  </rdf:Description>
