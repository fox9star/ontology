    <rdfs:comment xml:lang="ko">ChargingSession의 충전 포트를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#energyFlowDestination">
