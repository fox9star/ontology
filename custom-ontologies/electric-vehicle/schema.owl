<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#SourceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">출처 문서</rdfs:label>
    <rdfs:label xml:lang="en">Source document</rdfs:label>
    <rdfs:comment xml:lang="ko">발행기관, URL, 확인일과 서술 범위를 보존한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Preserves a source's publisher, URL, access date, and scope.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#EVSEPort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">EVSE 충전 포트</rdfs:label>
    <rdfs:label xml:lang="en">EVSE port</rdfs:label>
    <rdfs:comment xml:lang="ko">한 번에 한 차량에 전력을 공급하는 설비 측 포트다. 한 포트에 여러 커넥터가 있을 수 있다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The equipment-side port that supplies one vehicle at a time; one port may have multiple connectors.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#VehicleChargePort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">차량 충전구</rdfs:label>
    <rdfs:label xml:lang="en">Vehicle charge port</rdfs:label>
    <rdfs:comment xml:lang="ko">외부 충전 설비와 차량을 연결하는 차량 측 인터페이스다.</rdfs:comment>
    <rdfs:comment xml:lang="en">The vehicle-side interface connecting external charging equipment to the vehicle.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#connectorDataStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ChargingConnector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">데이터 상태</rdfs:label>
    <rdfs:label xml:lang="en">data status</rdfs:label>
    <rdfs:comment xml:lang="en">Records data status for ChargingConnector.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ChargingConnector의 데이터 상태를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#recordIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">기록 식별자</rdfs:label>
    <rdfs:label xml:lang="en">record identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Records record identifier for ResourceRecord.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ResourceRecord의 기록 식별자를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#portHasConnector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EVSEPort"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electric-vehicle#ChargingConnector"/>
    <rdfs:label xml:lang="ko">커넥터</rdfs:label>
    <rdfs:label xml:lang="en">has connector</rdfs:label>
    <rdfs:comment xml:lang="en">Records has connector for EVSEPort.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EVSEPort의 커넥터를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#vehiclePowertrainConfiguration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#Vehicle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">동력 구성</rdfs:label>
    <rdfs:label xml:lang="en">powertrain configuration</rdfs:label>
    <rdfs:comment xml:lang="en">Records powertrain configuration for Vehicle.</rdfs:comment>
    <rdfs:comment xml:lang="ko">Vehicle의 동력 구성를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#stationDataStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ChargingStationLocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">데이터 상태</rdfs:label>
    <rdfs:label xml:lang="en">data status</rdfs:label>
    <rdfs:comment xml:lang="en">Records data status for ChargingStationLocation.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ChargingStationLocation의 데이터 상태를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#connectorInterfaceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ChargingConnector"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">인터페이스 유형</rdfs:label>
    <rdfs:label xml:lang="en">interface type</rdfs:label>
    <rdfs:comment xml:lang="en">Records interface type for ChargingConnector.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ChargingConnector의 인터페이스 유형를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#energyFlowCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EnergyFlow"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">흐름 조건</rdfs:label>
    <rdfs:label xml:lang="en">flow condition</rdfs:label>
    <rdfs:comment xml:lang="en">Records flow condition for EnergyFlow.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EnergyFlow의 흐름 조건를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#evidenceLocator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">출처 내 위치</rdfs:label>
    <rdfs:label xml:lang="en">source locator</rdfs:label>
    <rdfs:comment xml:lang="en">Records source locator for EvidenceRecord.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EvidenceRecord의 출처 내 위치를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#ElectricTractionMotor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">전기 구동 모터</rdfs:label>
    <rdfs:label xml:lang="en">Electric traction motor</rdfs:label>
    <rdfs:comment xml:lang="ko">전기 에너지를 바퀴 구동력으로 변환하며 일부 차량에서 회생 기능도 수행한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Converts electrical energy into wheel propulsion and may also perform regeneration.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#sessionState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ChargingSession"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">세션 상태</rdfs:label>
    <rdfs:label xml:lang="en">session state</rdfs:label>
    <rdfs:comment xml:lang="en">Records session state for ChargingSession.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ChargingSession의 세션 상태를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#sourceTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#SourceDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">출처 제목</rdfs:label>
    <rdfs:label xml:lang="en">source title</rdfs:label>
    <rdfs:comment xml:lang="en">Records source title for SourceDocument.</rdfs:comment>
    <rdfs:comment xml:lang="ko">SourceDocument의 출처 제목를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#vehicleHasComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#Vehicle"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent"/>
    <rdfs:label xml:lang="ko">구성품</rdfs:label>
    <rdfs:label xml:lang="en">has component</rdfs:label>
    <rdfs:comment xml:lang="en">Records has component for Vehicle.</rdfs:comment>
    <rdfs:comment xml:lang="ko">Vehicle의 구성품를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#sourceAccessedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#SourceDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="ko">확인일</rdfs:label>
    <rdfs:label xml:lang="en">accessed on</rdfs:label>
    <rdfs:comment xml:lang="en">Records accessed on for SourceDocument.</rdfs:comment>
    <rdfs:comment xml:lang="ko">SourceDocument의 확인일를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#vehiclePlugInChargeable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#Vehicle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="ko">외부 충전 가능</rdfs:label>
    <rdfs:label xml:lang="en">chargeable from off-board electricity</rdfs:label>
    <rdfs:comment xml:lang="en">Records chargeable from off-board electricity for Vehicle.</rdfs:comment>
    <rdfs:comment xml:lang="ko">Vehicle의 외부 충전 가능를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#evidenceClaim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">근거 주장</rdfs:label>
    <rdfs:label xml:lang="en">evidence claim</rdfs:label>
    <rdfs:comment xml:lang="en">Records evidence claim for EvidenceRecord.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EvidenceRecord의 근거 주장를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#recordDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">설명</rdfs:label>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:comment xml:lang="en">Records description for ResourceRecord.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ResourceRecord의 설명를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">구동계 구성품</rdfs:label>
    <rdfs:label xml:lang="en">Powertrain component</rdfs:label>
    <rdfs:comment xml:lang="ko">전기 구동, 에너지 저장, 전력 변환 또는 동력 전달에 참여하는 구성품이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A component participating in electric propulsion, energy storage, power conversion, or power transfer.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#vehicleChargingEnergySource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#Vehicle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">충전 에너지원</rdfs:label>
    <rdfs:label xml:lang="en">charging energy source</rdfs:label>
    <rdfs:comment xml:lang="en">Records charging energy source for Vehicle.</rdfs:comment>
    <rdfs:comment xml:lang="ko">Vehicle의 충전 에너지원를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#componentHasEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/electric-vehicle#EvidenceRecord"/>
    <rdfs:label xml:lang="ko">구성품 근거</rdfs:label>
    <rdfs:label xml:lang="en">component evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Records component evidence for PowertrainComponent.</rdfs:comment>
    <rdfs:comment xml:lang="ko">PowertrainComponent의 구성품 근거를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#energyFlowSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EnergyFlow"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="ko">에너지 출발점</rdfs:label>
    <rdfs:label xml:lang="en">energy source</rdfs:label>
    <rdfs:comment xml:lang="en">Records energy source for EnergyFlow.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EnergyFlow의 에너지 출발점를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#PlugInHybridElectricVehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">플러그인 하이브리드 전기차</rdfs:label>
    <rdfs:label xml:lang="en">Plug-in hybrid electric vehicle</rdfs:label>
    <rdfs:comment xml:lang="ko">내연기관과 전기 구동을 함께 사용하고 외부 전원으로 배터리를 충전할 수 있는 유형이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A vehicle archetype combining combustion and electric drive whose battery can be charged externally.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ElectrifiedVehicle"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#EvidenceRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">근거 기록</rdfs:label>
    <rdfs:label xml:lang="en">Evidence record</rdfs:label>
    <rdfs:comment xml:lang="ko">출처 위치와 적용 범위가 명시된 주장의 근거다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A claim-level evidence record with a source locator and stated scope.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#ChargingStationLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">충전소 위치</rdfs:label>
    <rdfs:label xml:lang="en">Charging station location</rdfs:label>
    <rdfs:comment xml:lang="ko">하나 이상의 전기차 충전 포트가 설치된 물리적 장소다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A physical location containing one or more EV charging ports.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#evidenceAbout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#EvidenceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label xml:lang="ko">주장 대상</rdfs:label>
    <rdfs:label xml:lang="en">subject of evidence</rdfs:label>
    <rdfs:comment xml:lang="en">Records subject of evidence for EvidenceRecord.</rdfs:comment>
    <rdfs:comment xml:lang="ko">EvidenceRecord의 주장 대상를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#Inverter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">인버터</rdfs:label>
    <rdfs:label xml:lang="en">Inverter</rdfs:label>
    <rdfs:comment xml:lang="ko">전력전자 구동계에서 전력을 변환하는 구성품이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A component that converts power within the electric traction drive.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/electric-vehicle#PowertrainComponent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#recordLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/electric-vehicle#ResourceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">표시 이름</rdfs:label>
    <rdfs:label xml:lang="en">display label</rdfs:label>
    <rdfs:comment xml:lang="en">Records display label for ResourceRecord.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ResourceRecord의 표시 이름를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://example.org/ontology/custom/electric-vehicle/0.1.0"/>
    <rdfs:label xml:lang="ko">전기자동차 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">Electric Vehicle Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">BEV·PHEV·HEV 유형, 구동계 구성품, 에너지 흐름, 충전 설비와 출처 근거를 연결하는 초안이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A draft connecting BEV, PHEV, and HEV categories to drivetrain components, energy flows, charging infrastructure, and evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#DCDCConverter">
