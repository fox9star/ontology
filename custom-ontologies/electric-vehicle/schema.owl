    <rdfs:comment xml:lang="ko">EnergyFlow의 에너지 도착점를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/electric-vehicle#ChargingConnector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
