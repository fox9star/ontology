        ev:e-bev-components,
        ev:e-doe-components ;
    ns1:vehiclePlugInChargeable true ;
    ns1:vehiclePowertrainConfiguration "electric-only"^^xsd:string ;
    ns1:vehiclePropulsionMode "electric-only"^^xsd:string .

ev:e-bev-components a ev:EvidenceRecord,
        ev:ResourceRecord ;
    rdfs:label "Evidence e-bev-components"@en,
        "근거 e-bev-components"@ko ;
    ns1:evidenceAbout ev:vehicle-bev-pattern ;
    ns1:evidenceClaim "The page describes the charge port, DC/DC converter, traction motor, onboard charger, power electronics controller, thermal system, and traction battery."@en,
        "AFDC는 BEV의 충전구, DC-DC 변환기, 구동 모터, 탑재 충전기, 전력전자 제어기, 열관리와 구동 배터리 기능을 설명한다."@ko ;
    ns1:evidenceIdentifier "e-bev-components"^^xsd:string ;
    ns1:evidenceLocator "Key Components of an All-Electric Car section"^^xsd:string ;
    ns1:evidenceScope "A general source description, not a measured value or universal specification for a specific model."@en,
        "출처에 기술된 일반 유형·구성 설명이며 실제 차종의 측정값이나 보편 사양으로 해석하지 않는다."@ko ;
    ns1:evidenceSource ev:afdc-bev ;
    ns1:evidenceStatus "source-reported"^^xsd:string ;
    ns1:recordIdentifier "e-bev-components"^^xsd:string ;
    ns1:recordLabel "Evidence e-bev-components"@en,
        "근거 e-bev-components"@ko .

