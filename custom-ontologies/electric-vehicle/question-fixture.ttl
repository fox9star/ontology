@prefix ev: <https://example.test/electric-vehicle#> .
@prefix ns1: <https://example.org/ontology/custom/electric-vehicle#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ev:coverage-charging a ev:CoverageNote,
        ev:ResourceRecord ;
    rdfs:label "Charging infrastructure"@en,
        "충전 인프라"@ko ;
    ns1:coverageExplanation "Models station-port-connector structure and AC/DC interfaces; infrastructure and session data are synthetic."@en,
        "스테이션-포트-커넥터 구조와 AC/DC 인터페이스를 나타낸다. 인프라·세션 자료는 합성 예시다."@ko ;
    ns1:coverageLabel "Charging infrastructure"@en,
        "충전 인프라"@ko ;
    ns1:coverageStatus "limited"^^xsd:string ;
    ns1:recordIdentifier "coverage-charging"^^xsd:string ;
    ns1:recordLabel "Charging infrastructure"@en,
        "충전 인프라"@ko .

ev:coverage-components a ev:CoverageNote,
        ev:ResourceRecord ;
    rdfs:label "Drivetrain and power conversion"@en,
        "구동계와 전력 변환"@ko ;
    ns1:coverageExplanation "Covers battery, motor, onboard charger, inverter, DC-DC converter, controller, and thermal-management roles."@en,
        "구동 배터리, 모터, 탑재 충전기, 인버터, DC-DC 변환기, 제어기와 열관리 역할을 다룬다."@ko ;
    ns1:coverageLabel "Drivetrain and power conversion"@en,
        "구동계와 전력 변환"@ko ;
    ns1:coverageStatus "included"^^xsd:string ;
    ns1:recordIdentifier "coverage-components"^^xsd:string ;
    ns1:recordLabel "Drivetrain and power conversion"@en,
        "구동계와 전력 변환"@ko .

ev:coverage-performance a ev:CoverageNote,
        ev:ResourceRecord ;
    rdfs:label "Model-specific performance and battery figures"@en,
        "차종별 성능·배터리 수치"@ko ;
    ns1:coverageExplanation "Capacity, charging speed, range, efficiency, and battery health are not generalized without model- and use-specific sources."@en,
        "용량, 충전 속도, 주행거리, 효율과 배터리 건강도는 차종·시험·운행별 자료가 없어 일반화하지 않는다."@ko ;
    ns1:coverageLabel "Model-specific performance and battery figures"@en,
        "차종별 성능·배터리 수치"@ko ;
    ns1:coverageStatus "excluded"^^xsd:string ;
    ns1:recordIdentifier "coverage-performance"^^xsd:string ;
    ns1:recordLabel "Model-specific performance and battery figures"@en,
        "차종별 성능·배터리 수치"@ko .

ev:coverage-standards a ev:CoverageNote,
        ev:ResourceRecord ;
    rdfs:label "Market-specific connector standards and compatibility"@en,
        "지역별 커넥터 표준과 호환성"@ko ;
    ns1:coverageExplanation "Standards support, manufacturer compatibility, laws, tariffs, and incentives require market- and time-specific sources and are excluded."@en,
        "표준별 지원, 제조사 호환성, 법규·요금·보조금은 지역과 시점별 자료가 필요해 제외한다."@ko ;
    ns1:coverageLabel "Market-specific connector standards and compatibility"@en,
        "지역별 커넥터 표준과 호환성"@ko ;
    ns1:coverageStatus "excluded"^^xsd:string ;
    ns1:recordIdentifier "coverage-standards"^^xsd:string ;
    ns1:recordLabel "Market-specific connector standards and compatibility"@en,
        "지역별 커넥터 표준과 호환성"@ko .

ev:coverage-vehicle-types a ev:CoverageNote,
        ev:ResourceRecord ;
    rdfs:label "Vehicle categories"@en,
        "차량 유형"@ko ;
    ns1:coverageExplanation "Separate BEV, PHEV, and HEV classes represent differences in off-board charging and propulsion energy."@en,
        "BEV, PHEV, HEV를 별도 클래스로 두고 외부 충전과 추진 에너지 범주의 차이를 표현한다."@ko ;
    ns1:coverageLabel "Vehicle categories"@en,
        "차량 유형"@ko ;
    ns1:coverageStatus "included"^^xsd:string ;
    ns1:recordIdentifier "coverage-vehicle-types"^^xsd:string ;
    ns1:recordLabel "Vehicle categories"@en,
        "차량 유형"@ko .

ev:e-charge-factors a ev:EvidenceRecord,
        ev:ResourceRecord ;
    rdfs:label "Evidence e-charge-factors"@en,
        "근거 e-charge-factors"@ko ;
    ns1:evidenceAbout ev:evse-ac-example ;
    ns1:evidenceClaim "Charging time depends on battery state of charge and capacity, battery type, onboard-charger capacity, equipment output, and electrical service."@en,
        "충전 시간에는 배터리 상태·용량·종류, 차량 충전기 용량, 설비 출력과 전기 서비스가 영향을 준다."@ko ;
    ns1:evidenceIdentifier "e-charge-factors"^^xsd:string ;
    ns1:evidenceLocator "Charging Equipment section"^^xsd:string ;
    ns1:evidenceScope "A general source description, not a measured value or universal specification for a specific model."@en,
        "출처에 기술된 일반 유형·구성 설명이며 실제 차종의 측정값이나 보편 사양으로 해석하지 않는다."@ko ;
    ns1:evidenceSource ev:afdc-charging ;
    ns1:evidenceStatus "source-reported"^^xsd:string ;
    ns1:recordIdentifier "e-charge-factors"^^xsd:string ;
    ns1:recordLabel "Evidence e-charge-factors"@en,
        "근거 e-charge-factors"@ko .

ev:e-port-topology a ev:EvidenceRecord,
        ev:ResourceRecord ;
    rdfs:label "Evidence e-port-topology"@en,
        "근거 e-port-topology"@ko ;
    ns1:evidenceAbout ev:station-location-example ;
    ns1:evidenceClaim "A station location can contain multiple ports; a port serves one vehicle at a time and can have multiple connectors."@en,
        "충전소 위치는 여러 충전 포트를 가질 수 있고 포트는 한 번에 한 차량을 공급하며 여러 커넥터를 가질 수 있다."@ko ;
    ns1:evidenceIdentifier "e-port-topology"^^xsd:string ;
    ns1:evidenceLocator "Charging Infrastructure Terminology section"^^xsd:string ;
    ns1:evidenceScope "A general source description, not a measured value or universal specification for a specific model."@en,
        "출처에 기술된 일반 유형·구성 설명이며 실제 차종의 측정값이나 보편 사양으로 해석하지 않는다."@ko ;
    ns1:evidenceSource ev:afdc-charging ;
    ns1:evidenceStatus "source-reported"^^xsd:string ;
    ns1:recordIdentifier "e-port-topology"^^xsd:string ;
    ns1:recordLabel "Evidence e-port-topology"@en,
        "근거 e-port-topology"@ko .

ev:flow-ac-evse-onboard a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "AC equipment to onboard charger"@en,
        "AC 설비에서 차량 탑재 충전기로"@ko ;
    ns1:energyFlowCondition "Input from AC charging equipment to the onboard charger."@en,
        "AC 충전 설비에서 차량 탑재 충전기로 입력된다."@ko ;
    ns1:energyFlowDestination ev:component-onboard-charger ;
    ns1:energyFlowForm "ac-electricity"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-doe-ac-path ;
    ns1:energyFlowSource ev:evse-ac-example ;
    ns1:recordIdentifier "flow-ac-evse-onboard"^^xsd:string ;
    ns1:recordLabel "AC equipment to onboard charger"@en,
        "AC 설비에서 차량 탑재 충전기로"@ko .

ev:flow-battery-controller a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "Traction battery to controller"@en,
        "구동 배터리에서 제어기로"@ko ;
    ns1:energyFlowCondition "A conceptual representation of power flow from battery to traction drive."@en,
        "배터리와 구동계 사이 전력 흐름의 개념적 표현이다."@ko ;
    ns1:energyFlowDestination ev:component-power-controller ;
    ns1:energyFlowForm "dc-electricity"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-doe-components ;
    ns1:energyFlowSource ev:component-traction-battery ;
    ns1:recordIdentifier "flow-battery-controller"^^xsd:string ;
    ns1:recordLabel "Traction battery to controller"@en,
        "구동 배터리에서 제어기로"@ko .

ev:flow-controller-inverter a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "Controller to inverter"@en,
        "제어기에서 인버터로"@ko ;
    ns1:energyFlowCondition "A simplified relation; detailed circuit topology varies."@en,
        "전력전자 구성품의 단순화된 관계이며 상세 회로 구성은 다를 수 있다."@ko ;
    ns1:energyFlowDestination ev:component-inverter ;
    ns1:energyFlowForm "dc-electricity"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-doe-components ;
    ns1:energyFlowSource ev:component-power-controller ;
    ns1:recordIdentifier "flow-controller-inverter"^^xsd:string ;
    ns1:recordLabel "Controller to inverter"@en,
        "제어기에서 인버터로"@ko .

ev:flow-dc-equipment-battery a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "DC equipment to traction battery"@en,
        "DC 충전 설비에서 구동 배터리로"@ko ;
    ns1:energyFlowCondition "Represents the DC charging interface path without generalizing internal vehicle topology."@en,
        "DC 충전 경로를 인터페이스 수준에서 나타낸다. 차량 내부 토폴로지를 일반화하지 않는다."@ko ;
    ns1:energyFlowDestination ev:component-traction-battery ;
    ns1:energyFlowForm "dc-electricity"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-dc-interface ;
    ns1:energyFlowSource ev:evse-dc-example ;
    ns1:recordIdentifier "flow-dc-equipment-battery"^^xsd:string ;
    ns1:recordLabel "DC equipment to traction battery"@en,
        "DC 충전 설비에서 구동 배터리로"@ko .

ev:flow-inverter-motor a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "Inverter to motor"@en,
        "인버터에서 모터로"@ko ;
    ns1:energyFlowCondition "A conceptual flow of controlled power to the motor."@en,
        "모터에 제어된 전력을 공급하는 개념 흐름이다."@ko ;
    ns1:energyFlowDestination ev:component-electric-motor ;
    ns1:energyFlowForm "ac-electricity"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-doe-components ;
    ns1:energyFlowSource ev:component-inverter ;
    ns1:recordIdentifier "flow-inverter-motor"^^xsd:string ;
    ns1:recordLabel "Inverter to motor"@en,
        "인버터에서 모터로"@ko .

ev:flow-motor-vehicle a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "Motor to vehicle drivetrain"@en,
        "모터에서 차량 구동계로"@ko ;
    ns1:energyFlowCondition "The drivetrain transfers motor mechanical power to the wheels."@en,
        "구동계가 모터의 기계적 동력을 바퀴로 전달한다."@ko ;
    ns1:energyFlowDestination ev:vehicle-bev-pattern ;
    ns1:energyFlowForm "mechanical-energy"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-bev-components ;
    ns1:energyFlowSource ev:component-electric-motor ;
    ns1:recordIdentifier "flow-motor-vehicle"^^xsd:string ;
    ns1:recordLabel "Motor to vehicle drivetrain"@en,
        "모터에서 차량 구동계로"@ko .

ev:flow-onboard-battery a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "Onboard charger to traction battery"@en,
        "차량 탑재 충전기에서 구동 배터리로"@ko ;
    ns1:energyFlowCondition "The onboard charger converts input AC to DC for the battery."@en,
        "탑재 충전기가 입력 AC를 배터리 충전용 DC로 변환한다."@ko ;
    ns1:energyFlowDestination ev:component-traction-battery ;
    ns1:energyFlowForm "dc-electricity"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-doe-ac-path ;
    ns1:energyFlowSource ev:component-onboard-charger ;
    ns1:recordIdentifier "flow-onboard-battery"^^xsd:string ;
    ns1:recordLabel "Onboard charger to traction battery"@en,
        "차량 탑재 충전기에서 구동 배터리로"@ko .

ev:flow-regeneration-battery a ev:EnergyFlow,
        ev:ResourceRecord ;
    rdfs:label "Regenerative braking to battery"@en,
        "회생 제동에서 배터리로"@ko ;
    ns1:energyFlowCondition "Where supported, motor-generator operation captures braking energy for storage."@en,
        "회생 제동을 지원할 때 모터 발전 기능이 에너지를 포착해 저장한다."@ko ;
    ns1:energyFlowDestination ev:component-traction-battery ;
    ns1:energyFlowForm "dc-electricity"^^xsd:string ;
    ns1:energyFlowHasEvidence ev:e-doe-components ;
    ns1:energyFlowSource ev:component-electric-motor ;
    ns1:recordIdentifier "flow-regeneration-battery"^^xsd:string ;
    ns1:recordLabel "Regenerative braking to battery"@en,
        "회생 제동에서 배터리로"@ko .

ev:session-example a ev:ChargingSession,
        ev:ResourceRecord ;
    rdfs:label "Synthetic AC charging session"@en,
        "가상 AC 충전 세션"@ko ;
    ns1:recordDescription "Synthetic session, not validated metering data."@en,
        "검증·계량 데이터가 아닌 합성 세션이다."@ko ;
    ns1:recordIdentifier "session-example"^^xsd:string ;
    ns1:recordLabel "Synthetic AC charging session"@en,
        "가상 AC 충전 세션"@ko ;
    ns1:sessionConnector ev:connector-ac-example ;
    ns1:sessionCurrentType "ac"^^xsd:string ;
    ns1:sessionDataStatus "synthetic-example"^^xsd:string ;
    ns1:sessionEVSEPort ev:evse-ac-example ;
    ns1:sessionState "completed"^^xsd:string ;
    ns1:sessionVehicle ev:vehicle-bev-pattern .

ev:afdc-bev a ev:ResourceRecord,
        ev:SourceDocument ;
    rdfs:label "Alternative Fuels Data Center: How Do All-Electric Cars Work?"@en,
        "미국 에너지부 대체연료 데이터센터: 배터리 전기차 작동 방식"@ko ;
    ns1:recordIdentifier "afdc-bev"^^xsd:string ;
    ns1:recordLabel "Alternative Fuels Data Center: How Do All-Electric Cars Work?"@en,
        "미국 에너지부 대체연료 데이터센터: 배터리 전기차 작동 방식"@ko ;
    ns1:sourceAccessedOn "2026-10-08"^^xsd:date ;
    ns1:sourcePublisher "U.S. Department of Energy, Transportation Technologies Office"^^xsd:string ;
    ns1:sourceScope "Overview of BEV components and functions; does not generalize model-specific design or numerical specifications."@en,
        "BEV 구성품과 기능 개요다. 차종별 상세 설계와 수치 사양을 일반화하지 않는다."@ko ;
    ns1:sourceTitle "Alternative Fuels Data Center: How Do All-Electric Cars Work?"@en,
        "미국 에너지부 대체연료 데이터센터: 배터리 전기차 작동 방식"@ko ;
    ns1:sourceURL "https://afdc.energy.gov/vehicles/how-do-all-electric-cars-work"^^xsd:anyURI .

ev:afdc-hev a ev:ResourceRecord,
        ev:SourceDocument ;
    rdfs:label "Alternative Fuels Data Center: Hybrid Electric Vehicles"@en,
        "미국 에너지부 대체연료 데이터센터: 하이브리드 전기차"@ko ;
    ns1:recordIdentifier "afdc-hev"^^xsd:string ;
    ns1:recordLabel "Alternative Fuels Data Center: Hybrid Electric Vehicles"@en,
        "미국 에너지부 대체연료 데이터센터: 하이브리드 전기차"@ko ;
    ns1:sourceAccessedOn "2026-10-08"^^xsd:date ;
    ns1:sourcePublisher "U.S. Department of Energy, Transportation Technologies Office"^^xsd:string ;
    ns1:sourceScope "Describes HEV charging through regenerative braking and the combustion engine rather than plugging in."@en,
        "HEV의 외부 충전 불가와 회생 제동·내연기관 충전을 설명한다."@ko ;
    ns1:sourceTitle "Alternative Fuels Data Center: Hybrid Electric Vehicles"@en,
        "미국 에너지부 대체연료 데이터센터: 하이브리드 전기차"@ko ;
    ns1:sourceURL "https://afdc.energy.gov/vehicles/electric-basics-hev"^^xsd:anyURI .

ev:afdc-phev a ev:ResourceRecord,
        ev:SourceDocument ;
    rdfs:label "Alternative Fuels Data Center: Plug-In Hybrid Electric Vehicles"@en,
        "미국 에너지부 대체연료 데이터센터: 플러그인 하이브리드 전기차"@ko ;
    ns1:recordIdentifier "afdc-phev"^^xsd:string ;
    ns1:recordLabel "Alternative Fuels Data Center: Plug-In Hybrid Electric Vehicles"@en,
        "미국 에너지부 대체연료 데이터센터: 플러그인 하이브리드 전기차"@ko ;
    ns1:sourceAccessedOn "2026-10-08"^^xsd:date ;
    ns1:sourcePublisher "U.S. Department of Energy, Transportation Technologies Office"^^xsd:string ;
    ns1:sourceScope "Describes PHEV engine, motor, battery, external charging, regeneration, and series or parallel layouts."@en,
        "PHEV의 엔진·모터·배터리, 외부 충전, 회생 제동, 직렬·병렬 구성을 설명한다."@ko ;
    ns1:sourceTitle "Alternative Fuels Data Center: Plug-In Hybrid Electric Vehicles"@en,
        "미국 에너지부 대체연료 데이터센터: 플러그인 하이브리드 전기차"@ko ;
    ns1:sourceURL "https://afdc.energy.gov/vehicles/electric-basics-phev"^^xsd:anyURI .

ev:component-auxiliary-battery a ev:AuxiliaryBattery,
        ev:PowertrainComponent,
        ev:ResourceRecord ;
    rdfs:label "Auxiliary battery"@en,
        "보조 배터리"@ko ;
    ns1:componentFunction "Supplies auxiliary power to vehicle accessories."@en,
        "차량 액세서리에 보조 전력을 공급한다."@ko ;
    ns1:componentHasEvidence ev:e-bev-components ;
    ns1:componentRole "auxiliary-storage"^^xsd:string ;
    ns1:recordIdentifier "component-auxiliary-battery"^^xsd:string ;
    ns1:recordLabel "Auxiliary battery"@en,
        "보조 배터리"@ko .

ev:component-dcdc a ev:DCDCConverter,
        ev:PowertrainComponent,
        ev:ResourceRecord ;
    rdfs:label "DC-DC converter"@en,
        "DC-DC 변환기"@ko ;
    ns1:componentFunction "Converts higher-voltage traction-battery DC to lower-voltage DC for auxiliary loads."@en,
        "구동 배터리의 고전압 DC를 보조 부하용 저전압 DC로 변환한다."@ko ;
    ns1:componentHasEvidence ev:e-bev-components,
        ev:e-doe-components ;
    ns1:componentRole "power-conversion"^^xsd:string ;
    ns1:recordIdentifier "component-dcdc"^^xsd:string ;
    ns1:recordLabel "DC-DC converter"@en,
        "DC-DC 변환기"@ko .

ev:component-thermal-management a ev:PowertrainComponent,
        ev:ResourceRecord,
        ev:ThermalManagementSystem ;
    rdfs:label "EV thermal management system"@en,
        "전기차 열관리 시스템"@ko ;
    ns1:componentFunction "Manages operating temperatures of the battery, motor, and power electronics."@en,
        "배터리와 모터, 전력전자 등 구성품의 작동 온도를 관리한다."@ko ;
    ns1:componentHasEvidence ev:e-bev-components,
        ev:e-doe-components ;
    ns1:componentRole "thermal-control"^^xsd:string ;
    ns1:recordIdentifier "component-thermal-management"^^xsd:string ;
    ns1:recordLabel "EV thermal management system"@en,
        "전기차 열관리 시스템"@ko .

ev:component-vehicle-charge-port a ev:PowertrainComponent,
        ev:ResourceRecord,
        ev:VehicleChargePort ;
    rdfs:label "Vehicle charge port"@en,
        "차량 충전구"@ko ;
    ns1:componentFunction "Connects the vehicle to external charging equipment."@en,
        "외부 충전 설비와 차량을 연결한다."@ko ;
    ns1:componentHasEvidence ev:e-bev-components ;
    ns1:componentRole "charging-interface"^^xsd:string ;
    ns1:recordIdentifier "component-vehicle-charge-port"^^xsd:string ;
    ns1:recordLabel "Vehicle charge port"@en,
        "차량 충전구"@ko .

ev:connector-dc-example a ev:ChargingConnector,
        ev:ResourceRecord ;
    rdfs:label "Synthetic DC interface connector"@en,
        "가상 DC 인터페이스 커넥터"@ko ;
    ns1:connectorDataStatus "synthetic-example"^^xsd:string ;
    ns1:connectorInterfaceType "dc-example"^^xsd:string ;
