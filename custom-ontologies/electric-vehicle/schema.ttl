@prefix ev: <https://example.org/ontology/custom/electric-vehicle#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/custom/electric-vehicle> a owl:Ontology ;
    rdfs:label "Electric Vehicle Ontology"@en,
        "전기자동차 온톨로지"@ko ;
    rdfs:comment "A draft connecting BEV, PHEV, and HEV categories to drivetrain components, energy flows, charging infrastructure, and evidence."@en,
        "BEV·PHEV·HEV 유형, 구동계 구성품, 에너지 흐름, 충전 설비와 출처 근거를 연결하는 초안이다."@ko ;
    owl:versionIRI <https://example.org/ontology/custom/electric-vehicle/0.1.0> ;
    owl:versionInfo "0.1.0" .

ev:AuxiliaryBattery a owl:Class ;
    rdfs:label "Auxiliary battery"@en,
        "보조 배터리"@ko ;
    rdfs:comment "Supplies vehicle accessories and low-voltage auxiliary loads."@en,
        "차량 액세서리와 저전압 보조 부하에 전력을 공급한다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:BatteryElectricVehicle a owl:Class ;
    rdfs:label "Battery electric vehicle"@en,
        "배터리 전기차"@ko ;
    rdfs:comment "A plug-in vehicle archetype propelled by an electric motor using traction-battery energy."@en,
        "주행용 배터리와 전기 모터로 구동되는 플러그인 차량 유형이다."@ko ;
    rdfs:subClassOf ev:ElectrifiedVehicle .

ev:DCDCConverter a owl:Class ;
    rdfs:label "DC-DC converter"@en,
        "DC-DC 변환기"@ko ;
    rdfs:comment "Converts higher-voltage traction-battery DC to lower-voltage DC for auxiliary loads."@en,
        "구동 배터리의 고전압 직류를 저전압 보조 부하용 직류로 변환한다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:ElectricTractionMotor a owl:Class ;
    rdfs:label "Electric traction motor"@en,
        "전기 구동 모터"@ko ;
    rdfs:comment "Converts electrical energy into wheel propulsion and may also perform regeneration."@en,
        "전기 에너지를 바퀴 구동력으로 변환하며 일부 차량에서 회생 기능도 수행한다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:HybridElectricVehicle a owl:Class ;
    rdfs:label "Hybrid electric vehicle"@en,
        "하이브리드 전기차"@ko ;
    rdfs:comment "A vehicle archetype combining combustion and electric drive that is not plugged into off-board electricity."@en,
        "내연기관과 전기 모터를 사용하지만 외부 전원에 꽂아 충전하지 않는 유형이다."@ko ;
    rdfs:subClassOf ev:ElectrifiedVehicle .

ev:Inverter a owl:Class ;
    rdfs:label "Inverter"@en,
        "인버터"@ko ;
    rdfs:comment "A component that converts power within the electric traction drive."@en,
        "전력전자 구동계에서 전력을 변환하는 구성품이다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:OnboardCharger a owl:Class ;
    rdfs:label "Onboard charger"@en,
        "차량 탑재 충전기"@ko ;
    rdfs:comment "For AC charging, converts input AC to battery-charging DC and communicates with charging equipment."@en,
        "AC 충전 때 입력 AC를 배터리 충전용 DC로 변환하고 충전 설비와 통신한다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:PlugInHybridElectricVehicle a owl:Class ;
    rdfs:label "Plug-in hybrid electric vehicle"@en,
        "플러그인 하이브리드 전기차"@ko ;
    rdfs:comment "A vehicle archetype combining combustion and electric drive whose battery can be charged externally."@en,
        "내연기관과 전기 구동을 함께 사용하고 외부 전원으로 배터리를 충전할 수 있는 유형이다."@ko ;
    rdfs:subClassOf ev:ElectrifiedVehicle .

ev:PowerElectronicsController a owl:Class ;
    rdfs:label "Power electronics controller"@en,
        "전력전자 제어기"@ko ;
    rdfs:comment "Manages energy delivered from the battery and controls motor speed and torque."@en,
        "배터리에서 구동계로 흐르는 전력을 관리하고 모터 속도와 토크를 제어한다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:ThermalManagementSystem a owl:Class ;
    rdfs:label "Thermal management system"@en,
        "열관리 시스템"@ko ;
    rdfs:comment "Manages operating temperatures of the battery, motor, and power electronics."@en,
        "배터리, 모터와 전력전자 등 구성품의 작동 온도를 관리한다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:TractionBatteryPack a owl:Class ;
    rdfs:label "Traction battery pack"@en,
        "구동 배터리 팩"@ko ;
    rdfs:comment "Stores electricity for electric propulsion."@en,
        "전기 구동에 사용할 에너지를 저장한다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:VehicleChargePort a owl:Class ;
    rdfs:label "Vehicle charge port"@en,
        "차량 충전구"@ko ;
    rdfs:comment "The vehicle-side interface connecting external charging equipment to the vehicle."@en,
        "외부 충전 설비와 차량을 연결하는 차량 측 인터페이스다."@ko ;
    rdfs:subClassOf ev:PowertrainComponent .

ev:componentFunction a owl:DatatypeProperty ;
    rdfs:label "component function"@en,
        "구성품 기능"@ko ;
    rdfs:comment "Records component function for PowertrainComponent."@en,
        "PowertrainComponent의 구성품 기능를 기록한다."@ko ;
    rdfs:domain ev:PowertrainComponent ;
    rdfs:range rdf:langString .

ev:componentHasEvidence a owl:ObjectProperty ;
    rdfs:label "component evidence"@en,
        "구성품 근거"@ko ;
    rdfs:comment "Records component evidence for PowertrainComponent."@en,
        "PowertrainComponent의 구성품 근거를 기록한다."@ko ;
    rdfs:domain ev:PowertrainComponent ;
    rdfs:range ev:EvidenceRecord .

ev:componentRole a owl:DatatypeProperty ;
    rdfs:label "component role"@en,
        "기능 범주"@ko ;
    rdfs:comment "Records component role for PowertrainComponent."@en,
        "PowertrainComponent의 기능 범주를 기록한다."@ko ;
    rdfs:domain ev:PowertrainComponent ;
    rdfs:range xsd:string .

ev:connectorDataStatus a owl:DatatypeProperty ;
    rdfs:label "data status"@en,
        "데이터 상태"@ko ;
    rdfs:comment "Records data status for ChargingConnector."@en,
        "ChargingConnector의 데이터 상태를 기록한다."@ko ;
    rdfs:domain ev:ChargingConnector ;
    rdfs:range xsd:string .

ev:connectorInterfaceType a owl:DatatypeProperty ;
    rdfs:label "interface type"@en,
        "인터페이스 유형"@ko ;
    rdfs:comment "Records interface type for ChargingConnector."@en,
        "ChargingConnector의 인터페이스 유형를 기록한다."@ko ;
    rdfs:domain ev:ChargingConnector ;
    rdfs:range xsd:string .

ev:coverageExplanation a owl:DatatypeProperty ;
    rdfs:label "coverage explanation"@en,
        "범위 설명"@ko ;
    rdfs:comment "Records coverage explanation for CoverageNote."@en,
        "CoverageNote의 범위 설명를 기록한다."@ko ;
    rdfs:domain ev:CoverageNote ;
    rdfs:range rdf:langString .

ev:coverageLabel a owl:DatatypeProperty ;
    rdfs:label "coverage label"@en,
        "범위 항목"@ko ;
    rdfs:comment "Records coverage label for CoverageNote."@en,
        "CoverageNote의 범위 항목를 기록한다."@ko ;
    rdfs:domain ev:CoverageNote ;
    rdfs:range rdf:langString .

ev:coverageStatus a owl:DatatypeProperty ;
    rdfs:label "coverage status"@en,
        "범위 상태"@ko ;
    rdfs:comment "Records coverage status for CoverageNote."@en,
        "CoverageNote의 범위 상태를 기록한다."@ko ;
    rdfs:domain ev:CoverageNote ;
    rdfs:range xsd:string .

ev:energyFlowCondition a owl:DatatypeProperty ;
    rdfs:label "flow condition"@en,
        "흐름 조건"@ko ;
    rdfs:comment "Records flow condition for EnergyFlow."@en,
        "EnergyFlow의 흐름 조건를 기록한다."@ko ;
    rdfs:domain ev:EnergyFlow ;
    rdfs:range rdf:langString .

ev:energyFlowDestination a owl:ObjectProperty ;
    rdfs:label "energy destination"@en,
        "에너지 도착점"@ko ;
    rdfs:comment "Records energy destination for EnergyFlow."@en,
        "EnergyFlow의 에너지 도착점를 기록한다."@ko ;
    rdfs:domain ev:EnergyFlow ;
    rdfs:range owl:Thing .

ev:energyFlowForm a owl:DatatypeProperty ;
    rdfs:label "energy form"@en,
        "에너지 형태"@ko ;
    rdfs:comment "Records energy form for EnergyFlow."@en,
        "EnergyFlow의 에너지 형태를 기록한다."@ko ;
    rdfs:domain ev:EnergyFlow ;
    rdfs:range xsd:string .

ev:energyFlowHasEvidence a owl:ObjectProperty ;
    rdfs:label "energy-flow evidence"@en,
        "에너지 흐름 근거"@ko ;
    rdfs:comment "Records energy-flow evidence for EnergyFlow."@en,
        "EnergyFlow의 에너지 흐름 근거를 기록한다."@ko ;
    rdfs:domain ev:EnergyFlow ;
    rdfs:range ev:EvidenceRecord .

ev:energyFlowSource a owl:ObjectProperty ;
    rdfs:label "energy source"@en,
        "에너지 출발점"@ko ;
    rdfs:comment "Records energy source for EnergyFlow."@en,
        "EnergyFlow의 에너지 출발점를 기록한다."@ko ;
    rdfs:domain ev:EnergyFlow ;
    rdfs:range owl:Thing .

ev:evidenceAbout a owl:ObjectProperty ;
    rdfs:label "subject of evidence"@en,
        "주장 대상"@ko ;
    rdfs:comment "Records subject of evidence for EvidenceRecord."@en,
        "EvidenceRecord의 주장 대상를 기록한다."@ko ;
    rdfs:domain ev:EvidenceRecord ;
    rdfs:range owl:Thing .

ev:evidenceClaim a owl:DatatypeProperty ;
    rdfs:label "evidence claim"@en,
        "근거 주장"@ko ;
    rdfs:comment "Records evidence claim for EvidenceRecord."@en,
        "EvidenceRecord의 근거 주장를 기록한다."@ko ;
    rdfs:domain ev:EvidenceRecord ;
    rdfs:range rdf:langString .

ev:evidenceIdentifier a owl:DatatypeProperty ;
    rdfs:label "evidence identifier"@en,
        "근거 식별자"@ko ;
    rdfs:comment "Records evidence identifier for EvidenceRecord."@en,
        "EvidenceRecord의 근거 식별자를 기록한다."@ko ;
    rdfs:domain ev:EvidenceRecord ;
    rdfs:range xsd:string .

ev:evidenceLocator a owl:DatatypeProperty ;
    rdfs:label "source locator"@en,
        "출처 내 위치"@ko ;
    rdfs:comment "Records source locator for EvidenceRecord."@en,
        "EvidenceRecord의 출처 내 위치를 기록한다."@ko ;
    rdfs:domain ev:EvidenceRecord ;
    rdfs:range xsd:string .

ev:evidenceScope a owl:DatatypeProperty ;
    rdfs:label "claim scope"@en,
        "주장 적용 범위"@ko ;
    rdfs:comment "Records claim scope for EvidenceRecord."@en,
        "EvidenceRecord의 주장 적용 범위를 기록한다."@ko ;
    rdfs:domain ev:EvidenceRecord ;
    rdfs:range rdf:langString .

ev:evidenceSource a owl:ObjectProperty ;
    rdfs:label "evidence source"@en,
        "근거 출처"@ko ;
    rdfs:comment "Records evidence source for EvidenceRecord."@en,
        "EvidenceRecord의 근거 출처를 기록한다."@ko ;
    rdfs:domain ev:EvidenceRecord ;
    rdfs:range ev:SourceDocument .

ev:evidenceStatus a owl:DatatypeProperty ;
    rdfs:label "evidence status"@en,
        "근거 상태"@ko ;
    rdfs:comment "Records evidence status for EvidenceRecord."@en,
        "EvidenceRecord의 근거 상태를 기록한다."@ko ;
    rdfs:domain ev:EvidenceRecord ;
    rdfs:range xsd:string .

ev:portDataStatus a owl:DatatypeProperty ;
    rdfs:label "data status"@en,
        "데이터 상태"@ko ;
    rdfs:comment "Records data status for EVSEPort."@en,
        "EVSEPort의 데이터 상태를 기록한다."@ko ;
    rdfs:domain ev:EVSEPort ;
    rdfs:range xsd:string .

ev:portHasConnector a owl:ObjectProperty ;
    rdfs:label "has connector"@en,
        "커넥터"@ko ;
    rdfs:comment "Records has connector for EVSEPort."@en,
        "EVSEPort의 커넥터를 기록한다."@ko ;
    rdfs:domain ev:EVSEPort ;
    rdfs:range ev:ChargingConnector .

ev:portOutputCurrentType a owl:DatatypeProperty ;
    rdfs:label "output current type"@en,
        "출력 전류 유형"@ko ;
    rdfs:comment "Records output current type for EVSEPort."@en,
        "EVSEPort의 출력 전류 유형를 기록한다."@ko ;
    rdfs:domain ev:EVSEPort ;
    rdfs:range xsd:string .

ev:portSingleVehicleAtATime a owl:DatatypeProperty ;
    rdfs:label "supplies one vehicle at a time"@en,
        "동시 충전 차량 제한"@ko ;
    rdfs:comment "Records supplies one vehicle at a time for EVSEPort."@en,
        "EVSEPort의 동시 충전 차량 제한를 기록한다."@ko ;
    rdfs:domain ev:EVSEPort ;
    rdfs:range xsd:boolean .

ev:recordDescription a owl:DatatypeProperty ;
    rdfs:label "description"@en,
        "설명"@ko ;
    rdfs:comment "Records description for ResourceRecord."@en,
        "ResourceRecord의 설명를 기록한다."@ko ;
    rdfs:domain ev:ResourceRecord ;
    rdfs:range rdf:langString .

ev:recordIdentifier a owl:DatatypeProperty ;
    rdfs:label "record identifier"@en,
        "기록 식별자"@ko ;
    rdfs:comment "Records record identifier for ResourceRecord."@en,
        "ResourceRecord의 기록 식별자를 기록한다."@ko ;
    rdfs:domain ev:ResourceRecord ;
    rdfs:range xsd:string .

ev:recordLabel a owl:DatatypeProperty ;
    rdfs:label "display label"@en,
        "표시 이름"@ko ;
    rdfs:comment "Records display label for ResourceRecord."@en,
        "ResourceRecord의 표시 이름를 기록한다."@ko ;
    rdfs:domain ev:ResourceRecord ;
    rdfs:range rdf:langString .

ev:sessionConnector a owl:ObjectProperty ;
    rdfs:label "connector used"@en,
        "사용 커넥터"@ko ;
    rdfs:comment "Records connector used for ChargingSession."@en,
        "ChargingSession의 사용 커넥터를 기록한다."@ko ;
    rdfs:domain ev:ChargingSession ;
    rdfs:range ev:ChargingConnector .

ev:sessionCurrentType a owl:DatatypeProperty ;
    rdfs:label "current type"@en,
        "전류 유형"@ko ;
    rdfs:comment "Records current type for ChargingSession."@en,
        "ChargingSession의 전류 유형를 기록한다."@ko ;
    rdfs:domain ev:ChargingSession ;
    rdfs:range xsd:string .

ev:sessionDataStatus a owl:DatatypeProperty ;
    rdfs:label "data status"@en,
        "데이터 상태"@ko ;
    rdfs:comment "Records data status for ChargingSession."@en,
        "ChargingSession의 데이터 상태를 기록한다."@ko ;
    rdfs:domain ev:ChargingSession ;
    rdfs:range xsd:string .

ev:sessionEVSEPort a owl:ObjectProperty ;
    rdfs:label "EVSE port in session"@en,
        "충전 포트"@ko ;
    rdfs:comment "Records EVSE port in session for ChargingSession."@en,
        "ChargingSession의 충전 포트를 기록한다."@ko ;
    rdfs:domain ev:ChargingSession ;
    rdfs:range ev:EVSEPort .

ev:sessionState a owl:DatatypeProperty ;
    rdfs:label "session state"@en,
        "세션 상태"@ko ;
    rdfs:comment "Records session state for ChargingSession."@en,
        "ChargingSession의 세션 상태를 기록한다."@ko ;
    rdfs:domain ev:ChargingSession ;
    rdfs:range xsd:string .

ev:sessionVehicle a owl:ObjectProperty ;
    rdfs:label "vehicle in session"@en,
        "충전 차량"@ko ;
    rdfs:comment "Records vehicle in session for ChargingSession."@en,
        "ChargingSession의 충전 차량를 기록한다."@ko ;
    rdfs:domain ev:ChargingSession ;
    rdfs:range ev:Vehicle .

ev:sourceAccessedOn a owl:DatatypeProperty ;
    rdfs:label "accessed on"@en,
        "확인일"@ko ;
    rdfs:comment "Records accessed on for SourceDocument."@en,
        "SourceDocument의 확인일를 기록한다."@ko ;
    rdfs:domain ev:SourceDocument ;
    rdfs:range xsd:date .

ev:sourcePublisher a owl:DatatypeProperty ;
    rdfs:label "publisher"@en,
        "발행 기관"@ko ;
    rdfs:comment "Records publisher for SourceDocument."@en,
        "SourceDocument의 발행 기관를 기록한다."@ko ;
    rdfs:domain ev:SourceDocument ;
    rdfs:range xsd:string .

ev:sourceScope a owl:DatatypeProperty ;
    rdfs:label "source scope and caveat"@en,
        "출처 범위와 주의"@ko ;
    rdfs:comment "Records source scope and caveat for SourceDocument."@en,
        "SourceDocument의 출처 범위와 주의를 기록한다."@ko ;
    rdfs:domain ev:SourceDocument ;
    rdfs:range rdf:langString .

ev:sourceTitle a owl:DatatypeProperty ;
    rdfs:label "source title"@en,
        "출처 제목"@ko ;
    rdfs:comment "Records source title for SourceDocument."@en,
        "SourceDocument의 출처 제목를 기록한다."@ko ;
    rdfs:domain ev:SourceDocument ;
    rdfs:range rdf:langString .

ev:sourceURL a owl:DatatypeProperty ;
    rdfs:label "source URL"@en,
        "출처 URL"@ko ;
    rdfs:comment "Records source URL for SourceDocument."@en,
        "SourceDocument의 출처 URL를 기록한다."@ko ;
    rdfs:domain ev:SourceDocument ;
    rdfs:range xsd:anyURI .

ev:stationDataStatus a owl:DatatypeProperty ;
    rdfs:label "data status"@en,
        "데이터 상태"@ko ;
    rdfs:comment "Records data status for ChargingStationLocation."@en,
        "ChargingStationLocation의 데이터 상태를 기록한다."@ko ;
    rdfs:domain ev:ChargingStationLocation ;
    rdfs:range xsd:string .

ev:stationHasPort a owl:ObjectProperty ;
    rdfs:label "has charging port"@en,
        "충전 포트"@ko ;
    rdfs:comment "Records has charging port for ChargingStationLocation."@en,
        "ChargingStationLocation의 충전 포트를 기록한다."@ko ;
    rdfs:domain ev:ChargingStationLocation ;
    rdfs:range ev:EVSEPort .

ev:vehicleChargingEnergySource a owl:DatatypeProperty ;
    rdfs:label "charging energy source"@en,
        "충전 에너지원"@ko ;
    rdfs:comment "Records charging energy source for Vehicle."@en,
        "Vehicle의 충전 에너지원를 기록한다."@ko ;
    rdfs:domain ev:Vehicle ;
    rdfs:range xsd:string .

ev:vehicleHasComponent a owl:ObjectProperty ;
    rdfs:label "has component"@en,
        "구성품"@ko ;
    rdfs:comment "Records has component for Vehicle."@en,
        "Vehicle의 구성품를 기록한다."@ko ;
    rdfs:domain ev:Vehicle ;
    rdfs:range ev:PowertrainComponent .

ev:vehicleHasEvidence a owl:ObjectProperty ;
    rdfs:label "vehicle evidence"@en,
        "차량 유형 근거"@ko ;
    rdfs:comment "Records vehicle evidence for Vehicle."@en,
        "Vehicle의 차량 유형 근거를 기록한다."@ko ;
    rdfs:domain ev:Vehicle ;
    rdfs:range ev:EvidenceRecord .

ev:vehiclePlugInChargeable a owl:DatatypeProperty ;
    rdfs:label "chargeable from off-board electricity"@en,
        "외부 충전 가능"@ko ;
    rdfs:comment "Records chargeable from off-board electricity for Vehicle."@en,
        "Vehicle의 외부 충전 가능를 기록한다."@ko ;
    rdfs:domain ev:Vehicle ;
    rdfs:range xsd:boolean .

ev:vehiclePowertrainConfiguration a owl:DatatypeProperty ;
    rdfs:label "powertrain configuration"@en,
        "동력 구성"@ko ;
    rdfs:comment "Records powertrain configuration for Vehicle."@en,
        "Vehicle의 동력 구성를 기록한다."@ko ;
    rdfs:domain ev:Vehicle ;
    rdfs:range xsd:string .

ev:vehiclePropulsionMode a owl:DatatypeProperty ;
    rdfs:label "propulsion mode"@en,
        "추진 방식"@ko ;
    rdfs:comment "Records propulsion mode for Vehicle."@en,
        "Vehicle의 추진 방식를 기록한다."@ko ;
    rdfs:domain ev:Vehicle ;
    rdfs:range xsd:string .

ev:ChargingStationLocation a owl:Class ;
    rdfs:label "Charging station location"@en,
        "충전소 위치"@ko ;
    rdfs:comment "A physical location containing one or more EV charging ports."@en,
        "하나 이상의 전기차 충전 포트가 설치된 물리적 장소다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:CoverageNote a owl:Class ;
    rdfs:label "Coverage note"@en,
        "범위 메모"@ko ;
    rdfs:comment "States what this draft includes, limits, or excludes."@en,
        "초안에 포함하거나 제한하거나 제외한 지식 범위를 설명한다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:ElectrifiedVehicle a owl:Class ;
    rdfs:label "Electrified vehicle"@en,
        "전동화 차량"@ko ;
    rdfs:comment "A vehicle category using electric-drive elements; colloquial EV usage is distinct from plug-in vehicle categories."@en,
        "전기 구동 요소를 사용하는 차량 범주다. 일상어의 EV와 플러그인 전기차 범주를 구별한다."@ko ;
    rdfs:subClassOf ev:Vehicle .

ev:ChargingConnector a owl:Class ;
    rdfs:label "Charging connector"@en,
        "충전 커넥터"@ko ;
    rdfs:comment "A connector physically linking an EVSE port and a vehicle charge port."@en,
        "EVSE 포트와 차량 충전구를 물리적으로 연결하는 커넥터다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:EnergyFlow a owl:Class ;
    rdfs:label "Energy flow"@en,
        "에너지 흐름"@ko ;
    rdfs:comment "Represents a directed electrical or mechanical energy flow and its conditions."@en,
        "전기 또는 기계 에너지의 방향과 조건을 나타낸다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:ChargingSession a owl:Class ;
    rdfs:label "Charging session"@en,
        "충전 세션"@ko ;
    rdfs:comment "A record of one charging interaction involving a vehicle, EVSE port, and connector."@en,
        "차량, EVSE 포트와 커넥터가 관여하는 한 번의 충전 과정 기록이다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:EVSEPort a owl:Class ;
    rdfs:label "EVSE port"@en,
        "EVSE 충전 포트"@ko ;
    rdfs:comment "The equipment-side port that supplies one vehicle at a time; one port may have multiple connectors."@en,
        "한 번에 한 차량에 전력을 공급하는 설비 측 포트다. 한 포트에 여러 커넥터가 있을 수 있다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:SourceDocument a owl:Class ;
    rdfs:label "Source document"@en,
        "출처 문서"@ko ;
    rdfs:comment "Preserves a source's publisher, URL, access date, and scope."@en,
        "발행기관, URL, 확인일과 서술 범위를 보존한다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en,
        "차량"@ko ;
    rdfs:comment "A vehicle or vehicle archetype whose propulsion and drivetrain are described."@en,
        "동력원과 구동계 구성을 기록하는 차량 또는 차량 유형이다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:EvidenceRecord a owl:Class ;
    rdfs:label "Evidence record"@en,
        "근거 기록"@ko ;
    rdfs:comment "A claim-level evidence record with a source locator and stated scope."@en,
        "출처 위치와 적용 범위가 명시된 주장의 근거다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:PowertrainComponent a owl:Class ;
    rdfs:label "Powertrain component"@en,
        "구동계 구성품"@ko ;
    rdfs:comment "A component participating in electric propulsion, energy storage, power conversion, or power transfer."@en,
        "전기 구동, 에너지 저장, 전력 변환 또는 동력 전달에 참여하는 구성품이다."@ko ;
    rdfs:subClassOf ev:ResourceRecord .

ev:ResourceRecord a owl:Class ;
    rdfs:label "Resource record"@en,
        "자원 기록"@ko ;
    rdfs:comment "A named ontology resource with a stable local identifier."@en,
        "식별자와 다국어 이름을 가진 온톨로지 자원이다."@ko .
