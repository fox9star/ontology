item:british-shorthair a cat:Breed ;
    rdfs:label "British Shorthair"@en,
        "브리티시 쇼트헤어"@ko ;
    cat:describedBy item:cfa-british-shorthair ;
    cat:hasTrait item:british-shorthair-body,
        item:british-shorthair-coat .

item:british-shorthair-body a cat:Trait ;
    rdfs:label "British Shorthair body description"@en,
        "브리티시 쇼트헤어의 체형 기술"@ko ;
    cat:documentedBy item:cfa-british-shorthair ;
    cat:traitCategory "body" ;
    cat:traitText "CFA 표준은 다부지고 힘 있는 몸과 넓은 가슴을 기술한다." .

item:british-shorthair-coat a cat:Trait ;
    rdfs:label "British Shorthair coat description"@en,
        "브리티시 쇼트헤어의 털 기술"@ko ;
    cat:documentedBy item:cfa-british-shorthair ;
    cat:traitCategory "coat" ;
    cat:traitText "CFA 표준은 짧고 매우 조밀한 털을 기술한다." .

item:enclosed-space a cat:Environment ;
    rdfs:label "Synthetic enclosed outdoor space"@en,
        "합성 울타리 외부 공간"@ko ;
