    cat:environmentType "enclosed-outdoor" .

item:maine-coon a cat:Breed ;
    rdfs:label "Maine Coon Cat"@en,
        "메인쿤"@ko ;
    cat:describedBy item:cfa-maine-coon ;
    cat:hasTrait item:maine-coon-body,
        item:maine-coon-coat .

item:maine-coon-body a cat:Trait ;
    rdfs:label "Maine Coon body description"@en,
        "메인쿤의 체형 기술"@ko ;
    cat:documentedBy item:cfa-maine-coon ;
    cat:traitCategory "body" ;
    cat:traitText "CFA 표준은 길고 균형 잡힌 직사각형 형태의 몸을 기술한다." .

item:maine-coon-coat a cat:Trait ;
    rdfs:label "Maine Coon coat description"@en,
        "메인쿤의 털 기술"@ko ;
    cat:documentedBy item:cfa-maine-coon ;
    cat:traitCategory "coat" ;
    cat:traitText "CFA 표준은 풍성하고 길이가 고르지 않은 털을 기술하며, 어깨의 털은 배와 뒷다리 부위보다 짧다." .

item:norwegian-forest a cat:Breed ;
    rdfs:label "Norwegian Forest Cat"@en,
        "노르웨이 숲"@ko ;
