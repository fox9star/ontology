    cat:traitCategory "body" ;
    cat:traitText "CFA 표준은 근육이 발달하고 넓은 가슴을 가진 몸을 기술한다." .

item:norwegian-forest-coat a cat:Trait ;
    rdfs:label "Norwegian Forest Cat double coat description"@en,
        "노르웨이 숲의 이중모 기술"@ko ;
