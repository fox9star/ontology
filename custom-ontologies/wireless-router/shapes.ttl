@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix wr: <https://example.org/ontology/custom/wireless-router#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wr:AssociationRecordShape a sh:NodeShape ;
    sh:message "무선 접속 기록의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "수신 신호 dBm의 값과 형식을 확인하세요."@ko ;
            sh:path wr:associationSignalDbm ],
        [ sh:class wr:WirelessNetwork ;
            sh:maxCount 1 ;
            sh:message "접속 무선망의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:associationToNetwork ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "접속 관측 시각의 값과 형식을 확인하세요."@ko ;
            sh:path wr:associationObservedAt ],
        [ sh:datatype xsd:string ;
            sh:in ( "observed"^^xsd:string "not_observed"^^xsd:string "not_provided"^^xsd:string "synthetic"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "접속 근거 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:associationEvidenceStatus ],
        [ sh:datatype xsd:string ;
            sh:in ( "associated"^^xsd:string "disconnected"^^xsd:string "denied"^^xsd:string "planned"^^xsd:string "not_observed"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "접속 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:associationStatus ],
        [ sh:class wr:ClientDevice ;
            sh:maxCount 1 ;
            sh:message "접속 단말의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:associationForClient ],
        [ sh:class wr:PerformanceObservation ;
            sh:message "성능 관측의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:associationHasObservation ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "링크 속도 Mbps의 값과 형식을 확인하세요."@ko ;
            sh:minInclusive 0.0 ;
            sh:path wr:associationLinkRateMbps ],
        [ sh:datatype xsd:string ;
            sh:in ( "observed"^^xsd:string "planned"^^xsd:string "illustrative"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "접속 기록 성격의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:associationIntent ] ;
    sh:targetClass wr:AssociationRecord .

wr:ClientDeviceShape a sh:NodeShape ;
    sh:message "클라이언트 장치의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "observed"^^xsd:string "not_observed"^^xsd:string "not_provided"^^xsd:string "synthetic"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "단말 근거 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:clientEvidenceStatus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "클라이언트 가명의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:clientPseudonym ],
        [ sh:datatype xsd:string ;
            sh:in ( "pseudonym_only"^^xsd:string "redacted"^^xsd:string "withheld"^^xsd:string "not_recorded"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "단말 식별자 처리의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:clientIdentityHandling ],
        [ sh:class wr:RouterSystem ;
            sh:maxCount 1 ;
            sh:message "소속 시스템의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:clientPartOfSystem ],
        [ sh:class wr:AssociationRecord ;
            sh:message "접속 기록의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:clientHasAssociation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "클라이언트 종류의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:clientCategory ],
        [ sh:datatype xsd:string ;
            sh:in ( "planned"^^xsd:string "known"^^xsd:string "unknown"^^xsd:string "retired"^^xsd:string "synthetic"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "단말 목록 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:clientInventoryStatus ] ;
    sh:targetClass wr:ClientDevice .

wr:ConfigurationSnapshotShape a sh:NodeShape ;
    sh:message "설정 스냅샷의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "변경 요약의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:snapshotChangeSummary ],
        [ sh:datatype xsd:string ;
            sh:in ( "applied"^^xsd:string "not_applied"^^xsd:string "partially_applied"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "설정 적용 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:snapshotAppliedStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "스냅샷 시각의 값과 형식을 확인하세요."@ko ;
            sh:path wr:snapshotCapturedAt ],
        [ sh:datatype xsd:string ;
            sh:in ( "planned"^^xsd:string "current"^^xsd:string "archived"^^xsd:string "superseded"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "스냅샷 생애주기 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:snapshotLifecycleStatus ],
        [ sh:datatype xsd:string ;
            sh:in ( "manually_entered"^^xsd:string "device_export"^^xsd:string "synthetic"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "스냅샷 출처 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:snapshotProvenanceStatus ],
        [ sh:datatype xsd:string ;
            sh:in ( "complete"^^xsd:string "partial"^^xsd:string "unknown"^^xsd:string "not_assessed"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "스냅샷 완전성의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:snapshotCompletenessStatus ],
        [ sh:class wr:DocumentationSource ;
            sh:message "스냅샷 출처 문서의 값과 형식을 확인하세요."@ko ;
            sh:path wr:snapshotDocumentedBy ],
        [ sh:datatype xsd:string ;
            sh:in ( "secrets_omitted"^^xsd:string "identifiers_redacted"^^xsd:string "not_applicable_no_secrets"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "비식별·비밀 제거 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:snapshotRedactionStatus ],
        [ sh:class wr:RouterDevice ;
            sh:maxCount 1 ;
            sh:message "대상 장치의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:snapshotForDevice ] ;
    sh:targetClass wr:ConfigurationSnapshot .

wr:DocumentationSourceShape a sh:NodeShape ;
    sh:message "문서 출처의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "확인 날짜의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:sourceAccessedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "발행 기관의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:sourcePublisher ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "자료가 뒷받침하는 범위의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:sourceScope ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:message "문서 URI의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:sourceUri ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "발행 연도의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minInclusive 1900 ;
            sh:path wr:sourceYear ],
        [ sh:datatype xsd:string ;
            sh:in ( "government_guidance"^^xsd:string "standards_catalogue"^^xsd:string "official_specification"^^xsd:string "vendor_documentation"^^xsd:string "other"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "자료 종류의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:sourceMaterialKind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "문서 제목의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:sourceTitle ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "자료 한계의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:sourceLimitations ] ;
    sh:targetClass wr:DocumentationSource .

wr:FirmwareReleaseShape a sh:NodeShape ;
    sh:message "펌웨어 릴리스의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:class wr:RouterDevice ;
            sh:message "대상 장치 계열의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:firmwareReleaseForDevice ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "펌웨어 버전 표기의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:firmwareVersionLabel ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "펌웨어 발행자 표기의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:firmwarePublisherLabel ],
        [ sh:datatype xsd:string ;
            sh:in ( "supported"^^xsd:string "unsupported"^^xsd:string "end_of_support"^^xsd:string "unknown"^^xsd:string "not_assessed"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "지원 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:firmwareSupportStatus ],
        [ sh:datatype xsd:string ;
            sh:in ( "vendor_signed"^^xsd:string "vendor_documented"^^xsd:string "not_provided"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "펌웨어 출처 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:firmwareArtifactProvenance ],
        [ sh:class wr:DocumentationSource ;
            sh:message "릴리스 근거의 값과 형식을 확인하세요."@ko ;
            sh:path wr:firmwareReleaseDocumentedBy ] ;
    sh:targetClass wr:FirmwareRelease .

wr:FirmwareUpdateShape a sh:NodeShape ;
    sh:message "펌웨어 업데이트의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "observed"^^xsd:string "documented"^^xsd:string "not_provided"^^xsd:string "not_observed"^^xsd:string "synthetic"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "업데이트 근거 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:updateEvidenceStatus ],
        [ sh:class wr:DocumentationSource ;
            sh:message "업데이트 근거의 값과 형식을 확인하세요."@ko ;
            sh:path wr:updateDocumentedBy ],
        [ sh:datatype xsd:string ;
            sh:in ( "planned"^^xsd:string "available"^^xsd:string "downloading"^^xsd:string "installed"^^xsd:string "failed"^^xsd:string "rolled_back"^^xsd:string "unknown"^^xsd:string "not_assessed"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "업데이트 진행 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:updateLifecycleStatus ],
        [ sh:class wr:FirmwareRelease ;
            sh:maxCount 1 ;
            sh:message "현재 릴리스의 값과 형식을 확인하세요."@ko ;
            sh:path wr:updateFromRelease ],
        [ sh:datatype xsd:string ;
            sh:in ( "required"^^xsd:string "not_required"^^xsd:string "pending"^^xsd:string "completed"^^xsd:string "unknown"^^xsd:string "not_observed"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "재시작 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:updateRebootStatus ],
        [ sh:class wr:FirmwareRelease ;
            sh:maxCount 1 ;
            sh:message "목표 릴리스의 값과 형식을 확인하세요."@ko ;
            sh:path wr:updateToRelease ],
        [ sh:datatype xsd:string ;
            sh:in ( "available"^^xsd:string "unavailable"^^xsd:string "planned"^^xsd:string "unknown"^^xsd:string "not_tested"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "롤백 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:updateRollbackStatus ],
        [ sh:class wr:RouterDevice ;
            sh:maxCount 1 ;
            sh:message "업데이트 대상의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:updateTargetsDevice ] ;
    sh:targetClass wr:FirmwareUpdate .

wr:IncidentRecordShape a sh:NodeShape ;
    sh:message "장애·보안 사건 기록의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "informational"^^xsd:string "low"^^xsd:string "medium"^^xsd:string "high"^^xsd:string "critical"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "심각도의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:incidentSeverity ],
        [ sh:class wr:WirelessNetwork ;
            sh:message "영향 무선망의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:incidentAffectsNetwork ],
        [ sh:datatype xsd:string ;
            sh:in ( "not_started"^^xsd:string "planned"^^xsd:string "in_progress"^^xsd:string "completed"^^xsd:string "not_observed"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "대응 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:incidentResponseStatus ],
        [ sh:datatype xsd:string ;
            sh:in ( "coverage"^^xsd:string "connectivity"^^xsd:string "security"^^xsd:string "performance"^^xsd:string "firmware"^^xsd:string "configuration"^^xsd:string "other"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "사건 분류의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:incidentCategory ],
        [ sh:class wr:RouterDevice ;
            sh:message "영향 장치의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:incidentAffectsDevice ],
        [ sh:datatype xsd:string ;
            sh:in ( "observed"^^xsd:string "not_observed"^^xsd:string "synthetic"^^xsd:string "not_provided"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "사건 근거 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:incidentEvidenceStatus ],
        [ sh:class wr:DocumentationSource ;
            sh:message "사건 근거의 값과 형식을 확인하세요."@ko ;
            sh:path wr:incidentEvidenceSource ],
        [ sh:datatype xsd:string ;
            sh:in ( "open"^^xsd:string "investigating"^^xsd:string "resolved"^^xsd:string "closed"^^xsd:string "none_recorded"^^xsd:string "not_observed"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "사건 진행 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:incidentLifecycleStatus ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "발견 시각의 값과 형식을 확인하세요."@ko ;
            sh:path wr:incidentDetectedAt ],
        [ sh:class wr:UplinkConnection ;
            sh:message "영향 상위 연결의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:incidentAffectsUplink ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "영향 범위의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:incidentImpactScope ] ;
    sh:targetClass wr:IncidentRecord .

wr:IsolationPolicyShape a sh:NodeShape ;
    sh:message "망 분리 정책의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:class wr:DocumentationSource ;
            sh:message "근거 문서의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:policyDocumentedBy ],
        [ sh:class wr:NetworkSegment ;
            sh:message "적용 대상 구간의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:policyAppliesToSegment ],
        [ sh:datatype xsd:string ;
            sh:in ( "ingress"^^xsd:string "egress"^^xsd:string "east_west"^^xsd:string "north_south"^^xsd:string "bidirectional"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "정책 트래픽 방향의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:policyTrafficDirection ],
        [ sh:datatype xsd:string ;
            sh:in ( "planned"^^xsd:string "applied"^^xsd:string "disabled"^^xsd:string "not_assessed"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "정책 적용 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:policyApplicationStatus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "차단 흐름 범위의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:policyDeniedFlowScope ],
        [ sh:datatype xsd:string ;
            sh:in ( "documented"^^xsd:string "observed"^^xsd:string "not_provided"^^xsd:string "not_assessed"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "정책 근거 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:policyEvidenceStatus ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "허용 흐름 범위의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:policyAllowedFlowScope ] ;
    sh:targetClass wr:IsolationPolicy .

wr:NetworkSegmentShape a sh:NodeShape ;
    sh:message "네트워크 구간의 필수 속성과 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype xsd:string ;
