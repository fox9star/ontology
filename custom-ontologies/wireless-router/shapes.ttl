            sh:message "접속 정책 유형의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:networkAssociationRule ],
        [ sh:class wr:RadioInterface ;
            sh:message "사용 무선 인터페이스의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path wr:networkUsesRadio ],
        [ sh:datatype xsd:string ;
            sh:in ( "planned"^^xsd:string "enabled"^^xsd:string "disabled"^^xsd:string "retired"^^xsd:string "unknown"^^xsd:string "not_observed"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "무선망 설정 상태의 값과 형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path wr:networkLifecycleStatus ],
        [ sh:class wr:PerformanceObservation ;
            sh:message "성능 관측의 값과 형식을 확인하세요."@ko ;
            sh:path wr:networkHasObservation ] ;
    sh:targetClass wr:WirelessNetwork .
