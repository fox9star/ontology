    rdfs:comment "Records a relation from Incident record to Uplink connection."@en,
        "장애·보안 사건 기록에서 상위 연결와의 관계를 기록한다."@ko ;
    rdfs:domain wr:IncidentRecord ;
    rdfs:range wr:UplinkConnection .

wr:incidentCategory a owl:DatatypeProperty ;
