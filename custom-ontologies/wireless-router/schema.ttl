        "무선 네트워크 프로필에서 성능 관측와의 관계를 기록한다."@ko ;
    rdfs:domain wr:WirelessNetwork ;
    rdfs:range wr:PerformanceObservation .

wr:networkIdentifierHandling a owl:DatatypeProperty ;
