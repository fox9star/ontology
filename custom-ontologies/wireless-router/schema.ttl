@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wr: <https://example.org/ontology/custom/wireless-router#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wr: a owl:Ontology ;
    rdfs:label "Wireless Router Ontology"@en,
        "무선공유기 온톨로지"@ko ;
    rdfs:comment "A local draft connecting wireless router devices and networks with security, associations, firmware, configuration, and observations. Example records are synthetic."@en,
        "무선공유기 장치와 무선망의 구성·보안·접속·펌웨어·설정·관측을 연결하는 로컬 초안이다. 예시 자료는 합성 데이터이다."@ko ;
    owl:versionInfo "0.1.0" .

wr:associationEvidenceStatus a owl:DatatypeProperty ;
    rdfs:label "association evidence state"@en,
        "접속 근거 상태"@ko ;
    rdfs:comment "Records the association evidence state value or state for Wireless association record."@en,
        "무선 접속 기록의 접속 근거 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range xsd:string .

wr:associationForClient a owl:ObjectProperty ;
    rdfs:label "for client"@en,
        "접속 단말"@ko ;
    rdfs:comment "Records a relation from Wireless association record to Client device."@en,
        "무선 접속 기록에서 클라이언트 장치와의 관계를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range wr:ClientDevice .

wr:associationHasObservation a owl:ObjectProperty ;
    rdfs:label "has observation"@en,
        "성능 관측"@ko ;
    rdfs:comment "Records a relation from Wireless association record to Performance observation."@en,
        "무선 접속 기록에서 성능 관측와의 관계를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range wr:PerformanceObservation .

wr:associationIntent a owl:DatatypeProperty ;
    rdfs:label "association record intent"@en,
        "접속 기록 성격"@ko ;
    rdfs:comment "Records the association record intent value or state for Wireless association record."@en,
        "무선 접속 기록의 접속 기록 성격 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range xsd:string .

wr:associationLinkRateMbps a owl:DatatypeProperty ;
    rdfs:label "link rate in Mbps"@en,
        "링크 속도 Mbps"@ko ;
    rdfs:comment "Records the link rate in Mbps value or state for Wireless association record."@en,
        "무선 접속 기록의 링크 속도 Mbps 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range xsd:decimal .

wr:associationObservedAt a owl:DatatypeProperty ;
    rdfs:label "association observation time"@en,
        "접속 관측 시각"@ko ;
    rdfs:comment "Records the association observation time value or state for Wireless association record."@en,
        "무선 접속 기록의 접속 관측 시각 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range xsd:dateTime .

wr:associationSignalDbm a owl:DatatypeProperty ;
    rdfs:label "received signal in dBm"@en,
        "수신 신호 dBm"@ko ;
    rdfs:comment "Records the received signal in dBm value or state for Wireless association record."@en,
        "무선 접속 기록의 수신 신호 dBm 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range xsd:decimal .

wr:associationStatus a owl:DatatypeProperty ;
    rdfs:label "association state"@en,
        "접속 상태"@ko ;
    rdfs:comment "Records the association state value or state for Wireless association record."@en,
        "무선 접속 기록의 접속 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range xsd:string .

wr:associationToNetwork a owl:ObjectProperty ;
    rdfs:label "to network"@en,
        "접속 무선망"@ko ;
    rdfs:comment "Records a relation from Wireless association record to Wireless network profile."@en,
        "무선 접속 기록에서 무선 네트워크 프로필와의 관계를 기록한다."@ko ;
    rdfs:domain wr:AssociationRecord ;
    rdfs:range wr:WirelessNetwork .

wr:clientCategory a owl:DatatypeProperty ;
    rdfs:label "client category"@en,
        "클라이언트 종류"@ko ;
    rdfs:comment "Records the client category value or state for Client device."@en,
        "클라이언트 장치의 클라이언트 종류 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ClientDevice ;
    rdfs:range xsd:string .

wr:clientEvidenceStatus a owl:DatatypeProperty ;
    rdfs:label "client evidence state"@en,
        "단말 근거 상태"@ko ;
    rdfs:comment "Records the client evidence state value or state for Client device."@en,
        "클라이언트 장치의 단말 근거 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ClientDevice ;
    rdfs:range xsd:string .

wr:clientHasAssociation a owl:ObjectProperty ;
    rdfs:label "has association"@en,
        "접속 기록"@ko ;
    rdfs:comment "Records a relation from Client device to Wireless association record."@en,
        "클라이언트 장치에서 무선 접속 기록와의 관계를 기록한다."@ko ;
    rdfs:domain wr:ClientDevice ;
    rdfs:range wr:AssociationRecord .

wr:clientIdentityHandling a owl:DatatypeProperty ;
    rdfs:label "client identity handling"@en,
        "단말 식별자 처리"@ko ;
    rdfs:comment "Records the client identity handling value or state for Client device."@en,
        "클라이언트 장치의 단말 식별자 처리 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ClientDevice ;
    rdfs:range xsd:string .

wr:clientInventoryStatus a owl:DatatypeProperty ;
    rdfs:label "client inventory state"@en,
        "단말 목록 상태"@ko ;
    rdfs:comment "Records the client inventory state value or state for Client device."@en,
        "클라이언트 장치의 단말 목록 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ClientDevice ;
    rdfs:range xsd:string .

wr:clientPartOfSystem a owl:ObjectProperty ;
    rdfs:label "part of system"@en,
        "소속 시스템"@ko ;
    rdfs:comment "Records a relation from Client device to Wireless router system."@en,
        "클라이언트 장치에서 무선 공유기 시스템와의 관계를 기록한다."@ko ;
    rdfs:domain wr:ClientDevice ;
    rdfs:range wr:RouterSystem .

wr:clientPseudonym a owl:DatatypeProperty ;
    rdfs:label "client pseudonym"@en,
        "클라이언트 가명"@ko ;
    rdfs:comment "Records the client pseudonym value or state for Client device."@en,
        "클라이언트 장치의 클라이언트 가명 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ClientDevice ;
    rdfs:range xsd:string .

wr:deviceHasFirmwareRelease a owl:ObjectProperty ;
    rdfs:label "has firmware release"@en,
        "펌웨어 릴리스"@ko ;
    rdfs:comment "Records a relation from Router device to Firmware release."@en,
        "공유기 장치에서 펌웨어 릴리스와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range wr:FirmwareRelease .

wr:deviceHasIncident a owl:ObjectProperty ;
    rdfs:label "has incident record"@en,
        "사건 기록"@ko ;
    rdfs:comment "Records a relation from Router device to Incident record."@en,
        "공유기 장치에서 장애·보안 사건 기록와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range wr:IncidentRecord .

wr:deviceHasRadio a owl:ObjectProperty ;
    rdfs:label "has radio"@en,
        "무선 인터페이스"@ko ;
    rdfs:comment "Records a relation from Router device to Radio interface."@en,
        "공유기 장치에서 무선 인터페이스와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range wr:RadioInterface .

wr:deviceHasSnapshot a owl:ObjectProperty ;
    rdfs:label "has snapshot"@en,
        "설정 스냅샷"@ko ;
    rdfs:comment "Records a relation from Router device to Configuration snapshot."@en,
        "공유기 장치에서 설정 스냅샷와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range wr:ConfigurationSnapshot .

wr:deviceHasUpdate a owl:ObjectProperty ;
    rdfs:label "has update"@en,
        "업데이트 기록"@ko ;
    rdfs:comment "Records a relation from Router device to Firmware update."@en,
        "공유기 장치에서 펌웨어 업데이트와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range wr:FirmwareUpdate .

wr:deviceIdentifierHandling a owl:DatatypeProperty ;
    rdfs:label "device identifier handling"@en,
        "장치 식별자 처리"@ko ;
    rdfs:comment "Records the device identifier handling value or state for Router device."@en,
        "공유기 장치의 장치 식별자 처리 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range xsd:string .

wr:deviceInventoryAlias a owl:DatatypeProperty ;
    rdfs:label "device inventory alias"@en,
        "장치 별칭"@ko ;
    rdfs:comment "Records the device inventory alias value or state for Router device."@en,
        "공유기 장치의 장치 별칭 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range xsd:string .

wr:deviceLifecycleStatus a owl:DatatypeProperty ;
    rdfs:label "device lifecycle status"@en,
        "장치 생애주기 상태"@ko ;
