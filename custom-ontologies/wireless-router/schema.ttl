    rdfs:comment "Records the redaction and secret omission state value or state for Configuration snapshot."@en,
        "설정 스냅샷의 비식별·비밀 제거 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ConfigurationSnapshot ;
    rdfs:range xsd:string .

wr:sourceAccessedAt a owl:DatatypeProperty ;
    rdfs:label "access date"@en,
        "확인 날짜"@ko ;
    rdfs:comment "Records the access date value or state for Documentation source."@en,
        "문서 출처의 확인 날짜 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:date .

wr:sourceLimitations a owl:DatatypeProperty ;
    rdfs:label "source limitations"@en,
        "자료 한계"@ko ;
    rdfs:comment "Records the source limitations value or state for Documentation source."@en,
        "문서 출처의 자료 한계 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:string .

wr:sourceMaterialKind a owl:DatatypeProperty ;
    rdfs:label "source material kind"@en,
        "자료 종류"@ko ;
    rdfs:comment "Records the source material kind value or state for Documentation source."@en,
        "문서 출처의 자료 종류 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:string .

wr:sourcePublisher a owl:DatatypeProperty ;
    rdfs:label "publisher"@en,
        "발행 기관"@ko ;
    rdfs:comment "Records the publisher value or state for Documentation source."@en,
        "문서 출처의 발행 기관 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:string .

wr:sourceScope a owl:DatatypeProperty ;
    rdfs:label "supported claim scope"@en,
        "자료가 뒷받침하는 범위"@ko ;
    rdfs:comment "Records the supported claim scope value or state for Documentation source."@en,
        "문서 출처의 자료가 뒷받침하는 범위 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:string .

wr:sourceTitle a owl:DatatypeProperty ;
    rdfs:label "document title"@en,
        "문서 제목"@ko ;
    rdfs:comment "Records the document title value or state for Documentation source."@en,
        "문서 출처의 문서 제목 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:string .

wr:sourceUri a owl:DatatypeProperty ;
    rdfs:label "document URI"@en,
        "문서 URI"@ko ;
    rdfs:comment "Records the document URI value or state for Documentation source."@en,
        "문서 출처의 문서 URI 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:anyURI .

wr:sourceYear a owl:DatatypeProperty ;
    rdfs:label "publication year"@en,
        "발행 연도"@ko ;
    rdfs:comment "Records the publication year value or state for Documentation source."@en,
        "문서 출처의 발행 연도 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:DocumentationSource ;
    rdfs:range xsd:integer .

wr:systemHasDevice a owl:ObjectProperty ;
    rdfs:label "has device"@en,
        "포함 장치"@ko ;
    rdfs:comment "Records a relation from Wireless router system to Router device."@en,
        "무선 공유기 시스템에서 공유기 장치와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterSystem ;
    rdfs:range wr:RouterDevice .

wr:systemHasNetwork a owl:ObjectProperty ;
    rdfs:label "has wireless network"@en,
        "포함 무선망"@ko ;
    rdfs:comment "Records a relation from Wireless router system to Wireless network profile."@en,
        "무선 공유기 시스템에서 무선 네트워크 프로필와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterSystem ;
    rdfs:range wr:WirelessNetwork .

wr:systemHasUplink a owl:ObjectProperty ;
    rdfs:label "has uplink"@en,
        "포함 상위 연결"@ko ;
    rdfs:comment "Records a relation from Wireless router system to Uplink connection."@en,
        "무선 공유기 시스템에서 상위 연결와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterSystem ;
    rdfs:range wr:UplinkConnection .

wr:systemRecordStatus a owl:DatatypeProperty ;
    rdfs:label "system record status"@en,
        "시스템 기록 상태"@ko ;
    rdfs:comment "Records the system record status value or state for Wireless router system."@en,
        "무선 공유기 시스템의 시스템 기록 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterSystem ;
    rdfs:range xsd:string .

wr:systemScopeNote a owl:DatatypeProperty ;
    rdfs:label "system scope note"@en,
        "시스템 범위 설명"@ko ;
    rdfs:comment "Records the system scope note value or state for Wireless router system."@en,
        "무선 공유기 시스템의 시스템 범위 설명 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterSystem ;
    rdfs:range xsd:string .

wr:updateDocumentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en,
        "업데이트 근거"@ko ;
    rdfs:comment "Records a relation from Firmware update to Documentation source."@en,
        "펌웨어 업데이트에서 문서 출처와의 관계를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range wr:DocumentationSource .

wr:updateEvidenceStatus a owl:DatatypeProperty ;
    rdfs:label "update evidence state"@en,
        "업데이트 근거 상태"@ko ;
    rdfs:comment "Records the update evidence state value or state for Firmware update."@en,
        "펌웨어 업데이트의 업데이트 근거 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range xsd:string .

wr:updateFromRelease a owl:ObjectProperty ;
    rdfs:label "from release"@en,
        "현재 릴리스"@ko ;
    rdfs:comment "Records a relation from Firmware update to Firmware release."@en,
        "펌웨어 업데이트에서 펌웨어 릴리스와의 관계를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range wr:FirmwareRelease .

wr:updateLifecycleStatus a owl:DatatypeProperty ;
    rdfs:label "update lifecycle state"@en,
        "업데이트 진행 상태"@ko ;
    rdfs:comment "Records the update lifecycle state value or state for Firmware update."@en,
        "펌웨어 업데이트의 업데이트 진행 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range xsd:string .

wr:updateRebootStatus a owl:DatatypeProperty ;
    rdfs:label "reboot state"@en,
        "재시작 상태"@ko ;
    rdfs:comment "Records the reboot state value or state for Firmware update."@en,
        "펌웨어 업데이트의 재시작 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range xsd:string .

wr:updateRollbackStatus a owl:DatatypeProperty ;
    rdfs:label "rollback state"@en,
        "롤백 상태"@ko ;
    rdfs:comment "Records the rollback state value or state for Firmware update."@en,
        "펌웨어 업데이트의 롤백 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range xsd:string .

wr:updateTargetsDevice a owl:ObjectProperty ;
    rdfs:label "targets device"@en,
        "업데이트 대상"@ko ;
    rdfs:comment "Records a relation from Firmware update to Router device."@en,
        "펌웨어 업데이트에서 공유기 장치와의 관계를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range wr:RouterDevice .

wr:updateToRelease a owl:ObjectProperty ;
    rdfs:label "target firmware release"@en,
        "목표 릴리스"@ko ;
    rdfs:comment "Records a relation from Firmware update to Firmware release."@en,
        "펌웨어 업데이트에서 펌웨어 릴리스와의 관계를 기록한다."@ko ;
    rdfs:domain wr:FirmwareUpdate ;
    rdfs:range wr:FirmwareRelease .

wr:uplinkAttachedToDevice a owl:ObjectProperty ;
    rdfs:label "attached to device"@en,
        "연결 장치"@ko ;
    rdfs:comment "Records a relation from Uplink connection to Router device."@en,
        "상위 연결에서 공유기 장치와의 관계를 기록한다."@ko ;
    rdfs:domain wr:UplinkConnection ;
    rdfs:range wr:RouterDevice .

wr:uplinkConnectionStatus a owl:DatatypeProperty ;
    rdfs:label "uplink state"@en,
        "상위 연결 상태"@ko ;
    rdfs:comment "Records the uplink state value or state for Uplink connection."@en,
        "상위 연결의 상위 연결 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:UplinkConnection ;
    rdfs:range xsd:string .

wr:uplinkConnectionType a owl:DatatypeProperty ;
    rdfs:label "uplink type"@en,
        "상위 연결 종류"@ko ;
    rdfs:comment "Records the uplink type value or state for Uplink connection."@en,
        "상위 연결의 상위 연결 종류 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:UplinkConnection ;
    rdfs:range xsd:string .

wr:uplinkCredentialHandling a owl:DatatypeProperty ;
    rdfs:label "uplink credential handling"@en,
        "상위 인증 정보 처리"@ko ;
    rdfs:comment "Records the uplink credential handling value or state for Uplink connection."@en,
        "상위 연결의 상위 인증 정보 처리 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:UplinkConnection ;
    rdfs:range xsd:string .

wr:uplinkObservationStatus a owl:DatatypeProperty ;
    rdfs:label "uplink observation state"@en,
        "상위 연결 관측 상태"@ko ;
    rdfs:comment "Records the uplink observation state value or state for Uplink connection."@en,
        "상위 연결의 상위 연결 관측 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:UplinkConnection ;
    rdfs:range xsd:string .

wr:uplinkProviderDisclosure a owl:DatatypeProperty ;
    rdfs:label "provider disclosure state"@en,
        "사업자 정보 공개 상태"@ko ;
    rdfs:comment "Records the provider disclosure state value or state for Uplink connection."@en,
        "상위 연결의 사업자 정보 공개 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:UplinkConnection ;
    rdfs:range xsd:string .

wr:uplinkWithinSystem a owl:ObjectProperty ;
    rdfs:label "within system"@en,
        "소속 시스템"@ko ;
    rdfs:comment "Records a relation from Uplink connection to Wireless router system."@en,
        "상위 연결에서 무선 공유기 시스템와의 관계를 기록한다."@ko ;
    rdfs:domain wr:UplinkConnection ;
    rdfs:range wr:RouterSystem .

wr:ClientDevice a owl:Class ;
    rdfs:label "Client device"@en,
        "클라이언트 장치"@ko ;
    rdfs:comment "Represents a client category and record state using a synthetic or pseudonymous label instead of a real MAC or IP address."@en,
        "실제 MAC·IP 주소 대신 합성 또는 가명 식별자로 단말 종류와 기록 상태를 표현한다."@ko .

wr:IsolationPolicy a owl:Class ;
    rdfs:label "Network isolation policy"@en,
        "망 분리 정책"@ko ;
    rdfs:comment "Records intended allowed and denied flows between segments, their applied state, and evidence."@en,
        "구간 간 허용·차단 의도, 적용 상태와 근거를 기록한다."@ko .

wr:FirmwareRelease a owl:Class ;
    rdfs:label "Firmware release"@en,
        "펌웨어 릴리스"@ko ;
    rdfs:comment "Records firmware version and support or provenance state without inferring support for a particular product."@en,
        "장치 펌웨어 버전 및 지원·출처 상태를 기록하며 특정 제품 지원을 추정하지 않는다."@ko .

wr:FirmwareUpdate a owl:Class ;
    rdfs:label "Firmware update"@en,
        "펌웨어 업데이트"@ko ;
    rdfs:comment "Represents an update target, source and target release, progress, reboot, and rollback states."@en,
        "업데이트의 대상, 출발·목표 버전, 진행·재시작·롤백 상태를 표현한다."@ko .

wr:RouterSystem a owl:Class ;
    rdfs:label "Wireless router system"@en,
        "무선 공유기 시스템"@ko ;
    rdfs:comment "A management unit that groups router devices, wireless networks, wired connections, and operational records."@en,
        "공유기 장치, 무선망, 유선 연결 및 운영 기록을 묶는 관리 단위이다."@ko .

wr:SecurityProfile a owl:Class ;
    rdfs:label "Security profile"@en,
        "보안 프로필"@ko ;
    rdfs:comment "Records security-standard labels, application state, authentication and encryption modes, and evidence state separately."@en,
        "보안 표준 이름, 적용 상태, 인증·암호화 방식과 근거 상태를 분리해 기록한다."@ko .

wr:ConfigurationSnapshot a owl:Class ;
    rdfs:label "Configuration snapshot"@en,
        "설정 스냅샷"@ko ;
    rdfs:comment "Distinguishes planned, current, and archived configuration while recording application, completeness, redaction, and provenance."@en,
        "계획·현재·보관 설정을 구분하고 적용·완전성·비식별 상태 및 출처를 기록한다."@ko .

wr:NetworkSegment a owl:Class ;
    rdfs:label "Network segment"@en,
        "네트워크 구간"@ko ;
    rdfs:comment "Represents a trust zone and logical network boundary; address values are outside this ontology."@en,
        "신뢰 영역과 논리적 네트워크 구분을 표현한다. 주소 값 자체는 이 온톨로지에 두지 않는다."@ko .

wr:UplinkConnection a owl:Class ;
    rdfs:label "Uplink connection"@en,
        "상위 연결"@ko ;
    rdfs:comment "Represents the type and observed state of a router connection to an upstream internet, provider, or mesh path."@en,
        "공유기에서 상위 인터넷·사업자·메시 경로로 이어지는 연결의 종류와 관측 상태를 표현한다."@ko .

wr:RadioInterface a owl:Class ;
    rdfs:label "Radio interface"@en,
        "무선 인터페이스"@ko ;
    rdfs:comment "Represents supported radio capabilities, configured state, and network links for a band."@en,
        "무선 대역의 지원 능력, 설정 상태 및 네트워크 연결을 표현한다."@ko .

wr:AssociationRecord a owl:Class ;
    rdfs:label "Wireless association record"@en,
        "무선 접속 기록"@ko ;
    rdfs:comment "Distinguishes whether a client association is observed, planned, or unobserved."@en,
        "클라이언트가 무선망에 접속했는지, 계획인지, 관측되지 않았는지를 구분한다."@ko .

wr:IncidentRecord a owl:Class ;
    rdfs:label "Incident record"@en,
        "장애·보안 사건 기록"@ko ;
    rdfs:comment "Records the state and impact scope of an outage or security incident with supporting evidence."@en,
        "장애 또는 보안 사건의 상태와 영향 범위를 근거와 함께 기록한다."@ko .

wr:PerformanceObservation a owl:Class ;
    rdfs:label "Performance observation"@en,
        "성능 관측"@ko ;
    rdfs:comment "Separates measured values from unmeasured state and records target, time, method, and unit."@en,
        "측정값과 미측정 상태를 구분하고 측정 대상, 시각, 방법 및 단위를 기록한다."@ko .

wr:DocumentationSource a owl:Class ;
    rdfs:label "Documentation source"@en,
        "문서 출처"@ko ;
    rdfs:comment "Preserves the title, scope, and limitations of standards, guidance, and vendor documentation."@en,
        "표준·지침·제조사 문서의 제목, 범위 및 한계를 보존한다."@ko .

wr:WirelessNetwork a owl:Class ;
    rdfs:label "Wireless network profile"@en,
        "무선 네트워크 프로필"@ko ;
    rdfs:comment "Represents a wireless network alias, purpose, security profile, and logical segment without storing the literal SSID."@en,
        "SSID 원문을 저장하지 않고 무선망의 별칭, 용도, 보안 프로필 및 논리 구간 연결을 표현한다."@ko .

wr:RouterDevice a owl:Class ;
    rdfs:label "Router device"@en,
        "공유기 장치"@ko ;
    rdfs:comment "Describes the identity metadata and state of a device that provides wireless networking or manages network forwarding."@en,
        "무선 네트워크를 제공하거나 전달 경로를 관리하는 장치의 식별 정보와 상태를 기술한다."@ko .
