    rdfs:domain wr:IncidentRecord ;
    rdfs:range xsd:string .

wr:networkAssociationRule a owl:DatatypeProperty ;
    rdfs:label "association rule type"@en,
        "접속 정책 유형"@ko ;
    rdfs:comment "Records the association rule type value or state for Wireless network profile."@en,
        "무선 네트워크 프로필의 접속 정책 유형 값 또는 상태를 기록한다."@ko ;
