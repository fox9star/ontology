    rdfs:comment "Records a relation from Configuration snapshot to Router device."@en,
        "설정 스냅샷에서 공유기 장치와의 관계를 기록한다."@ko ;
    rdfs:domain wr:ConfigurationSnapshot ;
    rdfs:range wr:RouterDevice .

wr:snapshotLifecycleStatus a owl:DatatypeProperty ;
