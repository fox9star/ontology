    rdfs:comment "Records the snapshot time value or state for Configuration snapshot."@en,
        "설정 스냅샷의 스냅샷 시각 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ConfigurationSnapshot ;
