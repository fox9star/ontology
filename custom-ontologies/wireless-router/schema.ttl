        "공유기 장치의 장치 생애주기 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range xsd:string .

wr:deviceManagementExposure a owl:DatatypeProperty ;
    rdfs:label "management exposure state"@en,
        "관리 경로 노출 상태"@ko ;
    rdfs:comment "Records the management exposure state value or state for Router device."@en,
        "공유기 장치의 관리 경로 노출 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range xsd:string .

wr:deviceModelFamily a owl:DatatypeProperty ;
    rdfs:label "model family"@en,
        "모델 계열"@ko ;
    rdfs:comment "Records the model family value or state for Router device."@en,
        "공유기 장치의 모델 계열 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range xsd:string .

wr:deviceObservationStatus a owl:DatatypeProperty ;
    rdfs:label "device observation status"@en,
        "장치 관측 상태"@ko ;
    rdfs:comment "Records the device observation status value or state for Router device."@en,
        "공유기 장치의 장치 관측 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range xsd:string .

wr:devicePartOfSystem a owl:ObjectProperty ;
    rdfs:label "part of system"@en,
        "소속 시스템"@ko ;
    rdfs:comment "Records a relation from Router device to Wireless router system."@en,
        "공유기 장치에서 무선 공유기 시스템와의 관계를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range wr:RouterSystem .

wr:deviceVendorLabel a owl:DatatypeProperty ;
    rdfs:label "vendor label"@en,
        "제조사 표기"@ko ;
    rdfs:comment "Records the vendor label value or state for Router device."@en,
        "공유기 장치의 제조사 표기 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:RouterDevice ;
    rdfs:range xsd:string .

wr:firmwareArtifactProvenance a owl:DatatypeProperty ;
    rdfs:label "firmware provenance state"@en,
        "펌웨어 출처 상태"@ko ;
    rdfs:comment "Records the firmware provenance state value or state for Firmware release."@en,
        "펌웨어 릴리스의 펌웨어 출처 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareRelease ;
    rdfs:range xsd:string .

wr:firmwarePublisherLabel a owl:DatatypeProperty ;
    rdfs:label "firmware publisher label"@en,
        "펌웨어 발행자 표기"@ko ;
    rdfs:comment "Records the firmware publisher label value or state for Firmware release."@en,
        "펌웨어 릴리스의 펌웨어 발행자 표기 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareRelease ;
    rdfs:range xsd:string .

wr:firmwareReleaseDocumentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en,
        "릴리스 근거"@ko ;
    rdfs:comment "Records a relation from Firmware release to Documentation source."@en,
        "펌웨어 릴리스에서 문서 출처와의 관계를 기록한다."@ko ;
    rdfs:domain wr:FirmwareRelease ;
    rdfs:range wr:DocumentationSource .

wr:firmwareReleaseForDevice a owl:ObjectProperty ;
    rdfs:label "for device family"@en,
        "대상 장치 계열"@ko ;
    rdfs:comment "Records a relation from Firmware release to Router device."@en,
        "펌웨어 릴리스에서 공유기 장치와의 관계를 기록한다."@ko ;
    rdfs:domain wr:FirmwareRelease ;
    rdfs:range wr:RouterDevice .

wr:firmwareSupportStatus a owl:DatatypeProperty ;
    rdfs:label "support state"@en,
        "지원 상태"@ko ;
    rdfs:comment "Records the support state value or state for Firmware release."@en,
        "펌웨어 릴리스의 지원 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareRelease ;
    rdfs:range xsd:string .

wr:firmwareVersionLabel a owl:DatatypeProperty ;
    rdfs:label "firmware version label"@en,
        "펌웨어 버전 표기"@ko ;
    rdfs:comment "Records the firmware version label value or state for Firmware release."@en,
        "펌웨어 릴리스의 펌웨어 버전 표기 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:FirmwareRelease ;
    rdfs:range xsd:string .

wr:incidentAffectsDevice a owl:ObjectProperty ;
    rdfs:label "affects device"@en,
        "영향 장치"@ko ;
    rdfs:comment "Records a relation from Incident record to Router device."@en,
        "장애·보안 사건 기록에서 공유기 장치와의 관계를 기록한다."@ko ;
    rdfs:domain wr:IncidentRecord ;
    rdfs:range wr:RouterDevice .

wr:incidentAffectsNetwork a owl:ObjectProperty ;
