    rdfs:comment "Records the snapshot provenance state value or state for Configuration snapshot."@en,
        "설정 스냅샷의 스냅샷 출처 상태 값 또는 상태를 기록한다."@ko ;
    rdfs:domain wr:ConfigurationSnapshot ;
    rdfs:range xsd:string .

wr:snapshotRedactionStatus a owl:DatatypeProperty ;
