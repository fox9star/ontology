<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#updateRebootStatus">
    <rdfs:comment xml:lang="ko">펌웨어 업데이트의 재시작 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the reboot state value or state for Firmware update.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">재시작 상태</rdfs:label>
    <rdfs:label xml:lang="en">reboot state</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#FirmwareUpdate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#clientEvidenceStatus">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#ClientDevice"/>
    <rdfs:label xml:lang="ko">단말 근거 상태</rdfs:label>
    <rdfs:label xml:lang="en">client evidence state</rdfs:label>
    <rdfs:comment xml:lang="en">Records the client evidence state value or state for Client device.</rdfs:comment>
    <rdfs:comment xml:lang="ko">클라이언트 장치의 단말 근거 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#sourceScope">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#DocumentationSource"/>
    <rdfs:comment xml:lang="en">Records the supported claim scope value or state for Documentation source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">문서 출처의 자료가 뒷받침하는 범위 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="ko">자료가 뒷받침하는 범위</rdfs:label>
    <rdfs:label xml:lang="en">supported claim scope</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#securityDocumentedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">documented by</rdfs:label>
    <rdfs:label xml:lang="ko">근거 문서</rdfs:label>
    <rdfs:comment xml:lang="ko">보안 프로필에서 문서 출처와의 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Security profile to Documentation source.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#SecurityProfile"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/wireless-router#DocumentationSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#systemRecordStatus">
    <rdfs:label xml:lang="en">system record status</rdfs:label>
    <rdfs:label xml:lang="ko">시스템 기록 상태</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="ko">무선 공유기 시스템의 시스템 기록 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the system record status value or state for Wireless router system.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#RouterSystem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#observationMethod">
    <rdfs:label xml:lang="ko">측정 방법</rdfs:label>
    <rdfs:label xml:lang="en">measurement method</rdfs:label>
    <rdfs:comment xml:lang="ko">성능 관측의 측정 방법 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the measurement method value or state for Performance observation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#PerformanceObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#incidentEvidenceSource">
    <rdfs:comment xml:lang="en">Records a relation from Incident record to Documentation source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">장애·보안 사건 기록에서 문서 출처와의 관계를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#IncidentRecord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/wireless-router#DocumentationSource"/>
    <rdfs:label xml:lang="ko">사건 근거</rdfs:label>
    <rdfs:label xml:lang="en">evidence source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#snapshotForDevice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/wireless-router#RouterDevice"/>
    <rdfs:comment xml:lang="en">Records a relation from Configuration snapshot to Router device.</rdfs:comment>
    <rdfs:comment xml:lang="ko">설정 스냅샷에서 공유기 장치와의 관계를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">for device</rdfs:label>
    <rdfs:label xml:lang="ko">대상 장치</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#ConfigurationSnapshot"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#sourceAccessedAt">
    <rdfs:label xml:lang="ko">확인 날짜</rdfs:label>
    <rdfs:label xml:lang="en">access date</rdfs:label>
    <rdfs:comment xml:lang="en">Records the access date value or state for Documentation source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">문서 출처의 확인 날짜 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#DocumentationSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#incidentResponseStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">대응 상태</rdfs:label>
    <rdfs:label xml:lang="en">response state</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#IncidentRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="ko">장애·보안 사건 기록의 대응 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the response state value or state for Incident record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#uplinkConnectionStatus">
    <rdfs:label xml:lang="en">uplink state</rdfs:label>
    <rdfs:label xml:lang="ko">상위 연결 상태</rdfs:label>
    <rdfs:comment xml:lang="en">Records the uplink state value or state for Uplink connection.</rdfs:comment>
    <rdfs:comment xml:lang="ko">상위 연결의 상위 연결 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#UplinkConnection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#clientCategory">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="ko">클라이언트 장치의 클라이언트 종류 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the client category value or state for Client device.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#ClientDevice"/>
    <rdfs:label xml:lang="en">client category</rdfs:label>
    <rdfs:label xml:lang="ko">클라이언트 종류</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#networkVisibilityState">
    <rdfs:label xml:lang="ko">관리 화면 표시 상태</rdfs:label>
    <rdfs:label xml:lang="en">management visibility state</rdfs:label>
    <rdfs:comment xml:lang="en">Records the management visibility state value or state for Wireless network profile.</rdfs:comment>
    <rdfs:comment xml:lang="ko">무선 네트워크 프로필의 관리 화면 표시 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#WirelessNetwork"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#segmentAddressDisclosure">
    <rdfs:label xml:lang="ko">주소 정보 공개 상태</rdfs:label>
    <rdfs:label xml:lang="en">address disclosure state</rdfs:label>
    <rdfs:comment xml:lang="ko">네트워크 구간의 주소 정보 공개 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the address disclosure state value or state for Network segment.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#NetworkSegment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#clientIdentityHandling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#ClientDevice"/>
    <rdfs:label xml:lang="ko">단말 식별자 처리</rdfs:label>
    <rdfs:label xml:lang="en">client identity handling</rdfs:label>
    <rdfs:comment xml:lang="ko">클라이언트 장치의 단말 식별자 처리 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the client identity handling value or state for Client device.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#policyDeniedFlowScope">
    <rdfs:label xml:lang="ko">차단 흐름 범위</rdfs:label>
    <rdfs:label xml:lang="en">denied flow scope</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the denied flow scope value or state for Network isolation policy.</rdfs:comment>
    <rdfs:comment xml:lang="ko">망 분리 정책의 차단 흐름 범위 값 또는 상태를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#IsolationPolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#observationSampleCount">
    <rdfs:comment xml:lang="en">Records the sample count value or state for Performance observation.</rdfs:comment>
    <rdfs:comment xml:lang="ko">성능 관측의 표본 수 값 또는 상태를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#PerformanceObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">표본 수</rdfs:label>
    <rdfs:label xml:lang="en">sample count</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#associationToNetwork">
    <rdfs:range rdf:resource="https://example.org/ontology/custom/wireless-router#WirelessNetwork"/>
    <rdfs:label xml:lang="en">to network</rdfs:label>
    <rdfs:label xml:lang="ko">접속 무선망</rdfs:label>
    <rdfs:comment xml:lang="ko">무선 접속 기록에서 무선 네트워크 프로필와의 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Wireless association record to Wireless network profile.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#AssociationRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#observationValue">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">Records the measured value value or state for Performance observation.</rdfs:comment>
    <rdfs:comment xml:lang="ko">성능 관측의 측정값 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#PerformanceObservation"/>
    <rdfs:label xml:lang="en">measured value</rdfs:label>
    <rdfs:label xml:lang="ko">측정값</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#uplinkProviderDisclosure">
    <rdfs:label xml:lang="en">provider disclosure state</rdfs:label>
    <rdfs:label xml:lang="ko">사업자 정보 공개 상태</rdfs:label>
    <rdfs:comment xml:lang="en">Records the provider disclosure state value or state for Uplink connection.</rdfs:comment>
    <rdfs:comment xml:lang="ko">상위 연결의 사업자 정보 공개 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#UplinkConnection"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#updateFromRelease">
    <rdfs:label xml:lang="ko">현재 릴리스</rdfs:label>
    <rdfs:label xml:lang="en">from release</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/wireless-router#FirmwareRelease"/>
    <rdfs:comment xml:lang="ko">펌웨어 업데이트에서 펌웨어 릴리스와의 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Firmware update to Firmware release.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#FirmwareUpdate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#policyDocumentedBy">
    <rdfs:label xml:lang="en">documented by</rdfs:label>
    <rdfs:label xml:lang="ko">근거 문서</rdfs:label>
    <rdfs:comment xml:lang="en">Records a relation from Network isolation policy to Documentation source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">망 분리 정책에서 문서 출처와의 관계를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/wireless-router#DocumentationSource"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#IsolationPolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#incidentAffectsNetwork">
    <rdfs:comment xml:lang="ko">장애·보안 사건 기록에서 무선 네트워크 프로필와의 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Incident record to Wireless network profile.</rdfs:comment>
    <rdfs:label xml:lang="en">affects network</rdfs:label>
    <rdfs:label xml:lang="ko">영향 무선망</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/wireless-router#WirelessNetwork"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#IncidentRecord"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#incidentImpactScope">
    <rdfs:comment xml:lang="en">Records the impact scope value or state for Incident record.</rdfs:comment>
    <rdfs:comment xml:lang="ko">장애·보안 사건 기록의 영향 범위 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#IncidentRecord"/>
    <rdfs:label xml:lang="ko">영향 범위</rdfs:label>
    <rdfs:label xml:lang="en">impact scope</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#incidentCategory">
    <rdfs:label xml:lang="ko">사건 분류</rdfs:label>
    <rdfs:label xml:lang="en">incident category</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Records the incident category value or state for Incident record.</rdfs:comment>
    <rdfs:comment xml:lang="ko">장애·보안 사건 기록의 사건 분류 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#IncidentRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#updateLifecycleStatus">
    <rdfs:comment xml:lang="en">Records the update lifecycle state value or state for Firmware update.</rdfs:comment>
    <rdfs:comment xml:lang="ko">펌웨어 업데이트의 업데이트 진행 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="ko">업데이트 진행 상태</rdfs:label>
    <rdfs:label xml:lang="en">update lifecycle state</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#FirmwareUpdate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#snapshotProvenanceStatus">
    <rdfs:comment xml:lang="en">Records the snapshot provenance state value or state for Configuration snapshot.</rdfs:comment>
    <rdfs:comment xml:lang="ko">설정 스냅샷의 스냅샷 출처 상태 값 또는 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/wireless-router#ConfigurationSnapshot"/>
    <rdfs:label xml:lang="ko">스냅샷 출처 상태</rdfs:label>
    <rdfs:label xml:lang="en">snapshot provenance state</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/wireless-router#firmwareReleaseDocumentedBy">
    <rdfs:label xml:lang="en">documented by</rdfs:label>
