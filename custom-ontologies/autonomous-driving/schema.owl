    <rdfs:comment xml:lang="en">Records an official standard or document source and the scope of the claim it supports.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#hasTestRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
