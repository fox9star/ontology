  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#sourceLanguage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/autonomous-driving#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">문서 언어</rdfs:label>
    <rdfs:label xml:lang="en">Source language</rdfs:label>
    <rdfs:comment xml:lang="ko">문서 언어를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies source language.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#SoftwareModule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">자율주행 소프트웨어 모듈</rdfs:label>
    <rdfs:label xml:lang="en">Autonomous-driving software module</rdfs:label>
    <rdfs:comment xml:lang="ko">감지·인지·위치추정·계획·제어·차량 연결 또는 안전 감시를 수행하는 소프트웨어 구성요소다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software component for sensing, perception, localization, planning, control, vehicle interfacing or safety monitoring.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
