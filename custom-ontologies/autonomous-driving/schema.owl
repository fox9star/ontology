    <rdfs:comment xml:lang="en">Links the related mounted on vehicle entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#OperationalDesignDomain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
