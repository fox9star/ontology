  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">자율주행 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">Autonomous Driving Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">자율주행 기능·차량·ODD·센서·소프트웨어 스택·시나리오·시험·안전 근거를 연결한다. 캠퍼스 셔틀 예시는 합성 기록이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Connects driving features, vehicles, ODD, sensors, software stack, scenarios, tests and safety evidence. The campus shuttle is synthetic.</rdfs:comment>
    <owl:versionIRI rdf:resource="https://example.org/ontology/custom/autonomous-driving/0.1.0"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
