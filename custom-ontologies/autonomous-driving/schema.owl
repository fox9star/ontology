    <rdfs:comment xml:lang="en">A sensor measuring the vehicle surroundings or vehicle state, with its mounting relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#trajectoryForRoute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
