  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#SafetyFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">안전 기능</rdfs:label>
    <rdfs:label xml:lang="en">Safety function</rdfs:label>
    <rdfs:comment xml:lang="ko">운행 조건 감시, 위험 대응, 최소위험상태 전환 또는 수동 해제와 같은 안전 관련 기능이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A safety-related function such as operating-domain monitoring, hazard response, minimal-risk fallback or manual disengagement.</rdfs:comment>
  </rdf:Description>
