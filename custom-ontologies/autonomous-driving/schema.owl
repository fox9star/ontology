  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#Scenario">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">주행 시나리오</rdfs:label>
    <rdfs:label xml:lang="en">Driving scenario</rdfs:label>
    <rdfs:comment xml:lang="ko">운행 조건과 경로에서 차량·보행자·신호 등 도로 행위자가 상호작용하는 상황이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A situation in which road actors such as vehicles, pedestrians and signals interact under operating conditions and on a route.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/autonomous-driving#mountedOnVehicle">
