        ns1:sourcePublisher "Autoware Foundation"^^xsd:string ;
        ns1:sourceTitle "Autonomous Driving Stack Architecture"^^xsd:string ;
        ns1:sourceUri "https://autowarefoundation.github.io/autoware-documentation/1.5.0/design/autoware-architecture-v2/roadmap/autonomous-driving-stack-architecture/"^^xsd:anyURI .
