        ns1:sourceLanguage "en"^^xsd:string ;
        ns1:sourcePublisher "National Highway Traffic Safety Administration"^^xsd:string ;
        ns1:sourceTitle "A Framework for Automated Driving System Testable Cases and Scenarios"^^xsd:string ;
