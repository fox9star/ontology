@prefix ad: <https://example.org/ontology/custom/autonomous-driving#> .
@prefix item: <https://example.test/autonomous-driving/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

item:campus-shuttle-system a ad:AutonomousDrivingSystem ;
    rdfs:label "Synthetic campus shuttle driving system"@en,
        "가상 캠퍼스 셔틀 자율주행 구성"@ko ;
    ad:hasAutomationLevel item:level-0,
        item:level-1,
        item:level-2,
        item:level-3,
        item:level-4,
        item:level-5 ;
    ad:hasDocumentationSource item:src-autoware-stack,
        item:src-autoware-vehicle,
        item:src-awsim,
        item:src-nhtsa-ads,
        item:src-nhtsa-odd,
        item:src-sae-j3016 ;
    ad:hasDrivingFeature item:feature-campus-loop ;
    ad:hasOperationalDesignDomain item:odd-campus-day ;
    ad:hasRoadMap item:map-campus ;
    ad:hasRoute item:route-campus-loop ;
    ad:hasSafetyFunction item:safety-minimal-risk,
        item:safety-odd-monitor ;
    ad:hasScenario item:scenario-pedestrian-crossing,
        item:scenario-signalized-junction ;
    ad:hasSensor item:sensor-camera,
        item:sensor-gnss-imu,
        item:sensor-lidar,
        item:sensor-wheel-odometry ;
    ad:hasSoftwareModule item:module-control,
        item:module-localization,
        item:module-odd-monitor,
        item:module-perception,
        item:module-planning,
        item:module-sensing,
        item:module-vehicle-interface ;
    ad:hasTestRun item:test-pedestrian-simulation ;
    ad:hasTrajectory item:trajectory-campus-loop ;
    ad:hasVehicle item:vehicle-campus-shuttle ;
    ad:systemNote "실제 차량·도로 배포, 성능 수준, 인증 또는 안전 검증을 나타내지 않는 설명용 합성 그래프다."^^xsd:string ;
    ad:systemPurpose "자율주행 구성요소, 운행 조건과 시험 계획 사이의 관계를 학습한다."^^xsd:string ;
    ad:systemRecordKind "synthetic"^^xsd:string .

item:actor-approaching-car a ad:RoadActor ;
    rdfs:label "Synthetic approaching vehicle actor"@en,
        "가상 접근 차량 행위자"@ko ;
    ad:actorKind "vehicle"^^xsd:string ;
    ad:actorMotion "moving"^^xsd:string ;
    ad:actorName "approaching_vehicle"^^xsd:string .

item:actor-pedestrian a ad:RoadActor ;
    rdfs:label "Synthetic pedestrian actor"@en,
        "가상 보행자 행위자"@ko ;
    ad:actorKind "pedestrian"^^xsd:string ;
    ad:actorMotion "moving"^^xsd:string ;
    ad:actorName "crossing_pedestrian"^^xsd:string .

item:actor-traffic-signal a ad:RoadActor ;
    rdfs:label "Synthetic traffic signal actor"@en,
        "가상 교통 신호 행위자"@ko ;
    ad:actorKind "traffic_signal"^^xsd:string ;
    ad:actorMotion "traffic_control"^^xsd:string ;
    ad:actorName "campus_signal"^^xsd:string .

item:feature-campus-loop a ad:DrivingFeature ;
    rdfs:label "Synthetic geofenced shuttle loop feature"@en,
        "가상 지정 구간 셔틀 운행 기능"@ko ;
    ad:documentedBy item:src-autoware-stack,
        item:src-sae-j3016 ;
    ad:featureKind "automated_driving"^^xsd:string ;
    ad:featureName "geofenced_campus_loop"^^xsd:string ;
    ad:featureNote "SAE 수준을 평가·할당하지 않았다. 제한된 ODD가 있는 가상 학습 기능 이름이며, 운행 가능성이나 안전성을 의미하지 않는다."^^xsd:string ;
    ad:featureODD item:odd-campus-day ;
    ad:featureUsesModule item:module-control,
        item:module-localization,
        item:module-odd-monitor,
        item:module-perception,
        item:module-planning,
        item:module-sensing,
        item:module-vehicle-interface .

item:level-0 a ad:AutomationLevel ;
    rdfs:label "SAE driving automation Level 0"@en,
        "SAE 주행 자동화 수준 0"@ko ;
    ad:documentedBy item:src-sae-j3016 ;
    ad:levelLabel "No Driving Automation"^^xsd:string ;
    ad:levelNote "표준 용어 참조 항목이다. 이 시스템의 합성 셔틀 기능에 평가 결과를 부여하지 않는다."^^xsd:string ;
    ad:levelNumber 0 ;
    ad:levelScope "on-road vehicle feature"^^xsd:string .

item:level-1 a ad:AutomationLevel ;
    rdfs:label "SAE driving automation Level 1"@en,
        "SAE 주행 자동화 수준 1"@ko ;
    ad:documentedBy item:src-sae-j3016 ;
    ad:levelLabel "Driver Assistance"^^xsd:string ;
    ad:levelNote "표준 용어 참조 항목이다. 이 시스템의 합성 셔틀 기능에 평가 결과를 부여하지 않는다."^^xsd:string ;
    ad:levelNumber 1 ;
    ad:levelScope "on-road vehicle feature"^^xsd:string .

item:level-2 a ad:AutomationLevel ;
    rdfs:label "SAE driving automation Level 2"@en,
        "SAE 주행 자동화 수준 2"@ko ;
    ad:documentedBy item:src-sae-j3016 ;
    ad:levelLabel "Partial Driving Automation"^^xsd:string ;
    ad:levelNote "표준 용어 참조 항목이다. 이 시스템의 합성 셔틀 기능에 평가 결과를 부여하지 않는다."^^xsd:string ;
    ad:levelNumber 2 ;
    ad:levelScope "on-road vehicle feature"^^xsd:string .

item:level-3 a ad:AutomationLevel ;
    rdfs:label "SAE driving automation Level 3"@en,
        "SAE 주행 자동화 수준 3"@ko ;
    ad:documentedBy item:src-sae-j3016 ;
    ad:levelLabel "Conditional Driving Automation"^^xsd:string ;
    ad:levelNote "표준 용어 참조 항목이다. 이 시스템의 합성 셔틀 기능에 평가 결과를 부여하지 않는다."^^xsd:string ;
    ad:levelNumber 3 ;
    ad:levelScope "on-road vehicle feature"^^xsd:string .

item:level-4 a ad:AutomationLevel ;
    rdfs:label "SAE driving automation Level 4"@en,
        "SAE 주행 자동화 수준 4"@ko ;
    ad:documentedBy item:src-sae-j3016 ;
    ad:levelLabel "High Driving Automation"^^xsd:string ;
    ad:levelNote "표준 용어 참조 항목이다. 이 시스템의 합성 셔틀 기능에 평가 결과를 부여하지 않는다."^^xsd:string ;
    ad:levelNumber 4 ;
    ad:levelScope "on-road vehicle feature"^^xsd:string .

item:level-5 a ad:AutomationLevel ;
    rdfs:label "SAE driving automation Level 5"@en,
        "SAE 주행 자동화 수준 5"@ko ;
    ad:documentedBy item:src-sae-j3016 ;
    ad:levelLabel "Full Driving Automation"^^xsd:string ;
    ad:levelNote "표준 용어 참조 항목이다. 이 시스템의 합성 셔틀 기능에 평가 결과를 부여하지 않는다."^^xsd:string ;
    ad:levelNumber 5 ;
    ad:levelScope "on-road vehicle feature"^^xsd:string .

item:safety-minimal-risk a ad:SafetyFunction ;
    rdfs:label "Synthetic minimal-risk fallback concept"@en,
        "가상 최소위험상태 전환 개념"@ko ;
    ad:documentedBy item:src-autoware-vehicle,
        item:src-nhtsa-ads ;
    ad:monitorsODD item:odd-campus-day ;
    ad:responseAction "조건에 따라 감속·정지 등 최소위험상태 전환을 검토한다."^^xsd:string ;
    ad:safetyFunctionKind "minimal_risk_fallback"^^xsd:string ;
    ad:safetyFunctionName "minimal_risk_fallback_demo"^^xsd:string ;
    ad:safetyFunctionNote "차량 제동거리, 위험 분석, 규제 요구사항 또는 안전 성능을 정의하지 않은 학습용 개념이다."^^xsd:string ;
    ad:safetyFunctionStatus "conceptual"^^xsd:string .

item:safety-odd-monitor a ad:SafetyFunction ;
    rdfs:label "Synthetic operating-domain boundary monitor"@en,
        "가상 운행영역 이탈 감시"@ko ;
    ad:documentedBy item:src-nhtsa-ads ;
    ad:monitorsODD item:odd-campus-day ;
    ad:responseAction "범위 이탈 감지 시 운행 승인 상태를 낮추고 대응 계획으로 전달한다."^^xsd:string ;
    ad:safetyFunctionKind "odd_monitoring"^^xsd:string ;
    ad:safetyFunctionName "odd_boundary_monitor_demo"^^xsd:string ;
    ad:safetyFunctionNote "동작 코드·진단 커버리지·안전 검증이 없는 개념 항목이다."^^xsd:string ;
    ad:safetyFunctionStatus "conceptual"^^xsd:string .

item:scenario-signalized-junction a ad:Scenario ;
    rdfs:label "Synthetic signalized junction scenario"@en,
        "가상 신호 교차로 시나리오"@ko ;
    ad:documentedBy item:src-awsim ;
    ad:hasRoadActor item:actor-approaching-car,
        item:actor-ego-shuttle,
        item:actor-traffic-signal ;
    ad:scenarioKind "intersection"^^xsd:string ;
    ad:scenarioName "signalized_junction_demo"^^xsd:string ;
    ad:scenarioNote "신호·주변 차량 상호작용을 위한 가상 시나리오이며 통행 동작이 실행된 기록이 아니다."^^xsd:string ;
    ad:scenarioODD item:odd-campus-day ;
    ad:scenarioRoute item:route-campus-loop .

item:sensor-camera a ad:Sensor ;
    rdfs:label "Synthetic forward camera"@en,
        "가상 전방 카메라"@ko ;
    ad:documentedBy item:src-autoware-stack ;
    ad:mountedOnVehicle item:vehicle-campus-shuttle ;
    ad:sensorModality "camera"^^xsd:string ;
    ad:sensorName "front_camera_demo"^^xsd:string ;
    ad:sensorPurpose "차선·신호·물체 인지 입력을 나타내는 예시다."^^xsd:string .

item:sensor-gnss-imu a ad:Sensor ;
    rdfs:label "Synthetic GNSS and IMU"@en,
        "가상 GNSS·IMU"@ko ;
    ad:documentedBy item:src-autoware-stack ;
    ad:mountedOnVehicle item:vehicle-campus-shuttle ;
    ad:sensorModality "gnss_imu"^^xsd:string ;
    ad:sensorName "gnss_imu_demo"^^xsd:string ;
    ad:sensorPurpose "위치·자세 추정 입력을 나타내는 예시다."^^xsd:string .

item:sensor-lidar a ad:Sensor ;
    rdfs:label "Synthetic LiDAR"@en,
        "가상 라이다"@ko ;
    ad:documentedBy item:src-autoware-stack ;
    ad:mountedOnVehicle item:vehicle-campus-shuttle ;
    ad:sensorModality "lidar"^^xsd:string ;
    ad:sensorName "roof_lidar_demo"^^xsd:string ;
    ad:sensorPurpose "주변 3차원 물체 인지 입력을 나타내는 예시다."^^xsd:string .

item:sensor-wheel-odometry a ad:Sensor ;
    rdfs:label "Synthetic wheel odometry"@en,
        "가상 휠 오도메트리"@ko ;
    ad:documentedBy item:src-autoware-stack ;
    ad:mountedOnVehicle item:vehicle-campus-shuttle ;
    ad:sensorModality "wheel_odometry"^^xsd:string ;
    ad:sensorName "wheel_odometry_demo"^^xsd:string ;
    ad:sensorPurpose "차량 이동 추정 입력을 나타내는 예시다."^^xsd:string .

item:test-pedestrian-simulation a ad:TestRun ;
    rdfs:label "Unrun synthetic pedestrian simulation plan"@en,
        "미실행 가상 보행자 시뮬레이션 계획"@ko ;
    ad:testEnvironment "simulation"^^xsd:string ;
    ad:testName "pedestrian_crossing_simulation_plan"^^xsd:string ;
    ad:testNote "실제 시뮬레이터 실행, 결과 측정, 로그 수집 또는 안전 검증이 수행되지 않았다."^^xsd:string ;
    ad:testResult "not_run"^^xsd:string ;
    ad:testStatus "planned"^^xsd:string ;
    ad:testsScenario item:scenario-pedestrian-crossing .

item:trajectory-campus-loop a ad:Trajectory ;
    rdfs:label "Synthetic shuttle loop trajectory plan"@en,
        "가상 셔틀 순환 궤적 계획"@ko ;
    ad:trajectoryForRoute item:route-campus-loop ;
    ad:trajectoryGeneratedBy item:module-planning ;
    ad:trajectoryName "campus_loop_trajectory_demo"^^xsd:string ;
    ad:trajectoryNote "시뮬레이션에서 생성·추종한 실적이 없는 계획 개념 기록이다."^^xsd:string ;
    ad:trajectoryStatus "planned"^^xsd:string .

item:actor-ego-shuttle a ad:RoadActor ;
    rdfs:label "Synthetic ego shuttle actor"@en,
        "가상 자율주행 셔틀 행위자"@ko ;
    ad:actorKind "ego_vehicle"^^xsd:string ;
    ad:actorMotion "moving"^^xsd:string ;
    ad:actorName "ego_shuttle"^^xsd:string ;
    ad:actorVehicle item:vehicle-campus-shuttle .

item:map-campus a ad:RoadMap ;
    rdfs:label "Synthetic campus road map"@en,
        "가상 캠퍼스 도로 지도"@ko ;
    ad:documentedBy item:src-autoware-stack ;
    ad:mapCoverage "가상의 캠퍼스 순환 구간"^^xsd:string ;
    ad:mapFormat "lanelet2"^^xsd:string ;
    ad:mapName "campus_map_demo"^^xsd:string ;
    ad:mapNote "지도 파일·측량 자료·point-cloud 자료를 포함하지 않는 개념 예시다."^^xsd:string .

item:module-odd-monitor a ad:SoftwareModule ;
    rdfs:label "Synthetic ODD monitor module"@en,
        "가상 ODD 감시 모듈"@ko ;
    ad:documentedBy item:src-nhtsa-ads ;
    ad:moduleInput "vehicle, weather and geofence state"^^xsd:string ;
    ad:moduleKind "safety_monitor"^^xsd:string ;
    ad:moduleName "odd_monitor"^^xsd:string ;
    ad:moduleNote "실제 감시 로직이나 안전 무결성 수준을 구현·평가하지 않았다."^^xsd:string ;
    ad:moduleOutput "odd_status"^^xsd:string ;
    ad:modulePurpose "운행 조건이 합성 ODD 범위에 있는지 감시하는 역할의 예시다."^^xsd:string .

item:module-vehicle-interface a ad:SoftwareModule ;
    rdfs:label "Synthetic vehicle interface module"@en,
        "가상 차량 인터페이스 모듈"@ko ;
    ad:dependsOnModule item:module-control ;
    ad:documentedBy item:src-autoware-vehicle ;
    ad:moduleInput "steering and velocity commands, vehicle status"^^xsd:string ;
    ad:moduleKind "vehicle_interface"^^xsd:string ;
    ad:moduleName "vehicle_interface"^^xsd:string ;
    ad:moduleNote "CAN, drive-by-wire 또는 실차 프로토콜을 구현하지 않았다."^^xsd:string ;
    ad:moduleOutput "vehicle-specific command and normalized vehicle status"^^xsd:string ;
    ad:modulePurpose "차량별 제어 형식과 상태 형식 사이를 변환하는 역할의 예시다."^^xsd:string .

item:scenario-pedestrian-crossing a ad:Scenario ;
    rdfs:label "Synthetic crosswalk pedestrian scenario"@en,
        "가상 횡단보도 보행자 시나리오"@ko ;
    ad:documentedBy item:src-awsim,
        item:src-nhtsa-odd ;
    ad:hasRoadActor item:actor-ego-shuttle,
        item:actor-pedestrian ;
    ad:scenarioKind "pedestrian_crossing"^^xsd:string ;
    ad:scenarioName "crosswalk_pedestrian_demo"^^xsd:string ;
    ad:scenarioNote "속도·거리·우선권·반응 시간을 규정하지 않은 시험 설계 예시다."^^xsd:string ;
    ad:scenarioODD item:odd-campus-day ;
    ad:scenarioRoute item:route-campus-loop .

item:module-control a ad:SoftwareModule ;
    rdfs:label "Synthetic vehicle control module"@en,
        "가상 차량 제어 모듈"@ko ;
    ad:dependsOnModule item:module-planning ;
    ad:documentedBy item:src-autoware-stack ;
    ad:moduleInput "planned trajectory and vehicle state"^^xsd:string ;
    ad:moduleKind "control"^^xsd:string ;
    ad:moduleName "control"^^xsd:string ;
    ad:moduleNote "차량의 실제 actuator에 명령하지 않는다."^^xsd:string ;
    ad:moduleOutput "steering and velocity commands"^^xsd:string ;
    ad:modulePurpose "계획 궤적 추종용 조향·종방향 명령을 구성하는 역할의 예시다."^^xsd:string .

item:module-localization a ad:SoftwareModule ;
    rdfs:label "Synthetic localization module"@en,
        "가상 위치추정 모듈"@ko ;
    ad:dependsOnModule item:module-sensing ;
    ad:documentedBy item:src-autoware-stack ;
    ad:moduleInput "GNSS/IMU, wheel odometry and map"^^xsd:string ;
    ad:moduleKind "localization"^^xsd:string ;
    ad:moduleName "localization"^^xsd:string ;
    ad:moduleNote "정확도나 수렴 상태를 주장하지 않는다."^^xsd:string ;
    ad:moduleOutput "localized vehicle pose"^^xsd:string ;
    ad:modulePurpose "차량 위치·자세를 지도 기준으로 추정하는 역할의 예시다."^^xsd:string .

item:module-perception a ad:SoftwareModule ;
    rdfs:label "Synthetic perception module"@en,
        "가상 인지 모듈"@ko ;
    ad:dependsOnModule item:module-sensing ;
    ad:documentedBy item:src-autoware-stack ;
    ad:moduleInput "timestamped sensor data"^^xsd:string ;
    ad:moduleKind "perception"^^xsd:string ;
    ad:moduleName "perception"^^xsd:string ;
    ad:moduleNote "출력 형식과 모델 성능은 지정하거나 검증하지 않았다."^^xsd:string ;
    ad:moduleOutput "objects, traffic signal states and lane scene"^^xsd:string ;
    ad:modulePurpose "주변 물체·차선·신호 관련 장면 정보를 구성하는 역할의 예시다."^^xsd:string .

item:src-awsim a ad:DocumentationSource ;
    rdfs:label "AWSIM simulation documentation"@en,
        "AWSIM 시뮬레이션 문서"@ko ;
    ad:sourceAccessedAt "2026-10-08"^^xsd:date ;
    ad:sourceClaim "AWSIM is documented as a simulator for testing and evaluating autonomous-driving perception, planning and control under different configurations and scenarios."^^xsd:string ;
    ad:sourceLanguage "en"^^xsd:string ;
    ad:sourcePublisher "Autoware Foundation"^^xsd:string ;
    ad:sourceTitle "AWSIM Labs"^^xsd:string ;
    ad:sourceUri "https://autowarefoundation.github.io/AWSIM-Labs/main/Introduction/AWSIM/"^^xsd:anyURI .

item:src-nhtsa-odd a ad:DocumentationSource ;
    rdfs:label "NHTSA operational design domain definition"@en,
        "NHTSA 운행설계영역 정의"@ko ;
    ad:sourceAccessedAt "2026-10-08"^^xsd:date ;
    ad:sourceClaim "The report describes ODD attributes such as roadway type, speed range, lighting, weather and other operating constraints; the sample campus bounds here are synthetic."^^xsd:string ;
    ad:sourceLanguage "en"^^xsd:string ;
    ad:sourcePublisher "National Highway Traffic Safety Administration"^^xsd:string ;
    ad:sourceTitle "A Framework for Automated Driving System Testable Cases and Scenarios"^^xsd:string ;
    ad:sourceUri "https://www.nhtsa.gov/sites/nhtsa.gov/files/documents/13882-automateddrivingsystems_092618_v1a_tag.pdf"^^xsd:anyURI .

item:module-planning a ad:SoftwareModule ;
    rdfs:label "Synthetic planning module"@en,
        "가상 경로계획 모듈"@ko ;
    ad:dependsOnModule item:module-localization,
        item:module-perception ;
    ad:documentedBy item:src-autoware-stack ;
    ad:moduleInput "localized vehicle pose, objects and route"^^xsd:string ;
    ad:moduleKind "planning"^^xsd:string ;
    ad:moduleName "planning"^^xsd:string ;
    ad:moduleNote "실제 충돌 회피나 통행 규칙 준수 결과는 확인하지 않았다."^^xsd:string ;
    ad:moduleOutput "planned trajectory"^^xsd:string ;
    ad:modulePurpose "목표 경로와 장면 정보를 이용해 궤적을 생성하는 역할의 예시다."^^xsd:string .

item:module-sensing a ad:SoftwareModule ;
    rdfs:label "Synthetic sensing module"@en,
        "가상 감지 모듈"@ko ;
    ad:documentedBy item:src-autoware-stack ;
    ad:moduleInput "camera frames, LiDAR scans, GNSS/IMU and wheel odometry"^^xsd:string ;
    ad:moduleKind "sensing"^^xsd:string ;
    ad:moduleName "sensing"^^xsd:string ;
    ad:moduleNote "실제 ROS 노드나 드라이버를 가리키지 않는다."^^xsd:string ;
    ad:moduleOutput "timestamped sensor data"^^xsd:string ;
    ad:modulePurpose "센서 입력 수집·전처리 역할의 예시다."^^xsd:string .

item:route-campus-loop a ad:Route ;
    rdfs:label "Synthetic campus loop route"@en,
        "가상 캠퍼스 순환 경로"@ko ;
    ad:routeEnd "가상 연구동 정류장"^^xsd:string ;
    ad:routeMap item:map-campus ;
    ad:routeName "campus_loop_demo"^^xsd:string ;
    ad:routeNote "측량·접근성·도로 규칙 확인 전의 설명용 경로다."^^xsd:string ;
    ad:routeStart "가상 북문 정류장"^^xsd:string .

