@prefix ad: <https://example.org/ontology/custom/autonomous-driving#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/custom/autonomous-driving> a owl:Ontology ;
    rdfs:label "Autonomous Driving Ontology"@en,
        "자율주행 온톨로지"@ko ;
    rdfs:comment "Connects driving features, vehicles, ODD, sensors, software stack, scenarios, tests and safety evidence. The campus shuttle is synthetic."@en,
        "자율주행 기능·차량·ODD·센서·소프트웨어 스택·시나리오·시험·안전 근거를 연결한다. 캠퍼스 셔틀 예시는 합성 기록이다."@ko ;
    owl:versionIRI <https://example.org/ontology/custom/autonomous-driving/0.1.0> ;
    owl:versionInfo "0.1.0" .

ad:actorKind a owl:DatatypeProperty ;
    rdfs:label "Actor kind"@en,
        "행위자 유형"@ko ;
    rdfs:comment "Records or classifies actor kind."@en,
        "행위자 유형를 기록하거나 구분한다."@ko ;
    rdfs:domain ad:RoadActor ;
    rdfs:range xsd:string .

ad:actorMotion a owl:DatatypeProperty ;
    rdfs:label "Actor motion"@en,
        "행위자 동작"@ko ;
    rdfs:comment "Records or classifies actor motion."@en,
        "행위자 동작를 기록하거나 구분한다."@ko ;
    rdfs:domain ad:RoadActor ;
    rdfs:range xsd:string .

