ad:RoadActor a owl:Class ;
    rdfs:label "Road actor"@en,
        "도로 행위자"@ko ;
    rdfs:comment "A vehicle, pedestrian, cyclist, signal or static obstacle in a driving scenario."@en,
        "주행 시나리오에 포함된 차량·보행자·자전거·신호·정적 장애물이다."@ko .

ad:Sensor a owl:Class ;
    rdfs:label "Vehicle sensor"@en,
        "차량 센서"@ko ;
    rdfs:comment "A sensor measuring the vehicle surroundings or vehicle state, with its mounting relation."@en,
        "차량 주변이나 차량 상태를 측정하는 센서와 장착 관계다."@ko .

ad:AutomationLevel a owl:Class ;
    rdfs:label "Automation level term"@en,
        "자동화 수준 용어"@ko ;
    rdfs:comment "A classification term referring to an on-road driving automation level in SAE J3016."@en,
        "SAE J3016의 온로드 주행 자동화 수준을 참조하는 분류 용어다."@ko .

ad:RoadMap a owl:Class ;
    rdfs:label "Road map"@en,
        "도로 지도"@ko ;
    rdfs:comment "A road, lane or environment map referenced by routes and planning."@en,
        "경로와 계획이 참조하는 도로·차선·환경 지도의 범위와 형식이다."@ko .

ad:Trajectory a owl:Class ;
    rdfs:label "Trajectory"@en,
        "주행 궤적"@ko ;
    rdfs:comment "A planned or tracked trajectory linked to a route and driving feature."@en,
        "경로와 주행 기능에 연결된 계획 또는 추종 궤적이다."@ko .

ad:DrivingFeature a owl:Class ;
    rdfs:label "Driving automation feature"@en,
        "주행 자동화 기능"@ko ;
    rdfs:comment "A driving automation feature designed for stated operating conditions; its level and ODD are recorded per feature."@en,
        "특정 운행 조건에서 수행하도록 설계된 주행 자동화 기능이다. 기능별 등급과 ODD를 기록한다."@ko .

ad:SafetyFunction a owl:Class ;
    rdfs:label "Safety function"@en,
        "안전 기능"@ko ;
    rdfs:comment "A safety-related function such as operating-domain monitoring, hazard response, minimal-risk fallback or manual disengagement."@en,
        "운행 조건 감시, 위험 대응, 최소위험상태 전환 또는 수동 해제와 같은 안전 관련 기능이다."@ko .

ad:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en,
        "차량"@ko ;
    rdfs:comment "A road vehicle connected to driving features, sensors and vehicle interfaces."@en,
        "자율주행 기능과 센서·차량 인터페이스가 연결되는 도로 차량이다."@ko .

ad:DocumentationSource a owl:Class ;
    rdfs:label "Documentation source"@en,
        "문서 근거"@ko ;
    rdfs:comment "Records an official standard or document source and the scope of the claim it supports."@en,
        "용어 또는 속성의 주장을 뒷받침하는 표준·공식 문서 출처와 범위를 기록한다."@ko .

ad:Route a owl:Class ;
    rdfs:label "Route"@en,
        "주행 경로"@ko ;
    rdfs:comment "A high-level path connecting a start and destination on a map."@en,
        "지도 위의 출발·도착 지점을 연결하는 상위 경로다."@ko .

ad:Scenario a owl:Class ;
    rdfs:label "Driving scenario"@en,
        "주행 시나리오"@ko ;
    rdfs:comment "A situation in which road actors such as vehicles, pedestrians and signals interact under operating conditions and on a route."@en,
        "운행 조건과 경로에서 차량·보행자·신호 등 도로 행위자가 상호작용하는 상황이다."@ko .

ad:TestRun a owl:Class ;
    rdfs:label "Test run record"@en,
        "시험 실행 기록"@ko ;
    rdfs:comment "Records the plan, result and evidence state of a simulation, closed-track, road or log-replay test."@en,
        "시뮬레이션·폐쇄 시험장·도로·기록 재생 시험의 계획과 결과·증거 상태를 기록한다."@ko .

ad:OperationalDesignDomain a owl:Class ;
    rdfs:label "Operational design domain"@en,
        "운행설계영역"@ko ;
    rdfs:comment "The roadway, geography, speed and environmental conditions and limits for which a feature is designed to operate."@en,
        "기능이 작동하도록 설계된 도로·지역·속도·환경 조건과 경계다."@ko .

ad:SoftwareModule a owl:Class ;
    rdfs:label "Autonomous-driving software module"@en,
        "자율주행 소프트웨어 모듈"@ko ;
    rdfs:comment "A software component for sensing, perception, localization, planning, control, vehicle interfacing or safety monitoring."@en,
        "감지·인지·위치추정·계획·제어·차량 연결 또는 안전 감시를 수행하는 소프트웨어 구성요소다."@ko .

ad:AutonomousDrivingSystem a owl:Class ;
    rdfs:label "Autonomous driving system"@en,
        "자율주행 시스템"@ko ;
    rdfs:comment "Groups a vehicle, driving features, operating conditions, software modules, tests and evidence into a system."@en,
        "차량, 자율주행 기능, 운용 조건, 소프트웨어 모듈, 시험과 근거를 하나의 시스템으로 묶는다."@ko .
