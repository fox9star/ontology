    <rdfs:comment xml:lang="ko">관련 시연 에피소드 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related demonstration episode entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationStep"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#Demonstration"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#policyStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
