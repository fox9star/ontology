    <rdfs:comment xml:lang="en">Links a related imitation-learning method entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Policy"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#LearningMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#sourceAccessedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">확인 날짜</rdfs:label>
    <rdfs:label xml:lang="en">Accessed date</rdfs:label>
    <rdfs:comment xml:lang="ko">확인 날짜를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies accessed date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DocumentationSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#demonstrationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">시연 상태</rdfs:label>
    <rdfs:label xml:lang="en">Demonstration status</rdfs:label>
    <rdfs:comment xml:lang="ko">시연 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies demonstration status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Demonstration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#trainingUsesDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
