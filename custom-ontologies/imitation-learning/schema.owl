    <rdfs:label xml:lang="en">Learning task</rdfs:label>
    <rdfs:comment xml:lang="ko">관측에서 행동으로 이어지는 학습 목표와 범위를 기술한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Describes the goal and scope of mapping observations to actions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#constraintName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
