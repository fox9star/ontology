    <rdfs:label xml:lang="en">Policy status</rdfs:label>
    <rdfs:comment xml:lang="ko">정책 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies policy status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">모방학습 프로젝트</rdfs:label>
    <rdfs:label xml:lang="en">Imitation-learning project</rdfs:label>
    <rdfs:comment xml:lang="ko">학습 과제, 시연 데이터, 방법, 정책, 실행 및 근거를 묶는다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Groups a learning task, demonstrations, methods, policies, runs and evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#TrainingRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">학습 실행 기록</rdfs:label>
    <rdfs:label xml:lang="en">Training run record</rdfs:label>
    <rdfs:comment xml:lang="ko">데이터, 방법, 결과 정책 및 학습 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the data, method, output policy and training status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#constraintDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">제약 설명</rdfs:label>
    <rdfs:label xml:lang="en">Constraint description</rdfs:label>
    <rdfs:comment xml:lang="ko">제약 설명를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies constraint description.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#SafetyConstraint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#SafetyConstraint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">안전 제약</rdfs:label>
    <rdfs:label xml:lang="en">Safety constraint</rdfs:label>
    <rdfs:comment xml:lang="ko">학습·평가 범위의 안전 조건과 검증 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a safety condition for training or evaluation and its verification status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#methodKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">방법 유형</rdfs:label>
    <rdfs:label xml:lang="en">Method kind</rdfs:label>
    <rdfs:comment xml:lang="ko">방법 유형를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies method kind.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#LearningMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#observationSummary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">관측 요약</rdfs:label>
    <rdfs:label xml:lang="en">Observation summary</rdfs:label>
    <rdfs:comment xml:lang="ko">관측 요약를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies observation summary.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Observation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#Policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">정책</rdfs:label>
    <rdfs:label xml:lang="en">Policy</rdfs:label>
    <rdfs:comment xml:lang="ko">관측이나 상태를 행동으로 사상하는 학습 대상 또는 기준이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learned or reference mapping from observations or states to actions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#actionValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">행동 값 또는 레이블</rdfs:label>
    <rdfs:label xml:lang="en">Action value or label</rdfs:label>
    <rdfs:comment xml:lang="ko">행동 값 또는 레이블를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies action value or label.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Action"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#trainingName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">학습 실행 이름</rdfs:label>
    <rdfs:label xml:lang="en">Training run name</rdfs:label>
    <rdfs:comment xml:lang="ko">학습 실행 이름를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies training run name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#TrainingRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#EvaluationRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">평가 실행 기록</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation run record</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 대상, 지표, 측정 상태와 근거를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the evaluation target, metrics, measurement status and evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://example.org/ontology/custom/imitation-learning/0.1.0"/>
    <rdfs:label xml:lang="ko">모방학습 온톨로지 (imitation-learning)</rdfs:label>
    <rdfs:label xml:lang="en">Imitation Learning Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">전문가 시연, 행동복제·DAgger·역강화학습, 정책, 학습·평가 상태, 분포 변화 및 문헌 근거를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Connects demonstrations, behavior cloning, DAgger, inverse reinforcement learning, policies, run status, distribution shift and literature evidence.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#Demonstration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">시연 에피소드</rdfs:label>
    <rdfs:label xml:lang="en">Demonstration episode</rdfs:label>
    <rdfs:comment xml:lang="ko">과제와 시연자에 연결된 관측·행동 시퀀스 또는 기록이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">An observation-action sequence or record linked to a task and demonstrator.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#projectHasDistributionShift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">상태 분포 변화</rdfs:label>
    <rdfs:label xml:lang="en">Has distribution shift</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 상태 분포 변화 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related state distribution shift entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#DistributionShift"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#stepObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">단계 관측</rdfs:label>
    <rdfs:label xml:lang="en">Step observation</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 관측 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related observation entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationStep"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#stepAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">단계 행동 레이블</rdfs:label>
    <rdfs:label xml:lang="en">Step action label</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 행동 레이블 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related action label entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationStep"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#Action"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#policyLearnsWithMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">학습 방법</rdfs:label>
    <rdfs:label xml:lang="en">Learns with method</rdfs:label>
