<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#DemonstrationDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">시연 데이터셋</rdfs:label>
    <rdfs:label xml:lang="en">Demonstration dataset</rdfs:label>
    <rdfs:comment xml:lang="ko">출처, 수집 상태, 분할 상태와 한계를 갖는 시연 자료 모음이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A collection of demonstrations with provenance, collection status, split status and limitations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#shiftDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">분포 변화 설명</rdfs:label>
    <rdfs:label xml:lang="en">Shift description</rdfs:label>
    <rdfs:comment xml:lang="ko">분포 변화 설명를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies shift description.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DistributionShift"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#evaluationEvidenceStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">평가 근거 상태</rdfs:label>
    <rdfs:label xml:lang="en">Evidence status</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 근거 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies evidence status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#EvaluationRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#policyNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">정책 메모</rdfs:label>
    <rdfs:label xml:lang="en">Policy note</rdfs:label>
    <rdfs:comment xml:lang="ko">정책 메모를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies policy note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Policy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#methodDescription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">방법 설명</rdfs:label>
    <rdfs:label xml:lang="en">Method description</rdfs:label>
    <rdfs:comment xml:lang="ko">방법 설명를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies method description.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#LearningMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#evaluationName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">평가 이름</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation name</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 이름를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies evaluation name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#EvaluationRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#constraintNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">제약 메모</rdfs:label>
    <rdfs:label xml:lang="en">Constraint note</rdfs:label>
    <rdfs:comment xml:lang="ko">제약 메모를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies constraint note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#SafetyConstraint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#policyForTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">대상 과제</rdfs:label>
    <rdfs:label xml:lang="en">Policy for task</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 학습 과제 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related learning task entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Policy"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#LearningTask"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#projectHasExpert">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">시연자</rdfs:label>
    <rdfs:label xml:lang="en">Has demonstrator</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 시연자 또는 참조 정책 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related demonstrator or reference policy entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#Expert"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#DistributionShift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">상태 분포 변화</rdfs:label>
    <rdfs:label xml:lang="en">State distribution shift</rdfs:label>
    <rdfs:comment xml:lang="ko">전문가 시연과 학습 정책이 유도하는 관측 차이 및 평가 상태다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A difference between expert demonstration states and states induced by a learned policy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#stepIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">단계 순서</rdfs:label>
    <rdfs:label xml:lang="en">Step index</rdfs:label>
    <rdfs:comment xml:lang="ko">단계 순서를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies step index.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationStep"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#metricMeasuredValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">측정값</rdfs:label>
    <rdfs:label xml:lang="en">Measured value</rdfs:label>
    <rdfs:comment xml:lang="ko">측정값를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies measured value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#EvaluationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#projectHasDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">시연 데이터셋</rdfs:label>
    <rdfs:label xml:lang="en">Has dataset</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 시연 데이터셋 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related demonstration dataset entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationDataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#evaluationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">평가 상태</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation status</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies evaluation status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#EvaluationRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#Action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">행동 레이블</rdfs:label>
    <rdfs:label xml:lang="en">Action label</rdfs:label>
    <rdfs:comment xml:lang="ko">관측과 짝을 이루는 전문가, 참조, 합성 행동 또는 명령이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">An expert, reference, synthetic or commanded action paired with an observation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#shiftName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">분포 변화 이름</rdfs:label>
    <rdfs:label xml:lang="en">Shift name</rdfs:label>
    <rdfs:comment xml:lang="ko">분포 변화 이름를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies shift name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DistributionShift"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#projectHasDocumentationSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
