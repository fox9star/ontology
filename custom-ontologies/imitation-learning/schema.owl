    <rdfs:comment xml:lang="en">Links a related documentation source entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#DocumentationSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#metricMeasurementStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
