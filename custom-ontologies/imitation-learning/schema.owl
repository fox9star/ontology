  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#metricName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">지표 이름</rdfs:label>
    <rdfs:label xml:lang="en">Metric name</rdfs:label>
    <rdfs:comment xml:lang="ko">지표 이름를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies metric name.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#EvaluationMetric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#datasetSplitStatus">
