    <rdfs:comment xml:lang="en">Records or classifies demonstration note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Demonstration"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#shiftDiscussedByMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
