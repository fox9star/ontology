  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#projectHasTrainingRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">학습 실행</rdfs:label>
    <rdfs:label xml:lang="en">Has training run</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 학습 실행 기록 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related training run record entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#TrainingRun"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#sourceTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">자료 제목</rdfs:label>
    <rdfs:label xml:lang="en">Source title</rdfs:label>
    <rdfs:comment xml:lang="ko">자료 제목를 기록하거나 구분한다.</rdfs:comment>
