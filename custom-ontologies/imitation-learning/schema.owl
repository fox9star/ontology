    <rdfs:comment xml:lang="en">Links a related demonstration step entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Demonstration"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationStep"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#demonstrationNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
