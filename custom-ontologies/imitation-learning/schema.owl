  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#evaluationNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">평가 메모</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation note</rdfs:label>
    <rdfs:comment xml:lang="ko">평가 메모를 기록하거나 구분한다.</rdfs:comment>
