    <rdfs:comment xml:lang="en">Records or classifies applicability note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#LearningMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#demonstrationByExpert">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">시연자 또는 참조</rdfs:label>
    <rdfs:label xml:lang="en">Demonstrated by</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 시연자 또는 참조 정책 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related demonstrator or reference policy entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Demonstration"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#Expert"/>
