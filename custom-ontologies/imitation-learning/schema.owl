    <rdfs:comment xml:lang="ko">수집 상태를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies collection status.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationDataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#EvaluationMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">평가 지표</rdfs:label>
    <rdfs:label xml:lang="en">Evaluation metric</rdfs:label>
    <rdfs:comment xml:lang="ko">행동 모방 또는 과제 성능 척도와 측정 여부를 나타낸다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A measure for action imitation or task performance and its measurement status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#DocumentationSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">문헌 출처</rdfs:label>
    <rdfs:label xml:lang="en">Documentation source</rdfs:label>
    <rdfs:comment xml:lang="ko">방법 설명과 주장을 뒷받침하는 문헌 및 주장 범위다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Literature and claim scope supporting method descriptions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#projectConsidersMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">검토 방법</rdfs:label>
    <rdfs:label xml:lang="en">Considers method</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 모방학습 방법 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related imitation-learning method entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#LearningMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#evaluationUsesDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">평가 데이터셋</rdfs:label>
    <rdfs:label xml:lang="en">Uses dataset</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 시연 데이터셋 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related demonstration dataset entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#EvaluationRun"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#DemonstrationDataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#projectNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">프로젝트 범위 메모</rdfs:label>
    <rdfs:label xml:lang="en">Project scope note</rdfs:label>
    <rdfs:comment xml:lang="ko">프로젝트 범위 메모를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies project scope note.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#ImitationLearningProject"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#actionType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">행동 유형</rdfs:label>
    <rdfs:label xml:lang="en">Action type</rdfs:label>
    <rdfs:comment xml:lang="ko">행동 유형를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies action type.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Action"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#evaluationForPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">평가 대상 정책</rdfs:label>
    <rdfs:label xml:lang="en">Evaluates policy</rdfs:label>
    <rdfs:comment xml:lang="ko">관련 정책 개체를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a related policy entity.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#EvaluationRun"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/imitation-learning#Policy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#Observation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">관측</rdfs:label>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:comment xml:lang="ko">정책 입력으로 쓰이는 관측 내용과 형식을 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the content and modality of a policy input.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/imitation-learning#actionLabelSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">레이블 출처 유형</rdfs:label>
    <rdfs:label xml:lang="en">Label source type</rdfs:label>
    <rdfs:comment xml:lang="ko">레이블 출처 유형를 기록하거나 구분한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records or classifies label source type.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/imitation-learning#Action"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
</rdf:RDF>
