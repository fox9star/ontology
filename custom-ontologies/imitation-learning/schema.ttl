        "학습 과제"@ko ;
    rdfs:comment "Links a related learning task entity."@en,
        "관련 학습 과제 개체를 연결한다."@ko ;
    rdfs:domain iml:ImitationLearningProject ;
    rdfs:range iml:LearningTask .

iml:projectHasTrainingRun a owl:ObjectProperty ;
    rdfs:label "Has training run"@en,
        "학습 실행"@ko ;
    rdfs:comment "Links a related training run record entity."@en,
        "관련 학습 실행 기록 개체를 연결한다."@ko ;
    rdfs:domain iml:ImitationLearningProject ;
    rdfs:range iml:TrainingRun .

iml:projectNote a owl:DatatypeProperty ;
    rdfs:label "Project scope note"@en,
        "프로젝트 범위 메모"@ko ;
    rdfs:comment "Records or classifies project scope note."@en,
        "프로젝트 범위 메모를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:ImitationLearningProject ;
    rdfs:range xsd:string .

iml:shiftAssessmentStatus a owl:DatatypeProperty ;
    rdfs:label "Shift assessment status"@en,
        "분포 변화 평가 상태"@ko ;
    rdfs:comment "Records or classifies shift assessment status."@en,
