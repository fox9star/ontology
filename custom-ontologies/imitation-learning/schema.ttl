@prefix iml: <https://example.org/ontology/custom/imitation-learning#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/custom/imitation-learning> a owl:Ontology ;
    rdfs:label "Imitation Learning Ontology"@en,
        "모방학습 온톨로지 (imitation-learning)"@ko ;
    rdfs:comment "Connects demonstrations, behavior cloning, DAgger, inverse reinforcement learning, policies, run status, distribution shift and literature evidence."@en,
        "전문가 시연, 행동복제·DAgger·역강화학습, 정책, 학습·평가 상태, 분포 변화 및 문헌 근거를 연결한다."@ko ;
    owl:versionIRI <https://example.org/ontology/custom/imitation-learning/0.1.0> ;
    owl:versionInfo "0.1.0" .

iml:actionLabelSource a owl:DatatypeProperty ;
    rdfs:label "Label source type"@en,
        "레이블 출처 유형"@ko ;
    rdfs:comment "Records or classifies label source type."@en,
        "레이블 출처 유형를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:Action ;
    rdfs:range xsd:string .

iml:actionType a owl:DatatypeProperty ;
    rdfs:label "Action type"@en,
        "행동 유형"@ko ;
    rdfs:comment "Records or classifies action type."@en,
        "행동 유형를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:Action ;
    rdfs:range xsd:string .

iml:actionUnit a owl:DatatypeProperty ;
    rdfs:label "Action unit"@en,
        "행동 단위"@ko ;
    rdfs:comment "Records or classifies action unit."@en,
        "행동 단위를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:Action ;
    rdfs:range xsd:string .

iml:actionValue a owl:DatatypeProperty ;
    rdfs:label "Action value or label"@en,
        "행동 값 또는 레이블"@ko ;
    rdfs:comment "Records or classifies action value or label."@en,
        "행동 값 또는 레이블를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:Action ;
    rdfs:range xsd:string .

iml:constraintAppliesToTask a owl:ObjectProperty ;
    rdfs:label "Applies to task"@en,
        "적용 과제"@ko ;
    rdfs:comment "Links a related learning task entity."@en,
        "관련 학습 과제 개체를 연결한다."@ko ;
    rdfs:domain iml:SafetyConstraint ;
    rdfs:range iml:LearningTask .

iml:constraintDescription a owl:DatatypeProperty ;
    rdfs:label "Constraint description"@en,
        "제약 설명"@ko ;
    rdfs:comment "Records or classifies constraint description."@en,
        "제약 설명를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:SafetyConstraint ;
    rdfs:range xsd:string .

iml:constraintName a owl:DatatypeProperty ;
    rdfs:label "Constraint name"@en,
        "제약 이름"@ko ;
    rdfs:comment "Records or classifies constraint name."@en,
        "제약 이름를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:SafetyConstraint ;
    rdfs:range xsd:string .

iml:constraintNote a owl:DatatypeProperty ;
