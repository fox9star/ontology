iml:shiftDescription a owl:DatatypeProperty ;
    rdfs:label "Shift description"@en,
        "분포 변화 설명"@ko ;
    rdfs:comment "Records or classifies shift description."@en,
        "분포 변화 설명를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DistributionShift ;
    rdfs:range xsd:string .

iml:shiftDiscussedByMethod a owl:ObjectProperty ;
    rdfs:label "Discussed by method"@en,
        "관련 방법"@ko ;
    rdfs:comment "Links a related imitation-learning method entity."@en,
        "관련 모방학습 방법 개체를 연결한다."@ko ;
    rdfs:domain iml:DistributionShift ;
    rdfs:range iml:LearningMethod .

iml:shiftName a owl:DatatypeProperty ;
    rdfs:label "Shift name"@en,
        "분포 변화 이름"@ko ;
    rdfs:comment "Records or classifies shift name."@en,
        "분포 변화 이름를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DistributionShift ;
    rdfs:range xsd:string .

iml:shiftNote a owl:DatatypeProperty ;
    rdfs:label "Shift note"@en,
        "분포 변화 메모"@ko ;
    rdfs:comment "Records or classifies shift note."@en,
        "분포 변화 메모를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DistributionShift ;
    rdfs:range xsd:string .

iml:sourceAccessedAt a owl:DatatypeProperty ;
    rdfs:label "Accessed date"@en,
        "확인 날짜"@ko ;
    rdfs:comment "Records or classifies accessed date."@en,
        "확인 날짜를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DocumentationSource ;
    rdfs:range xsd:date .

iml:sourceAuthors a owl:DatatypeProperty ;
    rdfs:label "Authors"@en,
        "저자"@ko ;
    rdfs:comment "Records or classifies authors."@en,
        "저자를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DocumentationSource ;
    rdfs:range xsd:string .

iml:sourceClaim a owl:DatatypeProperty ;
    rdfs:label "Claim supported here"@en,
        "뒷받침하는 주장"@ko ;
    rdfs:comment "Records or classifies claim supported here."@en,
        "뒷받침하는 주장를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DocumentationSource ;
    rdfs:range xsd:string .

iml:sourceTitle a owl:DatatypeProperty ;
    rdfs:label "Source title"@en,
        "자료 제목"@ko ;
    rdfs:comment "Records or classifies source title."@en,
        "자료 제목를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DocumentationSource ;
    rdfs:range xsd:string .

iml:sourceUri a owl:DatatypeProperty ;
    rdfs:label "Source URI"@en,
        "자료 URI"@ko ;
    rdfs:comment "Records or classifies source uri."@en,
        "자료 URI를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DocumentationSource ;
    rdfs:range xsd:anyURI .

iml:sourceYear a owl:DatatypeProperty ;
    rdfs:label "Publication year"@en,
        "발행 연도"@ko ;
    rdfs:comment "Records or classifies publication year."@en,
        "발행 연도를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DocumentationSource ;
    rdfs:range xsd:integer .

iml:stepAction a owl:ObjectProperty ;
    rdfs:label "Step action label"@en,
        "단계 행동 레이블"@ko ;
    rdfs:comment "Links a related action label entity."@en,
        "관련 행동 레이블 개체를 연결한다."@ko ;
    rdfs:domain iml:DemonstrationStep ;
    rdfs:range iml:Action .

iml:stepInDemonstration a owl:ObjectProperty ;
    rdfs:label "Step in demonstration"@en,
        "소속 시연"@ko ;
    rdfs:comment "Links a related demonstration episode entity."@en,
        "관련 시연 에피소드 개체를 연결한다."@ko ;
    rdfs:domain iml:DemonstrationStep ;
    rdfs:range iml:Demonstration .

iml:stepIndex a owl:DatatypeProperty ;
    rdfs:label "Step index"@en,
        "단계 순서"@ko ;
    rdfs:comment "Records or classifies step index."@en,
        "단계 순서를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:DemonstrationStep ;
    rdfs:range xsd:integer .

iml:stepObservation a owl:ObjectProperty ;
    rdfs:label "Step observation"@en,
        "단계 관측"@ko ;
    rdfs:comment "Links a related observation entity."@en,
        "관련 관측 개체를 연결한다."@ko ;
    rdfs:domain iml:DemonstrationStep ;
    rdfs:range iml:Observation .

iml:taskGoal a owl:DatatypeProperty ;
    rdfs:label "Task goal"@en,
        "과제 목표"@ko ;
    rdfs:comment "Records or classifies task goal."@en,
        "과제 목표를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:LearningTask ;
    rdfs:range xsd:string .

iml:taskName a owl:DatatypeProperty ;
    rdfs:label "Task name"@en,
        "과제 이름"@ko ;
    rdfs:comment "Records or classifies task name."@en,
        "과제 이름를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:LearningTask ;
    rdfs:range xsd:string .

iml:trainingName a owl:DatatypeProperty ;
    rdfs:label "Training run name"@en,
        "학습 실행 이름"@ko ;
    rdfs:comment "Records or classifies training run name."@en,
        "학습 실행 이름를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:TrainingRun ;
    rdfs:range xsd:string .

iml:trainingNote a owl:DatatypeProperty ;
    rdfs:label "Training note"@en,
        "학습 실행 메모"@ko ;
    rdfs:comment "Records or classifies training note."@en,
        "학습 실행 메모를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:TrainingRun ;
    rdfs:range xsd:string .

iml:trainingProducesPolicy a owl:ObjectProperty ;
    rdfs:label "Produces policy"@en,
        "결과 정책"@ko ;
    rdfs:comment "Links a related policy entity."@en,
        "관련 정책 개체를 연결한다."@ko ;
    rdfs:domain iml:TrainingRun ;
    rdfs:range iml:Policy .

iml:trainingStatus a owl:DatatypeProperty ;
    rdfs:label "Training status"@en,
        "학습 상태"@ko ;
    rdfs:comment "Records or classifies training status."@en,
        "학습 상태를 기록하거나 구분한다."@ko ;
    rdfs:domain iml:TrainingRun ;
    rdfs:range xsd:string .

iml:trainingUsesDataset a owl:ObjectProperty ;
    rdfs:label "Uses dataset"@en,
        "사용 데이터셋"@ko ;
    rdfs:comment "Links a related demonstration dataset entity."@en,
        "관련 시연 데이터셋 개체를 연결한다."@ko ;
    rdfs:domain iml:TrainingRun ;
    rdfs:range iml:DemonstrationDataset .

iml:trainingUsesMethod a owl:ObjectProperty ;
    rdfs:label "Uses method"@en,
        "사용 방법"@ko ;
    rdfs:comment "Links a related imitation-learning method entity."@en,
        "관련 모방학습 방법 개체를 연결한다."@ko ;
    rdfs:domain iml:TrainingRun ;
    rdfs:range iml:LearningMethod .

iml:Observation a owl:Class ;
    rdfs:label "Observation"@en,
        "관측"@ko ;
    rdfs:comment "Records the content and modality of a policy input."@en,
        "정책 입력으로 쓰이는 관측 내용과 형식을 기록한다."@ko .

iml:Expert a owl:Class ;
    rdfs:label "Demonstrator or reference policy"@en,
        "시연자 또는 참조 정책"@ko ;
    rdfs:comment "A person, controller or policy supplying or serving as a demonstration reference."@en,
        "시연 행동을 제공하거나 참조하는 사람, 제어기 또는 정책이다."@ko .

iml:Action a owl:Class ;
    rdfs:label "Action label"@en,
        "행동 레이블"@ko ;
    rdfs:comment "An expert, reference, synthetic or commanded action paired with an observation."@en,
        "관측과 짝을 이루는 전문가, 참조, 합성 행동 또는 명령이다."@ko .

iml:DemonstrationStep a owl:Class ;
    rdfs:label "Demonstration step"@en,
        "시연 단계"@ko ;
    rdfs:comment "An ordered observation and action-label pair within a demonstration."@en,
        "시연 안에서 순서가 있는 관측과 행동 레이블 한 쌍이다."@ko .

iml:DistributionShift a owl:Class ;
    rdfs:label "State distribution shift"@en,
        "상태 분포 변화"@ko ;
    rdfs:comment "A difference between expert demonstration states and states induced by a learned policy."@en,
        "전문가 시연과 학습 정책이 유도하는 관측 차이 및 평가 상태다."@ko .

iml:EvaluationMetric a owl:Class ;
    rdfs:label "Evaluation metric"@en,
        "평가 지표"@ko ;
    rdfs:comment "A measure for action imitation or task performance and its measurement status."@en,
        "행동 모방 또는 과제 성능 척도와 측정 여부를 나타낸다."@ko .

iml:SafetyConstraint a owl:Class ;
    rdfs:label "Safety constraint"@en,
        "안전 제약"@ko ;
    rdfs:comment "Records a safety condition for training or evaluation and its verification status."@en,
        "학습·평가 범위의 안전 조건과 검증 상태를 기록한다."@ko .

iml:LearningTask a owl:Class ;
    rdfs:label "Learning task"@en,
        "학습 과제"@ko ;
    rdfs:comment "Describes the goal and scope of mapping observations to actions."@en,
        "관측에서 행동으로 이어지는 학습 목표와 범위를 기술한다."@ko .

iml:TrainingRun a owl:Class ;
    rdfs:label "Training run record"@en,
        "학습 실행 기록"@ko ;
    rdfs:comment "Records the data, method, output policy and training status."@en,
        "데이터, 방법, 결과 정책 및 학습 상태를 기록한다."@ko .

iml:DocumentationSource a owl:Class ;
    rdfs:label "Documentation source"@en,
        "문헌 출처"@ko ;
    rdfs:comment "Literature and claim scope supporting method descriptions."@en,
        "방법 설명과 주장을 뒷받침하는 문헌 및 주장 범위다."@ko .

iml:EvaluationRun a owl:Class ;
    rdfs:label "Evaluation run record"@en,
        "평가 실행 기록"@ko ;
    rdfs:comment "Records the evaluation target, metrics, measurement status and evidence."@en,
        "평가 대상, 지표, 측정 상태와 근거를 기록한다."@ko .

iml:Policy a owl:Class ;
    rdfs:label "Policy"@en,
        "정책"@ko ;
    rdfs:comment "A learned or reference mapping from observations or states to actions."@en,
        "관측이나 상태를 행동으로 사상하는 학습 대상 또는 기준이다."@ko .

iml:Demonstration a owl:Class ;
    rdfs:label "Demonstration episode"@en,
        "시연 에피소드"@ko ;
    rdfs:comment "An observation-action sequence or record linked to a task and demonstrator."@en,
        "과제와 시연자에 연결된 관측·행동 시퀀스 또는 기록이다."@ko .

iml:LearningMethod a owl:Class ;
    rdfs:label "Imitation-learning method"@en,
        "모방학습 방법"@ko ;
    rdfs:comment "A method for learning a policy or objective from demonstrations, with literature evidence."@en,
        "시연으로부터 정책 또는 목적을 학습하는 방법과 문헌 근거다."@ko .

iml:DemonstrationDataset a owl:Class ;
    rdfs:label "Demonstration dataset"@en,
        "시연 데이터셋"@ko ;
    rdfs:comment "A collection of demonstrations with provenance, collection status, split status and limitations."@en,
        "출처, 수집 상태, 분할 상태와 한계를 갖는 시연 자료 모음이다."@ko .

iml:ImitationLearningProject a owl:Class ;
    rdfs:label "Imitation-learning project"@en,
        "모방학습 프로젝트"@ko ;
    rdfs:comment "Groups a learning task, demonstrations, methods, policies, runs and evidence."@en,
        "학습 과제, 시연 데이터, 방법, 정책, 실행 및 근거를 묶는다."@ko .
