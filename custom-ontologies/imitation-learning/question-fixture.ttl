@prefix iml: <https://example.org/ontology/custom/imitation-learning#> .
@prefix item: <https://example.test/imitation-learning/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

item:pick-place-project a iml:ImitationLearningProject ;
    rdfs:label "Synthetic example: robot-arm pick-and-place imitation-learning design"@en,
        "합성 예시: 로봇팔 집기·놓기 모방학습 설계"@ko ;
    iml:projectConsidersMethod item:behavior-cloning,
        item:dagger,
        item:inverse-rl ;
    iml:projectDataStatus "synthetic_example"^^xsd:string ;
    iml:projectHasDataset item:synthetic-demo-dataset ;
    iml:projectHasDistributionShift item:expert-policy-state-shift ;
    iml:projectHasDocumentationSource item:ng-russell-2000,
        item:pomerleau-1989,
        item:ross-gordon-bagnell-2011 ;
    iml:projectHasEvaluationRun item:evaluation-run-01 ;
    iml:projectHasExpert item:reference-controller ;
    iml:projectHasPolicy item:learner-policy ;
    iml:projectHasSafetyConstraint item:simulation-only-constraint ;
    iml:projectHasTask item:pick-place-task ;
    iml:projectHasTrainingRun item:training-run-01 ;
    iml:projectNote "설계 예시만 기록한다. 실제 데이터 수집, 모델 학습, 로봇 제어와 성능 평가는 하지 않았다."^^xsd:string .

item:action-01 a iml:Action ;
    rdfs:label "Synthetic action label 1"@en,
        "합성 행동 레이블 1"@ko ;
    iml:actionLabelSource "synthetic_fixture"^^xsd:string ;
    iml:actionType "robot_command"^^xsd:string ;
    iml:actionValue "approach_target_pose"^^xsd:string .

item:action-02 a iml:Action ;
    rdfs:label "Synthetic action label 2"@en,
        "합성 행동 레이블 2"@ko ;
    iml:actionLabelSource "synthetic_fixture"^^xsd:string ;
    iml:actionType "gripper_command"^^xsd:string ;
    iml:actionValue "close_gripper"^^xsd:string .

item:evaluation-run-01 a iml:EvaluationRun ;
    rdfs:label "Unrun policy evaluation plan"@en,
        "미실행 정책 평가 계획"@ko ;
    iml:evaluationEvidenceStatus "none"^^xsd:string ;
    iml:evaluationForPolicy item:learner-policy ;
    iml:evaluationName "planned-pick-place-policy-evaluation"^^xsd:string ;
    iml:evaluationNote "평가하지 않았다. 아래 지표에 결과 수치는 없다."^^xsd:string ;
    iml:evaluationStatus "planned"^^xsd:string ;
    iml:evaluationUsesDataset item:synthetic-demo-dataset ;
    iml:evaluationUsesMetric item:metric-action-error,
        item:metric-collision,
        item:metric-success .

item:expert-policy-state-shift a iml:DistributionShift ;
    rdfs:label "Expert-versus-learner state distribution shift"@en,
        "전문가·학습 정책 상태 분포 차이"@ko ;
    iml:shiftAssessmentStatus "concept_only"^^xsd:string ;
    iml:shiftDescription "순차 의사결정에서 정책 오류가 이후 방문 상태를 바꾸어 전문가 시연과 다른 입력 분포를 만들 수 있다."^^xsd:string ;
    iml:shiftDiscussedByMethod item:dagger ;
    iml:shiftName "expert-state-distribution-versus-learner-induced-states"^^xsd:string ;
    iml:shiftNote "개념만 등록했다. 실제 분포 차이나 DAgger 성능은 측정하지 않았다."^^xsd:string .

item:inverse-rl a iml:LearningMethod ;
    rdfs:label "Inverse reinforcement learning"@en,
        "Inverse reinforcement learning"@ko ;
    iml:methodApplicabilityNote "행동복제처럼 관측마다 행동 레이블을 바로 예측하는 것과 학습 대상이 다르다."^^xsd:string ;
    iml:methodDescription "행동 궤적으로부터 이를 설명하는 보상 또는 목적 함수를 추론한다."^^xsd:string ;
    iml:methodDocumentedBy item:ng-russell-2000 ;
    iml:methodKind "inverse_reinforcement_learning"^^xsd:string ;
    iml:methodName "Inverse reinforcement learning"^^xsd:string .

item:metric-action-error a iml:EvaluationMetric ;
    rdfs:label "행동 모방 오차"@en,
        "행동 모방 오차"@ko ;
    iml:metricDefinition "정렬한 레이블과 정책 출력 사이의 과제별 오차 척도"^^xsd:string ;
    iml:metricMeasurementStatus "not_measured"^^xsd:string ;
    iml:metricName "행동 모방 오차"^^xsd:string ;
    iml:metricUnit "task-defined"^^xsd:string .

item:metric-collision a iml:EvaluationMetric ;
    rdfs:label "충돌 횟수"@en,
        "충돌 횟수"@ko ;
    iml:metricDefinition "정의한 충돌 판정 기준에 해당한 횟수"^^xsd:string ;
    iml:metricMeasurementStatus "not_measured"^^xsd:string ;
    iml:metricName "충돌 횟수"^^xsd:string ;
    iml:metricUnit "count"^^xsd:string .

item:metric-success a iml:EvaluationMetric ;
    rdfs:label "과제 성공률"@en,
        "과제 성공률"@ko ;
    iml:metricDefinition "정의한 평가 에피소드 중 목표 배치 조건을 만족한 비율"^^xsd:string ;
    iml:metricMeasurementStatus "not_measured"^^xsd:string ;
    iml:metricName "과제 성공률"^^xsd:string ;
    iml:metricUnit "ratio"^^xsd:string .

item:observation-01 a iml:Observation ;
    rdfs:label "Synthetic observation 1"@en,
        "합성 관측 1"@ko ;
    iml:observationModality "simulated_image"^^xsd:string ;
    iml:observationSummary "가상 장면에서 큐브와 목표 구역을 보는 이미지 관측의 설명용 예시"^^xsd:string .

item:observation-02 a iml:Observation ;
    rdfs:label "Synthetic observation 2"@en,
        "합성 관측 2"@ko ;
    iml:observationModality "simulated_state"^^xsd:string ;
    iml:observationSummary "그리퍼가 큐브를 잡았다고 가정한 가상 상태 관측의 설명용 예시"^^xsd:string .

item:simulation-only-constraint a iml:SafetyConstraint ;
    rdfs:label "Simulation-only constraint"@en,
        "시뮬레이션 전용 제약"@ko ;
    iml:constraintAppliesToTask item:pick-place-task ;
    iml:constraintDescription "이 픽스처를 실제 하드웨어에 보내지 않는다. 물리 구동 전 속도 제한, 비상 정지, 작업공간과 사람 안전에 대한 별도 검증이 필요하다."^^xsd:string ;
    iml:constraintName "no-live-robot-actuation"^^xsd:string ;
    iml:constraintNote "안전성이 검증된 제어기가 아니라 범위 설명 항목이다."^^xsd:string ;
    iml:constraintStatus "planned"^^xsd:string .

item:step-01 a iml:DemonstrationStep ;
    rdfs:label "Synthetic demonstration step 1"@en,
        "합성 시연 단계 1"@ko ;
    iml:stepAction item:action-01 ;
    iml:stepInDemonstration item:demo-pick-place-01 ;
    iml:stepIndex 1 ;
    iml:stepObservation item:observation-01 .

item:step-02 a iml:DemonstrationStep ;
    rdfs:label "Synthetic demonstration step 2"@en,
        "합성 시연 단계 2"@ko ;
    iml:stepAction item:action-02 ;
    iml:stepInDemonstration item:demo-pick-place-01 ;
    iml:stepIndex 2 ;
    iml:stepObservation item:observation-02 .

item:training-run-01 a iml:TrainingRun ;
    rdfs:label "Planned behavior-cloning training run"@en,
        "계획된 행동복제 학습 실행"@ko ;
    iml:trainingName "planned-pick-place-behavior-cloning"^^xsd:string ;
    iml:trainingNote "실행되지 않았다. 가중치, 로그 또는 학습 시간은 생성하지 않았다."^^xsd:string ;
    iml:trainingProducesPolicy item:learner-policy ;
    iml:trainingStatus "planned"^^xsd:string ;
    iml:trainingUsesDataset item:synthetic-demo-dataset ;
    iml:trainingUsesMethod item:behavior-cloning .

item:dagger a iml:LearningMethod ;
    rdfs:label "DAgger (Dataset Aggregation)"@en,
        "DAgger (Dataset Aggregation)"@ko ;
    iml:methodApplicabilityNote "전문가 분포와 정책 유도 상태 분포의 차이를 다루는 방법이다. 이 예시는 성능을 측정하지 않는다."^^xsd:string ;
    iml:methodDescription "학습 정책이 방문한 상태에서 전문가 레이블을 얻고 학습 데이터를 반복적으로 누적한다."^^xsd:string ;
    iml:methodDocumentedBy item:ross-gordon-bagnell-2011 ;
    iml:methodKind "dagger"^^xsd:string ;
    iml:methodName "DAgger (Dataset Aggregation)"^^xsd:string .

item:ng-russell-2000 a iml:DocumentationSource ;
    rdfs:label "Algorithms for Inverse Reinforcement Learning"@en,
        "Algorithms for Inverse Reinforcement Learning"@ko ;
    iml:sourceAccessedAt "2026-10-08"^^xsd:date ;
    iml:sourceAuthors "Andrew Y. Ng, Stuart Russell"^^xsd:string ;
    iml:sourceClaim "Formulates reward inference from observed optimal behavior, including a finite-trajectory case."^^xsd:string ;
    iml:sourceTitle "Algorithms for Inverse Reinforcement Learning"^^xsd:string ;
    iml:sourceUri "https://ai.stanford.edu/~ang/papers/icml00-irl.pdf"^^xsd:anyURI ;
    iml:sourceYear 2000 .

item:pomerleau-1989 a iml:DocumentationSource ;
    rdfs:label "ALVINN: An Autonomous Land Vehicle in a Neural Network"@en,
        "ALVINN: An Autonomous Land Vehicle in a Neural Network"@ko ;
    iml:sourceAccessedAt "2026-10-08"^^xsd:date ;
    iml:sourceAuthors "Dean A. Pomerleau"^^xsd:string ;
    iml:sourceClaim "Describes camera and laser-range inputs, a driving-direction output, and training with simulated road images."^^xsd:string ;
    iml:sourceTitle "ALVINN: An Autonomous Land Vehicle in a Neural Network"^^xsd:string ;
    iml:sourceUri "https://publications.ri.cmu.edu/alvinn-an-autonomous-land-vehicle-in-a-neural-network"^^xsd:anyURI ;
    iml:sourceYear 1989 .

item:reference-controller a iml:Expert ;
    rdfs:label "Simulated reference controller"@en,
        "가상 참조 제어기"@ko ;
    iml:expertRole "합성 설명 개체이며 실제 사람이나 실행된 제어기 기록이 아니다."^^xsd:string ;
    iml:expertType "simulation_reference_policy"^^xsd:string .

item:ross-gordon-bagnell-2011 a iml:DocumentationSource ;
    rdfs:label "A Reduction of Imitation Learning and Structured Prediction to No-Regret Online Learning"@en,
        "A Reduction of Imitation Learning and Structured Prediction to No-Regret Online Learning"@ko ;
    iml:sourceAccessedAt "2026-10-08"^^xsd:date ;
    iml:sourceAuthors "Stéphane Ross, Geoffrey J. Gordon, J. Andrew Bagnell"^^xsd:string ;
    iml:sourceClaim "DAgger uses learner-induced states, expert action labels and iterative data aggregation."^^xsd:string ;
    iml:sourceTitle "A Reduction of Imitation Learning and Structured Prediction to No-Regret Online Learning"^^xsd:string ;
    iml:sourceUri "https://proceedings.mlr.press/v15/ross11a.html"^^xsd:anyURI ;
    iml:sourceYear 2011 .

item:behavior-cloning a iml:LearningMethod ;
    rdfs:label "Behavior cloning"@en,
        "Behavior cloning"@ko ;
    iml:methodApplicabilityNote "ALVINN은 직접 입력-출력 학습의 관련 사례다. 논문이 이 방법명을 최초로 정의했다고 주장하지 않는다."^^xsd:string ;
    iml:methodDescription "근사 정책을 학습하도록 시연의 관측·행동 쌍을 지도 신호로 사용한다."^^xsd:string ;
    iml:methodDocumentedBy item:pomerleau-1989 ;
    iml:methodKind "behavior_cloning"^^xsd:string ;
    iml:methodName "Behavior cloning"^^xsd:string .

item:demo-pick-place-01 a iml:Demonstration ;
    rdfs:label "Synthetic demonstration example 1"@en,
        "합성 시연 예시 1"@ko ;
    iml:demonstrationByExpert item:reference-controller ;
    iml:demonstrationForTask item:pick-place-task ;
    iml:demonstrationHasStep item:step-01,
        item:step-02 ;
    iml:demonstrationInDataset item:synthetic-demo-dataset ;
    iml:demonstrationLabelStatus "synthetic_fixture"^^xsd:string ;
    iml:demonstrationNote "실제 전문가가 수행하거나 레이블링한 궤적이 아니라 스키마 설명을 위해 만든 단계 예시다."^^xsd:string ;
    iml:demonstrationStatus "synthetic_example"^^xsd:string .

item:learner-policy a iml:Policy ;
    rdfs:label "Untrained learner policy"@en,
        "미학습 학습자 정책"@ko ;
    iml:policyForTask item:pick-place-task ;
    iml:policyLearnsWithMethod item:behavior-cloning ;
    iml:policyName "pick-place-learner-policy"^^xsd:string ;
    iml:policyNote "설계용 정책 개체다. 모델 파일이나 학습 결과가 없다."^^xsd:string ;
    iml:policyStatus "not_trained"^^xsd:string .

item:synthetic-demo-dataset a iml:DemonstrationDataset ;
    rdfs:label "Synthetic demonstration dataset example"@en,
        "합성 시연 데이터 예시"@ko ;
    iml:datasetCollectionStatus "synthetic_fixture_not_collected"^^xsd:string ;
    iml:datasetForTask item:pick-place-task ;
    iml:datasetIncludesDemonstration item:demo-pick-place-01 ;
    iml:datasetLimitations "설명용 두 단계 예시만 있다. 실제 프레임, 관절 수치, 데이터 파일, 사람 시연, 분할 또는 수집 절차는 없다."^^xsd:string ;
    iml:datasetName "pick-place-synthetic-fixture"^^xsd:string ;
    iml:datasetProvenanceType "synthetic_only"^^xsd:string ;
    iml:datasetSplitStatus "not_applicable_synthetic_fixture"^^xsd:string .

item:pick-place-task a iml:LearningTask ;
    rdfs:label "Pick a cube and place it in a target area"@en,
        "큐브 집어 목표 구역에 놓기"@ko ;
    iml:taskGoal "가상 관측을 입력으로 참조 행동 순서를 학습하는 구상이며 실제 로봇 실행은 범위에 포함하지 않는다."^^xsd:string ;
    iml:taskName "시뮬레이션 기반 큐브 집기·놓기"^^xsd:string .
