@prefix ns1: <https://example.org/ontology/custom/ww2#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.test/consumer/ww2-reject> {
    <https://example.test/ww2/auschwitz> a ns1:Place ;
        rdfs:label "Auschwitz camp complex"@en,
            "아우슈비츠 수용소 복합시설"@ko ;
        ns1:placeKind "camp" .

    <https://example.test/ww2/auschwitz-liberation> a ns1:HistoricalEvent ;
        rdfs:label "Liberation of Auschwitz"@en,
            "아우슈비츠 수용소 해방"@ko ;
        ns1:dateNote "소련군의 수용소 해방 일자입니다. 홀로코스트의 시작·종료 경계를 하나의 일자로 단정하지 않습니다." ;
        ns1:endDate "1945-01-27"^^xsd:date ;
        ns1:eventKind "liberation" ;
        ns1:eventOf <https://example.test/ww2/world-war-ii> ;
        ns1:hasClaim <https://example.test/ww2/auschwitz-liberation-claim> ;
        ns1:hasParticipation <https://example.test/ww2/auschwitz-liberation-participation-soviet-union> ;
        ns1:occurredAt <https://example.test/ww2/auschwitz> ;
        ns1:startDate "1945-01-27"^^xsd:date .

    <https://example.test/ww2/auschwitz-liberation-claim> a ns1:HistoricalClaim ;
        rdfs:label "Sourced account of Liberation of Auschwitz"@en,
            "아우슈비츠 수용소 해방의 출처 서술"@ko ;
        ns1:aboutEvent <https://example.test/ww2/auschwitz-liberation> ;
        ns1:citesSource <https://example.test/ww2/auschwitz-source> ;
        ns1:claimText "1945년 1월 27일 소련군은 아우슈비츠 수용소 복합시설에 남아 있던 수감자들을 해방했다." .

    <https://example.test/ww2/auschwitz-liberation-participation-soviet-union> a ns1:Participation ;
        rdfs:label "Liberation of Auschwitz: participation of Union of Soviet Socialist Republics"@en,
            "아우슈비츠 수용소 해방: 소련의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/auschwitz-source> ;
        ns1:endDate "1945-01-27"^^xsd:date ;
        ns1:participant <https://example.test/ww2/soviet-union> ;
        ns1:role "liberator" ;
        ns1:side "Allied" ;
        ns1:startDate "1945-01-27"^^xsd:date .

    <https://example.test/ww2/barbarossa-opening> a ns1:HistoricalEvent ;
        rdfs:label "Opening of Operation Barbarossa"@en,
            "바르바로사 작전 개시"@ko ;
        ns1:dateNote "독일의 소련 침공 개시일입니다. 동부전선 전체나 작전 전체의 종료일을 기록한 구간이 아닙니다." ;
        ns1:endDate "1941-06-22"^^xsd:date ;
        ns1:eventKind "invasion" ;
        ns1:eventOf <https://example.test/ww2/world-war-ii> ;
        ns1:hasClaim <https://example.test/ww2/barbarossa-opening-claim> ;
        ns1:hasParticipation <https://example.test/ww2/barbarossa-opening-participation-german-reich>,
            <https://example.test/ww2/barbarossa-opening-participation-soviet-union> ;
        ns1:occurredAt <https://example.test/ww2/soviet-territory> ;
        ns1:startDate "1941-06-22"^^xsd:date .

    <https://example.test/ww2/barbarossa-opening-claim> a ns1:HistoricalClaim ;
        rdfs:label "Sourced account of Opening of Operation Barbarossa"@en,
            "바르바로사 작전 개시의 출처 서술"@ko ;
        ns1:aboutEvent <https://example.test/ww2/barbarossa-opening> ;
        ns1:citesSource <https://example.test/ww2/barbarossa-source> ;
        ns1:claimText "1941년 6월 22일 나치 독일이 소련을 침공했다. 초기 장소 기록은 현대 국경 대신 당시 소련 영토를 가리킨다." .

    <https://example.test/ww2/barbarossa-opening-participation-german-reich> a ns1:Participation ;
        rdfs:label "Opening of Operation Barbarossa: participation of German Reich"@en,
            "바르바로사 작전 개시: 독일국 (당시 독일)의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/barbarossa-source> ;
        ns1:endDate "1941-06-22"^^xsd:date ;
        ns1:participant <https://example.test/ww2/german-reich> ;
        ns1:role "attacker" ;
        ns1:side "Axis" ;
        ns1:startDate "1941-06-22"^^xsd:date .

    <https://example.test/ww2/barbarossa-opening-participation-soviet-union> a ns1:Participation ;
        rdfs:label "Opening of Operation Barbarossa: participation of Union of Soviet Socialist Republics"@en,
            "바르바로사 작전 개시: 소련의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/barbarossa-source> ;
        ns1:endDate "1941-06-22"^^xsd:date ;
        ns1:participant <https://example.test/ww2/soviet-union> ;
        ns1:role "defender" ;
        ns1:side "Allied" ;
        ns1:startDate "1941-06-22"^^xsd:date .

    <https://example.test/ww2/canada> a ns1:State ;
        rdfs:label "Canada"@en,
            "캐나다"@ko ;
        ns1:historicalName "캐나다" .

    <https://example.test/ww2/europe> a ns1:Place ;
        rdfs:label "European theater, scope of the event"@en,
            "유럽 전역 (사건의 적용 범위)"@ko ;
        ns1:placeKind "region" .

    <https://example.test/ww2/german-ceasefire-effective> a ns1:HistoricalEvent ;
        rdfs:label "Effective cessation of German military operations"@en,
            "독일군 작전 중지의 발효"@ko ;
        ns1:dateNote "항복문서상 중앙유럽시간 23:01의 작전 중지 발효일입니다. 모든 지역에서 동시에 실제 전투가 멈췄다고 단정하지 않습니다." ;
        ns1:endDate "1945-05-08"^^xsd:date ;
        ns1:eventKind "ceasefire" ;
        ns1:eventOf <https://example.test/ww2/world-war-ii> ;
        ns1:hasClaim <https://example.test/ww2/german-ceasefire-effective-claim> ;
        ns1:hasParticipation <https://example.test/ww2/german-ceasefire-effective-participation-german-reich> ;
        ns1:occurredAt <https://example.test/ww2/europe> ;
        ns1:startDate "1945-05-08"^^xsd:date .

    <https://example.test/ww2/german-ceasefire-effective-claim> a ns1:HistoricalClaim ;
        rdfs:label "Sourced account of Effective cessation of German military operations"@en,
            "독일군 작전 중지의 발효의 출처 서술"@ko ;
        ns1:aboutEvent <https://example.test/ww2/german-ceasefire-effective> ;
        ns1:citesSource <https://example.test/ww2/german-surrender-source> ;
        ns1:claimText "독일 항복문서는 독일 지휘하의 육·해·공군이 1945년 5월 8일 중앙유럽시간 23:01에 작전을 중지하도록 규정했다." .

    <https://example.test/ww2/german-ceasefire-effective-participation-german-reich> a ns1:Participation ;
        rdfs:label "Effective cessation of German military operations: participation of German Reich"@en,
            "독일군 작전 중지의 발효: 독일국 (당시 독일)의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/german-surrender-source> ;
        ns1:endDate "1945-05-08"^^xsd:date ;
        ns1:participant <https://example.test/ww2/german-reich> ;
        ns1:role "surrendering-party" ;
        ns1:side "Axis" ;
        ns1:startDate "1945-05-08"^^xsd:date .

    <https://example.test/ww2/german-surrender-reims> a ns1:HistoricalEvent ;
        rdfs:label "Signing of the German surrender at Reims"@en,
            "독일 항복문서의 랭스 서명"@ko ;
        ns1:dateNote "프랑스 랭스에서의 항복문서 서명일입니다. 5월 8일의 작전 중지 발효와 베를린 재서명을 별도 사실로 구별합니다." ;
        ns1:endDate "1945-05-07"^^xsd:date ;
        ns1:eventKind "surrender-signing" ;
        ns1:eventOf <https://example.test/ww2/world-war-ii> ;
        ns1:hasClaim <https://example.test/ww2/german-surrender-reims-claim> ;
        ns1:hasParticipation <https://example.test/ww2/german-surrender-reims-participation-german-reich> ;
        ns1:occurredAt <https://example.test/ww2/reims> ;
        ns1:startDate "1945-05-07"^^xsd:date .

    <https://example.test/ww2/german-surrender-reims-claim> a ns1:HistoricalClaim ;
        rdfs:label "Sourced account of Signing of the German surrender at Reims"@en,
            "독일 항복문서의 랭스 서명의 출처 서술"@ko ;
        ns1:aboutEvent <https://example.test/ww2/german-surrender-reims> ;
        ns1:citesSource <https://example.test/ww2/german-surrender-source> ;
        ns1:claimText "1945년 5월 7일 프랑스 랭스에서 독일군의 무조건 항복문서가 서명되었다. 문서가 규정한 작전 중지는 이튿날 발효했다." .

    <https://example.test/ww2/german-surrender-reims-participation-german-reich> a ns1:Participation ;
        rdfs:label "Signing of the German surrender at Reims: participation of German Reich"@en,
            "독일 항복문서의 랭스 서명: 독일국 (당시 독일)의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/german-surrender-source> ;
        ns1:endDate "1945-05-07"^^xsd:date ;
        ns1:participant <https://example.test/ww2/german-reich> ;
        ns1:role "surrendering-party" ;
        ns1:side "Axis" ;
        ns1:startDate "1945-05-07"^^xsd:date .

    <https://example.test/ww2/japan-place> a ns1:Place ;
        rdfs:label "Japan, audience scope of the broadcast"@en,
            "일본 (방송의 전달 범위)"@ko ;
        ns1:placeKind "country" .

    <https://example.test/ww2/japan-surrender-broadcast> a ns1:HistoricalEvent ;
        rdfs:label "Japanese broadcast announcing acceptance of surrender"@en,
            "일본의 항복 수락 방송"@ko ;
        ns1:dateNote "국민에게 방송된 일본 현지 일자입니다. 8월 14일의 준비·녹음 및 9월 2일의 정식 항복문서 서명과 구별합니다." ;
        ns1:endDate "1945-08-15"^^xsd:date ;
        ns1:eventKind "surrender-announcement" ;
        ns1:eventOf <https://example.test/ww2/world-war-ii> ;
        ns1:hasClaim <https://example.test/ww2/japan-surrender-broadcast-claim> ;
        ns1:hasParticipation <https://example.test/ww2/japan-surrender-broadcast-participation-empire-of-japan> ;
        ns1:occurredAt <https://example.test/ww2/japan-place> ;
        ns1:startDate "1945-08-15"^^xsd:date .

    <https://example.test/ww2/japan-surrender-broadcast-claim> a ns1:HistoricalClaim ;
        rdfs:label "Sourced account of Japanese broadcast announcing acceptance of surrender"@en,
            "일본의 항복 수락 방송의 출처 서술"@ko ;
        ns1:aboutEvent <https://example.test/ww2/japan-surrender-broadcast> ;
        ns1:citesSource <https://example.test/ww2/japan-broadcast-source> ;
        ns1:claimText "1945년 8월 15일 히로히토의 라디오 방송이 일본의 항복 수락을 국민에게 알렸다." .

    <https://example.test/ww2/japan-surrender-broadcast-participation-empire-of-japan> a ns1:Participation ;
        rdfs:label "Japanese broadcast announcing acceptance of surrender: participation of Empire of Japan"@en,
            "일본의 항복 수락 방송: 일본제국의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/japan-broadcast-source> ;
        ns1:endDate "1945-08-15"^^xsd:date ;
        ns1:participant <https://example.test/ww2/empire-of-japan> ;
        ns1:role "surrendering-party" ;
        ns1:side "Axis" ;
        ns1:startDate "1945-08-15"^^xsd:date .

    <https://example.test/ww2/japan-surrender-signing> a ns1:HistoricalEvent ;
        rdfs:label "Formal signing of the Japanese Instrument of Surrender"@en,
            "일본 항복문서의 정식 서명"@ko ;
        ns1:dateNote "도쿄만 USS Missouri 함상에서의 정식 항복문서 서명일입니다. 8월 15일의 발표·방송과 별도 사건입니다." ;
        ns1:endDate "1945-09-02"^^xsd:date ;
        ns1:eventKind "surrender-signing" ;
        ns1:eventOf <https://example.test/ww2/world-war-ii> ;
        ns1:hasClaim <https://example.test/ww2/japan-surrender-signing-claim> ;
        ns1:hasParticipation <https://example.test/ww2/japan-surrender-signing-participation-empire-of-japan>,
            <https://example.test/ww2/japan-surrender-signing-participation-macarthur>,
            <https://example.test/ww2/japan-surrender-signing-participation-shigemitsu> ;
        ns1:occurredAt <https://example.test/ww2/tokyo-bay> ;
        ns1:startDate "1945-09-02"^^xsd:date .

    <https://example.test/ww2/japan-surrender-signing-claim> a ns1:HistoricalClaim ;
        rdfs:label "Sourced account of Formal signing of the Japanese Instrument of Surrender"@en,
            "일본 항복문서의 정식 서명의 출처 서술"@ko ;
        ns1:aboutEvent <https://example.test/ww2/japan-surrender-signing> ;
        ns1:citesSource <https://example.test/ww2/japan-surrender-source> ;
        ns1:claimText "1945년 9월 2일 도쿄만의 USS Missouri 함상에서 일본 항복문서가 서명되었다. 시게미쓰 마모루는 일본 정부를 대표해 서명했고 더글러스 맥아더는 연합국을 대표해 수락했다." .

    <https://example.test/ww2/japan-surrender-signing-participation-empire-of-japan> a ns1:Participation ;
        rdfs:label "Formal signing of the Japanese Instrument of Surrender: participation of Empire of Japan"@en,
            "일본 항복문서의 정식 서명: 일본제국의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/japan-surrender-source> ;
        ns1:endDate "1945-09-02"^^xsd:date ;
        ns1:participant <https://example.test/ww2/empire-of-japan> ;
        ns1:role "surrendering-party" ;
        ns1:side "Axis" ;
        ns1:startDate "1945-09-02"^^xsd:date .

    <https://example.test/ww2/japan-surrender-signing-participation-macarthur> a ns1:Participation ;
        rdfs:label "Formal signing of the Japanese Instrument of Surrender: participation of Douglas MacArthur"@en,
            "일본 항복문서의 정식 서명: 더글러스 맥아더의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/japan-surrender-source> ;
        ns1:endDate "1945-09-02"^^xsd:date ;
        ns1:participant <https://example.test/ww2/macarthur> ;
        ns1:role "accepting-party" ;
        ns1:side "Allied" ;
        ns1:startDate "1945-09-02"^^xsd:date .

    <https://example.test/ww2/japan-surrender-signing-participation-shigemitsu> a ns1:Participation ;
        rdfs:label "Formal signing of the Japanese Instrument of Surrender: participation of Mamoru Shigemitsu"@en,
            "일본 항복문서의 정식 서명: 시게미쓰 마모루의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/japan-surrender-source> ;
        ns1:endDate "1945-09-02"^^xsd:date ;
        ns1:participant <https://example.test/ww2/shigemitsu> ;
        ns1:role "representative" ;
        ns1:side "Axis" ;
        ns1:startDate "1945-09-02"^^xsd:date .

    <https://example.test/ww2/macarthur> a ns1:Person ;
        rdfs:label "Douglas MacArthur"@en,
            "더글러스 맥아더"@ko .

    <https://example.test/ww2/normandy> a ns1:Place ;
        rdfs:label "Normandy landing area, France"@en,
            "프랑스 노르망디 상륙 지역"@ko ;
        ns1:placeKind "region" .

    <https://example.test/ww2/normandy-landings> a ns1:HistoricalEvent ;
        rdfs:label "Normandy landings, D-Day"@en,
            "노르망디 상륙 개시 (D-Day)"@ko ;
        ns1:dateNote "상륙 개시일입니다. 노르망디 전역 또는 오버로드 작전 전체의 기간을 뜻하지 않습니다." ;
        ns1:endDate "1944-06-06"^^xsd:date ;
        ns1:eventKind "landing" ;
        ns1:eventOf <https://example.test/ww2/world-war-ii> ;
        ns1:hasClaim <https://example.test/ww2/normandy-landings-claim> ;
        ns1:hasParticipation <https://example.test/ww2/normandy-landings-participation-canada>,
            <https://example.test/ww2/normandy-landings-participation-german-reich>,
            <https://example.test/ww2/normandy-landings-participation-united-kingdom>,
            <https://example.test/ww2/normandy-landings-participation-united-states> ;
        ns1:occurredAt <https://example.test/ww2/normandy> ;
        ns1:startDate "1944-06-06"^^xsd:date .

    <https://example.test/ww2/normandy-landings-claim> a ns1:HistoricalClaim ;
        rdfs:label "Sourced account of Normandy landings, D-Day"@en,
            "노르망디 상륙 개시 (D-Day)의 출처 서술"@ko ;
        ns1:aboutEvent <https://example.test/ww2/normandy-landings> ;
        ns1:citesSource <https://example.test/ww2/d-day-source> ;
        ns1:claimText "1944년 6월 6일 미국·영국·캐나다군이 프랑스 노르망디에 상륙해 독일 방어군과 전투를 벌였다." .

    <https://example.test/ww2/normandy-landings-participation-canada> a ns1:Participation ;
        rdfs:label "Normandy landings, D-Day: participation of Canada"@en,
            "노르망디 상륙 개시 (D-Day): 캐나다의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/d-day-source> ;
        ns1:endDate "1944-06-06"^^xsd:date ;
        ns1:participant <https://example.test/ww2/canada> ;
        ns1:role "attacker" ;
        ns1:side "Allied" ;
        ns1:startDate "1944-06-06"^^xsd:date .

    <https://example.test/ww2/normandy-landings-participation-german-reich> a ns1:Participation ;
        rdfs:label "Normandy landings, D-Day: participation of German Reich"@en,
            "노르망디 상륙 개시 (D-Day): 독일국 (당시 독일)의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/d-day-source> ;
        ns1:endDate "1944-06-06"^^xsd:date ;
        ns1:participant <https://example.test/ww2/german-reich> ;
        ns1:role "defender" ;
        ns1:side "Axis" ;
        ns1:startDate "1944-06-06"^^xsd:date .

    <https://example.test/ww2/normandy-landings-participation-united-kingdom> a ns1:Participation ;
        rdfs:label "Normandy landings, D-Day: participation of United Kingdom"@en,
            "노르망디 상륙 개시 (D-Day): 영국의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/d-day-source> ;
        ns1:endDate "1944-06-06"^^xsd:date ;
        ns1:participant <https://example.test/ww2/united-kingdom> ;
        ns1:role "attacker" ;
        ns1:side "Allied" ;
        ns1:startDate "1944-06-06"^^xsd:date .

    <https://example.test/ww2/normandy-landings-participation-united-states> a ns1:Participation ;
        rdfs:label "Normandy landings, D-Day: participation of United States of America"@en,
            "노르망디 상륙 개시 (D-Day): 미국의 참여"@ko ;
        ns1:documentedBy <https://example.test/ww2/d-day-source> ;
        ns1:endDate "1944-06-06"^^xsd:date ;
        ns1:participant <https://example.test/ww2/united-states> ;
        ns1:role "attacker" ;
        ns1:side "Allied" ;
        ns1:startDate "1944-06-06"^^xsd:date .

    <https://example.test/ww2/pearl-harbor> a ns1:Place ;
        rdfs:label "Pearl Harbor, then Territory of Hawaii"@en,
            "진주만, 당시 미국령 하와이"@ko ;
        ns1:placeKind "base" .

    <https://example.test/ww2/pearl-harbor-attack> a ns1:HistoricalEvent ;
        rdfs:label "Attack on Pearl Harbor"@en,
            "진주만 공격"@ko ;
        ns1:dateNote "하와이 현지 달력의 공격 일자입니다. 시간대가 다른 지역의 달력 일자와 구별합니다." ;
        ns1:endDate "1941-12-07"^^xsd:date ;
