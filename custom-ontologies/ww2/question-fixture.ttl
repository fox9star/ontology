@prefix item: <https://example.test/ww2/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ww2: <https://example.org/ontology/custom/ww2#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

item:auschwitz a ww2:Place ;
    rdfs:label "Auschwitz camp complex"@en,
        "아우슈비츠 수용소 복합시설"@ko ;
    ww2:placeKind "camp" .

item:auschwitz-liberation a ww2:HistoricalEvent ;
    rdfs:label "Liberation of Auschwitz"@en,
        "아우슈비츠 수용소 해방"@ko ;
    ww2:dateNote "소련군의 수용소 해방 일자입니다. 홀로코스트의 시작·종료 경계를 하나의 일자로 단정하지 않습니다." ;
    ww2:endDate "1945-01-27"^^xsd:date ;
    ww2:eventKind "liberation" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:auschwitz-liberation-claim ;
    ww2:hasParticipation item:auschwitz-liberation-participation-soviet-union ;
    ww2:occurredAt item:auschwitz ;
    ww2:startDate "1945-01-27"^^xsd:date .

item:auschwitz-liberation-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Liberation of Auschwitz"@en,
        "아우슈비츠 수용소 해방의 출처 서술"@ko ;
    ww2:aboutEvent item:auschwitz-liberation ;
    ww2:citesSource item:auschwitz-source ;
    ww2:claimText "1945년 1월 27일 소련군은 아우슈비츠 수용소 복합시설에 남아 있던 수감자들을 해방했다." .

item:auschwitz-liberation-participation-soviet-union a ww2:Participation ;
    rdfs:label "Liberation of Auschwitz: participation of Union of Soviet Socialist Republics"@en,
        "아우슈비츠 수용소 해방: 소련의 참여"@ko ;
    ww2:documentedBy item:auschwitz-source ;
    ww2:endDate "1945-01-27"^^xsd:date ;
    ww2:participant item:soviet-union ;
    ww2:role "liberator" ;
    ww2:side "Allied" ;
    ww2:startDate "1945-01-27"^^xsd:date .

item:barbarossa-opening a ww2:HistoricalEvent ;
    rdfs:label "Opening of Operation Barbarossa"@en,
        "바르바로사 작전 개시"@ko ;
    ww2:dateNote "독일의 소련 침공 개시일입니다. 동부전선 전체나 작전 전체의 종료일을 기록한 구간이 아닙니다." ;
    ww2:endDate "1941-06-22"^^xsd:date ;
    ww2:eventKind "invasion" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:barbarossa-opening-claim ;
    ww2:hasParticipation item:barbarossa-opening-participation-german-reich,
        item:barbarossa-opening-participation-soviet-union ;
    ww2:occurredAt item:soviet-territory ;
    ww2:startDate "1941-06-22"^^xsd:date .

item:barbarossa-opening-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Opening of Operation Barbarossa"@en,
        "바르바로사 작전 개시의 출처 서술"@ko ;
    ww2:aboutEvent item:barbarossa-opening ;
    ww2:citesSource item:barbarossa-source ;
    ww2:claimText "1941년 6월 22일 나치 독일이 소련을 침공했다. 초기 장소 기록은 현대 국경 대신 당시 소련 영토를 가리킨다." .

item:barbarossa-opening-participation-german-reich a ww2:Participation ;
    rdfs:label "Opening of Operation Barbarossa: participation of German Reich"@en,
        "바르바로사 작전 개시: 독일국 (당시 독일)의 참여"@ko ;
    ww2:documentedBy item:barbarossa-source ;
    ww2:endDate "1941-06-22"^^xsd:date ;
    ww2:participant item:german-reich ;
    ww2:role "attacker" ;
    ww2:side "Axis" ;
    ww2:startDate "1941-06-22"^^xsd:date .

item:barbarossa-opening-participation-soviet-union a ww2:Participation ;
    rdfs:label "Opening of Operation Barbarossa: participation of Union of Soviet Socialist Republics"@en,
        "바르바로사 작전 개시: 소련의 참여"@ko ;
    ww2:documentedBy item:barbarossa-source ;
    ww2:endDate "1941-06-22"^^xsd:date ;
    ww2:participant item:soviet-union ;
    ww2:role "defender" ;
    ww2:side "Allied" ;
    ww2:startDate "1941-06-22"^^xsd:date .

item:canada a ww2:State ;
    rdfs:label "Canada"@en,
        "캐나다"@ko ;
    ww2:historicalName "캐나다" .

item:europe a ww2:Place ;
    rdfs:label "European theater, scope of the event"@en,
        "유럽 전역 (사건의 적용 범위)"@ko ;
    ww2:placeKind "region" .

item:german-ceasefire-effective a ww2:HistoricalEvent ;
    rdfs:label "Effective cessation of German military operations"@en,
        "독일군 작전 중지의 발효"@ko ;
    ww2:dateNote "항복문서상 중앙유럽시간 23:01의 작전 중지 발효일입니다. 모든 지역에서 동시에 실제 전투가 멈췄다고 단정하지 않습니다." ;
    ww2:endDate "1945-05-08"^^xsd:date ;
    ww2:eventKind "ceasefire" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:german-ceasefire-effective-claim ;
    ww2:hasParticipation item:german-ceasefire-effective-participation-german-reich ;
    ww2:occurredAt item:europe ;
    ww2:startDate "1945-05-08"^^xsd:date .

item:german-ceasefire-effective-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Effective cessation of German military operations"@en,
        "독일군 작전 중지의 발효의 출처 서술"@ko ;
    ww2:aboutEvent item:german-ceasefire-effective ;
    ww2:citesSource item:german-surrender-source ;
    ww2:claimText "독일 항복문서는 독일 지휘하의 육·해·공군이 1945년 5월 8일 중앙유럽시간 23:01에 작전을 중지하도록 규정했다." .

item:german-ceasefire-effective-participation-german-reich a ww2:Participation ;
    rdfs:label "Effective cessation of German military operations: participation of German Reich"@en,
        "독일군 작전 중지의 발효: 독일국 (당시 독일)의 참여"@ko ;
    ww2:documentedBy item:german-surrender-source ;
    ww2:endDate "1945-05-08"^^xsd:date ;
    ww2:participant item:german-reich ;
    ww2:role "surrendering-party" ;
    ww2:side "Axis" ;
    ww2:startDate "1945-05-08"^^xsd:date .

item:german-surrender-reims a ww2:HistoricalEvent ;
    rdfs:label "Signing of the German surrender at Reims"@en,
        "독일 항복문서의 랭스 서명"@ko ;
    ww2:dateNote "프랑스 랭스에서의 항복문서 서명일입니다. 5월 8일의 작전 중지 발효와 베를린 재서명을 별도 사실로 구별합니다." ;
    ww2:endDate "1945-05-07"^^xsd:date ;
    ww2:eventKind "surrender-signing" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:german-surrender-reims-claim ;
    ww2:hasParticipation item:german-surrender-reims-participation-german-reich ;
    ww2:occurredAt item:reims ;
    ww2:startDate "1945-05-07"^^xsd:date .

item:german-surrender-reims-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Signing of the German surrender at Reims"@en,
        "독일 항복문서의 랭스 서명의 출처 서술"@ko ;
    ww2:aboutEvent item:german-surrender-reims ;
    ww2:citesSource item:german-surrender-source ;
    ww2:claimText "1945년 5월 7일 프랑스 랭스에서 독일군의 무조건 항복문서가 서명되었다. 문서가 규정한 작전 중지는 이튿날 발효했다." .

item:german-surrender-reims-participation-german-reich a ww2:Participation ;
    rdfs:label "Signing of the German surrender at Reims: participation of German Reich"@en,
        "독일 항복문서의 랭스 서명: 독일국 (당시 독일)의 참여"@ko ;
    ww2:documentedBy item:german-surrender-source ;
    ww2:endDate "1945-05-07"^^xsd:date ;
    ww2:participant item:german-reich ;
    ww2:role "surrendering-party" ;
    ww2:side "Axis" ;
    ww2:startDate "1945-05-07"^^xsd:date .

item:japan-place a ww2:Place ;
    rdfs:label "Japan, audience scope of the broadcast"@en,
        "일본 (방송의 전달 범위)"@ko ;
    ww2:placeKind "country" .

item:japan-surrender-broadcast a ww2:HistoricalEvent ;
    rdfs:label "Japanese broadcast announcing acceptance of surrender"@en,
        "일본의 항복 수락 방송"@ko ;
    ww2:dateNote "국민에게 방송된 일본 현지 일자입니다. 8월 14일의 준비·녹음 및 9월 2일의 정식 항복문서 서명과 구별합니다." ;
    ww2:endDate "1945-08-15"^^xsd:date ;
    ww2:eventKind "surrender-announcement" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:japan-surrender-broadcast-claim ;
    ww2:hasParticipation item:japan-surrender-broadcast-participation-empire-of-japan ;
    ww2:occurredAt item:japan-place ;
    ww2:startDate "1945-08-15"^^xsd:date .

item:japan-surrender-broadcast-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Japanese broadcast announcing acceptance of surrender"@en,
        "일본의 항복 수락 방송의 출처 서술"@ko ;
    ww2:aboutEvent item:japan-surrender-broadcast ;
    ww2:citesSource item:japan-broadcast-source ;
    ww2:claimText "1945년 8월 15일 히로히토의 라디오 방송이 일본의 항복 수락을 국민에게 알렸다." .

item:japan-surrender-broadcast-participation-empire-of-japan a ww2:Participation ;
    rdfs:label "Japanese broadcast announcing acceptance of surrender: participation of Empire of Japan"@en,
        "일본의 항복 수락 방송: 일본제국의 참여"@ko ;
    ww2:documentedBy item:japan-broadcast-source ;
    ww2:endDate "1945-08-15"^^xsd:date ;
    ww2:participant item:empire-of-japan ;
    ww2:role "surrendering-party" ;
    ww2:side "Axis" ;
    ww2:startDate "1945-08-15"^^xsd:date .

item:japan-surrender-signing a ww2:HistoricalEvent ;
    rdfs:label "Formal signing of the Japanese Instrument of Surrender"@en,
        "일본 항복문서의 정식 서명"@ko ;
    ww2:dateNote "도쿄만 USS Missouri 함상에서의 정식 항복문서 서명일입니다. 8월 15일의 발표·방송과 별도 사건입니다." ;
    ww2:endDate "1945-09-02"^^xsd:date ;
    ww2:eventKind "surrender-signing" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:japan-surrender-signing-claim ;
    ww2:hasParticipation item:japan-surrender-signing-participation-empire-of-japan,
        item:japan-surrender-signing-participation-macarthur,
        item:japan-surrender-signing-participation-shigemitsu ;
    ww2:occurredAt item:tokyo-bay ;
    ww2:startDate "1945-09-02"^^xsd:date .

item:japan-surrender-signing-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Formal signing of the Japanese Instrument of Surrender"@en,
        "일본 항복문서의 정식 서명의 출처 서술"@ko ;
    ww2:aboutEvent item:japan-surrender-signing ;
    ww2:citesSource item:japan-surrender-source ;
    ww2:claimText "1945년 9월 2일 도쿄만의 USS Missouri 함상에서 일본 항복문서가 서명되었다. 시게미쓰 마모루는 일본 정부를 대표해 서명했고 더글러스 맥아더는 연합국을 대표해 수락했다." .

item:japan-surrender-signing-participation-empire-of-japan a ww2:Participation ;
    rdfs:label "Formal signing of the Japanese Instrument of Surrender: participation of Empire of Japan"@en,
        "일본 항복문서의 정식 서명: 일본제국의 참여"@ko ;
    ww2:documentedBy item:japan-surrender-source ;
    ww2:endDate "1945-09-02"^^xsd:date ;
    ww2:participant item:empire-of-japan ;
    ww2:role "surrendering-party" ;
    ww2:side "Axis" ;
    ww2:startDate "1945-09-02"^^xsd:date .

item:japan-surrender-signing-participation-macarthur a ww2:Participation ;
    rdfs:label "Formal signing of the Japanese Instrument of Surrender: participation of Douglas MacArthur"@en,
        "일본 항복문서의 정식 서명: 더글러스 맥아더의 참여"@ko ;
    ww2:documentedBy item:japan-surrender-source ;
    ww2:endDate "1945-09-02"^^xsd:date ;
    ww2:participant item:macarthur ;
    ww2:role "accepting-party" ;
    ww2:side "Allied" ;
    ww2:startDate "1945-09-02"^^xsd:date .

item:japan-surrender-signing-participation-shigemitsu a ww2:Participation ;
    rdfs:label "Formal signing of the Japanese Instrument of Surrender: participation of Mamoru Shigemitsu"@en,
        "일본 항복문서의 정식 서명: 시게미쓰 마모루의 참여"@ko ;
    ww2:documentedBy item:japan-surrender-source ;
    ww2:endDate "1945-09-02"^^xsd:date ;
    ww2:participant item:shigemitsu ;
    ww2:role "representative" ;
    ww2:side "Axis" ;
    ww2:startDate "1945-09-02"^^xsd:date .

item:macarthur a ww2:Person ;
    rdfs:label "Douglas MacArthur"@en,
        "더글러스 맥아더"@ko .

item:normandy a ww2:Place ;
    rdfs:label "Normandy landing area, France"@en,
        "프랑스 노르망디 상륙 지역"@ko ;
    ww2:placeKind "region" .

item:normandy-landings a ww2:HistoricalEvent ;
    rdfs:label "Normandy landings, D-Day"@en,
        "노르망디 상륙 개시 (D-Day)"@ko ;
    ww2:dateNote "상륙 개시일입니다. 노르망디 전역 또는 오버로드 작전 전체의 기간을 뜻하지 않습니다." ;
    ww2:endDate "1944-06-06"^^xsd:date ;
    ww2:eventKind "landing" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:normandy-landings-claim ;
    ww2:hasParticipation item:normandy-landings-participation-canada,
        item:normandy-landings-participation-german-reich,
        item:normandy-landings-participation-united-kingdom,
        item:normandy-landings-participation-united-states ;
    ww2:occurredAt item:normandy ;
    ww2:startDate "1944-06-06"^^xsd:date .

item:normandy-landings-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Normandy landings, D-Day"@en,
        "노르망디 상륙 개시 (D-Day)의 출처 서술"@ko ;
    ww2:aboutEvent item:normandy-landings ;
    ww2:citesSource item:d-day-source ;
    ww2:claimText "1944년 6월 6일 미국·영국·캐나다군이 프랑스 노르망디에 상륙해 독일 방어군과 전투를 벌였다." .

item:normandy-landings-participation-canada a ww2:Participation ;
    rdfs:label "Normandy landings, D-Day: participation of Canada"@en,
        "노르망디 상륙 개시 (D-Day): 캐나다의 참여"@ko ;
    ww2:documentedBy item:d-day-source ;
    ww2:endDate "1944-06-06"^^xsd:date ;
    ww2:participant item:canada ;
    ww2:role "attacker" ;
    ww2:side "Allied" ;
    ww2:startDate "1944-06-06"^^xsd:date .

item:normandy-landings-participation-german-reich a ww2:Participation ;
    rdfs:label "Normandy landings, D-Day: participation of German Reich"@en,
        "노르망디 상륙 개시 (D-Day): 독일국 (당시 독일)의 참여"@ko ;
    ww2:documentedBy item:d-day-source ;
    ww2:endDate "1944-06-06"^^xsd:date ;
    ww2:participant item:german-reich ;
    ww2:role "defender" ;
    ww2:side "Axis" ;
    ww2:startDate "1944-06-06"^^xsd:date .

item:normandy-landings-participation-united-kingdom a ww2:Participation ;
    rdfs:label "Normandy landings, D-Day: participation of United Kingdom"@en,
        "노르망디 상륙 개시 (D-Day): 영국의 참여"@ko ;
    ww2:documentedBy item:d-day-source ;
    ww2:endDate "1944-06-06"^^xsd:date ;
    ww2:participant item:united-kingdom ;
    ww2:role "attacker" ;
    ww2:side "Allied" ;
    ww2:startDate "1944-06-06"^^xsd:date .

item:normandy-landings-participation-united-states a ww2:Participation ;
    rdfs:label "Normandy landings, D-Day: participation of United States of America"@en,
        "노르망디 상륙 개시 (D-Day): 미국의 참여"@ko ;
    ww2:documentedBy item:d-day-source ;
    ww2:endDate "1944-06-06"^^xsd:date ;
    ww2:participant item:united-states ;
    ww2:role "attacker" ;
    ww2:side "Allied" ;
    ww2:startDate "1944-06-06"^^xsd:date .

item:pearl-harbor a ww2:Place ;
    rdfs:label "Pearl Harbor, then Territory of Hawaii"@en,
        "진주만, 당시 미국령 하와이"@ko ;
    ww2:placeKind "base" .

item:pearl-harbor-attack a ww2:HistoricalEvent ;
    rdfs:label "Attack on Pearl Harbor"@en,
        "진주만 공격"@ko ;
    ww2:dateNote "하와이 현지 달력의 공격 일자입니다. 시간대가 다른 지역의 달력 일자와 구별합니다." ;
    ww2:endDate "1941-12-07"^^xsd:date ;
    ww2:eventKind "attack" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:pearl-harbor-attack-claim ;
    ww2:hasParticipation item:pearl-harbor-attack-participation-empire-of-japan,
        item:pearl-harbor-attack-participation-united-states ;
    ww2:occurredAt item:pearl-harbor ;
    ww2:startDate "1941-12-07"^^xsd:date .

item:pearl-harbor-attack-claim a ww2:HistoricalClaim ;
    rdfs:label "Sourced account of Attack on Pearl Harbor"@en,
        "진주만 공격의 출처 서술"@ko ;
    ww2:aboutEvent item:pearl-harbor-attack ;
    ww2:citesSource item:pearl-harbor-source ;
    ww2:claimText "1941년 12월 7일 하와이 현지 날짜에 일본군이 미국의 진주만 해군기지를 공격했다. 하와이는 당시 미국령이었다." .

item:pearl-harbor-attack-participation-empire-of-japan a ww2:Participation ;
    rdfs:label "Attack on Pearl Harbor: participation of Empire of Japan"@en,
        "진주만 공격: 일본제국의 참여"@ko ;
    ww2:documentedBy item:pearl-harbor-source ;
    ww2:endDate "1941-12-07"^^xsd:date ;
    ww2:participant item:empire-of-japan ;
    ww2:role "attacker" ;
    ww2:side "Axis" ;
    ww2:startDate "1941-12-07"^^xsd:date .

item:pearl-harbor-attack-participation-united-states a ww2:Participation ;
    rdfs:label "Attack on Pearl Harbor: participation of United States of America"@en,
        "진주만 공격: 미국의 참여"@ko ;
    ww2:documentedBy item:pearl-harbor-source ;
    ww2:endDate "1941-12-07"^^xsd:date ;
    ww2:participant item:united-states ;
    ww2:role "defender" ;
    ww2:side "Allied" ;
    ww2:startDate "1941-12-07"^^xsd:date .

item:poland-invasion-opening a ww2:HistoricalEvent ;
    rdfs:label "Opening of the German invasion of Poland"@en,
        "독일의 폴란드 침공 개시"@ko ;
    ww2:dateNote "침공이 개시된 일자입니다. 폴란드 전역 전체가 하루 동안 진행되었다는 뜻이 아닙니다." ;
    ww2:endDate "1939-09-01"^^xsd:date ;
    ww2:eventKind "invasion" ;
    ww2:eventOf item:world-war-ii ;
    ww2:hasClaim item:poland-invasion-opening-claim ;
