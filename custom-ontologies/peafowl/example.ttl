pea:e-display a pea:EvidenceRecord ;
    rdfs:label "Evidence e-display"@en,
        "근거 e-display"@ko ;
    pea:evidenceAbout pea:behavior-display ;
    pea:evidenceClaim "The male fans the train and quivers it in display; the page discusses courtship display."@en,
        "수컷은 구애 전시로 train을 펼치고 떨거나 흔든다."@ko ;
    pea:evidenceIdentifier "e-display"^^xsd:string ;
    pea:evidenceLocator "FAMILY LIFE: lines 69-70"^^xsd:string ;
    pea:evidenceScope "peafowl courtship behavior"@en ;
    pea:evidenceSource pea:sandiego ;
    pea:evidenceStatus "source-reported"^^xsd:string .

pea:e-eggs-sd a pea:EvidenceRecord ;
    rdfs:label "Evidence e-eggs-sd"@en,
        "근거 e-eggs-sd"@ko ;
    pea:evidenceAbout pea:repro-eggs-sandiego ;
    pea:evidenceClaim "The peahen is reported to lay three to eight eggs."@en,
        "암컷의 한 번 산란 수는 3~8개로 기재된다."@ko ;
    pea:evidenceIdentifier "e-eggs-sd"^^xsd:string ;
    pea:evidenceLocator "FAMILY LIFE and YOUNG: lines 71 and 86-90"^^xsd:string ;
    pea:evidenceScope "peafowl profile; source-specific clutch range"@en ;
    pea:evidenceSource pea:sandiego ;
    pea:evidenceStatus "source-reported"^^xsd:string .

pea:e-eggs-sm a pea:EvidenceRecord ;
    rdfs:label "Evidence e-eggs-sm"@en,
        "근거 e-eggs-sm"@ko ;
    pea:evidenceAbout pea:repro-eggs-smithsonian ;
    pea:evidenceClaim "The peahen is reported to lay four to eight eggs."@en,
        "암컷의 한 번 산란 수는 4~8개로 기재된다."@ko ;
    pea:evidenceIdentifier "e-eggs-sm"^^xsd:string ;
    pea:evidenceLocator "Reproduction and Development: lines 38-41"^^xsd:string ;
    pea:evidenceScope "common peafowl profile; source-specific clutch range"@en ;
    pea:evidenceSource pea:smithsonian ;
    pea:evidenceStatus "source-reported"^^xsd:string .

pea:e-green-color a pea:EvidenceRecord ;
    rdfs:label "Evidence e-green-color"@en,
        "근거 e-green-color"@ko ;
    pea:evidenceAbout pea:feature-green-color ;
    pea:evidenceClaim "Green peafowl are described with green rather than blue feathers on head and neck."@en,
        "녹색공작은 머리와 목에 파란색 대신 녹색 깃털이 있다고 설명된다."@ko ;
    pea:evidenceIdentifier "e-green-color"^^xsd:string ;
    pea:evidenceLocator "ABOUT: line 49"^^xsd:string ;
    pea:evidenceScope "green peafowl appearance"@en ;
    pea:evidenceSource pea:sandiego ;
    pea:evidenceStatus "source-reported"^^xsd:string .

pea:e-green-range a pea:EvidenceRecord ;
    rdfs:label "Evidence e-green-range"@en,
        "근거 e-green-range"@ko ;
    pea:evidenceAbout pea:range-green ;
    pea:evidenceClaim "Green peafowl are described as found in Southeast Asia."@en,
        "녹색공작은 동남아시아에 분포한다고 설명된다."@ko ;
    pea:evidenceIdentifier "e-green-range"^^xsd:string ;
    pea:evidenceLocator "HABITAT AND DIET: line 60"^^xsd:string ;
    pea:evidenceScope "green peafowl reported range"@en ;
    pea:evidenceSource pea:sandiego ;
    pea:evidenceStatus "source-reported"^^xsd:string .

pea:e-green-sex-difference a pea:EvidenceRecord ;
    rdfs:label "Evidence e-green-sex-difference"@en,
        "근거 e-green-sex-difference"@ko ;
    pea:evidenceAbout pea:feature-green-sex-similarity ;
    pea:evidenceClaim "Green peafowl sexes are described as similarly colored, with the female less vivid and male tail longer."@en,
        "녹색공작 암수의 색은 비슷하나 암컷은 덜 선명하고 수컷 꼬리는 더 길다고 설명된다."@ko ;
    pea:evidenceIdentifier "e-green-sex-difference"^^xsd:string ;
    pea:evidenceLocator "ABOUT: line 49"^^xsd:string ;
    pea:evidenceScope "green peafowl appearance"@en ;
    pea:evidenceSource pea:sandiego ;
    pea:evidenceStatus "source-reported"^^xsd:string .

