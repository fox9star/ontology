@prefix pea: <https://example.org/ontology/custom/peafowl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pea:coverage-conservation a pea:CoverageNote ;
    rdfs:label "Conservation status and legal protection"@en,
        "보전 등급과 법적 보호"@ko ;
    pea:coverageExplanation "Species-level current conservation categories and legal protections were not modeled because they were not verified against specialist conservation assessments."@en,
        "종별 현행 보전 등급과 법적 보호 상태는 전문 보전 평가 자료로 검증하지 않아 온톨로지 사실로 넣지 않았다."@ko ;
    pea:coverageLabel "Conservation status and legal protection"@en,
        "보전 등급과 법적 보호"@ko ;
    pea:coverageStatus "excluded"^^xsd:string .

pea:coverage-individuals a pea:CoverageNote ;
    rdfs:label "Individual and population observations"@en,
        "개체·개체군 관찰"@ko ;
    pea:coverageExplanation "Wild population data, zoo specimen histories, and individual animal observations are outside scope; included biological facts are species-profile claims."@en,
        "야생 개체군, 동물원 개체 이력, 개별 동물 관찰 자료는 포함하지 않는다. 예시의 모든 사실은 출처 프로필의 종 설명이다."@ko ;
    pea:coverageLabel "Individual and population observations"@en,
        "개체·개체군 관찰"@ko ;
    pea:coverageStatus "excluded"^^xsd:string .

pea:coverage-source-figures a pea:CoverageNote ;
    rdfs:label "Source-specific reproductive figures"@en,
        "번식 수치의 출처별 보존"@ko ;
    pea:coverageExplanation "Clutch-size and incubation figures are retained per source and are not collapsed into one universal value."@en,
        "산란 수와 포란 기간은 출처별 기재 범위를 각각 보존한다. 하나의 보편적인 값으로 통합하지 않았다."@ko ;
    pea:coverageLabel "Source-specific reproductive figures"@en,
        "번식 수치의 출처별 보존"@ko ;
    pea:coverageStatus "limited"^^xsd:string .

pea:coverage-taxonomy a pea:CoverageNote ;
    rdfs:label "Taxonomy scope"@en,
        "분류 범위"@ko ;
    pea:coverageExplanation "An example draft covering Indian peafowl (Pavo cristatus) and green peafowl (Pavo muticus), not a complete taxonomic checklist of peafowl."@en,
        "인도공작(Pavo cristatus)과 녹색공작(Pavo muticus)을 다루는 예시 초안이다. 공작류 전체에 대한 완전한 분류 목록은 아니다."@ko ;
    pea:coverageLabel "Taxonomy scope"@en,
        "분류 범위"@ko ;
    pea:coverageStatus "limited"^^xsd:string .

pea:behavior-display a pea:Behavior ;
    rdfs:label "Courtship display"@en,
        "구애 전시"@ko ;
    pea:behaviorAssociatedSexTerm pea:term-peacock ;
    pea:behaviorDescription "Males fan and quiver or shake the train in courtship displays."@en,
        "수컷은 train을 부채꼴로 펼치고 떨거나 흔들어 암컷에게 보이는 구애 전시를 한다."@ko ;
    pea:behaviorEvidence pea:e-display ;
    pea:behaviorKind "courtship-display"^^xsd:string ;
    pea:behaviorLabel "Courtship display"@en,
        "구애 전시"@ko ;
    pea:behaviorOfSpecies pea:species-green,
        pea:species-indian .

pea:behavior-ground-foraging a pea:Behavior ;
    rdfs:label "Ground foraging"@en,
        "땅 위 먹이 찾기"@ko ;
    pea:behaviorDescription "The zoo profiles describe peafowl foraging on the ground."@en,
        "공작류는 땅에서 먹이를 찾는다고 동물원 자료가 기술한다."@ko ;
    pea:behaviorEvidence pea:e-ground-foraging ;
    pea:behaviorKind "foraging"^^xsd:string ;
    pea:behaviorLabel "Ground foraging"@en,
        "땅 위 먹이 찾기"@ko ;
    pea:behaviorOfSpecies pea:species-green,
        pea:species-indian .

pea:behavior-lek a pea:Behavior ;
    rdfs:label "Lek and small territories"@en,
        "lek과 작은 영역"@ko ;
    pea:behaviorAssociatedSexTerm pea:term-peacock ;
    pea:behaviorDescription "The Smithsonian profile describes males holding small territories in leks, where visiting females can assess several males."@en,
        "스미스소니언 자료는 수컷이 작은 개별 영역이 모인 lek을 형성하고 암컷이 여러 수컷을 살펴 짝을 선택한다고 설명한다."@ko ;
    pea:behaviorEvidence pea:e-lek ;
    pea:behaviorKind "social-organization"^^xsd:string ;
    pea:behaviorLabel "Lek and small territories"@en,
        "lek과 작은 영역"@ko ;
    pea:behaviorOfSpecies pea:species-indian .

pea:behavior-walk-run a pea:Behavior ;
    rdfs:label "Walking and running"@en,
        "걷기와 달리기"@ko ;
    pea:behaviorDescription "The Smithsonian common peafowl page says they prefer walking or running to flying."@en,
        "스미스소니언 공작류 페이지는 날기보다 걷거나 달리는 것을 선호한다고 기술한다."@ko ;
    pea:behaviorEvidence pea:e-walk-run ;
    pea:behaviorKind "movement"^^xsd:string ;
    pea:behaviorLabel "Walking and running"@en,
        "걷기와 달리기"@ko ;
    pea:behaviorOfSpecies pea:species-indian .

