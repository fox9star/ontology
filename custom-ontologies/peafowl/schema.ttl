        "성장 단계 명칭"@ko ;
    rdfs:comment "A common term for a young peafowl and its stated scope."@en,
        "어린 공작류를 가리키는 용어와 적용 범위를 나타낸다."@ko .

pea:DietItem a owl:Class ;
    rdfs:label "Diet item"@en,
        "먹이 항목"@ko ;
    rdfs:comment "A food type or feeding category documented by a source."@en,
        "출처에 기록된 먹이 종류 또는 먹이 범주이다."@ko .

pea:HabitatRange a owl:Class ;
    rdfs:label "Habitat or range"@en,
        "서식지·분포"@ko ;
    rdfs:comment "Preserves a source-specific description of habitat or geographic range."@en,
        "출처별 서식 환경 또는 지리적 분포 서술을 보존한다."@ko .

pea:Behavior a owl:Class ;
    rdfs:label "Behavior"@en,
        "행동"@ko ;
    rdfs:comment "A sourced courtship, foraging, or social behavior."@en,
        "출처에 기술된 구애·섭식·사회 행동을 나타낸다."@ko .

pea:MorphologicalFeature a owl:Class ;
    rdfs:label "Morphological feature"@en,
        "형태 특성"@ko ;
    rdfs:comment "A sourced plumage or color feature with a stated species and sex scope."@en,
        "출처에 설명된 깃털·색채 등 종 및 성별 범위가 있는 형태 특성이다."@ko .

pea:SourceDocument a owl:Class ;
    rdfs:label "Source document"@en,
        "출처 문서"@ko ;
    rdfs:comment "Records a zoo or species profile's publisher, URL, access date, and scope."@en,
        "사육·종 정보 페이지의 발행자, URL, 확인일 및 범위를 기록한다."@ko .

pea:PeafowlSpecies a owl:Class ;
    rdfs:label "Peafowl species"@en,
        "공작류 종"@ko ;
    rdfs:comment "A peafowl species example covered by this draft; a subclass of Taxon."@en,
        "이 초안에서 다루는 공작류의 종 예시이며 Taxon의 하위 유형이다."@ko ;
    rdfs:subClassOf pea:Taxon .

pea:SexTerm a owl:Class ;
    rdfs:label "Sex term"@en,
        "성별 명칭"@ko ;
    rdfs:comment "A common term for male or female peafowl and its stated scope."@en,
        "공작 수컷·암컷을 가리키는 보통명사와 적용 범위를 나타낸다."@ko .

pea:Taxon a owl:Class ;
    rdfs:label "Taxon"@en,
        "분류군"@ko ;
    rdfs:comment "A taxonomic group or species in the recorded classification."@en,
        "분류 체계의 상위 분류군과 종을 나타낸다."@ko .

pea:ReproductiveObservation a owl:Class ;
    rdfs:label "Reproductive figure"@en,
        "번식 수치 기록"@ko ;
    rdfs:comment "A source-specific range or approximate figure for eggs or incubation."@en,
        "출처별 산란 수나 포란 기간의 범위·근삿값을 기록한다."@ko .

pea:EvidenceRecord a owl:Class ;
    rdfs:label "Evidence record"@en,
        "근거 기록"@ko ;
    rdfs:comment "Connects a described resource or claim to a source, locator, scope, and review status."@en,
        "특정 개체·주장과 출처, 위치, 범위 및 검토 상태를 연결한다."@ko .
