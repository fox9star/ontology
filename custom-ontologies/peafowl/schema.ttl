@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pea: <https://example.org/ontology/custom/peafowl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/custom/peafowl> a owl:Ontology ;
    rdfs:label "Peacock / Peafowl Ontology"@en,
        "Peacock / 공작류 온톨로지"@ko ;
    rdfs:comment "A draft connecting Indian and green peafowl examples to their sources and claim scopes. It distinguishes the sex-specific common term peacock, species-specific traits, and differing source figures."@en,
        "인도공작과 녹색공작 예시를 출처 및 주장 범위와 연결하는 초안이다. 보통명사 peacock의 성별 의미, 종별 차이, 상이한 출처 수치를 구분한다."@ko ;
    owl:versionIRI <https://example.org/ontology/custom/peafowl/0.1.0> ;
    owl:versionInfo "0.1.0" .

pea:behaviorAssociatedSexTerm a owl:ObjectProperty ;
    rdfs:label "associated sex term"@en,
        "관련 성별 용어"@ko ;
    rdfs:comment "Records associated sex term for Behavior."@en,
        "Behavior의 관련 성별 용어를 기록한다."@ko ;
    rdfs:domain pea:Behavior ;
    rdfs:range pea:SexTerm .

pea:behaviorDescription a owl:DatatypeProperty ;
    rdfs:label "behavior description"@en,
        "행동 설명"@ko ;
