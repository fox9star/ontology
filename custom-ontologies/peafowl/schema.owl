    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">성장 단계 명칭</rdfs:label>
    <rdfs:label xml:lang="en">Life-stage term</rdfs:label>
    <rdfs:comment xml:lang="ko">어린 공작류를 가리키는 용어와 적용 범위를 나타낸다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A common term for a young peafowl and its stated scope.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#sexTermEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/peafowl#SexTerm"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/peafowl#EvidenceRecord"/>
    <rdfs:label xml:lang="en">term evidence</rdfs:label>
    <rdfs:label xml:lang="ko">용어 근거</rdfs:label>
    <rdfs:comment xml:lang="en">Records term evidence for SexTerm.</rdfs:comment>
    <rdfs:comment xml:lang="ko">SexTerm의 용어 근거를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#Taxon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">분류군</rdfs:label>
    <rdfs:label xml:lang="en">Taxon</rdfs:label>
    <rdfs:comment xml:lang="ko">분류 체계의 상위 분류군과 종을 나타낸다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A taxonomic group or species in the recorded classification.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#dietLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/peafowl#DietItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">diet item</rdfs:label>
    <rdfs:label xml:lang="ko">먹이 항목</rdfs:label>
    <rdfs:comment xml:lang="en">Records diet item for DietItem.</rdfs:comment>
    <rdfs:comment xml:lang="ko">DietItem의 먹이 항목를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#reproductionUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/peafowl#ReproductiveObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">unit</rdfs:label>
    <rdfs:label xml:lang="ko">단위</rdfs:label>
    <rdfs:comment xml:lang="en">Records unit for ReproductiveObservation.</rdfs:comment>
    <rdfs:comment xml:lang="ko">ReproductiveObservation의 단위를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#coverageStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/peafowl#CoverageNote"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">coverage status</rdfs:label>
    <rdfs:label xml:lang="ko">포함 범위 상태</rdfs:label>
    <rdfs:comment xml:lang="en">Records coverage status for CoverageNote.</rdfs:comment>
    <rdfs:comment xml:lang="ko">CoverageNote의 포함 범위 상태를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#featureAssociatedSexTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/peafowl#MorphologicalFeature"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/peafowl#SexTerm"/>
    <rdfs:label xml:lang="en">associated sex term</rdfs:label>
    <rdfs:label xml:lang="ko">관련 성별 용어</rdfs:label>
    <rdfs:comment xml:lang="en">Records associated sex term for MorphologicalFeature.</rdfs:comment>
    <rdfs:comment xml:lang="ko">MorphologicalFeature의 관련 성별 용어를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#SourceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">출처 문서</rdfs:label>
    <rdfs:label xml:lang="en">Source document</rdfs:label>
    <rdfs:comment xml:lang="ko">사육·종 정보 페이지의 발행자, URL, 확인일 및 범위를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a zoo or species profile's publisher, URL, access date, and scope.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#PeafowlSpecies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">공작류 종</rdfs:label>
    <rdfs:label xml:lang="en">Peafowl species</rdfs:label>
    <rdfs:comment xml:lang="ko">이 초안에서 다루는 공작류의 종 예시이며 Taxon의 하위 유형이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A peafowl species example covered by this draft; a subclass of Taxon.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/custom/peafowl#Taxon"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#dietOfSpecies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/peafowl#DietItem"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/peafowl#PeafowlSpecies"/>
    <rdfs:label xml:lang="en">diet of species</rdfs:label>
    <rdfs:label xml:lang="ko">해당 종</rdfs:label>
    <rdfs:comment xml:lang="en">Records diet of species for DietItem.</rdfs:comment>
    <rdfs:comment xml:lang="ko">DietItem의 해당 종를 기록한다.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
