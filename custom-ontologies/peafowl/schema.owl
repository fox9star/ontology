    <rdfs:comment xml:lang="ko">ReproductiveObservation의 번식 근거를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#MorphologicalFeature">
