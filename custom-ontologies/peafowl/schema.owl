  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#CoverageNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">범위 메모</rdfs:label>
    <rdfs:label xml:lang="en">Coverage note</rdfs:label>
    <rdfs:comment xml:lang="ko">이 초안에서 포함·제한·제외한 지식 영역을 명시한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">States knowledge areas included, limited, or excluded by this draft.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/peafowl#reproductionEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/peafowl#ReproductiveObservation"/>
