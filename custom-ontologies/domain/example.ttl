dom:change-ai-created a dom:DomainChangeEvent ;
    rdfs:label "AI domain draft creation event"@en,
        "인공지능 영역 초안 생성 기록"@ko ;
    dom:changeAction "created"^^xsd:string ;
    dom:changeDate "2026-10-08"^^xsd:date ;
    dom:changeForDomain dom:artificial-intelligence ;
    dom:changeNewStatus "proposed"^^xsd:string ;
    dom:changePreviousStatus "not_recorded"^^xsd:string ;
    dom:changeReason "Created an illustrative domain hierarchy to organize and cross-reference local ontology profiles."@en ;
    dom:changeRecordedByRole "ontology_editor"^^xsd:string .

dom:mapping-ai-unstarted a dom:DomainMapping ;
    rdfs:label "AI external classification mapping not started"@en,
        "AI 외부 분류 매핑 미착수"@ko ;
    dom:mappingLocalDomain dom:artificial-intelligence ;
    dom:mappingRationale "No external classification scheme or concept URI has been selected; no equivalence is asserted."@en ;
    dom:mappingRelationType "unknown"^^xsd:string ;
    dom:mappingStatus "not_started"^^xsd:string .

dom:review-ai-pending a dom:DomainReview ;
    rdfs:label "AI domain review plan"@en,
        "인공지능 영역 검토 계획"@ko ;
    dom:reviewCriteria "Check the definition boundary, direct parents, aliases, profile assignments, and source scope."@en ;
    dom:reviewForDomain dom:artificial-intelligence ;
    dom:reviewOutcome "not_reviewed"^^xsd:string ;
    dom:reviewRationale "A review is planned; no domain owner has approved this draft."@en ;
    dom:reviewStatus "planned"^^xsd:string ;
    dom:reviewerRole "not_assigned"^^xsd:string .

dom:scope-ai-exclusion a dom:DomainScopeStatement ;
    rdfs:label "Scope example artificial-intelligence exclusion"@en,
        "범위 예시 artificial-intelligence exclusion"@ko ;
    dom:scopeEvidenceLevel "curated"^^xsd:string ;
    dom:scopeForDomain dom:artificial-intelligence ;
    dom:scopeKind "exclusion"^^xsd:string ;
    dom:scopeReviewStatus "draft"^^xsd:string ;
    dom:scopeText "A topic is not automatically classified as AI merely because it uses software or automation."@en .

dom:scope-ai-film a dom:DomainScopeStatement ;
    rdfs:label "Scope example ai-film-production inclusion"@en,
        "범위 예시 ai-film-production inclusion"@ko ;
    dom:scopeEvidenceLevel "curated"^^xsd:string ;
    dom:scopeForDomain dom:ai-film-production ;
    dom:scopeKind "inclusion"^^xsd:string ;
    dom:scopeReviewStatus "draft"^^xsd:string ;
    dom:scopeText "Film and video production activities that use AI for ideation, generation, editing, or review."@en .

dom:scope-ai-inclusion a dom:DomainScopeStatement ;
    rdfs:label "Scope example artificial-intelligence inclusion"@en,
        "범위 예시 artificial-intelligence inclusion"@ko ;
