dom:source-skos-reference a dom:DomainSource ;
    rdfs:label "W3C SKOS Reference"@en,
        "W3C SKOS 참조"@ko ;
    dom:sourceAccessedAt "2026-10-08"^^xsd:date ;
    dom:sourceKind "standards_document"^^xsd:string ;
    dom:sourceLimitations "SKOS supplies a knowledge-organization data model; it does not establish that this illustrative local domain taxonomy is authoritative or that any external mapping is correct."@en ;
    dom:sourcePublisher "World Wide Web Consortium (W3C)"^^xsd:string ;
    dom:sourceScope "Defines SKOS concept schemes, concepts, preferred and alternative labels, definitions, direct broader/narrower links, associative links, and mapping properties."@en ;
    dom:sourceTitle "SKOS Simple Knowledge Organization System Reference"^^xsd:string ;
    dom:sourceUri "https://www.w3.org/TR/skos-reference/"^^xsd:anyURI ;
    dom:sourceYear 2009 .

dom:healthcare a dom:KnowledgeDomain ;
    rdfs:label "Healthcare"@en,
        "헬스케어"@ko ;
    dom:domainBoundaryStatus "partial"^^xsd:string ;
    dom:domainDefinition "Illustrative definition for Healthcare; refine the boundary with the domain owner."@en,
        "헬스케어 영역의 예시 정의이다. 실제 범위는 도메인 소유자 검토로 구체화한다."@ko ;
    dom:domainIdentifier "healthcare"^^xsd:string ;
    dom:domainInCatalog dom:catalog-local-domains ;
    dom:domainLevel 0 ;
    dom:domainLifecycleStatus "proposed"^^xsd:string ;
    dom:domainNotation "HEALTH"^^xsd:string ;
    dom:domainPreferredLabel "Healthcare"@en,
        "헬스케어"@ko ;
    dom:domainTopConcept true .

dom:profile-ai-film a dom:OntologyProfile ;
    rdfs:label "AI Film Production Ontology"@en,
        "로컬 프로필 ai-film"@ko ;
    dom:ontologyProfileCoversDomain dom:ai-film-production ;
    dom:ontologyProfileDocumentedBy dom:source-profile-ai-film ;
    dom:ontologyProfileId "ai-film"^^xsd:string ;
    dom:ontologyProfileName "AI Film Production Ontology"@en,
        "AI 영화 제작 온톨로지 (ai-film)"@ko ;
    dom:ontologyProfileNamespace "https://example.org/ontology/custom/ai-film#"^^xsd:anyURI ;
    dom:ontologyProfileScope "Connects screenplay, scene and shot planning to generation tasks, evidence, rights and quality reviews, and edit readiness."@en,
        "시나리오·장면·샷부터 생성 계획, 출처 및 권리·품질 검토, 편집 버전의 준비 상태까지 연결합니다."@ko ;
    dom:ontologyProfileStatus "draft"^^xsd:string ;
    dom:ontologyProfileVersion "0.1.0"^^xsd:string .

dom:profile-autonomous-driving a dom:OntologyProfile ;
    rdfs:label "Autonomous Driving Ontology"@en,
        "로컬 프로필 autonomous-driving"@ko ;
    dom:ontologyProfileCoversDomain dom:autonomous-driving ;
    dom:ontologyProfileDocumentedBy dom:source-profile-autonomous-driving ;
    dom:ontologyProfileId "autonomous-driving"^^xsd:string ;
    dom:ontologyProfileName "Autonomous Driving Ontology"@en,
        "자율주행 온톨로지 (autonomous-driving)"@ko ;
    dom:ontologyProfileNamespace "https://example.org/ontology/custom/autonomous-driving#"^^xsd:anyURI ;
    dom:ontologyProfileScope "Connects driving features, SAE level terms, ODD, vehicles, sensors, perception, localization, planning, control, safety and test evidence."@en,
        "주행 자동화 기능·SAE 수준 용어·운행설계영역·차량·센서·인지·위치추정·계획·제어·안전·시험 근거를 연결합니다."@ko ;
    dom:ontologyProfileStatus "draft"^^xsd:string ;
    dom:ontologyProfileVersion "0.1.0"^^xsd:string .

dom:profile-imitation-learning a dom:OntologyProfile ;
    rdfs:label "Imitation Learning Ontology"@en,
        "로컬 프로필 imitation-learning"@ko ;
    dom:ontologyProfileCoversDomain dom:imitation-learning ;
    dom:ontologyProfileDocumentedBy dom:source-profile-imitation-learning ;
    dom:ontologyProfileId "imitation-learning"^^xsd:string ;
    dom:ontologyProfileName "Imitation Learning Ontology"@en,
        "모방학습 온톨로지 (imitation-learning)"@ko ;
    dom:ontologyProfileNamespace "https://example.org/ontology/custom/imitation-learning#"^^xsd:anyURI ;
    dom:ontologyProfileScope "Connects demonstrations, observation-action labels, behavior cloning, DAgger, inverse reinforcement learning, policies, run status, distribution shift and literature evidence; separates synthetic fixtures from executed experiments."@en,
        "시연, 관측·행동 레이블, 행동복제·DAgger·역강화학습, 정책, 학습·평가 상태, 분포 변화와 문헌 근거를 연결하며 합성 예시와 실제 실험을 구분한다."@ko ;
    dom:ontologyProfileStatus "draft"^^xsd:string ;
    dom:ontologyProfileVersion "0.1.0"^^xsd:string .

dom:profile-ros2 a dom:OntologyProfile ;
    rdfs:label "ROS 2 System Ontology"@en,
        "로컬 프로필 ros2"@ko ;
    dom:ontologyProfileCoversDomain dom:robot-middleware ;
    dom:ontologyProfileDocumentedBy dom:source-profile-ros2 ;
    dom:ontologyProfileId "ros2"^^xsd:string ;
    dom:ontologyProfileName "ROS 2 System Ontology"@en,
        "ROS 2 시스템 온톨로지 (ros2)"@ko ;
    dom:ontologyProfileNamespace "https://example.org/ontology/custom/ros2#"^^xsd:anyURI ;
    dom:ontologyProfileScope "Connects ROS 2 packages, nodes, topics, services, actions, interface types, QoS, hardware, controllers and tf2 frames with official documentation sources."@en,
        "ROS 2 패키지·노드·토픽·서비스·액션·메시지 형식·QoS·하드웨어·컨트롤러·tf2 프레임을 연결하고 공식 문서 근거를 조회합니다."@ko ;
    dom:ontologyProfileStatus "draft"^^xsd:string ;
    dom:ontologyProfileVersion "0.1.0"^^xsd:string .

dom:profile-wireless-router a dom:OntologyProfile ;
    rdfs:label "Wireless Router Ontology"@en,
        "로컬 프로필 wireless-router"@ko ;
    dom:ontologyProfileCoversDomain dom:wireless-networking ;
    dom:ontologyProfileDocumentedBy dom:source-profile-wireless-router ;
    dom:ontologyProfileId "wireless-router"^^xsd:string ;
    dom:ontologyProfileName "Wireless Router Ontology"@en,
        "무선공유기 온톨로지 (wireless-router)"@ko ;
    dom:ontologyProfileNamespace "https://example.org/ontology/custom/wireless-router#"^^xsd:anyURI ;
    dom:ontologyProfileScope "Connects router devices, radios, wireless networks, security profiles, isolation, clients and associations, firmware, configuration snapshots, performance observations, incidents, and evidence sources. Supported capability, configuration, and observed state remain distinct; examples are synthetic."@en,
        "무선공유기 장치·무선 인터페이스·네트워크·보안 프로필·망 분리·클라이언트 접속·펌웨어·설정 스냅샷·성능 관측·장애 및 근거 출처를 연결한다. 기능 지원, 설정 상태, 실제 관측 상태를 분리하며 예시는 합성 자료이다."@ko ;
    dom:ontologyProfileStatus "draft"^^xsd:string ;
    dom:ontologyProfileVersion "0.1.0"^^xsd:string .

