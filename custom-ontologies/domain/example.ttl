    dom:catalogPreferredLabel "Illustrative Knowledge and Application Domain Catalog"@en,
        "예시 지식·응용 영역 분류"@ko ;
    dom:catalogScopeNote "This is not an official academic classification. Hierarchy and profile assignments are draft examples awaiting review."@en,
