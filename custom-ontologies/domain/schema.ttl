dom:sourceKind a owl:DatatypeProperty ;
    rdfs:label "source kind"@en,
        "자료 유형"@ko ;
    rdfs:comment "Records the source kind for Domain evidence source."@en,
        "영역 근거 출처의 자료 유형를 기록한다."@ko ;
    rdfs:domain dom:DomainSource ;
    rdfs:range xsd:string .

dom:sourceLimitations a owl:DatatypeProperty ;
