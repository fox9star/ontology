@prefix dom: <https://example.org/ontology/custom/domain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dom: a owl:Ontology ;
    rdfs:label "Knowledge and Application Domain Ontology"@en,
        "지식·업무 영역 온톨로지"@ko ;
    rdfs:comment "A draft for assigning local ontology profiles to knowledge and application domains and managing hierarchy, scope, external mappings, evidence, review, and change."@en,
        "로컬 온톨로지 프로필을 지식·업무 영역에 연결하고 계층, 범위, 외부 매핑, 출처, 검토와 변경을 관리하는 초안이다."@ko ;
    owl:versionInfo "0.1.0" .

dom:assignmentConfidence a owl:DatatypeProperty ;
    rdfs:label "assignment confidence"@en,
        "배정 신뢰도"@ko ;
    rdfs:comment "Records the assignment confidence for Domain assignment."@en,
        "프로필 영역 배정의 배정 신뢰도를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range xsd:decimal .

dom:assignmentCreatedAt a owl:DatatypeProperty ;
    rdfs:label "assignment date"@en,
        "배정 기록 날짜"@ko ;
    rdfs:comment "Records the assignment date for Domain assignment."@en,
        "프로필 영역 배정의 배정 기록 날짜를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range xsd:date .

dom:assignmentEvidenceSource a owl:ObjectProperty ;
    rdfs:label "assignment evidence"@en,
        "배정 근거"@ko ;
    rdfs:comment "Records a relation from Domain assignment to Domain evidence source."@en,
        "프로필 영역 배정에서 영역 근거 출처로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range dom:DomainSource .

dom:assignmentForProfile a owl:ObjectProperty ;
    rdfs:label "for ontology profile"@en,
        "배정 대상 프로필"@ko ;
    rdfs:comment "Records a relation from Domain assignment to Ontology profile."@en,
        "프로필 영역 배정에서 온톨로지 프로필로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range dom:OntologyProfile .

dom:assignmentMethod a owl:DatatypeProperty ;
    rdfs:label "assignment method"@en,
        "배정 방법"@ko ;
    rdfs:comment "Records the assignment method for Domain assignment."@en,
        "프로필 영역 배정의 배정 방법를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range xsd:string .

dom:assignmentRationale a owl:DatatypeProperty ;
    rdfs:label "assignment rationale"@en,
        "배정 근거 설명"@ko ;
    rdfs:comment "Records the assignment rationale for Domain assignment."@en,
        "프로필 영역 배정의 배정 근거 설명를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range rdf:langString .

dom:assignmentStatus a owl:DatatypeProperty ;
    rdfs:label "assignment review status"@en,
        "배정 검토 상태"@ko ;
    rdfs:comment "Records the assignment review status for Domain assignment."@en,
        "프로필 영역 배정의 배정 검토 상태를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range xsd:string .

dom:assignmentToDomain a owl:ObjectProperty ;
    rdfs:label "assigned domain"@en,
        "배정 영역"@ko ;
    rdfs:comment "Records a relation from Domain assignment to Knowledge domain."@en,
        "프로필 영역 배정에서 지식·업무 영역로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainAssignment ;
    rdfs:range dom:KnowledgeDomain .

dom:catalogDefinition a owl:DatatypeProperty ;
    rdfs:label "catalog definition"@en,
        "분류 체계 정의"@ko ;
    rdfs:comment "Records the catalog definition for Domain catalog."@en,
        "영역 분류 체계의 분류 체계 정의를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf skos:definition .

dom:catalogHasDomain a owl:ObjectProperty ;
    rdfs:label "has domain"@en,
        "포함 영역"@ko ;
    rdfs:comment "Records a relation from Domain catalog to Knowledge domain."@en,
        "영역 분류 체계에서 지식·업무 영역로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range dom:KnowledgeDomain .

dom:catalogHasSource a owl:ObjectProperty ;
    rdfs:label "has evidence source"@en,
        "근거 출처"@ko ;
    rdfs:comment "Records a relation from Domain catalog to Domain evidence source."@en,
        "영역 분류 체계에서 영역 근거 출처로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range dom:DomainSource .

dom:catalogHasTopDomain a owl:ObjectProperty ;
    rdfs:label "has top domain"@en,
        "최상위 영역"@ko ;
    rdfs:comment "Records a relation from Domain catalog to Knowledge domain."@en,
        "영역 분류 체계에서 지식·업무 영역로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range dom:KnowledgeDomain ;
    rdfs:subPropertyOf skos:hasTopConcept .

dom:catalogLifecycleStatus a owl:DatatypeProperty ;
    rdfs:label "catalog lifecycle status"@en,
        "분류 체계 상태"@ko ;
    rdfs:comment "Records the catalog lifecycle status for Domain catalog."@en,
        "영역 분류 체계의 분류 체계 상태를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range xsd:string .

dom:catalogPreferredLabel a owl:DatatypeProperty ;
    rdfs:label "catalog preferred label"@en,
        "분류 체계 표제"@ko ;
    rdfs:comment "Records the catalog preferred label for Domain catalog."@en,
        "영역 분류 체계의 분류 체계 표제를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf skos:prefLabel .

dom:catalogScopeNote a owl:DatatypeProperty ;
    rdfs:label "catalog scope note"@en,
        "분류 범위 주석"@ko ;
    rdfs:comment "Records the catalog scope note for Domain catalog."@en,
        "영역 분류 체계의 분류 범위 주석를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf skos:scopeNote .

dom:catalogVersion a owl:DatatypeProperty ;
    rdfs:label "catalog version"@en,
        "분류 체계 버전"@ko ;
    rdfs:comment "Records the catalog version for Domain catalog."@en,
        "영역 분류 체계의 분류 체계 버전를 기록한다."@ko ;
    rdfs:domain dom:DomainCatalog ;
    rdfs:range xsd:string .

dom:changeAction a owl:DatatypeProperty ;
    rdfs:label "change action"@en,
        "변경 작업"@ko ;
    rdfs:comment "Records the change action for Domain change event."@en,
        "영역 변경 사건의 변경 작업를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range xsd:string .

dom:changeDate a owl:DatatypeProperty ;
    rdfs:label "change date"@en,
        "변경 날짜"@ko ;
    rdfs:comment "Records the change date for Domain change event."@en,
        "영역 변경 사건의 변경 날짜를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range xsd:date .

dom:changeEvidenceSource a owl:ObjectProperty ;
    rdfs:label "change evidence"@en,
        "변경 근거 출처"@ko ;
    rdfs:comment "Records a relation from Domain change event to Domain evidence source."@en,
        "영역 변경 사건에서 영역 근거 출처로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range dom:DomainSource .

dom:changeForDomain a owl:ObjectProperty ;
    rdfs:label "change for domain"@en,
        "변경 대상 영역"@ko ;
    rdfs:comment "Records a relation from Domain change event to Knowledge domain."@en,
        "영역 변경 사건에서 지식·업무 영역로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range dom:KnowledgeDomain .

dom:changeNewStatus a owl:DatatypeProperty ;
    rdfs:label "new state"@en,
        "변경 후 상태"@ko ;
    rdfs:comment "Records the new state for Domain change event."@en,
        "영역 변경 사건의 변경 후 상태를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range xsd:string .

dom:changePreviousStatus a owl:DatatypeProperty ;
    rdfs:label "previous state"@en,
        "이전 상태"@ko ;
    rdfs:comment "Records the previous state for Domain change event."@en,
        "영역 변경 사건의 이전 상태를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range xsd:string .

dom:changeReason a owl:DatatypeProperty ;
    rdfs:label "change reason"@en,
        "변경 사유"@ko ;
    rdfs:comment "Records the change reason for Domain change event."@en,
        "영역 변경 사건의 변경 사유를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range rdf:langString .

dom:changeRecordedByRole a owl:DatatypeProperty ;
    rdfs:label "recorded by role"@en,
        "기록자 역할"@ko ;
    rdfs:comment "Records the recorded by role for Domain change event."@en,
        "영역 변경 사건의 기록자 역할를 기록한다."@ko ;
    rdfs:domain dom:DomainChangeEvent ;
    rdfs:range xsd:string .

dom:domainAlternativeLabel a owl:DatatypeProperty ;
    rdfs:label "alternative label"@en,
        "대체 표기"@ko ;
    rdfs:comment "Records the alternative label for Knowledge domain."@en,
        "지식·업무 영역의 대체 표기를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf skos:altLabel .

dom:domainBoundaryStatus a owl:DatatypeProperty ;
    rdfs:label "boundary definition status"@en,
        "경계 정의 상태"@ko ;
    rdfs:comment "Records the boundary definition status for Knowledge domain."@en,
        "지식·업무 영역의 경계 정의 상태를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range xsd:string .

dom:domainBroader a owl:ObjectProperty ;
    rdfs:label "immediate broader domain"@en,
        "직접 상위 영역"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Knowledge domain."@en,
        "지식·업무 영역에서 지식·업무 영역로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:KnowledgeDomain ;
    rdfs:subPropertyOf skos:broader ;
    owl:inverseOf dom:domainNarrower .

dom:domainDefinition a owl:DatatypeProperty ;
    rdfs:label "domain definition"@en,
        "영역 정의"@ko ;
    rdfs:comment "Records the domain definition for Knowledge domain."@en,
        "지식·업무 영역의 영역 정의를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf skos:definition .

dom:domainHasAssignment a owl:ObjectProperty ;
    rdfs:label "has domain assignment"@en,
        "영역 배정 기록"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Domain assignment."@en,
        "지식·업무 영역에서 프로필 영역 배정로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainAssignment .

dom:domainHasChangeEvent a owl:ObjectProperty ;
    rdfs:label "has change event"@en,
        "변경 이력"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Domain change event."@en,
        "지식·업무 영역에서 영역 변경 사건로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainChangeEvent .

dom:domainHasMapping a owl:ObjectProperty ;
    rdfs:label "has external mapping"@en,
        "외부 매핑 기록"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to External classification mapping."@en,
        "지식·업무 영역에서 외부 분류 매핑로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainMapping .

dom:domainHasProfile a owl:ObjectProperty ;
    rdfs:label "has ontology profile"@en,
        "포함 온톨로지 프로필"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Ontology profile."@en,
        "지식·업무 영역에서 온톨로지 프로필로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:OntologyProfile .

dom:domainHasRelation a owl:ObjectProperty ;
    rdfs:label "has cross-domain relation"@en,
        "교차 영역 관계 기록"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Cross-domain relation."@en,
        "지식·업무 영역에서 교차 영역 관계로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainRelation .

dom:domainHasReview a owl:ObjectProperty ;
    rdfs:label "has review"@en,
        "검토 기록"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Domain review record."@en,
        "지식·업무 영역에서 영역 검토 기록로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainReview .

dom:domainHasScopeStatement a owl:ObjectProperty ;
    rdfs:label "has scope statement"@en,
        "범위 문장"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Domain scope statement."@en,
        "지식·업무 영역에서 영역 범위 문장로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainScopeStatement .

dom:domainHasSource a owl:ObjectProperty ;
    rdfs:label "has source"@en,
        "정의 출처"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Domain evidence source."@en,
        "지식·업무 영역에서 영역 근거 출처로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainSource .

dom:domainIdentifier a owl:DatatypeProperty ;
    rdfs:label "domain identifier"@en,
        "영역 식별자"@ko ;
    rdfs:comment "Records the domain identifier for Knowledge domain."@en,
        "지식·업무 영역의 영역 식별자를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range xsd:string .

dom:domainInCatalog a owl:ObjectProperty ;
    rdfs:label "in catalog"@en,
        "소속 분류 체계"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Domain catalog."@en,
        "지식·업무 영역에서 영역 분류 체계로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:DomainCatalog ;
    rdfs:subPropertyOf skos:inScheme .

dom:domainLevel a owl:DatatypeProperty ;
    rdfs:label "hierarchy level"@en,
        "계층 단계"@ko ;
    rdfs:comment "Records the hierarchy level for Knowledge domain."@en,
        "지식·업무 영역의 계층 단계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range xsd:integer .

dom:domainLifecycleStatus a owl:DatatypeProperty ;
    rdfs:label "domain lifecycle status"@en,
        "영역 상태"@ko ;
    rdfs:comment "Records the domain lifecycle status for Knowledge domain."@en,
        "지식·업무 영역의 영역 상태를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range xsd:string .

dom:domainNotation a owl:DatatypeProperty ;
    rdfs:label "domain notation"@en,
        "분류 기호"@ko ;
    rdfs:comment "Records the domain notation for Knowledge domain."@en,
        "지식·업무 영역의 분류 기호를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf skos:notation .

dom:domainPreferredLabel a owl:DatatypeProperty ;
    rdfs:label "preferred label"@en,
        "선호 표기"@ko ;
    rdfs:comment "Records the preferred label for Knowledge domain."@en,
        "지식·업무 영역의 선호 표기를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf skos:prefLabel .

dom:domainRelatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related domain"@en,
        "연관 영역"@ko ;
    rdfs:comment "Records a relation from Knowledge domain to Knowledge domain."@en,
        "지식·업무 영역에서 지식·업무 영역로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range dom:KnowledgeDomain ;
    rdfs:subPropertyOf skos:related .

dom:domainTopConcept a owl:DatatypeProperty ;
    rdfs:label "top concept flag"@en,
        "최상위 개념 여부"@ko ;
    rdfs:comment "Records the top concept flag for Knowledge domain."@en,
        "지식·업무 영역의 최상위 개념 여부를 기록한다."@ko ;
    rdfs:domain dom:KnowledgeDomain ;
    rdfs:range xsd:boolean .

dom:mappingConfidence a owl:DatatypeProperty ;
    rdfs:label "mapping confidence"@en,
        "매핑 신뢰도"@ko ;
    rdfs:comment "Records the mapping confidence for External classification mapping."@en,
        "외부 분류 매핑의 매핑 신뢰도를 기록한다."@ko ;
    rdfs:domain dom:DomainMapping ;
    rdfs:range xsd:decimal .

dom:mappingEvidenceSource a owl:ObjectProperty ;
    rdfs:label "mapping evidence"@en,
        "매핑 근거 출처"@ko ;
    rdfs:comment "Records a relation from External classification mapping to Domain evidence source."@en,
        "외부 분류 매핑에서 영역 근거 출처로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainMapping ;
    rdfs:range dom:DomainSource .

dom:mappingExternalConceptUri a owl:DatatypeProperty ;
    rdfs:label "external concept URI"@en,
        "외부 개념 URI"@ko ;
    rdfs:comment "Records the external concept URI for External classification mapping."@en,
        "외부 분류 매핑의 외부 개념 URI를 기록한다."@ko ;
    rdfs:domain dom:DomainMapping ;
    rdfs:range xsd:anyURI .

dom:mappingExternalNotation a owl:DatatypeProperty ;
    rdfs:label "external notation"@en,
        "외부 분류 기호"@ko ;
    rdfs:comment "Records the external notation for External classification mapping."@en,
        "외부 분류 매핑의 외부 분류 기호를 기록한다."@ko ;
    rdfs:domain dom:DomainMapping ;
    rdfs:range xsd:string .

dom:mappingExternalScheme a owl:ObjectProperty ;
    rdfs:label "target external scheme"@en,
        "대상 외부 분류 체계"@ko ;
    rdfs:comment "Records a relation from External classification mapping to External classification scheme."@en,
        "외부 분류 매핑에서 외부 분류 체계로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainMapping ;
    rdfs:range dom:ExternalClassificationScheme .

dom:mappingLocalDomain a owl:ObjectProperty ;
    rdfs:label "local domain"@en,
        "매핑할 로컬 영역"@ko ;
    rdfs:comment "Records a relation from External classification mapping to Knowledge domain."@en,
        "외부 분류 매핑에서 지식·업무 영역로 연결되는 관계를 기록한다."@ko ;
    rdfs:domain dom:DomainMapping ;
    rdfs:range dom:KnowledgeDomain .

dom:mappingRationale a owl:DatatypeProperty ;
    rdfs:label "mapping rationale"@en,
        "매핑 판단 근거"@ko ;
    rdfs:comment "Records the mapping rationale for External classification mapping."@en,
        "외부 분류 매핑의 매핑 판단 근거를 기록한다."@ko ;
    rdfs:domain dom:DomainMapping ;
    rdfs:range rdf:langString .

