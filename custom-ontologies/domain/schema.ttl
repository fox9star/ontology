dom:scopeText a owl:DatatypeProperty ;
    rdfs:label "scope text"@en,
        "범위 문장"@ko ;
    rdfs:comment "Records the scope text for Domain scope statement."@en,
        "영역 범위 문장의 범위 문장를 기록한다."@ko ;
