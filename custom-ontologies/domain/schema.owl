<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Records the hierarchy level for Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역의 계층 단계를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="ko">계층 단계</rdfs:label>
    <rdfs:label xml:lang="en">hierarchy level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasReview">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Domain review record.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 영역 검토 기록로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has review</rdfs:label>
    <rdfs:label xml:lang="ko">검토 기록</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#OntologyProfile">
    <rdfs:label xml:lang="ko">온톨로지 프로필</rdfs:label>
    <rdfs:label xml:lang="en">Ontology profile</rdfs:label>
    <rdfs:comment xml:lang="ko">로컬 카탈로그에 등록된 온톨로지 모듈의 ID, 버전, 네임스페이스와 범위를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the ID, version, namespace, and scope of an ontology module in the local catalog.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourceAccessedAt">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">Records the source access date for Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 근거 출처의 자료 확인 날짜를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">source access date</rdfs:label>
    <rdfs:label xml:lang="ko">자료 확인 날짜</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileScope">
    <rdfs:label xml:lang="en">profile scope</rdfs:label>
    <rdfs:label xml:lang="ko">프로필 범위</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdfs:comment xml:lang="ko">온톨로지 프로필의 프로필 범위를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the profile scope for Ontology profile.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainNotation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">분류 기호</rdfs:label>
    <rdfs:label xml:lang="en">domain notation</rdfs:label>
    <rdfs:comment xml:lang="en">Records the domain notation for Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역의 분류 기호를 기록한다.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentToDomain">
    <rdfs:label xml:lang="en">assigned domain</rdfs:label>
    <rdfs:label xml:lang="ko">배정 영역</rdfs:label>
    <rdfs:comment xml:lang="ko">프로필 영역 배정에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Domain assignment to Knowledge domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#relationSubjectDomain">
    <rdfs:comment xml:lang="en">Records a relation from Cross-domain relation to Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">교차 영역 관계에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">relation subject</rdfs:label>
    <rdfs:label xml:lang="ko">관계 시작 영역</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#scopeEvidenceSource">
    <rdfs:label xml:lang="ko">범위 근거 출처</rdfs:label>
    <rdfs:label xml:lang="en">scope evidence</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainScopeStatement"/>
    <rdfs:comment xml:lang="en">Records a relation from Domain scope statement to Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 범위 문장에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewEvidenceSource">
    <rdfs:label xml:lang="ko">검토 근거</rdfs:label>
    <rdfs:label xml:lang="en">review evidence</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
    <rdfs:comment xml:lang="ko">영역 검토 기록에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Domain review record to Domain evidence source.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="en">domain identifier</rdfs:label>
    <rdfs:label xml:lang="ko">영역 식별자</rdfs:label>
    <rdfs:comment xml:lang="en">Records the domain identifier for Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역의 영역 식별자를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasRelation">
    <rdfs:label xml:lang="en">has cross-domain relation</rdfs:label>
    <rdfs:label xml:lang="ko">교차 영역 관계 기록</rdfs:label>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Cross-domain relation.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 교차 영역 관계로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainBoundaryStatus">
    <rdfs:comment xml:lang="ko">지식·업무 영역의 경계 정의 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the boundary definition status for Knowledge domain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="ko">경계 정의 상태</rdfs:label>
    <rdfs:label xml:lang="en">boundary definition status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#relationRationale">
    <rdfs:label xml:lang="ko">관계 설명</rdfs:label>
    <rdfs:label xml:lang="en">relation rationale</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="ko">교차 영역 관계의 관계 설명를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the relation rationale for Cross-domain relation.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogPreferredLabel">
    <rdfs:label xml:lang="en">catalog preferred label</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 표제</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:comment xml:lang="ko">영역 분류 체계의 분류 체계 표제를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the catalog preferred label for Domain catalog.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewerRole">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the reviewer role for Domain review record.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 검토 기록의 검토자 역할를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="ko">검토자 역할</rdfs:label>
    <rdfs:label xml:lang="en">reviewer role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#KnowledgeDomain">
    <rdfs:comment xml:lang="en">A knowledge or application concept with a defined scope and boundary. Broader links name only the immediate parent.</rdfs:comment>
    <rdfs:comment xml:lang="ko">정의된 범위와 경계를 가진 지식 또는 응용 분야 개념이다. 상위 관계는 바로 위의 직접 부모만 표시한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">지식·업무 영역</rdfs:label>
    <rdfs:label xml:lang="en">Knowledge domain</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainAlternativeLabel">
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
    <rdfs:comment xml:lang="en">Records the alternative label for Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역의 대체 표기를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="ko">대체 표기</rdfs:label>
    <rdfs:label xml:lang="en">alternative label</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingExternalConceptUri">
    <rdfs:comment xml:lang="en">Records the external concept URI for External classification mapping.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 매핑의 외부 개념 URI를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">external concept URI</rdfs:label>
    <rdfs:label xml:lang="ko">외부 개념 URI</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#scopeKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">범위 문장 유형</rdfs:label>
    <rdfs:label xml:lang="en">scope statement kind</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainScopeStatement"/>
    <rdfs:comment xml:lang="en">Records the scope statement kind for Domain scope statement.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 범위 문장의 범위 문장 유형를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changeRecordedByRole">
    <rdfs:comment xml:lang="ko">영역 변경 사건의 기록자 역할를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the recorded by role for Domain change event.</rdfs:comment>
    <rdfs:label xml:lang="en">recorded by role</rdfs:label>
    <rdfs:label xml:lang="ko">기록자 역할</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileCoversDomain">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="en">covers domain</rdfs:label>
    <rdfs:label xml:lang="ko">포괄 영역</rdfs:label>
    <rdfs:comment xml:lang="ko">온톨로지 프로필에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Ontology profile to Knowledge domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourceScope">
    <rdfs:comment xml:lang="ko">영역 근거 출처의 자료가 뒷받침하는 범위를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the supported source scope for Domain evidence source.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">supported source scope</rdfs:label>
    <rdfs:label xml:lang="ko">자료가 뒷받침하는 범위</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainRelatedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
    <rdfs:label xml:lang="ko">연관 영역</rdfs:label>
    <rdfs:label xml:lang="en">related domain</rdfs:label>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasMapping">
    <rdfs:label xml:lang="en">has external mapping</rdfs:label>
    <rdfs:label xml:lang="ko">외부 매핑 기록</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 외부 분류 매핑로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to External classification mapping.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemeUri">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label xml:lang="en">scheme URI</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 URI</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="ko">외부 분류 체계의 분류 체계 URI를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the scheme URI for External classification scheme.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainInCatalog">
    <rdfs:label xml:lang="ko">소속 분류 체계</rdfs:label>
    <rdfs:label xml:lang="en">in catalog</rdfs:label>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Domain catalog.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 영역 분류 체계로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourceYear">
    <rdfs:comment xml:lang="ko">영역 근거 출처의 발행 연도를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the publication year for Domain evidence source.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">publication year</rdfs:label>
    <rdfs:label xml:lang="ko">발행 연도</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentMethod">
    <rdfs:comment xml:lang="ko">프로필 영역 배정의 배정 방법를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the assignment method for Domain assignment.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">assignment method</rdfs:label>
    <rdfs:label xml:lang="ko">배정 방법</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourceKind">
    <rdfs:label xml:lang="ko">자료 유형</rdfs:label>
    <rdfs:label xml:lang="en">source kind</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdfs:comment xml:lang="en">Records the source kind for Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 근거 출처의 자료 유형를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#relationStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">관계 검토 상태</rdfs:label>
    <rdfs:label xml:lang="en">relation review status</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="ko">교차 영역 관계의 관계 검토 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the relation review status for Cross-domain relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemeName">
    <rdfs:comment xml:lang="ko">외부 분류 체계의 분류 체계 이름를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the scheme name for External classification scheme.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">scheme name</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 이름</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#relationEvidenceSource">
    <rdfs:label xml:lang="en">relation evidence</rdfs:label>
    <rdfs:label xml:lang="ko">관계 근거 출처</rdfs:label>
    <rdfs:comment xml:lang="ko">교차 영역 관계에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Cross-domain relation to Domain evidence source.</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentCreatedAt">
    <rdfs:comment xml:lang="ko">프로필 영역 배정의 배정 기록 날짜를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the assignment date for Domain assignment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
    <rdfs:label xml:lang="ko">배정 기록 날짜</rdfs:label>
    <rdfs:label xml:lang="en">assignment date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="ko">영역 정의</rdfs:label>
    <rdfs:label xml:lang="en">domain definition</rdfs:label>
    <rdfs:comment xml:lang="ko">지식·업무 영역의 영역 정의를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the domain definition for Knowledge domain.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#scopeText">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="ko">범위 문장</rdfs:label>
    <rdfs:label xml:lang="en">scope text</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainScopeStatement"/>
    <rdfs:comment xml:lang="en">Records the scope text for Domain scope statement.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 범위 문장의 범위 문장를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainLifecycleStatus">
    <rdfs:comment xml:lang="ko">지식·업무 영역의 영역 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the domain lifecycle status for Knowledge domain.</rdfs:comment>
    <rdfs:label xml:lang="ko">영역 상태</rdfs:label>
    <rdfs:label xml:lang="en">domain lifecycle status</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainBroader">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
    <rdfs:label xml:lang="ko">직접 상위 영역</rdfs:label>
    <rdfs:label xml:lang="en">immediate broader domain</rdfs:label>
    <owl:inverseOf rdf:resource="https://example.org/ontology/custom/domain#domainNarrower"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">source URI</rdfs:label>
    <rdfs:label xml:lang="ko">자료 URI</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdfs:comment xml:lang="en">Records the source URI for Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 근거 출처의 자료 URI를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#relationObjectDomain">
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="ko">관계 대상 영역</rdfs:label>
    <rdfs:label xml:lang="en">relation object</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Records a relation from Cross-domain relation to Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">교차 영역 관계에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">지식·업무 영역 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">Knowledge and Application Domain Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">A draft for assigning local ontology profiles to knowledge and application domains and managing hierarchy, scope, external mappings, evidence, review, and change.</rdfs:comment>
    <rdfs:comment xml:lang="ko">로컬 온톨로지 프로필을 지식·업무 영역에 연결하고 계층, 범위, 외부 매핑, 출처, 검토와 변경을 관리하는 초안이다.</rdfs:comment>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingRationale">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
    <rdfs:comment xml:lang="en">Records the mapping rationale for External classification mapping.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 매핑의 매핑 판단 근거를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">mapping rationale</rdfs:label>
    <rdfs:label xml:lang="ko">매핑 판단 근거</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogVersion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">catalog version</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 버전</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="ko">영역 분류 체계의 분류 체계 버전를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the catalog version for Domain catalog.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#relationType">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
    <rdfs:label xml:lang="en">relation type</rdfs:label>
    <rdfs:label xml:lang="ko">관계 유형</rdfs:label>
    <rdfs:comment xml:lang="en">Records the relation type for Cross-domain relation.</rdfs:comment>
    <rdfs:comment xml:lang="ko">교차 영역 관계의 관계 유형를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainNarrower">
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#narrower"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="en">immediate narrower domain</rdfs:label>
    <rdfs:label xml:lang="ko">직접 하위 영역</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemeDocumentedBy">
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Records a relation from External classification scheme to Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 체계에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
    <rdfs:label xml:lang="en">documented by</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 출처</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileDocumentedBy">
    <rdfs:label xml:lang="ko">프로필 출처 기록</rdfs:label>
    <rdfs:label xml:lang="en">documented by</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Records a relation from Ontology profile to Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">온톨로지 프로필에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingExternalScheme">
    <rdfs:comment xml:lang="en">Records a relation from External classification mapping to External classification scheme.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 매핑에서 외부 분류 체계로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
    <rdfs:label xml:lang="ko">대상 외부 분류 체계</rdfs:label>
    <rdfs:label xml:lang="en">target external scheme</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemeVersion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">분류 체계 버전</rdfs:label>
    <rdfs:label xml:lang="en">scheme version</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="ko">외부 분류 체계의 분류 체계 버전를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the scheme version for External classification scheme.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemeLimitations">
    <rdfs:label xml:lang="en">scheme limitations</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 한계</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Records the scheme limitations for External classification scheme.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 체계의 분류 체계 한계를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainAssignment">
    <rdfs:comment xml:lang="en">Records a proposed or accepted assignment between a profile and a domain with method, evidence, and review state.</rdfs:comment>
    <rdfs:comment xml:lang="ko">프로필과 지식 영역 간 제안 또는 승인된 배정을 방법·근거·검토 상태와 함께 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">Domain assignment</rdfs:label>
    <rdfs:label xml:lang="ko">프로필 영역 배정</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changeNewStatus">
    <rdfs:comment xml:lang="en">Records the new state for Domain change event.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 변경 사건의 변경 후 상태를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
    <rdfs:label xml:lang="ko">변경 후 상태</rdfs:label>
    <rdfs:label xml:lang="en">new state</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingExternalNotation">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="ko">외부 분류 매핑의 외부 분류 기호를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the external notation for External classification mapping.</rdfs:comment>
    <rdfs:label xml:lang="ko">외부 분류 기호</rdfs:label>
    <rdfs:label xml:lang="en">external notation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentRationale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Records the assignment rationale for Domain assignment.</rdfs:comment>
    <rdfs:comment xml:lang="ko">프로필 영역 배정의 배정 근거 설명를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">assignment rationale</rdfs:label>
    <rdfs:label xml:lang="ko">배정 근거 설명</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewDate">
    <rdfs:label xml:lang="ko">검토 날짜</rdfs:label>
    <rdfs:label xml:lang="en">review date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="ko">영역 검토 기록의 검토 날짜를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the review date for Domain review record.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogHasDomain">
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="en">has domain</rdfs:label>
    <rdfs:label xml:lang="ko">포함 영역</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="ko">영역 분류 체계에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Domain catalog to Knowledge domain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileNamespace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Records the profile namespace for Ontology profile.</rdfs:comment>
    <rdfs:comment xml:lang="ko">온톨로지 프로필의 프로필 네임스페이스를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="ko">프로필 네임스페이스</rdfs:label>
    <rdfs:label xml:lang="en">profile namespace</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasSource">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">has source</rdfs:label>
    <rdfs:label xml:lang="ko">정의 출처</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingEvidenceSource">
    <rdfs:comment xml:lang="en">Records a relation from External classification mapping to Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 매핑에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">mapping evidence</rdfs:label>
    <rdfs:label xml:lang="ko">매핑 근거 출처</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainMapping">
    <rdfs:label xml:lang="en">External classification mapping</rdfs:label>
    <rdfs:label xml:lang="ko">외부 분류 매핑</rdfs:label>
    <rdfs:comment xml:lang="ko">외부 분류 체계의 개념과 연결하려는 매핑 후보, 관계 유형, 근거 및 검토 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a candidate mapping to an external classification concept, relation type, evidence, and review state.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingConfidence">
    <rdfs:label xml:lang="en">mapping confidence</rdfs:label>
    <rdfs:label xml:lang="ko">매핑 신뢰도</rdfs:label>
    <rdfs:comment xml:lang="en">Records the mapping confidence for External classification mapping.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 매핑의 매핑 신뢰도를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingStatus">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
    <rdfs:label xml:lang="en">mapping lifecycle status</rdfs:label>
    <rdfs:label xml:lang="ko">매핑 상태</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Records the mapping lifecycle status for External classification mapping.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 매핑의 매핑 상태를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changePreviousStatus">
    <rdfs:comment xml:lang="en">Records the previous state for Domain change event.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 변경 사건의 이전 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
    <rdfs:label xml:lang="en">previous state</rdfs:label>
    <rdfs:label xml:lang="ko">이전 상태</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentEvidenceSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="ko">프로필 영역 배정에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Domain assignment to Domain evidence source.</rdfs:comment>
    <rdfs:label xml:lang="ko">배정 근거</rdfs:label>
    <rdfs:label xml:lang="en">assignment evidence</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogHasTopDomain">
    <rdfs:comment xml:lang="ko">영역 분류 체계에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Domain catalog to Knowledge domain.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
    <rdfs:label xml:lang="ko">최상위 영역</rdfs:label>
    <rdfs:label xml:lang="en">has top domain</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#hasTopConcept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasChangeEvent">
    <rdfs:label xml:lang="ko">변경 이력</rdfs:label>
    <rdfs:label xml:lang="en">has change event</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 영역 변경 사건로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Domain change event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changeForDomain">
    <rdfs:label xml:lang="en">change for domain</rdfs:label>
    <rdfs:label xml:lang="ko">변경 대상 영역</rdfs:label>
    <rdfs:comment xml:lang="en">Records a relation from Domain change event to Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 변경 사건에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainSource">
    <rdfs:label xml:lang="en">Domain evidence source</rdfs:label>
    <rdfs:label xml:lang="ko">영역 근거 출처</rdfs:label>
    <rdfs:comment xml:lang="en">Describes a source document for the classification structure or a local profile scope and its limits.</rdfs:comment>
    <rdfs:comment xml:lang="ko">분류 구조 또는 로컬 프로필 범위의 근거 문서와 적용 한계를 기술한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasProfile">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 온톨로지 프로필로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Ontology profile.</rdfs:comment>
    <rdfs:label xml:lang="en">has ontology profile</rdfs:label>
    <rdfs:label xml:lang="ko">포함 온톨로지 프로필</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#scopeEvidenceLevel">
    <rdfs:comment xml:lang="ko">영역 범위 문장의 범위 근거 수준를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the scope evidence level for Domain scope statement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainScopeStatement"/>
    <rdfs:label xml:lang="ko">범위 근거 수준</rdfs:label>
    <rdfs:label xml:lang="en">scope evidence level</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileVersion">
    <rdfs:label xml:lang="en">profile version</rdfs:label>
    <rdfs:label xml:lang="ko">프로필 버전</rdfs:label>
    <rdfs:comment xml:lang="en">Records the profile version for Ontology profile.</rdfs:comment>
    <rdfs:comment xml:lang="ko">온톨로지 프로필의 프로필 버전를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainPreferredLabel">
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:comment xml:lang="en">Records the preferred label for Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">지식·업무 영역의 선호 표기를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="ko">선호 표기</rdfs:label>
    <rdfs:label xml:lang="en">preferred label</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourceTitle">
    <rdfs:label xml:lang="en">source title</rdfs:label>
    <rdfs:label xml:lang="ko">자료 제목</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdfs:comment xml:lang="ko">영역 근거 출처의 자료 제목를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the source title for Domain evidence source.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changeEvidenceSource">
    <rdfs:comment xml:lang="ko">영역 변경 사건에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Domain change event to Domain evidence source.</rdfs:comment>
    <rdfs:label xml:lang="en">change evidence</rdfs:label>
    <rdfs:label xml:lang="ko">변경 근거 출처</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewRationale">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
    <rdfs:label xml:lang="ko">검토 메모</rdfs:label>
    <rdfs:label xml:lang="en">review rationale</rdfs:label>
    <rdfs:comment xml:lang="ko">영역 검토 기록의 검토 메모를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the review rationale for Domain review record.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changeDate">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">change date</rdfs:label>
    <rdfs:label xml:lang="ko">변경 날짜</rdfs:label>
    <rdfs:comment xml:lang="en">Records the change date for Domain change event.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 변경 사건의 변경 날짜를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changeAction">
    <rdfs:label xml:lang="ko">변경 작업</rdfs:label>
    <rdfs:label xml:lang="en">change action</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
    <rdfs:comment xml:lang="ko">영역 변경 사건의 변경 작업를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the change action for Domain change event.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourcePublisher">
    <rdfs:comment xml:lang="ko">영역 근거 출처의 발행자를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the publisher for Domain evidence source.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">publisher</rdfs:label>
    <rdfs:label xml:lang="ko">발행자</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainChangeEvent">
    <rdfs:label xml:lang="ko">영역 변경 사건</rdfs:label>
    <rdfs:label xml:lang="en">Domain change event</rdfs:label>
    <rdfs:comment xml:lang="ko">영역 명칭·범위·계층·상태의 변경 이력을 이유와 출처와 함께 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a change to a domain label, scope, hierarchy, or state with its reason and source.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainTopConcept">
    <rdfs:label xml:lang="en">top concept flag</rdfs:label>
    <rdfs:label xml:lang="ko">최상위 개념 여부</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:comment xml:lang="ko">지식·업무 영역의 최상위 개념 여부를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the top concept flag for Knowledge domain.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingRelationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the mapping relation type for External classification mapping.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 매핑의 매핑 관계 유형를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="ko">매핑 관계 유형</rdfs:label>
    <rdfs:label xml:lang="en">mapping relation type</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentStatus">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">배정 검토 상태</rdfs:label>
    <rdfs:label xml:lang="en">assignment review status</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
    <rdfs:comment xml:lang="en">Records the assignment review status for Domain assignment.</rdfs:comment>
    <rdfs:comment xml:lang="ko">프로필 영역 배정의 배정 검토 상태를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#relationRecordedAt">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainRelation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">relation record date</rdfs:label>
    <rdfs:label xml:lang="ko">관계 기록 날짜</rdfs:label>
    <rdfs:comment xml:lang="en">Records the relation record date for Cross-domain relation.</rdfs:comment>
    <rdfs:comment xml:lang="ko">교차 영역 관계의 관계 기록 날짜를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="ko">계층 관계와 구별되는 학제성·중첩·인접 관계와 그 설명 및 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records interdisciplinary, overlapping, or adjacent relations separately from hierarchy, with explanation and status.</rdfs:comment>
    <rdfs:label xml:lang="ko">교차 영역 관계</rdfs:label>
    <rdfs:label xml:lang="en">Cross-domain relation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogLifecycleStatus">
    <rdfs:comment xml:lang="en">Records the catalog lifecycle status for Domain catalog.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 분류 체계의 분류 체계 상태를 기록한다.</rdfs:comment>
    <rdfs:label xml:lang="en">catalog lifecycle status</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 상태</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileName">
    <rdfs:comment xml:lang="ko">온톨로지 프로필의 프로필 이름를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the profile name for Ontology profile.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">profile name</rdfs:label>
    <rdfs:label xml:lang="ko">프로필 이름</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewForDomain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
    <rdfs:label xml:lang="ko">검토 대상 영역</rdfs:label>
    <rdfs:label xml:lang="en">reviews domain</rdfs:label>
    <rdfs:comment xml:lang="ko">영역 검토 기록에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Domain review record to Knowledge domain.</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#sourceLimitations">
    <rdfs:label xml:lang="ko">자료 한계</rdfs:label>
    <rdfs:label xml:lang="en">source limitations</rdfs:label>
    <rdfs:comment xml:lang="ko">영역 근거 출처의 자료 한계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the source limitations for Domain evidence source.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainReview">
    <rdfs:comment xml:lang="ko">영역 정의·계층·범위 문장의 검토 기준, 결과와 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records review criteria, outcome, and status for a domain definition, hierarchy, or scope statement.</rdfs:comment>
    <rdfs:label xml:lang="en">Domain review record</rdfs:label>
    <rdfs:label xml:lang="ko">영역 검토 기록</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogDefinition">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#definition"/>
    <rdfs:label xml:lang="ko">분류 체계 정의</rdfs:label>
    <rdfs:label xml:lang="en">catalog definition</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:comment xml:lang="ko">영역 분류 체계의 분류 체계 정의를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the catalog definition for Domain catalog.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileStatus">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">프로필 상태</rdfs:label>
    <rdfs:label xml:lang="en">profile lifecycle status</rdfs:label>
    <rdfs:comment xml:lang="ko">온톨로지 프로필의 프로필 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the profile lifecycle status for Ontology profile.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasScopeStatement">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="ko">범위 문장</rdfs:label>
    <rdfs:label xml:lang="en">has scope statement</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainScopeStatement"/>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 영역 범위 문장로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Domain scope statement.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemePublisher">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">scheme publisher</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 발행자</rdfs:label>
    <rdfs:comment xml:lang="ko">외부 분류 체계의 분류 체계 발행자를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the scheme publisher for External classification scheme.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewStatus">
    <rdfs:comment xml:lang="en">Records the review status for Domain review record.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 검토 기록의 검토 진행 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
    <rdfs:label xml:lang="en">review status</rdfs:label>
    <rdfs:label xml:lang="ko">검토 진행 상태</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemeLanguage">
    <rdfs:label xml:lang="en">scheme language</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 언어</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Records the scheme language for External classification scheme.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 체계의 분류 체계 언어를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewOutcome">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
    <rdfs:label xml:lang="ko">검토 결과</rdfs:label>
    <rdfs:label xml:lang="en">review outcome</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Records the review outcome for Domain review record.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 검토 기록의 검토 결과를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainCatalog">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:comment xml:lang="ko">지식·업무 영역 개념과 그 분류 기준을 한 버전으로 묶는 개념 체계이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A concept scheme that groups knowledge or application domains and its classification criteria as a versioned catalog.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">영역 분류 체계</rdfs:label>
    <rdfs:label xml:lang="en">Domain catalog</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#schemeStatus">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">scheme status</rdfs:label>
    <rdfs:label xml:lang="ko">분류 체계 상태</rdfs:label>
    <rdfs:comment xml:lang="en">Records the scheme status for External classification scheme.</rdfs:comment>
    <rdfs:comment xml:lang="ko">외부 분류 체계의 분류 체계 상태를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#ExternalClassificationScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#scopeReviewStatus">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="ko">영역 범위 문장의 범위 검토 상태를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the scope review status for Domain scope statement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainScopeStatement"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">범위 검토 상태</rdfs:label>
    <rdfs:label xml:lang="en">scope review status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#domainHasAssignment">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:comment xml:lang="ko">지식·업무 영역에서 프로필 영역 배정로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from Knowledge domain to Domain assignment.</rdfs:comment>
    <rdfs:label xml:lang="ko">영역 배정 기록</rdfs:label>
    <rdfs:label xml:lang="en">has domain assignment</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ontologyProfileId">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdfs:label xml:lang="en">profile ID</rdfs:label>
    <rdfs:label xml:lang="ko">프로필 ID</rdfs:label>
    <rdfs:comment xml:lang="en">Records the profile ID for Ontology profile.</rdfs:comment>
    <rdfs:comment xml:lang="ko">온톨로지 프로필의 프로필 ID를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentConfidence">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">assignment confidence</rdfs:label>
    <rdfs:label xml:lang="ko">배정 신뢰도</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
    <rdfs:comment xml:lang="en">Records the assignment confidence for Domain assignment.</rdfs:comment>
    <rdfs:comment xml:lang="ko">프로필 영역 배정의 배정 신뢰도를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#DomainScopeStatement">
    <rdfs:comment xml:lang="ko">영역에 포함되는 내용, 제외되는 내용 또는 경계에 대한 범위 문장이다.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statement about what a domain includes, excludes, or where its boundary lies.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Domain scope statement</rdfs:label>
    <rdfs:label xml:lang="ko">영역 범위 문장</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#changeReason">
    <rdfs:label xml:lang="ko">변경 사유</rdfs:label>
    <rdfs:label xml:lang="en">change reason</rdfs:label>
    <rdfs:comment xml:lang="en">Records the change reason for Domain change event.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 변경 사건의 변경 사유를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainChangeEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#assignmentForProfile">
    <rdfs:label xml:lang="ko">배정 대상 프로필</rdfs:label>
    <rdfs:label xml:lang="en">for ontology profile</rdfs:label>
    <rdfs:comment xml:lang="en">Records a relation from Domain assignment to Ontology profile.</rdfs:comment>
    <rdfs:comment xml:lang="ko">프로필 영역 배정에서 온톨로지 프로필로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainAssignment"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#OntologyProfile"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#scopeForDomain">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainScopeStatement"/>
    <rdfs:label xml:lang="en">scope for domain</rdfs:label>
    <rdfs:label xml:lang="ko">범위 대상 영역</rdfs:label>
    <rdfs:comment xml:lang="en">Records a relation from Domain scope statement to Knowledge domain.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 범위 문장에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#ExternalClassificationScheme">
    <rdfs:comment xml:lang="en">An external domain classification scheme managed with its version, publisher, URI, and limitations.</rdfs:comment>
    <rdfs:comment xml:lang="ko">버전·발행자·URI와 한계를 함께 관리하는 외부 영역 분류 체계이다.</rdfs:comment>
    <rdfs:label xml:lang="ko">외부 분류 체계</rdfs:label>
    <rdfs:label xml:lang="en">External classification scheme</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#reviewCriteria">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainReview"/>
    <rdfs:comment xml:lang="en">Records the review criteria for Domain review record.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 검토 기록의 검토 기준를 기록한다.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:label xml:lang="en">review criteria</rdfs:label>
    <rdfs:label xml:lang="ko">검토 기준</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#mappingLocalDomain">
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainMapping"/>
    <rdfs:comment xml:lang="ko">외부 분류 매핑에서 지식·업무 영역로 연결되는 관계를 기록한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records a relation from External classification mapping to Knowledge domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#KnowledgeDomain"/>
    <rdfs:label xml:lang="en">local domain</rdfs:label>
    <rdfs:label xml:lang="ko">매핑할 로컬 영역</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogHasSource">
    <rdfs:range rdf:resource="https://example.org/ontology/custom/domain#DomainSource"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
    <rdfs:label xml:lang="en">has evidence source</rdfs:label>
    <rdfs:label xml:lang="ko">근거 출처</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Records a relation from Domain catalog to Domain evidence source.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 분류 체계에서 영역 근거 출처로 연결되는 관계를 기록한다.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/custom/domain#catalogScopeNote">
    <rdfs:comment xml:lang="en">Records the catalog scope note for Domain catalog.</rdfs:comment>
    <rdfs:comment xml:lang="ko">영역 분류 체계의 분류 범위 주석를 기록한다.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">catalog scope note</rdfs:label>
    <rdfs:label xml:lang="ko">분류 범위 주석</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    <rdfs:domain rdf:resource="https://example.org/ontology/custom/domain#DomainCatalog"/>
  </rdf:Description>
</rdf:RDF>
