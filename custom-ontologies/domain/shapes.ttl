        [ sh:datatype rdf:langString ;
            sh:message "자료가 뒷받침하는 범위의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path dom:sourceScope ] ;
