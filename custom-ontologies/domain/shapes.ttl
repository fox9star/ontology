        [ sh:datatype xsd:string ;
            sh:in ( "standards_document"^^xsd:string "methodology"^^xsd:string "official_classification"^^xsd:string "local_profile"^^xsd:string "other"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "자료 유형의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path dom:sourceKind ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "자료 확인 날짜의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path dom:sourceAccessedAt ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:message "자료 URI의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
