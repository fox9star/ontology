            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path dom:scopeText ] ;
    sh:targetClass dom:DomainScopeStatement .

dom:DomainSourceShape a sh:NodeShape ;
    sh:message "영역 근거 출처의 필수 속성, 언어 태그 및 값 형식을 확인하세요."@ko ;
    sh:property [ sh:datatype rdf:langString ;
            sh:message "자료 한계의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path dom:sourceLimitations ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "자료 제목의 값·언어 태그·형식을 확인하세요."@ko ;
