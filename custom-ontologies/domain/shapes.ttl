            sh:message "범위 근거 출처의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:path dom:scopeEvidenceSource ],
        [ sh:datatype xsd:string ;
            sh:in ( "curated"^^xsd:string "source_grounded"^^xsd:string "synthetic"^^xsd:string "unknown"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "범위 근거 수준의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path dom:scopeEvidenceLevel ],
        [ sh:class dom:KnowledgeDomain ;
            sh:maxCount 1 ;
            sh:message "범위 대상 영역의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:path dom:scopeForDomain ],
        [ sh:datatype xsd:string ;
            sh:in ( "inclusion"^^xsd:string "exclusion"^^xsd:string "boundary"^^xsd:string "context"^^xsd:string ) ;
            sh:maxCount 1 ;
            sh:message "범위 문장 유형의 값·언어 태그·형식을 확인하세요."@ko ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path dom:scopeKind ],
        [ sh:datatype xsd:string ;
