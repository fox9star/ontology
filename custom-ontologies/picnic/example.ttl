@prefix item: <https://example.org/ontology/custom/picnic#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

item:garden-plan a item:PicnicPlan ;
    rdfs:label "Synthetic picnic: half day in a garden"@en,
        "합성 소풍: 정원에서 반나절"@ko ;
    item:budgetAmount 30000.0 ;
    item:currency "KRW" ;
    item:endsAt "2026-10-11T05:00:00+00:00"^^xsd:dateTime ;
    item:hasActivity item:garden-activity-01,
        item:garden-activity-02,
        item:garden-activity-03,
        item:garden-activity-04 ;
    item:hasAssignment item:garden-assignment-food,
        item:garden-assignment-mat ;
    item:hasExpense item:garden-expense-admission,
        item:garden-expense-food,
        item:garden-expense-other ;
    item:hasParticipant item:garden-member-a,
        item:garden-member-b ;
    item:hasPlace item:garden-place ;
    item:hasSupply item:garden-cleanup,
        item:garden-food,
        item:garden-mat ;
    item:hasWeatherCheck item:garden-weather ;
    item:picnicDate "2026-10-11"^^xsd:date ;
    item:planNote "가상 정원 소풍 계획입니다. 준비물 담당자·날씨 확인·예산 초과 항목이 남아 있습니다." ;
    item:recordKind "synthetic" ;
    item:startsAt "2026-10-11T01:00:00+00:00"^^xsd:dateTime ;
    item:status "draft" .

item:park-plan a item:PicnicPlan ;
    rdfs:label "Synthetic picnic: a day in a park"@en,
        "합성 소풍: 공원에서 하루"@ko ;
    item:budgetAmount 60000.0 ;
    item:currency "KRW" ;
    item:endsAt "2026-10-10T07:00:00+00:00"^^xsd:dateTime ;
    item:hasActivity item:park-activity-01,
        item:park-activity-02,
        item:park-activity-03,
        item:park-activity-04 ;
    item:hasAssignment item:park-assignment-cleanup,
        item:park-assignment-drink,
        item:park-assignment-mat ;
    item:hasExpense item:park-expense-equipment,
        item:park-expense-food,
        item:park-expense-transport ;
    item:hasParticipant item:park-member-a,
        item:park-member-b,
        item:park-member-c ;
    item:hasPlace item:park-place ;
    item:hasSupply item:park-cleanup,
        item:park-drink,
        item:park-mat ;
    item:hasWeatherCheck item:park-weather ;
    item:picnicDate "2026-10-10"^^xsd:date ;
    item:planNote "가상 공원 소풍 계획입니다. 일부 준비물 수량과 날씨 정보가 아직 준비되지 않았습니다." ;
    item:recordKind "synthetic" ;
    item:startsAt "2026-10-10T01:00:00+00:00"^^xsd:dateTime ;
    item:status "draft" .

item:garden-activity-01 a item:Activity ;
    rdfs:label "Synthetic garden activity: travel"@en,
        "합성 정원 일정: 이동"@ko ;
    item:activityEnd "2026-10-11T01:30:00+00:00"^^xsd:dateTime ;
    item:activityKind "travel" ;
    item:activityNote "가상 이동 일정으로 실제 교통편 예약은 없습니다." ;
    item:activityStart "2026-10-11T01:00:00+00:00"^^xsd:dateTime ;
    item:sequence 1 .

item:garden-activity-02 a item:Activity ;
    rdfs:label "Synthetic garden activity: meal"@en,
        "합성 정원 일정: 식사"@ko ;
    item:activityEnd "2026-10-11T02:30:00+00:00"^^xsd:dateTime ;
    item:activityKind "meal" ;
    item:activityNote "가상 식사 일정입니다." ;
    item:activityStart "2026-10-11T01:30:00+00:00"^^xsd:dateTime ;
    item:sequence 2 .

item:garden-activity-03 a item:Activity ;
    rdfs:label "Synthetic garden activity: rest"@en,
        "합성 정원 일정: 휴식"@ko ;
    item:activityEnd "2026-10-11T04:30:00+00:00"^^xsd:dateTime ;
    item:activityKind "rest" ;
    item:activityNote "가상 휴식 일정입니다." ;
    item:activityStart "2026-10-11T02:30:00+00:00"^^xsd:dateTime ;
    item:sequence 3 .

item:garden-activity-04 a item:Activity ;
    rdfs:label "Synthetic garden activity: cleanup"@en,
        "합성 정원 일정: 정리"@ko ;
    item:activityEnd "2026-10-11T05:00:00+00:00"^^xsd:dateTime ;
    item:activityKind "cleanup" ;
    item:activityNote "가상 정리 일정입니다." ;
    item:activityStart "2026-10-11T04:30:00+00:00"^^xsd:dateTime ;
