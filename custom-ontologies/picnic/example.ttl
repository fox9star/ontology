item:garden-assignment-food a item:Assignment ;
    rdfs:label "Synthetic assignment: garden meals"@en,
        "합성 담당: 정원 도시락"@ko ;
    item:assignedSupply item:garden-food ;
    item:assignedTo item:garden-member-b .

item:garden-assignment-mat a item:Assignment ;
    rdfs:label "Synthetic assignment: garden mat"@en,
        "합성 담당: 정원 돗자리"@ko ;
    item:assignedSupply item:garden-mat ;
    item:assignedTo item:garden-member-a .

item:garden-cleanup a item:SupplyItem ;
    rdfs:label "Synthetic supply: garden cleanup bags"@en,
        "합성 준비물: 정원 정리 봉투"@ko ;
    item:packedQuantity 1.0 ;
    item:requiredQuantity 1.0 ;
    item:supplyKind "cleanup" ;
    item:unit "pack" .

item:garden-expense-admission a item:Expense ;
    rdfs:label "Synthetic expense: garden admission"@en,
        "합성 비용: 정원 입장"@ko ;
    item:amount 14000.0 ;
    item:expenseKind "admission" ;
    item:expenseNote "가상의 지불 상태 예제이며 실제 결제를 수행하지 않았습니다." ;
    item:expenseStatus "paid" .

item:garden-expense-food a item:Expense ;
    rdfs:label "Synthetic expense: garden food"@en,
        "합성 비용: 정원 식사"@ko ;
    item:amount 18000.0 ;
    item:expenseKind "food" ;
    item:expenseNote "가상의 예정 금액입니다. 실제 식품 가격이 아닙니다." ;
    item:expenseStatus "planned" .

item:garden-expense-other a item:Expense ;
    rdfs:label "Synthetic expense: garden cancelled extra"@en,
        "합성 비용: 정원 기타 취소"@ko ;
    item:amount 2000.0 ;
    item:expenseKind "other" ;
    item:expenseNote "가상 취소 항목으로 배정 비용 합계에서 제외합니다." ;
    item:expenseStatus "cancelled" .

item:garden-place a item:Place ;
    rdfs:label "Synthetic garden place"@en,
        "합성 정원 장소"@ko ;
    item:locationNote "실제 정원 이름·주소·입장 조건을 포함하지 않는 가상 장소입니다." ;
    item:placeKind "garden" .

item:garden-weather a item:WeatherCheck ;
    rdfs:label "Synthetic garden weather check, unverified"@en,
        "합성 정원 소풍 날씨 미확인"@ko ;
    item:checkStatus "unverified" ;
    item:forDate "2026-10-11"^^xsd:date ;
    item:weatherSummary "가상 예제의 미확인 상태입니다. 실제 날씨 예보를 조회하지 않았습니다." .

