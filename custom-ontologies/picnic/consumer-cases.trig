            <https://example.test/picnic/garden-member-b> ;
        ns1:hasPlace <https://example.test/picnic/garden-place> ;
        ns1:hasSupply <https://example.test/picnic/garden-cleanup>,
            <https://example.test/picnic/garden-food>,
            <https://example.test/picnic/garden-mat> ;
        ns1:hasWeatherCheck <https://example.test/picnic/garden-weather> ;
        ns1:picnicDate "2026-10-11"^^xsd:date ;
        ns1:planNote "가상 정원 소풍 계획입니다. 준비물 담당자·날씨 확인·예산 초과 항목이 남아 있습니다." ;
        ns1:recordKind "synthetic" ;
        ns1:startsAt "2026-10-11T01:00:00+00:00"^^xsd:dateTime ;
        ns1:status "draft" .

    <https://example.test/picnic/park-plan> a ns1:PicnicPlan ;
        rdfs:label "Synthetic picnic: a day in a park"@en,
            "합성 소풍: 공원에서 하루"@ko ;
