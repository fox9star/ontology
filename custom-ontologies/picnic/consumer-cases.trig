@prefix ns1: <https://example.org/ontology/custom/picnic#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.test/consumer/picnic-accept> {
    <https://example.test/picnic/garden-plan> a ns1:PicnicPlan ;
        rdfs:label "Synthetic picnic: half day in a garden"@en,
            "합성 소풍: 정원에서 반나절"@ko ;
        ns1:budgetAmount 30000.0 ;
        ns1:currency "KRW" ;
        ns1:endsAt "2026-10-11T05:00:00+00:00"^^xsd:dateTime ;
        ns1:hasActivity <https://example.test/picnic/garden-activity-01>,
            <https://example.test/picnic/garden-activity-02>,
            <https://example.test/picnic/garden-activity-03>,
            <https://example.test/picnic/garden-activity-04> ;
