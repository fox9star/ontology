            <https://example.test/picnic/garden-assignment-mat> ;
        ns1:hasExpense <https://example.test/picnic/garden-expense-admission>,
            <https://example.test/picnic/garden-expense-food>,
            <https://example.test/picnic/garden-expense-other> ;
