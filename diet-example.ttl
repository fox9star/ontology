@prefix core: <https://example.org/ontology/core#> .
@prefix diet: <http://example.org/ontology/diet#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# AI Coaching Agents (인공지능 코칭 에이전트)
# =============================================================================

diet:Agent_NutritionCoach a diet:NutritionistAgent ;
    rdfs:label "AI 임상 영양 분석 에이전트"@ko, "AI Clinical Nutrition Specialist Agent"@en .

diet:Agent_FitnessCoach a diet:FitnessTrainerAgent ;
    rdfs:label "AI 맞춤 운동 처방 트레이너"@ko, "AI Personalized Fitness Trainer Agent"@en .

diet:Agent_MetabolicSupervisor a diet:MetabolicMonitorAgent ;
    rdfs:label "AI 대사 항상성 모니터링 코치"@ko, "AI Metabolic Homeostasis Monitor Coach"@en .

# =============================================================================
# Dietary Plans (식이 처방 플랜)
# =============================================================================

diet:Plan_LowCarbHighProtein a diet:DietaryPlan ;
    rdfs:label "순수 근육 보존형 저탄고단백 감량 플랜"@ko, "Lean Muscle Preserving Low-Carb High-Protein Plan"@en .

diet:Plan_MediterraneanDeficit a diet:DietaryPlan ;
    rdfs:label "항산화 지중해식 칼로리 결손 웰니스 플랜"@ko, "Antioxidant Mediterranean Calorie Deficit Wellness Plan"@en .

# =============================================================================
# Food Items (개별 식품 항목)
# =============================================================================

diet:Food_ChickenBreast a diet:FoodItem ;
    rdfs:label "수비드 저염 닭가슴살 150g"@ko, "Sous-vide Low Sodium Chicken Breast 150g"@en .

diet:Food_BrownRice a diet:FoodItem ;
    rdfs:label "유기농 현미 귀리밥 130g"@ko, "Organic Brown Rice and Oats 130g"@en .

diet:Food_SalmonFillet a diet:FoodItem ;
    rdfs:label "노르웨이 생연어 오븐구이 180g"@ko, "Baked Norwegian Salmon Fillet 180g"@en .

diet:Food_AvocadoSalad a diet:FoodItem ;
    rdfs:label "올리브유 아보카도 믹스 샐러드 120g"@ko, "Avocado Mixed Salad with Olive Oil 120g"@en .

diet:Food_GreekYogurt a diet:FoodItem ;
    rdfs:label "무가당 그릭 요거트 100g"@ko, "Unsweetened Plain Greek Yogurt 100g"@en .

diet:Food_SweetPotato a diet:FoodItem ;
    rdfs:label "에어프라이어 호박고구마 120g"@ko, "Air-fried Sweet Potato 120g"@en .

# =============================================================================
# Target Goals (감량 목표 설정)
# =============================================================================

diet:Goal_KimDiet a diet:TargetGoal ;
    rdfs:label "김다이어트 1차 체지방 집중 감량 목표"@ko, "Kim Diet Primary Fat Reduction Target"@en ;
    diet:targetWeightKg "72.0"^^xsd:decimal ;
    diet:targetBodyFatPercent "15.0"^^xsd:decimal ;
    diet:targetDailyCalorieDeficit "500.0"^^xsd:decimal .

diet:Goal_LeeHealth a diet:TargetGoal ;
    rdfs:label "이헬스 건강 유지 및 탄력 강화 감량 목표"@ko, "Lee Health Tone and Metabolic Target"@en ;
    diet:targetWeightKg "52.0"^^xsd:decimal ;
    diet:targetBodyFatPercent "20.0"^^xsd:decimal ;
    diet:targetDailyCalorieDeficit "400.0"^^xsd:decimal .

