# =============================================================================
# Dietary Meal Logs (식단 섭취 기록)
# =============================================================================

diet:Meal_Kim_Breakfast_20261005 a diet:DietaryMealLog ;
    rdfs:label "김다이어트 10월 5일 아침 고단백 식단"@ko, "Kim Diet High Protein Breakfast Oct 5"@en ;
    diet:mealType "BREAKFAST" ;
    diet:mealCaloriesKcal "420.0"^^xsd:decimal ;
    diet:carbohydrateGrams "35.0"^^xsd:decimal ;
    diet:proteinGrams "40.0"^^xsd:decimal ;
    diet:fatGrams "12.0"^^xsd:decimal ;
    diet:containsFood diet:Food_ChickenBreast, diet:Food_BrownRice .

diet:Meal_Kim_Lunch_20261005 a diet:DietaryMealLog ;
    rdfs:label "김다이어트 10월 5일 점심 연어 샐러드 식단"@ko, "Kim Diet Baked Salmon Lunch Oct 5"@en ;
    diet:mealType "LUNCH" ;
    diet:mealCaloriesKcal "580.0"^^xsd:decimal ;
    diet:carbohydrateGrams "45.0"^^xsd:decimal ;
    diet:proteinGrams "48.0"^^xsd:decimal ;
    diet:fatGrams "20.0"^^xsd:decimal ;
    diet:containsFood diet:Food_SalmonFillet, diet:Food_AvocadoSalad .

diet:Meal_Kim_Dinner_20261005 a diet:DietaryMealLog ;
    rdfs:label "김다이어트 10월 5일 저녁 가벼운 대사 조절 식단"@ko, "Kim Diet Light Dinner Oct 5"@en ;
    diet:mealType "DINNER" ;
    diet:mealCaloriesKcal "350.0"^^xsd:decimal ;
    diet:carbohydrateGrams "25.0"^^xsd:decimal ;
    diet:proteinGrams "32.0"^^xsd:decimal ;
    diet:fatGrams "8.0"^^xsd:decimal ;
    diet:containsFood diet:Food_GreekYogurt, diet:Food_SweetPotato .

# =============================================================================
# Exercise Sessions (운동 활동 기록)
# =============================================================================

diet:Exercise_Kim_MorningRun_20261005 a diet:ExerciseSession ;
    rdfs:label "김다이어트 공복 아침 인터벌 러닝 세션"@ko, "Kim Diet Fasted Morning Running Session"@en ;
    diet:exerciseType "AEROBIC" ;
    diet:durationMinutes 45 ;
    diet:burnedCaloriesKcal "420.0"^^xsd:decimal .

diet:Exercise_Kim_Resistance_20261005 a diet:ExerciseSession ;
    rdfs:label "김다이어트 저녁 점진적 과부하 근력 트레이닝"@ko, "Kim Diet Progressive Resistance Session"@en ;
    diet:exerciseType "RESISTANCE" ;
    diet:durationMinutes 60 ;
    diet:burnedCaloriesKcal "330.0"^^xsd:decimal .

# =============================================================================
# Metabolic Daily Summary (일일 대사 수지 요약)
# =============================================================================

diet:Summary_Kim_20261005 a diet:MetabolicDailySummary ;
    rdfs:label "김다이어트 2026-10-05 일일 대사 에너지 결손 요약"@ko, "Kim Diet Daily Metabolic Deficit Summary 2026-10-05"@en ;
    diet:netCalorieDeficitKcal "580.0"^^xsd:decimal .

diet:Summary_Lee_20261005 a diet:MetabolicDailySummary ;
    rdfs:label "이헬스 2026-10-05 일일 대사 에너지 결손 요약"@ko, "Lee Health Daily Metabolic Deficit Summary 2026-10-05"@en ;
    diet:netCalorieDeficitKcal "420.0"^^xsd:decimal .

# =============================================================================
# Plateau Alert & Coaching Intervention (정체기 경보 및 코칭 개입)
# =============================================================================

diet:Alert_Kim_Plateau_20261004 a diet:PlateauAlert ;
    rdfs:label "김다이어트 14일 주기 적응성 열발생 정체 경보"@ko, "Kim Diet 14-day Adaptive Plateau Alert"@en ;
    diet:detectedOnProfile diet:Profile_KimDiet .

diet:Task_Kim_RefeedIntervention a diet:CoachingInterventionTask ;
    rdfs:label "정체기 극복을 위한 렙틴 재활성화 및 HIIT 유산소 처방"@ko, "Leptin Reset and HIIT Prescription Intervention"@en ;
    diet:interventionAction "지속적인 열량 제한으로 인한 대사 저하를 극복하기 위해 이번 주 토요일 2500kcal 클린 탄수화물 리피드를 진행하고, 주 2회 고강도 인터벌 러닝 25분을 병행하십시오." ;
    diet:taskStatus "ACTIVE" ;
    diet:targetProfile diet:Profile_KimDiet ;
    diet:executedByCoach diet:Agent_MetabolicSupervisor ;
    diet:triggeredByAlert diet:Alert_Kim_Plateau_20261004 .

# =============================================================================
# Weight Loss Profiles (체중감량 관리 프로필)
# =============================================================================

diet:Profile_KimDiet a diet:WeightLossProfile ;
    rdfs:label "김다이어트 개인 웰니스 프로필"@ko, "Kim Diet Personalized Wellness Profile"@en ;
    diet:profileName "김다이어트" ;
    diet:heightCm "175.5"^^xsd:decimal ;
    diet:hasTargetGoal diet:Goal_KimDiet ;
    diet:followsDietPlan diet:Plan_LowCarbHighProtein ;
    diet:hasBodyComposition diet:BodyComp_Kim_Baseline, diet:BodyComp_Kim_Recent ;
    diet:logsMeal diet:Meal_Kim_Breakfast_20261005, diet:Meal_Kim_Lunch_20261005, diet:Meal_Kim_Dinner_20261005 ;
    diet:logsExercise diet:Exercise_Kim_MorningRun_20261005, diet:Exercise_Kim_Resistance_20261005 ;
    diet:hasDailySummary diet:Summary_Kim_20261005 ;
    diet:assignedAgent diet:Agent_MetabolicSupervisor .

diet:Profile_LeeHealth a diet:WeightLossProfile ;
    rdfs:label "이헬스 개인 웰니스 프로필"@ko, "Lee Health Personalized Wellness Profile"@en ;
    diet:profileName "이헬스" ;
    diet:heightCm "163.0"^^xsd:decimal ;
    diet:hasTargetGoal diet:Goal_LeeHealth ;
    diet:followsDietPlan diet:Plan_MediterraneanDeficit ;
    diet:hasBodyComposition diet:BodyComp_Lee_Recent ;
    diet:hasDailySummary diet:Summary_Lee_20261005 ;
    diet:assignedAgent diet:Agent_NutritionCoach .
