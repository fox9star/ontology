@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/ontology/academic#DatabaseIntroduction> a owl:NamedIndividual,
        <https://example.org/ontology/academic#Course> ;
    rdfs:label "데이터베이스 입문"@ko .

<https://example.org/ontology/academic#KimMinSu> a owl:NamedIndividual,
        <https://example.org/ontology/academic#Student> ;
    rdfs:label "김민수"@ko .

