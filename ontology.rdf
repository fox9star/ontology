<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ex="https://example.org/ontology/academic#"
    xml:base="https://example.org/ontology/academic">

  <rdf:Description rdf:about="https://example.org/ontology/academic">
    <rdfs:label xml:lang="ko">대학 수강 예시 온톨로지</rdfs:label>
    <rdfs:comment xml:lang="ko">itis.md의 온톨로지 설명 중 대학 수강 예시를 RDF와 RDF Schema로 표현한 모델이다. 개념, 관계, 속성, 개별 대상을 정의한다.</rdfs:comment>
  </rdf:Description>

  <rdfs:Class rdf:about="#Student">
    <rdfs:label xml:lang="ko">학생</rdfs:label>
    <rdfs:comment xml:lang="ko">과목을 수강할 수 있는 사람의 종류.</rdfs:comment>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Professor">
    <rdfs:label xml:lang="ko">교수</rdfs:label>
    <rdfs:comment xml:lang="ko">과목을 가르칠 수 있는 사람의 종류.</rdfs:comment>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Course">
    <rdfs:label xml:lang="ko">과목</rdfs:label>
    <rdfs:comment xml:lang="ko">학생이 수강하고 교수가 가르치는 대상.</rdfs:comment>
  </rdfs:Class>

  <rdf:Property rdf:about="#enrollsIn">
    <rdfs:label xml:lang="ko">수강한다</rdfs:label>
    <rdfs:domain rdf:resource="#Student"/>
    <rdfs:range rdf:resource="#Course"/>
  </rdf:Property>

  <rdf:Property rdf:about="#teaches">
    <rdfs:label xml:lang="ko">가르친다</rdfs:label>
    <rdfs:domain rdf:resource="#Professor"/>
    <rdfs:range rdf:resource="#Course"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasStudent">
    <rdfs:label xml:lang="ko">수강생이 있다</rdfs:label>
    <rdfs:comment xml:lang="ko">과목에서 학생으로 향하는 수강 관계. RDF Schema만으로는 enrollsIn의 역관계를 자동 추론하지 않는다.</rdfs:comment>
    <rdfs:domain rdf:resource="#Course"/>
    <rdfs:range rdf:resource="#Student"/>
  </rdf:Property>

  <rdf:Property rdf:about="#courseCode">
    <rdfs:label xml:lang="ko">과목 코드</rdfs:label>
    <rdfs:comment xml:lang="ko">과목을 식별하는 문자열. RDF Schema만으로 모든 과목에 코드가 존재해야 한다는 조건은 표현하지 않는다.</rdfs:comment>
    <rdfs:domain rdf:resource="#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Property>

  <rdf:Property rdf:about="#credits">
    <rdfs:label xml:lang="ko">학점</rdfs:label>
    <rdfs:domain rdf:resource="#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Property>

  <rdf:Description rdf:about="#KimMinSu">
    <rdf:type rdf:resource="#Student"/>
    <rdfs:label xml:lang="ko">김민수</rdfs:label>
  </rdf:Description>

  <rdf:Description rdf:about="#DatabaseIntroduction">
    <rdf:type rdf:resource="#Course"/>
    <rdfs:label xml:lang="ko">데이터베이스 입문</rdfs:label>
  </rdf:Description>
</rdf:RDF>
