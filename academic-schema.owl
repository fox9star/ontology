<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/ontology/academic#credits">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">학점</rdfs:label>
    <rdfs:label xml:lang="en">Credits</rdfs:label>
    <rdfs:comment xml:lang="ko">과목의 학점 수. 0 이상의 십진수로 표현한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the credits for a Course as a decimal value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/academic#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic#enrollsIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">수강한다</rdfs:label>
    <rdfs:label xml:lang="en">Enrolls In</rdfs:label>
    <rdfs:comment xml:lang="ko">학생이 수강하는 과목을 가리킨다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a Student to a Course.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/academic#Student"/>
    <rdfs:range rdf:resource="https://example.org/ontology/academic#Course"/>
    <owl:inverseOf rdf:resource="https://example.org/ontology/academic#hasStudent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic#courseCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">과목 코드</rdfs:label>
    <rdfs:label xml:lang="en">Course Code</rdfs:label>
    <rdfs:comment xml:lang="ko">과목을 식별하는 문자열 코드.</rdfs:comment>
    <rdfs:comment xml:lang="en">Records the course code for a Course as a string value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/academic#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">대학 수강 예시 온톨로지</rdfs:label>
    <rdfs:comment xml:lang="ko">학생, 교수, 과목과 수강 관계를 표현한다. 예시 데이터에 없는 수강 기록이나 값을 추정하지 않는다.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl2-primer/"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/shacl/"/>
    <owl:versionInfo>1.2.1</owl:versionInfo>
    <owl:imports rdf:resource="https://example.org/ontology/vocab"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic#Professor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">교수</rdfs:label>
    <rdfs:label xml:lang="en">Professor</rdfs:label>
    <rdfs:comment xml:lang="ko">과목을 가르칠 수 있는 사람의 종류.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents an instructor who teaches academic courses.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic#teaches">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">가르친다</rdfs:label>
    <rdfs:label xml:lang="en">Teaches</rdfs:label>
    <rdfs:comment xml:lang="ko">교수가 담당하는 과목을 가리킨다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a Professor to a Course.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/academic#Professor"/>
    <rdfs:range rdf:resource="https://example.org/ontology/academic#Course"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic#hasStudent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">수강생이 있다</rdfs:label>
    <rdfs:label xml:lang="en">Has Student</rdfs:label>
    <rdfs:comment xml:lang="ko">과목의 수강생을 가리키는 수강 관계의 역방향 표현.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a Course to a Student.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/ontology/academic#Course"/>
    <rdfs:range rdf:resource="https://example.org/ontology/academic#Student"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic#Course">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">과목</rdfs:label>
    <rdfs:label xml:lang="en">Course</rdfs:label>
    <rdfs:comment xml:lang="ko">과목 코드가 필요한 학업 과정.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents an academic course identified by a course code and credit value.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="naea9dd64f32542ce859db35ed5988103b1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/academic#Student">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">학생</rdfs:label>
    <rdfs:label xml:lang="en">Student</rdfs:label>
    <rdfs:comment xml:lang="ko">과목을 수강할 수 있는 사람의 종류.</rdfs:comment>
    <rdfs:comment xml:lang="en">Represents a learner who may enroll in academic courses.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="naea9dd64f32542ce859db35ed5988103b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://example.org/ontology/academic#courseCode"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:minCardinality>
  </rdf:Description>
</rdf:RDF>
