@prefix ag:   <https://example.org/agent#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# 운영 데이터의 필수 필드와 값 형식을 검사한다. OWL 존재 제약과 용도가 다르다.
ag:ProjectShape a sh:NodeShape ;
    sh:targetClass ag:Project ;
    sh:property [ sh:path ag:goal ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ] ;
    sh:property [ sh:path ag:hasTask ; sh:minCount 1 ; sh:class ag:Task ] ;
    sh:property [ sh:path ag:hasFinalArtifact ; sh:class ag:Artifact ] ;
    sh:sparql [
        sh:message "최종 결과물에는 같은 결과물을 승인한 검수 판정이 필요합니다."@ko ;
        sh:select """
            PREFIX ag: <https://example.org/agent#>
            SELECT $this ?value WHERE {
                $this ag:hasFinalArtifact ?value .
                FILTER NOT EXISTS {
                    ?decision a ag:ReviewDecision ;
                              ag:decisionAbout ?value ;
                              ag:decision "approved" .
                }
            }
        """
    ] .

ag:TaskShape a sh:NodeShape ;
    sh:targetClass ag:Task ;
    sh:property [ sh:path ag:assignedTo ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class ag:Agent ] ;
    sh:property [ sh:path ag:acceptanceCriteria ; sh:minCount 1 ;
                  sh:datatype xsd:string ] ;
    sh:property [ sh:path ag:dependsOn ; sh:class ag:Task ] .

ag:TaskRunShape a sh:NodeShape ;
    sh:targetClass ag:TaskRun ;
    sh:property [ sh:path ag:implementsTask ; sh:minCount 1 ;
                  sh:maxCount 1 ; sh:class ag:Task ] ;
    sh:property [ sh:path ag:status ; sh:minCount 1 ;
                  sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:in ( "planned" "ready" "running" "completed" "failed" ) ] ;
    sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ;
                  sh:class ag:Agent ] .

ag:ArtifactShape a sh:NodeShape ;
    sh:targetClass ag:Artifact ;
    sh:property [ sh:path ag:artifactUri ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ag:version ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ] .

ag:AgentShape a sh:NodeShape ;
    sh:targetClass ag:Agent ;
    sh:property [ sh:path ag:version ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ag:hasCapability ; sh:class ag:Capability ] .

ag:HandoffShape a sh:NodeShape ;
    sh:targetClass ag:Handoff ;
    sh:property [ sh:path ag:toTask ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class ag:Task ] ;
    sh:property [ sh:path ag:toAgent ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class ag:Agent ] ;
    sh:property [ sh:path ag:containsArtifact ; sh:minCount 1 ;
                  sh:class ag:Artifact ] ;
    sh:property [ sh:path ag:acceptanceCriteria ; sh:minCount 1 ;
                  sh:datatype xsd:string ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ;
                  sh:maxCount 1 ; sh:class ag:TaskRun ] .

ag:ReviewRunShape a sh:NodeShape ;
    sh:targetClass ag:ReviewRun ;
    sh:property [ sh:path ag:reviews ; sh:minCount 1 ;
                  sh:class ag:Artifact ] ;
    sh:property [ sh:path ag:hasDecision ; sh:minCount 1 ;
                  sh:class ag:ReviewDecision ] ;
    sh:sparql [
        sh:message "검수 판정의 대상은 이 실행이 검수한 결과물이어야 합니다."@ko ;
        sh:select """
            PREFIX ag: <https://example.org/agent#>
            SELECT $this ?decision WHERE {
                $this ag:hasDecision ?decision .
                ?decision ag:decisionAbout ?artifact .
                FILTER NOT EXISTS { $this ag:reviews ?artifact }
            }
        """
    ] .

ag:ReviewDecisionShape a sh:NodeShape ;
    sh:targetClass ag:ReviewDecision ;
    sh:property [ sh:path ag:decisionAbout ; sh:minCount 1 ;
                  sh:maxCount 1 ; sh:class ag:Artifact ] ;
    sh:property [ sh:path ag:decision ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ;
                  sh:in ( "approved" "rejected" ) ] ;
    sh:property [ sh:path ag:reason ; sh:minCount 1 ;
                  sh:datatype xsd:string ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ;
                  sh:maxCount 1 ; sh:class ag:ReviewRun ] .

ag:AgentAssignmentShape a sh:NodeShape ;
    sh:targetClass ag:AgentAssignment ;
    sh:property [ sh:path ag:assignmentAgent ; sh:minCount 1 ;
                  sh:maxCount 1 ; sh:class ag:Agent ] ;
    sh:property [ sh:path ag:assignmentRole ; sh:minCount 1 ;
                  sh:maxCount 1 ; sh:class ag:Role ] .
