@prefix health: <http://example.org/ontology/healthcare#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vocab: <https://example.org/ontology/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/ontology/vocab> a owl:Ontology ;
    rdfs:label "온톨로지 공통 통제 어휘"@ko ;
    owl:versionInfo "1.0.0" .

vocab:MVStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "뮤직비디오 작업 상태"@ko, "Music video task status"@en .
vocab:mv-planned a skos:Concept ; skos:inScheme vocab:MVStatusScheme ;
    skos:notation "planned" ; skos:prefLabel "계획"@ko, "Planned"@en .
vocab:mv-running a skos:Concept ; skos:inScheme vocab:MVStatusScheme ;
    skos:notation "running" ; skos:prefLabel "실행 중"@ko, "Running"@en .
vocab:mv-completed a skos:Concept ; skos:inScheme vocab:MVStatusScheme ;
    skos:notation "completed" ; skos:prefLabel "완료"@ko, "Completed"@en .
vocab:mv-failed a skos:Concept ; skos:inScheme vocab:MVStatusScheme ;
    skos:notation "failed" ; skos:prefLabel "실패"@ko, "Failed"@en .

vocab:AgentRunStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "에이전트 실행 상태"@ko, "Agent run status"@en .
vocab:agent-planned a skos:Concept ; skos:inScheme vocab:AgentRunStatusScheme ;
    skos:notation "planned" ; skos:prefLabel "계획"@ko, "Planned"@en .
vocab:agent-ready a skos:Concept ; skos:inScheme vocab:AgentRunStatusScheme ;
    skos:notation "ready" ; skos:prefLabel "준비"@ko, "Ready"@en .
vocab:agent-running a skos:Concept ; skos:inScheme vocab:AgentRunStatusScheme ;
    skos:notation "running" ; skos:prefLabel "실행 중"@ko, "Running"@en .
vocab:agent-completed a skos:Concept ; skos:inScheme vocab:AgentRunStatusScheme ;
    skos:notation "completed" ; skos:prefLabel "완료"@ko, "Completed"@en .
vocab:agent-failed a skos:Concept ; skos:inScheme vocab:AgentRunStatusScheme ;
    skos:notation "failed" ; skos:prefLabel "실패"@ko, "Failed"@en .

vocab:ReviewDecisionScheme a skos:ConceptScheme ;
    skos:prefLabel "검수 판정"@ko, "Review decision"@en .
vocab:review-approved a skos:Concept ; skos:inScheme vocab:ReviewDecisionScheme ;
    skos:notation "approved" ; skos:prefLabel "승인"@ko, "Approved"@en .
vocab:review-rejected a skos:Concept ; skos:inScheme vocab:ReviewDecisionScheme ;
    skos:notation "rejected" ; skos:prefLabel "반려"@ko, "Rejected"@en .

vocab:DevOpsStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "DevOps 실행 상태"@ko, "DevOps execution status"@en .
vocab:devops-pending a skos:Concept ; skos:inScheme vocab:DevOpsStatusScheme ;
    skos:notation "PENDING" ; skos:prefLabel "대기"@ko, "Pending"@en .
vocab:devops-running a skos:Concept ; skos:inScheme vocab:DevOpsStatusScheme ;
    skos:notation "RUNNING" ; skos:prefLabel "실행 중"@ko, "Running"@en .
vocab:devops-success a skos:Concept ; skos:inScheme vocab:DevOpsStatusScheme ;
    skos:notation "SUCCESS" ; skos:prefLabel "성공"@ko, "Success"@en .
vocab:devops-failed a skos:Concept ; skos:inScheme vocab:DevOpsStatusScheme ;
    skos:notation "FAILED" ; skos:prefLabel "실패"@ko, "Failed"@en .
vocab:devops-cancelled a skos:Concept ; skos:inScheme vocab:DevOpsStatusScheme ;
    skos:notation "CANCELLED" ; skos:prefLabel "취소"@ko, "Cancelled"@en .

vocab:EcommerceOrderStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "주문 상태"@ko, "E-commerce order status"@en .
vocab:order-placed a skos:Concept ; skos:inScheme vocab:EcommerceOrderStatusScheme ;
    skos:notation "PLACED" ; skos:prefLabel "주문 접수"@ko, "Placed"@en .
vocab:order-processing a skos:Concept ; skos:inScheme vocab:EcommerceOrderStatusScheme ;
    skos:notation "PROCESSING" ; skos:prefLabel "처리 중"@ko, "Processing"@en .
vocab:order-shipped a skos:Concept ; skos:inScheme vocab:EcommerceOrderStatusScheme ;
    skos:notation "SHIPPED" ; skos:prefLabel "배송 시작"@ko, "Shipped"@en .
vocab:order-delivered a skos:Concept ; skos:inScheme vocab:EcommerceOrderStatusScheme ;
    skos:notation "DELIVERED" ; skos:prefLabel "배송 완료"@ko, "Delivered"@en .
vocab:order-cancelled a skos:Concept ; skos:inScheme vocab:EcommerceOrderStatusScheme ;
    skos:notation "CANCELLED" ; skos:prefLabel "취소"@ko, "Cancelled"@en .

vocab:EcommerceCurrencyStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "가격 통화 확인 상태"@ko, "Price currency verification status"@en .
vocab:currency-verified a skos:Concept ; skos:inScheme vocab:EcommerceCurrencyStatusScheme ;
    skos:notation "verified" ; skos:prefLabel "확인됨"@ko, "Verified"@en .
vocab:currency-unverified a skos:Concept ; skos:inScheme vocab:EcommerceCurrencyStatusScheme ;
    skos:notation "unverified" ; skos:prefLabel "미확인"@ko, "Unverified"@en .

vocab:HealthcareDiagnosticStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "의료 분석 상태"@ko, "Healthcare diagnostic status"@en .
vocab:health-pending a skos:Concept ; skos:inScheme vocab:HealthcareDiagnosticStatusScheme ;
    skos:notation "PENDING" ; skos:prefLabel "대기"@ko, "Pending"@en .
vocab:health-analyzing a skos:Concept ; skos:inScheme vocab:HealthcareDiagnosticStatusScheme ;
    skos:notation "ANALYZING" ; skos:prefLabel "분석 중"@ko, "Analyzing"@en .
vocab:health-completed a skos:Concept ; skos:inScheme vocab:HealthcareDiagnosticStatusScheme ;
    skos:notation "COMPLETED" ; skos:prefLabel "완료"@ko, "Completed"@en .
vocab:health-verified a skos:Concept ; skos:inScheme vocab:HealthcareDiagnosticStatusScheme ;
    skos:notation "VERIFIED" ; skos:prefLabel "검증 완료"@ko, "Verified"@en .
vocab:health-failed a skos:Concept ; skos:inScheme vocab:HealthcareDiagnosticStatusScheme ;
    skos:notation "FAILED" ; skos:prefLabel "실패"@ko, "Failed"@en .
vocab:health-cancelled a skos:Concept ; skos:inScheme vocab:HealthcareDiagnosticStatusScheme ;
    skos:notation "CANCELLED" ; skos:prefLabel "취소"@ko, "Cancelled"@en .

health:DiagnosticTaskIntentScheme a skos:ConceptScheme ;
    skos:prefLabel "진단 작업 의도"@ko, "Diagnostic Task Intent"@en ;
    skos:exactMatch <http://hl7.org/fhir/ValueSet/task-intent> .
health:fhir-intent-unknown a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "unknown" ; skos:prefLabel "알 수 없음"@ko, "Unknown"@en .
health:fhir-intent-proposal a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "proposal" ; skos:prefLabel "제안"@ko, "Proposal"@en .
health:fhir-intent-plan a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "plan" ; skos:prefLabel "계획"@ko, "Plan"@en .
health:fhir-intent-order a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "order" ; skos:prefLabel "지시"@ko, "Order"@en .
health:fhir-intent-original-order a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "original-order" ; skos:prefLabel "원 지시"@ko, "Original order"@en .
health:fhir-intent-reflex-order a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "reflex-order" ; skos:prefLabel "후속 자동 지시"@ko, "Reflex order"@en .
health:fhir-intent-filler-order a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "filler-order" ; skos:prefLabel "수행 시스템 지시"@ko, "Filler order"@en .
health:fhir-intent-instance-order a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "instance-order" ; skos:prefLabel "단일 실행 지시"@ko, "Instance order"@en .
health:fhir-intent-option a skos:Concept ; skos:inScheme health:DiagnosticTaskIntentScheme ;
    skos:notation "option" ; skos:prefLabel "선택안"@ko, "Option"@en .

health:ClinicalObservationStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "임상 관측값 상태"@ko, "Clinical Observation Status"@en ;
    skos:exactMatch <http://hl7.org/fhir/ValueSet/observation-status> .
health:fhir-observation-registered a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "registered" ; skos:prefLabel "등록됨"@ko, "Registered"@en .
health:fhir-observation-preliminary a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "preliminary" ; skos:prefLabel "예비"@ko, "Preliminary"@en .
health:fhir-observation-final a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "final" ; skos:prefLabel "최종"@ko, "Final"@en .
health:fhir-observation-amended a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "amended" ; skos:prefLabel "수정됨"@ko, "Amended"@en .
health:fhir-observation-corrected a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "corrected" ; skos:prefLabel "정정됨"@ko, "Corrected"@en .
health:fhir-observation-cancelled a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "cancelled" ; skos:prefLabel "취소됨"@ko, "Cancelled"@en .
health:fhir-observation-error a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "entered-in-error" ; skos:prefLabel "오류 입력"@ko, "Entered in error"@en .
health:fhir-observation-unknown a skos:Concept ; skos:inScheme health:ClinicalObservationStatusScheme ;
    skos:notation "unknown" ; skos:prefLabel "알 수 없음"@ko, "Unknown"@en .

health:ClinicalReportStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "임상 보고서 상태"@ko, "Clinical Report Status"@en ;
    skos:exactMatch <http://hl7.org/fhir/ValueSet/diagnostic-report-status> .
health:fhir-report-registered a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "registered" ; skos:prefLabel "등록됨"@ko, "Registered"@en .
health:fhir-report-partial a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "partial" ; skos:prefLabel "일부 결과"@ko, "Partial"@en .
health:fhir-report-preliminary a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "preliminary" ; skos:prefLabel "예비"@ko, "Preliminary"@en .
health:fhir-report-modified a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "modified" ; skos:prefLabel "변경됨"@ko, "Modified"@en .
health:fhir-report-final a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "final" ; skos:prefLabel "최종"@ko, "Final"@en .
health:fhir-report-amended a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "amended" ; skos:prefLabel "수정됨"@ko, "Amended"@en .
health:fhir-report-corrected a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "corrected" ; skos:prefLabel "정정됨"@ko, "Corrected"@en .
health:fhir-report-appended a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "appended" ; skos:prefLabel "추가됨"@ko, "Appended"@en .
health:fhir-report-cancelled a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "cancelled" ; skos:prefLabel "취소됨"@ko, "Cancelled"@en .
health:fhir-report-error a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "entered-in-error" ; skos:prefLabel "오류 입력"@ko, "Entered in error"@en .
health:fhir-report-unknown a skos:Concept ; skos:inScheme health:ClinicalReportStatusScheme ;
    skos:notation "unknown" ; skos:prefLabel "알 수 없음"@ko, "Unknown"@en .

health:PrivacyClassificationScheme a skos:ConceptScheme ;
    skos:prefLabel "의료 기록 분류"@ko, "Healthcare record classification"@en ;
    skos:hasTopConcept health:Unverified, health:Synthetic,
                       health:Pseudonymized, health:Sensitive .
health:Unverified a skos:Concept ; skos:inScheme health:PrivacyClassificationScheme ;
    skos:notation "Unverified" ; skos:prefLabel "미확인"@ko, "Unverified"@en .
health:Synthetic a skos:Concept ; skos:inScheme health:PrivacyClassificationScheme ;
    skos:notation "Synthetic" ; skos:prefLabel "합성 예시"@ko, "Synthetic"@en .
health:Pseudonymized a skos:Concept ; skos:inScheme health:PrivacyClassificationScheme ;
    skos:notation "Pseudonymized" ; skos:prefLabel "가명 처리"@ko, "Pseudonymized"@en .
health:Sensitive a skos:Concept ; skos:inScheme health:PrivacyClassificationScheme ;
    skos:notation "Sensitive" ; skos:prefLabel "민감 정보"@ko, "Sensitive"@en .
