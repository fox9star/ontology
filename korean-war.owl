<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">작전 종료 일자</rdfs:label>
    <rdfs:label xml:lang="en">Operation End Date</rdfs:label>
    <rdfs:comment xml:lang="ko">작전 목표가 완수되거나 전투가 종결된 공식 종료 날짜.</rdfs:comment>
    <rdfs:comment xml:lang="en">Calendar date marking the termination, cessation of combat, or objective completion of the mission.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#MilitaryOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">군사 작전 및 주요 전투</rdfs:label>
    <rdfs:label xml:lang="en">Military Operation and Major Battle</rdfs:label>
    <rdfs:comment xml:lang="ko">한국전쟁 기간 동안 수행된 주요 군사 작전, 전역(Campaign) 및 격전지 전투 활동.</rdfs:comment>
    <rdfs:comment xml:lang="en">Strategic military campaign, operation, or tactical battle engagement executed during the Korean War.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#associatedOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">대상 작전 연결</rdfs:label>
    <rdfs:label xml:lang="en">Associated Operation</rdfs:label>
    <rdfs:comment xml:lang="ko">인명 피해 통계가 집계되어 귀속되는 대상 전투 및 작전을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Connects casualty audit statistics to the discrete military operation in which losses were sustained.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#WarCasualtyRecord"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#MilitaryUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">참전 부대 및 사단 편성</rdfs:label>
    <rdfs:label xml:lang="en">Participating Military Unit Formation</rdfs:label>
    <rdfs:comment xml:lang="ko">전투에 투입된 군단, 사단, 여단, 연대 등의 실전 편제 군사 부대 단위.</rdfs:comment>
    <rdfs:comment xml:lang="en">Organized military corps, division, brigade, or regiment deployed in active operational combat sectors.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#occurredAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">전투 발생 위치</rdfs:label>
    <rdfs:label xml:lang="en">Occurred At Location</rdfs:label>
    <rdfs:comment xml:lang="ko">군사 작전이나 전투가 전개된 지리적 전장 요충지를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates a military operation or battle with the geographical location where combat unfolded.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#BattleLocation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#HistoricalArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">전쟁 사료 및 역사적 유물</rdfs:label>
    <rdfs:label xml:lang="en">War Historical Document and Artifact</rdfs:label>
    <rdfs:comment xml:lang="ko">작전명령서, 전시일지, 전선 상황도, 무공훈장 등 전쟁 당시의 역사적 진실을 입증하는 물적 사료.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary archival record, operational order, battlefield map, or physical artifact substantiating events.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#TacticalAnalystAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/korean-war#HistoricalAnalysisAgent"/>
    <rdfs:label xml:lang="ko">전략 전술 시뮬레이션 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Tactical Maneuver Simulation Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">화력, 병력비, 기상 및 지형 요인을 복합 분석하여 작전 전개의 필연성을 시뮬레이션하는 전문 에이전트.</rdfs:comment>
    <rdfs:comment xml:lang="en">Algorithmic specialist simulating troop ratios, terrain bottlenecks, fire support, and maneuver outcomes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#strategicOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전략 작전 결과</rdfs:label>
    <rdfs:label xml:lang="en">Strategic Outcome Classification</rdfs:label>
    <rdfs:comment xml:lang="ko">작전의 최종 성과 분류로 VICTORY, DEFEAT, STALEMATE, TACTICAL_SUCCESS 중 하나를 취한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Categorical evaluation of combat results such as VICTORY, DEFEAT, STALEMATE, or TACTICAL_SUCCESS.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#WarCasualtyRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">전사상자 및 피해 통계 기록</rdfs:label>
    <rdfs:label xml:lang="en">War Casualty Statistical Record</rdfs:label>
    <rdfs:comment xml:lang="ko">특정 전투 또는 작전 수행 중 발생한 전사자, 부상자, 실종자, 포로 등의 인명 피해 집계 기록.</rdfs:comment>
    <rdfs:comment xml:lang="en">Comprehensive casualty audit logging battle deaths, wounded personnel, missing in action, and prisoners.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#treatyTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">조약 협정문 명칭</rdfs:label>
    <rdfs:label xml:lang="en">Treaty Document Official Title</rdfs:label>
    <rdfs:comment xml:lang="ko">서명 조인된 공식 조약 또는 협정 문서의 정식 법률 명칭.</rdfs:comment>
    <rdfs:comment xml:lang="en">Complete diplomatic title of the signed international ceasefire accord or defense agreement.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#TreatyDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#sessionRound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">정전 회담 차수</rdfs:label>
    <rdfs:label xml:lang="en">Negotiation Session Round</rdfs:label>
    <rdfs:comment xml:lang="ko">개최된 공식 정전 회담의 진행 회차 번호 (단위: 회).</rdfs:comment>
    <rdfs:comment xml:lang="en">Sequential numerical index identifying the formal plenary session of the ceasefire talks.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#ArmisticeNegotiation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#troopCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">투입 병력 인원수</rdfs:label>
    <rdfs:label xml:lang="en">Deplopyed Troop Headcount</rdfs:label>
    <rdfs:comment xml:lang="ko">작전 투입 당시 해당 부대의 실제 가용 병력 인원수 (단위: 명).</rdfs:comment>
    <rdfs:comment xml:lang="en">Quantitative numerical strength of active military personnel deployed into the tactical sector.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryUnit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#taskStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/ontology/core#taskStatus"/>
    <rdfs:label xml:lang="ko">작업 진행 상태</rdfs:label>
    <rdfs:label xml:lang="en">Task Lifecycle Status</rdfs:label>
    <rdfs:comment xml:lang="ko">역사 분석 작업의 진행 라이프사이클 상태 (PENDING, ACTIVE, COMPLETED).</rdfs:comment>
    <rdfs:comment xml:lang="en">Operational lifecycle progression state of the research task taking values PENDING, ACTIVE, or COMPLETED.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#AnalysisTask"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#targetOperation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">분석 대상 작전</rdfs:label>
    <rdfs:label xml:lang="en">Target Analyzed Operation</rdfs:label>
    <rdfs:comment xml:lang="ko">AI 고증 작업이 집중적으로 검증하는 군사 작전 또는 전투를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies the specific military operation subject to rigorous historical and tactical analysis.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#AnalysisTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#signingDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">조약 조인 서명일</rdfs:label>
    <rdfs:label xml:lang="en">Treaty Execution Signing Date</rdfs:label>
    <rdfs:comment xml:lang="ko">교전 당사자 대표들이 협정문에 공식 조인 서명한 날짜.</rdfs:comment>
    <rdfs:comment xml:lang="en">Historical date on which authoritative plenipotentiaries affixed signatures to the accord.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#TreatyDocument"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#startDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">작전 개시 일자</rdfs:label>
    <rdfs:label xml:lang="en">Operation Start Date</rdfs:label>
    <rdfs:comment xml:lang="ko">전투 또는 군사 작전이 공식적으로 시작된 개시 날짜.</rdfs:comment>
    <rdfs:comment xml:lang="en">Calendar date marking the formal commencement of military hostilities or mission launch.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#ledByCommander">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">작전 총지휘관</rdfs:label>
    <rdfs:label xml:lang="en">Led By Commanding Officer</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 군사 작전을 기획하고 현장 지휘한 총책임 장성을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies the primary general or admiral exercising supreme command over the operation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#CommandingOfficer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">한국전쟁 역사 및 전사 분석 AI 에이전트 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">Korean War History and Military Strategic Analysis AI Agent Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">한국전쟁(1950-1953)의 주요 군사 작전, 전장 위치, 참전 부대 및 지휘관, 정전 협상, 전사상자 사료 및 역사 분석 AI 에이전트 상호작용 체계를 정의한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Defines military operations, battlegrounds, armed units, commanding officers, armistice negotiations, casualty archives, and historical analysis AI agents for the Korean War.</rdfs:comment>
    <owl:imports rdf:resource="https://example.org/ontology/core"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov-o#"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#belongsToForce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">소속 참전 세력</rdfs:label>
    <rdfs:label xml:lang="en">Belongs To Belligerent Force</rdfs:label>
    <rdfs:comment xml:lang="ko">개별 군사 부대가 소속되어 있는 상위 군사 진영 및 국가 세력을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Connects a discrete military unit to the national armed forces or allied coalition it serves under.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryUnit"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#BelligerentForce"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#TreatyDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">공식 정전 협정 및 조약</rdfs:label>
    <rdfs:label xml:lang="en">Formal Treaty and Armistice Accord</rdfs:label>
    <rdfs:comment xml:lang="ko">군사정전에 관한 협정문, 한미상호방위조약 등 전쟁 및 전후 안보를 규정한 법적 조약 문서.</rdfs:comment>
    <rdfs:comment xml:lang="en">Authoritative legal covenant, ceasefire agreement, or collective mutual defense pact resulting from the war.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#assignedAnalyst">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">배정 분석 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Assigned Analysis Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">전사 분석 작업을 전담하여 실행하는 AI 분석 에이전트를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Assigns an autonomous historical reasoning agent to investigate the designated research task.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#AnalysisTask"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#HistoricalAnalysisAgent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#heldAtLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">회담 개최 장소</rdfs:label>
    <rdfs:label xml:lang="en">Held At Location</rdfs:label>
    <rdfs:comment xml:lang="ko">정전 협상 및 회담이 공식적으로 개최된 지리적 장소를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates an armistice negotiation conference with the geographical location where meetings occurred.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#ArmisticeNegotiation"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#BattleLocation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#artifactIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">사료 기록물 등록번호</rdfs:label>
    <rdfs:label xml:lang="en">Artifact Archival Identifier</rdfs:label>
    <rdfs:comment xml:lang="ko">국가기록원, 군사편찬연구소, 미 국립문서기록청(NARA) 등의 사료 고유 관리번호.</rdfs:comment>
    <rdfs:comment xml:lang="en">Standard archival accession or catalog identifier assigned by military repository collections.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#HistoricalArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#evidencedByArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">입증 사료 유물</rdfs:label>
    <rdfs:label xml:lang="en">Evidenced By Historical Artifact</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 작전이나 전투의 역사적 사실을 객관적으로 입증하는 1차 사료를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Substantiates the operation by linking it to authentic archival records, orders, or museum artifacts.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#HistoricalArtifact"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#AnalysisTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/core#TaskRun"/>
    <rdfs:label xml:lang="ko">전사 고증 및 사료 분석 작업</rdfs:label>
    <rdfs:label xml:lang="en">Military History Analysis Task</rdfs:label>
    <rdfs:comment xml:lang="ko">AI 에이전트가 1차 사료와 지형 데이터, 전황 일지를 대조하여 역사적 사실을 검증하는 분석 실행 기록.</rdfs:comment>
    <rdfs:comment xml:lang="en">Actionable analytical run evaluating primary sources, topographical metrics, and battle logs for accuracy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#ArmisticeNegotiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">정전 및 휴전 회담 세션</rdfs:label>
    <rdfs:label xml:lang="en">Armistice Negotiation Session</rdfs:label>
    <rdfs:comment xml:lang="ko">전쟁 종식과 적대행위 중단을 위해 개성과 판문점에서 개최된 공식 정전 협상 회의.</rdfs:comment>
    <rdfs:comment xml:lang="en">Formal diplomatic and military bilateral conference session conducted to negotiate terms of armistice.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#negotiationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">회담 진행 일자</rdfs:label>
    <rdfs:label xml:lang="en">Negotiation Calendar Date</rdfs:label>
    <rdfs:comment xml:lang="ko">정전 회담 본회의가 개최되어 토의가 이루어진 날짜.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specific calendar date on which the armistice plenary conference convened.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#ArmisticeNegotiation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#locationName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전장 지명 명칭</rdfs:label>
    <rdfs:label xml:lang="en">Location Name Text</rdfs:label>
    <rdfs:comment xml:lang="ko">전투나 회담이 진행된 전술 지역의 명칭 (예: 인천 월미도, 장진호, 판문점).</rdfs:comment>
    <rdfs:comment xml:lang="en">Geographical toponym designating the physical hill, port, river basin, or conference venue.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#BattleLocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#operationName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">작전 전투 명칭</rdfs:label>
    <rdfs:label xml:lang="en">Operation Name Text</rdfs:label>
    <rdfs:comment xml:lang="ko">역사적으로 공인된 작전명 또는 전투 명칭 (예: 인천상륙작전, 장진호 전투).</rdfs:comment>
    <rdfs:comment xml:lang="en">Official historical military designation of the tactical battle or offensive operation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#killedInAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전투 전사자 수</rdfs:label>
    <rdfs:label xml:lang="en">Killed In Action Count</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 작전 중 적과의 교전으로 인해 사망한 군인 인원수 (단위: 명).</rdfs:comment>
    <rdfs:comment xml:lang="en">Audited count of military service members who suffered fatal combat trauma in the battle.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#WarCasualtyRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#missingInAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">실종 및 포로 수</rdfs:label>
    <rdfs:label xml:lang="en">Missing In Action Count</rdfs:label>
    <rdfs:comment xml:lang="ko">교전 후 생사가 확인되지 않거나 적국에 포로로 억류된 인원수 (단위: 명).</rdfs:comment>
    <rdfs:comment xml:lang="en">Count of combat personnel unaccounted for or captured during the operational engagement.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#WarCasualtyRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#unitDesignation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">부대 고유 명칭</rdfs:label>
    <rdfs:label xml:lang="en">Unit Designation Text</rdfs:label>
    <rdfs:comment xml:lang="ko">참전 군사 부대의 정식 명칭 (예: 국군 제1사단, 미 해병 제1사단).</rdfs:comment>
    <rdfs:comment xml:lang="en">Formal tactical or organizational designation of the active military unit formation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryUnit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#BelligerentForce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">참전 국가 및 연합 세력</rdfs:label>
    <rdfs:label xml:lang="en">Belligerent Force and Coalition</rdfs:label>
    <rdfs:comment xml:lang="ko">대한민국 국군, 유엔군 연합, 공산 측 연합 등 전쟁에 직접 참전한 군사 정치적 연합체.</rdfs:comment>
    <rdfs:comment xml:lang="en">Sovereign belligerent party or multilateral military coalition actively engaged in combat operations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#longitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전장 경도 좌표</rdfs:label>
    <rdfs:label xml:lang="en">Longitude Coordinate</rdfs:label>
    <rdfs:comment xml:lang="ko">전장 지점의 WGS84 표준 경도 좌표 (단위: 도).</rdfs:comment>
    <rdfs:comment xml:lang="en">WGS84 decimal longitude coordinate of the combat engagement or conference facility.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#BattleLocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#allianceSide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">참전 진영 구분</rdfs:label>
    <rdfs:label xml:lang="en">Alliance Side Alignment</rdfs:label>
    <rdfs:comment xml:lang="ko">참전 세력의 국제 진영으로 UN_ALLIED 또는 COMMUNIST_BLOC 값을 가진다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Geopolitical coalition alignment categorizing the force as UN_ALLIED or COMMUNIST_BLOC.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#BelligerentForce"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#forceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">참전 세력 명칭</rdfs:label>
    <rdfs:label xml:lang="en">Belligerent Force Name</rdfs:label>
    <rdfs:comment xml:lang="ko">참전 국가 또는 연합군의 공식 명칭 (예: 유엔군, 대한민국 국군, 중국인민지원군).</rdfs:comment>
    <rdfs:comment xml:lang="en">Official standard name of the sovereign combatant force or multilateral military coalition.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#BelligerentForce"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#commanderName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">지휘관 성명</rdfs:label>
    <rdfs:label xml:lang="en">Commander Name Text</rdfs:label>
    <rdfs:comment xml:lang="ko">작전 지휘관의 공식 인명 성명.</rdfs:comment>
    <rdfs:comment xml:lang="en">Official personal name of the military commander leading tactical or theatre forces.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#CommandingOfficer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#CommandingOfficer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">참전 작전 지휘관</rdfs:label>
    <rdfs:label xml:lang="en">Commanding Military Officer</rdfs:label>
    <rdfs:comment xml:lang="ko">한국전쟁 당시 주요 군단, 사단 또는 연합군 최고 사령부를 지휘 통솔한 장성 및 야전 지휘관.</rdfs:comment>
    <rdfs:comment xml:lang="en">General officer or field tactical leader who exercised operational command over armed formations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#involvesForce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">참전 세력 연결</rdfs:label>
    <rdfs:label xml:lang="en">Involves Belligerent Force</rdfs:label>
    <rdfs:comment xml:lang="ko">군사 작전에 참여하거나 교전한 참전 국가 연합 세력을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an operation to the belligerent coalition forces engaged in the tactical action.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#BelligerentForce"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#supervisesUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">지휘 통솔 부대</rdfs:label>
    <rdfs:label xml:lang="en">Supervises Military Unit</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 지휘관이 직속으로 관할하고 지휘 통솔한 군사 부대를 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a commanding officer to the subordinate military units placed under their direct authority.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#CommandingOfficer"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#MilitaryUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#latitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전장 위도 좌표</rdfs:label>
    <rdfs:label xml:lang="en">Latitude Coordinate</rdfs:label>
    <rdfs:comment xml:lang="ko">전장 지점의 WGS84 표준 위도 좌표 (단위: 도).</rdfs:comment>
    <rdfs:comment xml:lang="en">WGS84 decimal latitude coordinate of the combat engagement or conference facility.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#BattleLocation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#HistoricalAnalysisAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/core#Agent"/>
    <rdfs:label xml:lang="ko">한국전쟁 역사 분석 AI 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Korean War Historical Analysis AI Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">한국전쟁 전사 사료를 체계적으로 고증하고 전술 시뮬레이션을 수행하는 인공지능 역사 연구원.</rdfs:comment>
    <rdfs:comment xml:lang="en">Autonomous artificial intelligence entity specialized in war history research, archival vetting, and simulation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#militaryRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">지휘관 군 계급</rdfs:label>
    <rdfs:label xml:lang="en">Military Officer Rank</rdfs:label>
    <rdfs:comment xml:lang="ko">작전 당시 지휘관이 보유한 정규 군 계급 (예: 대장, 소장, 준장).</rdfs:comment>
    <rdfs:comment xml:lang="en">Substantive military rank held by the officer during the wartime operational timeframe.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#CommandingOfficer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#taskFindings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전사 분석 결론 소견</rdfs:label>
    <rdfs:label xml:lang="en">Historical Findings Text</rdfs:label>
    <rdfs:comment xml:lang="ko">AI 역사 에이전트가 1차 사료와 전훈 일지를 교차 검증하여 도출한 종합 결론 텍스트.</rdfs:comment>
    <rdfs:comment xml:lang="en">Synthesized historiographical narrative and critical evaluation findings compiled by the agent.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#AnalysisTask"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#concludedWithTreaty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">체결 결과 조약</rdfs:label>
    <rdfs:label xml:lang="en">Concluded With Treaty</rdfs:label>
    <rdfs:comment xml:lang="ko">정전 회담 협상의 결과물로 최종 서명 조인된 공식 조약 문건을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links the negotiation process to the formal accord or treaty instrument produced by the talks.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#ArmisticeNegotiation"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#TreatyDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#woundedInAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ko">전투 부상자 수</rdfs:label>
    <rdfs:label xml:lang="en">Wounded In Action Count</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 작전 중 적의 공격으로 인해 전상을 입은 인원수 (단위: 명).</rdfs:comment>
    <rdfs:comment xml:lang="en">Count of military personnel who sustained physical non-fatal injuries during tactical combat.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#WarCasualtyRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#CasualtyVerificationAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/korean-war#HistoricalAnalysisAgent"/>
    <rdfs:label xml:lang="ko">전사자 및 참전 유공자 추적 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Casualty and Veteran Records Tracing Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">전몰용사 유해 발굴 데이터와 매장 기록, 참전 군번을 교차 추적하여 신원을 복원하는 전문 에이전트.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specialized biometric and archival agent correlating military serials, burial logs, and remains recovery records.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#ArchiveCurationAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/korean-war#HistoricalAnalysisAgent"/>
    <rdfs:label xml:lang="ko">사료 고증 및 문서 큐레이션 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Archival Curation and Provenance Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">참전국 정부의 기밀해제 외교 문서, 작전 일지, 전황 보고서의 진위와 출처를 검증하는 전문 에이전트.</rdfs:comment>
    <rdfs:comment xml:lang="en">Specialized documentary agent establishing provenance, declassification credibility, and cross-source validity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#participatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="ko">참가 군사 작전</rdfs:label>
    <rdfs:label xml:lang="en">Participated In Operation</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 부대가 실전에 투입되어 교전을 수행한 주요 작전을 연결한다.</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates a military unit with the specific campaigns or battle actions it was engaged in.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology/korean-war#MilitaryUnit"/>
    <rdfs:range rdf:resource="http://example.org/ontology/korean-war#MilitaryOperation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/korean-war#BattleLocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
    <rdfs:label xml:lang="ko">전장 전술 요충지</rdfs:label>
    <rdfs:label xml:lang="en">Battlefield Strategic Location</rdfs:label>
    <rdfs:comment xml:lang="ko">군사 작전이나 정전 회담이 전개된 한반도 전역의 지리적 전장 및 주요 요충 지점.</rdfs:comment>
    <rdfs:comment xml:lang="en">Geographical combat area, tactical hill, harbor, or village where military engagements or talks occurred.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
