<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#fastPassAvailable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="ko">스마트/매직패스 지원 여부</rdfs:label>
    <rdfs:label xml:lang="en">fast pass available</rdfs:label>
    <rdfs:comment xml:lang="ko">우선탑승 예약 시스템(패스트패스) 지원 여부</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates whether express priority queuing (fast pass) is supported.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#currentWaitMinutes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#WaitTimeRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">현재 대기 시간(분)</rdfs:label>
    <rdfs:label xml:lang="en">current wait minutes</rdfs:label>
    <rdfs:comment xml:lang="ko">일반 대기열 기준 예상 대기 시간(분 단위)</rdfs:comment>
    <rdfs:comment xml:lang="en">Estimated queue waiting time in minutes for standard queue guests.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#recordedTimestamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#WaitTimeRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="ko">측정 일시</rdfs:label>
    <rdfs:label xml:lang="en">recorded timestamp</rdfs:label>
    <rdfs:comment xml:lang="ko">대기 시간 데이터가 집계되어 기록된 시각</rdfs:comment>
    <rdfs:comment xml:lang="en">Date and time when the wait time metric was sampled.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#passType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#AdmissionPass"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">패스 유형</rdfs:label>
    <rdfs:label xml:lang="en">pass type</rdfs:label>
    <rdfs:comment xml:lang="ko">입장권 상품 등급 및 유형 (DayPass, AfternoonPass, MagicPass, AnnualPass)</rdfs:comment>
    <rdfs:comment xml:lang="en">Category or tier of admission product (DayPass, AfternoonPass, MagicPass, AnnualPass).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#AdmissionPass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">입장권/패스</rdfs:label>
    <rdfs:label xml:lang="en">Admission Pass</rdfs:label>
    <rdfs:comment xml:lang="ko">테마파크 입장 및 어트랙션 이용 권한을 증명하는 티켓 또는 디지털 패스</rdfs:comment>
    <rdfs:comment xml:lang="en">A physical ticket or digital pass certifying admission and ride access privileges.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#DarkRide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:label xml:lang="ko">다크 라이드</rdfs:label>
    <rdfs:label xml:lang="en">Dark Ride</rdfs:label>
    <rdfs:comment xml:lang="ko">실내 특수효과 및 스토리텔링 음향·시각 연출이 결합된 실내 탑승 어트랙션</rdfs:comment>
    <rdfs:comment xml:lang="en">An indoor guided ride combining special effects, storytelling, lighting, and soundscapes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#executesTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ThemeParkAgent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#RideMaintenanceTask"/>
    <rdfs:label xml:lang="ko">정비 작업 지시/실행</rdfs:label>
    <rdfs:label xml:lang="en">executes maintenance task</rdfs:label>
    <rdfs:comment xml:lang="ko">AI 에이전트가 스케줄링하거나 제어하는 시설 정비 작업</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an agent to the maintenance task it schedules or supervises.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#parkName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ThemePark"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">테마파크 명칭</rdfs:label>
    <rdfs:label xml:lang="en">park name</rdfs:label>
    <rdfs:comment xml:lang="ko">놀이공원(테마파크)의 공식 브랜드 상호 명칭</rdfs:comment>
    <rdfs:comment xml:lang="en">The official brand name of the theme park.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="ko">놀이공원 운영 및 스마트 대기 온톨로지</rdfs:label>
    <rdfs:label xml:lang="en">Theme Park Operations and Smart Queuing Ontology</rdfs:label>
    <rdfs:comment xml:lang="ko">놀이공원(테마파크)의 테마 구역, 어트랙션(놀이기구), 탑승 제한, 실시간 대기열, 안전 점검 및 AI 혼잡도 제어 에이전트의 운영을 종합적으로 모델링하는 온톨로지</rdfs:comment>
    <rdfs:comment xml:lang="en">An ontology comprehensively modeling theme park zones, attractions, ride restrictions, real-time queues, safety inspections, and AI crowd control agent operations.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#hasMaintenanceTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#RideMaintenanceTask"/>
    <rdfs:label xml:lang="ko">정비 작업 내역</rdfs:label>
    <rdfs:label xml:lang="en">has maintenance task</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션의 예방 정비 및 긴급 수리 작업</rdfs:comment>
    <rdfs:comment xml:lang="en">Connects an attraction with preventive or corrective maintenance tasks.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#maxSpeedKmh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">최고 속도(km/h)</rdfs:label>
    <rdfs:label xml:lang="en">maximum speed kmh</rdfs:label>
    <rdfs:comment xml:lang="ko">탑승물 운행 중 기록되는 순간 최고 속도</rdfs:comment>
    <rdfs:comment xml:lang="en">The top instantaneous speed reached during the ride cycle in km/h.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#attractionCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">어트랙션 식별 코드</rdfs:label>
    <rdfs:label xml:lang="en">attraction code</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션의 사내 관리용 고유 영숫자 식별 코드</rdfs:comment>
    <rdfs:comment xml:lang="en">A unique alphanumeric facility code assigned to the attraction.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#ThemePark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">테마파크</rdfs:label>
    <rdfs:label xml:lang="en">Theme Park</rdfs:label>
    <rdfs:comment xml:lang="ko">다양한 테마 구역과 어트랙션, 편의시설을 보유한 종합 놀이공원 시설</rdfs:comment>
    <rdfs:comment xml:lang="en">A comprehensive amusement park facility comprising multiple themed zones, attractions, and amenities.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#locatedInZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#ThemeZone"/>
    <rdfs:label xml:lang="ko">위치한 테마 구역</rdfs:label>
    <rdfs:label xml:lang="en">located in zone</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 어트랙션이 설치되어 위치하는 테마 구역</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies the themed zone in which the attraction is installed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#hasInspection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#SafetyInspection"/>
    <rdfs:label xml:lang="ko">안전 점검 기록 보유</rdfs:label>
    <rdfs:label xml:lang="en">has safety inspection</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션에 대해 수행된 안전 점검 내역</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates an attraction with conducted safety inspection records.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#holdsPass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ParkVisitor"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#AdmissionPass"/>
    <rdfs:label xml:lang="ko">보유 입장권</rdfs:label>
    <rdfs:label xml:lang="en">holds admission pass</rdfs:label>
    <rdfs:comment xml:lang="ko">방문객이 소지하고 있는 입장권 또는 우선탑승 패스</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates the admission ticket or express pass held by the park visitor.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#congestionLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#CrowdControlAgent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">파크 혼잡도 레벨</rdfs:label>
    <rdfs:label xml:lang="en">congestion level</rdfs:label>
    <rdfs:comment xml:lang="ko">에이전트가 산정한 공원 전역의 혼잡 수준 (low, moderate, high, extreme)</rdfs:comment>
    <rdfs:comment xml:lang="en">Park-wide congestion rating computed by the AI agent (low, moderate, high, extreme).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#operationalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">운영 상태</rdfs:label>
    <rdfs:label xml:lang="en">operational status</rdfs:label>
    <rdfs:comment xml:lang="ko">현재 어트랙션 운영 상태 (operating, maintenance, weather_hold, closed)</rdfs:comment>
    <rdfs:comment xml:lang="en">Current operational condition of the ride (operating, maintenance, weather_hold, closed).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#RideMaintenanceTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">정비 보수 작업</rdfs:label>
    <rdfs:label xml:lang="en">Ride Maintenance Task</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션의 부품 교체, 윤활, 레일 교정 등 실제 유지보수 실행 과업</rdfs:comment>
    <rdfs:comment xml:lang="en">An operational maintenance task executing component replacement, lubrication, or track calibration.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#safetyInspector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#SafetyInspection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">점검관/인증기관</rdfs:label>
    <rdfs:label xml:lang="en">safety inspector</rdfs:label>
    <rdfs:comment xml:lang="ko">점검을 주관한 전문 안전 검사관 또는 공인 검사 기관</rdfs:comment>
    <rdfs:comment xml:lang="en">Name of the certified safety inspector or regulatory auditing agency.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#WaterRide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:label xml:lang="ko">수상 어트랙션</rdfs:label>
    <rdfs:label xml:lang="en">Water Ride</rdfs:label>
    <rdfs:comment xml:lang="ko">수로를 따라 주행하거나 급류를 타는 물 관련 탑승 시설</rdfs:comment>
    <rdfs:comment xml:lang="en">A water-based ride installation navigating waterways or flumes with splashing thrills.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#hasWaitTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#WaitTimeRecord"/>
    <rdfs:label xml:lang="ko">대기 시간 기록 보유</rdfs:label>
    <rdfs:label xml:lang="en">has wait time record</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션에 연결된 실시간 대기열 측정 기록</rdfs:comment>
    <rdfs:comment xml:lang="en">Relates an attraction to its measured real-time queue wait record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#ThemeParkAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">테마파크 AI 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Theme Park AI Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">테마파크의 스마트 운영, 대기열 최적화 및 시설 안전을 관리하는 지능형 소프트웨어 에이전트</rdfs:comment>
    <rdfs:comment xml:lang="en">An intelligent software agent managing smart operations, queue optimization, and safety in the theme park.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#inspectionPassed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#SafetyInspection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="ko">점검 합격 여부</rdfs:label>
    <rdfs:label xml:lang="en">inspection passed</rdfs:label>
    <rdfs:comment xml:lang="ko">안전 점검 결과 기준 합격 여부</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean indicator verifying whether the attraction passed safety inspection.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#SafetyInspection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">안전 점검 기록</rdfs:label>
    <rdfs:label xml:lang="en">Safety Inspection</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션의 안전 운행을 검증하기 위한 정기 및 수시 기술 점검 기록</rdfs:comment>
    <rdfs:comment xml:lang="en">A formal record of periodic or ad-hoc technical inspection verifying safe ride operation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#totalAreaSqMeters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ThemePark"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">총 부지 면적(m²)</rdfs:label>
    <rdfs:label xml:lang="en">total area square meters</rdfs:label>
    <rdfs:comment xml:lang="ko">놀이공원의 총 부지 면적(제곱미터 단위)</rdfs:comment>
    <rdfs:comment xml:lang="en">The total site area of the theme park in square meters.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#ThemeZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">테마 구역</rdfs:label>
    <rdfs:label xml:lang="en">Themed Zone</rdfs:label>
    <rdfs:comment xml:lang="ko">공원 내에서 특정 세계관이나 테마 컨셉으로 조성된 구역</rdfs:comment>
    <rdfs:comment xml:lang="en">A designated zone within the theme park styled around a specific worldview or aesthetic concept.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#inspectionDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#SafetyInspection"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="ko">점검 일자</rdfs:label>
    <rdfs:label xml:lang="en">inspection date</rdfs:label>
    <rdfs:comment xml:lang="ko">안전 점검을 실시한 날짜</rdfs:comment>
    <rdfs:comment xml:lang="en">Calendar date on which the safety inspection was conducted.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#CrowdControlAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/theme-park#ThemeParkAgent"/>
    <rdfs:label xml:lang="ko">군중 혼잡도 제어 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Crowd Control Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">공원 전역의 인파 밀집도를 실시간 모니터링하고 대기열을 분산하는 AI 에이전트</rdfs:comment>
    <rdfs:comment xml:lang="en">An AI agent monitoring visitor density across the park and dynamically balancing queues.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#managedByAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#ThemeParkAgent"/>
    <rdfs:label xml:lang="ko">담당 운영 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">managed by agent</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션의 운영 및 상태 관리를 전담하는 AI 에이전트</rdfs:comment>
    <rdfs:comment xml:lang="en">Indicates the AI agent responsible for managing attraction operations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#validForPark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#AdmissionPass"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#ThemePark"/>
    <rdfs:label xml:lang="ko">적용 대상 테마파크</rdfs:label>
    <rdfs:label xml:lang="en">valid for theme park</rdfs:label>
    <rdfs:comment xml:lang="ko">해당 패스가 효력을 갖는 대상 테마파크 단지</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies the theme park for which the admission pass is valid.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#rideDurationSeconds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">운행 소요 시간(초)</rdfs:label>
    <rdfs:label xml:lang="en">ride duration seconds</rdfs:label>
    <rdfs:comment xml:lang="ko">출발부터 정지까지 1회 탑승 사이클 소요 시간(초)</rdfs:comment>
    <rdfs:comment xml:lang="en">Duration of one complete ride cycle from departure to station return in seconds.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#zoneTheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ThemeZone"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">구역 테마 컨셉</rdfs:label>
    <rdfs:label xml:lang="en">zone theme concept</rdfs:label>
    <rdfs:comment xml:lang="ko">테마 구역에 적용된 건축 및 시각 컨셉 (예: 서부개척시대, 미래우주, 동화)</rdfs:comment>
    <rdfs:comment xml:lang="en">The narrative or stylistic theme applied to the zone (e.g., Western, Sci-Fi, Fantasy).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#RollerCoaster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:label xml:lang="ko">롤러코스터</rdfs:label>
    <rdfs:label xml:lang="en">Roller Coaster</rdfs:label>
    <rdfs:comment xml:lang="ko">트랙을 따라 고속으로 주행하며 급강하 및 회전 체험을 제공하는 철도형 놀이기구</rdfs:comment>
    <rdfs:comment xml:lang="en">A rail-based ride operating at high speeds along tracks featuring steep drops and inversions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#visitorAssignedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ParkVisitor"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:label xml:lang="ko">예약/대기 중인 어트랙션</rdfs:label>
    <rdfs:label xml:lang="en">visitor assigned to attraction</rdfs:label>
    <rdfs:comment xml:lang="ko">방문객이 스마트 줄서기를 통해 배정받아 탑승 대기 중인 어트랙션</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates a visitor with the attraction they are currently queued or scheduled for.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#monitorsAttraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#CrowdControlAgent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:label xml:lang="ko">모니터링 대상 어트랙션</rdfs:label>
    <rdfs:label xml:lang="en">monitors attraction</rdfs:label>
    <rdfs:comment xml:lang="ko">혼잡도 분산 에이전트가 실시간 대기열을 감시하는 어트랙션</rdfs:comment>
    <rdfs:comment xml:lang="en">Specifies an attraction whose queue density is observed by the crowd control agent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#aiRecommendationNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ThemeParkAgent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">AI 운영 권고문</rdfs:label>
    <rdfs:label xml:lang="en">AI recommendation note</rdfs:label>
    <rdfs:comment xml:lang="ko">AI 에이전트가 생성한 대기 분산 또는 시설 운영 조치 권고</rdfs:comment>
    <rdfs:comment xml:lang="en">Operational dispatch or queue balancing advisory formulated by the AI agent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#queueLengthPersons">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#WaitTimeRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">대기열 인원(명)</rdfs:label>
    <rdfs:label xml:lang="en">queue length persons</rdfs:label>
    <rdfs:comment xml:lang="ko">대기열 구역에 줄을 서 있는 실시간 인원 수</rdfs:comment>
    <rdfs:comment xml:lang="en">Real-time head count of visitors waiting in line.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#Attraction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">어트랙션/놀이기구</rdfs:label>
    <rdfs:label xml:lang="en">Attraction</rdfs:label>
    <rdfs:comment xml:lang="ko">방문객이 즐길 수 있도록 설치된 놀이 탑승물 또는 체험형 시설</rdfs:comment>
    <rdfs:comment xml:lang="en">A ride or experiential installation provided for visitors to enjoy in the park.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#ParkVisitor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">공원 방문객</rdfs:label>
    <rdfs:label xml:lang="en">Park Visitor</rdfs:label>
    <rdfs:comment xml:lang="ko">테마파크에 입장하여 시설을 이용하는 관람객</rdfs:comment>
    <rdfs:comment xml:lang="en">A guest admitted to the theme park utilizing facilities and riding attractions.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#rideCapacityPerHour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="ko">시간당 탑승 정원(명)</rdfs:label>
    <rdfs:label xml:lang="en">ride capacity per hour</rdfs:label>
    <rdfs:comment xml:lang="ko">이론상 시간당 최대로 수용 가능한 탑승객 수</rdfs:comment>
    <rdfs:comment xml:lang="en">Theoretical maximum passenger throughput capacity per hour.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#trackLengthMeters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">트랙 길이(m)</rdfs:label>
    <rdfs:label xml:lang="en">track length meters</rdfs:label>
    <rdfs:comment xml:lang="ko">롤러코스터 또는 주행 어트랙션의 레일 총 길이</rdfs:comment>
    <rdfs:comment xml:lang="en">Total rail track distance of the ride installation in meters.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#auditsInspection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#SafetyMonitoringAgent"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#SafetyInspection"/>
    <rdfs:label xml:lang="ko">감사 대상 안전점검</rdfs:label>
    <rdfs:label xml:lang="en">audits safety inspection</rdfs:label>
    <rdfs:comment xml:lang="ko">안전 모니터링 에이전트가 검증 및 감사하는 안전 점검 기록</rdfs:comment>
    <rdfs:comment xml:lang="en">Identifies safety inspection records audited by the safety monitoring agent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#maintenanceCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#RideMaintenanceTask"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">정비 분류</rdfs:label>
    <rdfs:label xml:lang="en">maintenance category</rdfs:label>
    <rdfs:comment xml:lang="ko">정비 작업의 분류 (daily_check, periodic_overhaul, emergency_fix)</rdfs:comment>
    <rdfs:comment xml:lang="en">Classification of maintenance activity (daily_check, periodic_overhaul, emergency_fix).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#minHeightRequirementCm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#Attraction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">탑승 제한 신장(cm)</rdfs:label>
    <rdfs:label xml:lang="en">minimum height requirement cm</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션 탑승을 위해 요구되는 최소 신장(cm)</rdfs:comment>
    <rdfs:comment xml:lang="en">Minimum body height in centimeters required for safe boarding.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#passPrice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#AdmissionPass"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ko">패스 가격</rdfs:label>
    <rdfs:label xml:lang="en">pass price</rdfs:label>
    <rdfs:comment xml:lang="ko">입장권의 통화 기준 판매 가격</rdfs:comment>
    <rdfs:comment xml:lang="en">Monetary sale price of the admission pass.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#openingHours">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ThemePark"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ko">개장 운영 시간</rdfs:label>
    <rdfs:label xml:lang="en">opening hours</rdfs:label>
    <rdfs:comment xml:lang="ko">일일 개장 및 폐장 시간 표기 (예: 10:00-21:00)</rdfs:comment>
    <rdfs:comment xml:lang="en">The daily operational hours from opening to closing (e.g., 10:00-21:00).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#SafetyMonitoringAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology/theme-park#ThemeParkAgent"/>
    <rdfs:label xml:lang="ko">안전 모니터링 에이전트</rdfs:label>
    <rdfs:label xml:lang="en">Safety Monitoring Agent</rdfs:label>
    <rdfs:comment xml:lang="ko">센서 데이터와 점검 이력을 분석하여 선제적 정비 수요와 이상 징후를 감지하는 에이전트</rdfs:comment>
    <rdfs:comment xml:lang="en">An agent analyzing sensor telemetry and inspection history to detect maintenance needs and anomalies.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#hasZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology/theme-park#ThemePark"/>
    <rdfs:range rdf:resource="http://example.org/ontology/theme-park#ThemeZone"/>
    <rdfs:label xml:lang="ko">테마 구역 보유</rdfs:label>
    <rdfs:label xml:lang="en">has themed zone</rdfs:label>
    <rdfs:comment xml:lang="ko">테마파크 단지 내에 포함된 개별 테마 구역을 연결</rdfs:comment>
    <rdfs:comment xml:lang="en">Associates a theme park with its constituent themed zones.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology/theme-park#WaitTimeRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ko">대기 시간 기록</rdfs:label>
    <rdfs:label xml:lang="en">Wait Time Record</rdfs:label>
    <rdfs:comment xml:lang="ko">어트랙션별 특정 시점에 측정된 실시간 대기 시간 및 대기 인원 통계</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical record of real-time queue wait duration and visitor count for an attraction.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
